    {
      "ref": "Article 1",
      "topic": "Reference time",
      "summary": "Business clocks are synchronised to UTC as issued by a timing centre listed in the BIPM Annual Report on Time Activities, or as disseminated by a satellite system, with offsets accounted for.",
      "mapped_evidence": [
        "operator.utc_source",
        "fleet.inventory",
        "clock.records"
      ],
      "operator_action": "Name the UTC source of each grandmaster (UTC(k) laboratory or GNSS) and how its offset from UTC is accounted for."
    },
    {
      "ref": "Articles 2 and 3, Annex",
      "topic": "Level of accuracy",
      "summary": "The maximum divergence from UTC and the timestamp granularity depend on the trading activity: trading venue operators (Article 2, Annex Table 1) and their members or participants (Article 3, Annex Table 2).",
      "mapped_evidence": [
        "clock.divergence"
      ],
      "operator_action": "State the trading activity each clock serves; confirm the recorded offset is against UTC (or a reference traceable to it)."
    },
    {
      "ref": "Article 4",
      "topic": "Traceability to UTC",
      "summary": "A system of traceability to UTC is established, documenting the system design, functioning and specifications, identifying the exact point at which a timestamp is applied, and reviewed at least once a year.",
      "mapped_evidence": [
        "operator.traceability_chain",
        "operator.timestamp_point",
        "operator.review",
        "evidence.history",
        "report.signature"
      ],
      "operator_action": "Describe the chain from the UTC source to each timestamping point, the point where the timestamp is applied, and the date of the last yearly review."
    },
    {
      "ref": "Article 4 (continuity)",
      "topic": "Holdover and time to breach",
      "summary": "Not a provision text: the operator's own evidence that each clock stays within its divergence limit if its reference is lost, used to plan the response before the limit is reached.",
      "mapped_evidence": [
        "clock.holdover"
      ],
      "operator_action": "State the response when a clock's warning time is shorter than the time needed to restore its reference."
    }
