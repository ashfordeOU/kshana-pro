/target
**/*.rs.bk
Cargo.lock.orig

# macOS Finder cruft
.DS_Store
**/.DS_Store

# Closed-overlay safety: NDA / customer / export-controlled material must NEVER be
# committed. Keep such inputs out of the tree entirely; these patterns are a
# backstop, not a licence to place secrets in the repo.
/data/
/private/
*.nda
*.confidential
*-customer-*
*-device-data*

# Credentials / keys / secrets — never commit (hardening ahead of L2 work).
*.key
*.pem
*.p12
*.pfx
*.env
.env*
*.secret

# LaTeX build by-products. The manuscripts, figures and submission bundles are
# tracked; the compiler's scratch output is not — it is regenerated by every
# `tectonic`/`pdflatex` run and only ever shows up as noise in `git status`.
*.log
*.blg
*.aux
*.out
*.synctex.gz

# Dated ledger snapshots taken by hand before a gap-audit re-run. The ledger
# itself is tracked; these are local rollback copies.
*.bak-*

# Lab campaign outputs (engine `kshana iq campaign`). Client recordings, campaign results and
# scores must never be committed: export-control item N6
# (commercial/export-control/CLASSIFICATION-REQUEST-PACK.md §2.1a). Only the synthetic test
# fixtures under tests/fixtures/lab_campaign_synthetic/ are tracked, and
# tests/lab_campaign_no_client_data.rs enforces it.
/lab-campaigns/
**/campaign-out/
*.sigmf-data
*.sigmf-meta
**/cells/*.json
!tests/fixtures/lab_campaign_synthetic/**
__pycache__/

# The timing demo fleet keeps real-format clock logs as test inputs (tests/timing_assurance.rs).
!examples/timing-fleet/logs/*.log

# Agent worktrees (local only)
/.claude/worktrees/
/target-check/
