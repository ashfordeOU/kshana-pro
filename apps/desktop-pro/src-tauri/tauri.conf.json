{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kshana Desktop Pro",
  "version": "0.2.0",
  "identifier": "dev.kshana.desktop.pro",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "title": "Kshana Desktop Pro", "width": 1360, "height": 900, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Kshana Pro on your own machine",
    "copyright": "Ashforde OÜ"
  }
}
