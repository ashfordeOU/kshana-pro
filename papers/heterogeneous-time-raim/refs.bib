% ---------------------------------------------------------------------------
% Clock-ensemble fault detection (the common-mode incumbency) --- CITED
% ---------------------------------------------------------------------------

% Per-clock fault detection and identification WITHIN a clock ensemble via a
% generalized likelihood ratio test. The design-spine incumbency for the
% common-mode layer: it is well established here that an offset common to every
% ensemble member cancels in all inter-clock time differences and is therefore
% unobservable from the ensemble alone. Distinct from the present composed,
% source-agnostic time-RAIM object (a protection-level with a UTC(k)
% traceability-bias budget and an explicit common-mode statistic).
% DOI/title/authors/venue/pages confirmed against the IOP Metrologia record.
@article{trainotti2022,
  author  = {Trainotti, Christian and Giorgi, Gabriele and G{\"u}nther, Christoph},
  title   = {Detection and Identification of Faults in Clock Ensembles with the
             Generalized Likelihood Ratio Test},
  journal = {Metrologia},
  year    = {2022},
  volume  = {59},
  number  = {4},
  pages   = {045010},
  doi     = {10.1088/1681-7575/ac7686},
  note    = {Per-clock GLRT fault detection/identification in a clock ENSEMBLE, not
             a composed source-agnostic time-RAIM protection-level object. The
             common-offset-cancels-in-all-time-differences unobservability is
             established ensemble metrology. Corrigendum: Metrologia 62(2):029501,
             2025, DOI 10.1088/1681-7575/adb03e.},
}

