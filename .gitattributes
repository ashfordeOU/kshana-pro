# Git LFS for heavy binary media in the vendored site source and its brand and Pro assets
# (SOURCES.md). Text (HTML, CSS, JS, JSON recordings, Markdown) stays in plain git.
site-next/**/*.wasm filter=lfs diff=lfs merge=lfs -text
site-next/**/*.png filter=lfs diff=lfs merge=lfs -text
site-next/**/*.jpg filter=lfs diff=lfs merge=lfs -text
site-next/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
site-next/**/*.webp filter=lfs diff=lfs merge=lfs -text
site-next/**/*.pdf filter=lfs diff=lfs merge=lfs -text
site-next/**/*.gz filter=lfs diff=lfs merge=lfs -text
site-next/**/*.woff2 filter=lfs diff=lfs merge=lfs -text
site-next/**/*.ttf filter=lfs diff=lfs merge=lfs -text
site-next/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
brand/**/*.png filter=lfs diff=lfs merge=lfs -text
brand/**/*.ttf filter=lfs diff=lfs merge=lfs -text
brand/**/*.woff2 filter=lfs diff=lfs merge=lfs -text
pro-assets/**/*.pdf filter=lfs diff=lfs merge=lfs -text
pro-assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
