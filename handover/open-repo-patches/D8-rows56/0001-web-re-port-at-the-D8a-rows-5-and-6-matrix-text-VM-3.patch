n one coverage half-angle of\n# it. The `work` block of the result states how many satellite-point pair tests a brute-force\n# scan would have made and how many were made. The secular J2 drift of the nodes is on, and\n# the tracks are downsampled to 120 satellites.\n#\n# What the run answers: satellites in view, PDOP/HDOP/VDOP/GDOP per 10 deg cell, and the\n# share of time with PDOP at or below 3 above a 20 deg mask over two hours. The weak spot the\n# map shows is the polar caps: no shell reaches above about 82 deg latitude, so a user near a\n# pole sees every satellite on one side of the sky and the vertical geometry degrades. MODELLED: an\n# illustrative design, two-body orbits with J2, a spherical Earth, geometry only.\n\nkind = \"constellation-design\"\nbody = \"earth\"\nduration_s = 7200.0\nstep_s = 600.0\nmask_deg = 20.0\npdop_threshold = 3.0\ngrid_step_deg = 10.0\nclock = \"common\"\nj2 = true\ntrack_points = 13\nmax_tracks = 120\n\n[[constellation]]\nname = \"LEO-PNT\"\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 1600\nplanes = 32\nphasing = 1\naltitude_km = 550.0\ninclination_deg = 53.0\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 1600\nplanes = 32\nphasing = 7\naltitude_km = 540.0\ninclination_deg = 53.2\nraan0_deg = 5.625\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 1000\nplanes = 20\nphasing = 3\naltitude_km = 570.0\ninclination_deg = 70.0\n\n[[constellation.shell]]\npattern = \"star\"\ntotal = 800\nplanes = 16\nphasing = 1\naltitude_km = 560.0\ninclination_deg = 97.6\n","body":"Earth","radius_km":6378.137,"rot_deg_s":0.004178074216293311,"times":[0.0,600.0,1200.0,1800.0,2400.0,3000.0,3600.0,4200.0,4800.0,5400.0,6000.0,6600.0,7200.0],"shown":120,"total":5000,"sats":[{"c":"LEO-PNT","key":"leo-pnt","id":"S1-0001","a_km":6927.9,"lat":[0.0,29.2,50.58,47.33,23.06,-6.61,-35.03,-52.53,-43.05,-16.69,13.18,40.4,52.96],"lon":[0.0,22.37,61.4,117.55,151.14,172.32,-163.34,-118.31,-65.05,-35.9,-15.22,11.97,62.7]},{"c":"LEO-PNT","ke