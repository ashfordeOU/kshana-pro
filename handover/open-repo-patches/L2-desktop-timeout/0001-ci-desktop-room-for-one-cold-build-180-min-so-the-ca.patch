From 6887c4c550c062848c3194a657b578c44fa68f1d Mon Sep 17 00:00:00 2001
From: ashfordeOU <236818772+ashfordeOU@users.noreply.github.com>
Date: Sun, 8 Nov 2026 00:50:49 +0000
Subject: [PATCH] ci(desktop): room for one cold build (180 min), so the cache
 that makes later runs warm is saved

macos-14 was stopped at the 90-minute limit twice. rust-cache saves target/ and
~/.cargo/bin (tauri-cli) only when the job succeeds, so a timed-out job left no
cache and every macOS run started cold. The limit now allows one cold run.
---
 .github/workflows/desktop.yml | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/desktop.yml b/.github/workflows/desktop.yml
index 6372396b7..dbc2300d6 100644
--- a/.github/workflows/desktop.yml
+++ b/.github/workflows/desktop.yml
@@ -17,7 +17,12 @@ jobs:
       matrix:
         os: [ubuntu-22.04, macos-14, windows-2022]
     runs-on: ${{ matrix.os }}
-    timeout-minutes: 90
+    # A cold run builds the app three times (clippy, the tests, the release bundle) and
+    # tauri-cli from source. rust-cache saves target/ and ~/.cargo/bin only when the job
+    # succeeds, so a job that hits this limit leaves no cache and the next run is cold
+    # again: macos-14 was stopped at 90 minutes twice. With room for one cold run, the
+    # following runs start warm.
+    timeout-minutes: 180
     steps:
       - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
       - uses: dtolnay/rust-toolchain@e2a55d2ffb04f378e9626c28d38b36d230d1e12f # master; the toolchain is the `toolchain` input below
-- 
