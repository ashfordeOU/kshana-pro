.371482,0.220123,-0.901968],"a_km":25478.1,"n":0.00015524489851599424},{"c":"GLONASS","id":"R24","h":[0.680292,0.596579,0.425789],"u0":[0.709448,-0.390071,-0.586966],"a_km":25478.1,"n":0.00015524484544045378}],"constellations":[{"name":"GPS","satellites":24,"mean_visible":7.1744,"source":"GPS baseline 24-slot constellation, GPS SPS Performance Standard 5th ed. (2020) Tables 3.2-1 and 3.2-3"},{"name":"Galileo","satellites":24,"mean_visible":7.446,"source":"Galileo Walker 24/3/1, Galileo OS SDD issue 1.1 Tables 1 and 23"},{"name":"BeiDou","satellites":30,"mean_visible":9.3496,"source":"BeiDou MEO Walker 24/3/1 + 3 GEO + 3 IGSO, BDS-OS-PS-3.0 (2021) section 4.1; MEO phase and IGSO nodes modelled"},{"name":"GLONASS","satellites":24,"mean_visible":7.0636,"source":"GLONASS 24/3/1, GLONASS ICD edition 5.1 (2008) section 5.2"}],"total":102},"engine":{"version":"0.40.0","commit":"667bea5"},"phaseNames":{"nominal":"Nominal","jamming":"Jamming","spoofing":"Spoofing","holdover":"Holdover","integrity-alarm":"Integrity alarm","recovery":"Recovery"},"phaseColors":{"nominal":"--lime","jamming":"--amber","spoofing":"--magenta","holdover":"--cyan","integrity-alarm":"--coral","recovery":"--lime"},"facts":{"S_TRK":"8","S_CN0":"43.0","S_PL0":"9.1","S_PL1":"21.6","S_AL":"50","S_JAM1":"-30","S_CN0J":"30.6","S_FLOOR":"25","S_RF_T":"T+00:20:00","S_DET_S":"370","S_OFF":"36.0","S_RATE":"0.1","S_JAMKM":"1.0","S_JAM2":"10","S_CARRY":"37.0","S_GUARD":"50","S_GUARD_T":"T+00:35:40","S_GUARD_AFTER":"10","S_INS_KM":"24.3","S_MASK2":"25","S_TRK2":"5","S_PLMAX":"135","S_TEMAX":"62.7"},"mcp":{"recorded":"2026-11-08","protocol":"2024-11-05","server":{"name":"kshana-mcp","version":"0.40.0"},"tools":[{"name":"animate_scenario","does":"Run a Kshana scenario and return its time series as an animation."},{"name":"assess_receiver_log","does":"Assess a real GNSS receiver log for trust: read a u-blox UBX, RINEX 3 (optionally with broadcast navigation, which adds the engine's own fix, RAIM and a clock-aided monitor), Android GnssLogger or NMEA log, run the trust monitors (carrier-to-noise density drop, AGC, jamming indicator, loss of lock, position jump, RAIM, clock) against a calibration baseline, and return when and why the receiver stopped being trustworthy."},{"name":"assess_vessel_log","does":"Assess a vessel's NMEA 0183 log as a batch run (`kshana receiver-trust` with `[platform] kind = \"vessel\"`): the score model, the monitors that ran and every epoch's 0-100 score with its deductions, its satellite geometry (good, degraded, unknown) with a `label` (good, fair, poor) on every epoch, geometry deducting only when poor, and a class on every deduction (geometry, environment, inconsistency), with `geometry_model` (thresholds, the cap and floor in force, and provenance) and `geometry_summary`."},{"name":"assess_vessel_stream","does":"Score a bounded excerpt of a vessel's NMEA 0183 stream the way `kshana receiver-trust live` scores it, and return per-epoch trust state (calibrating, nominal, degraded, untrusted) and 0-100 score with the monitors that deducted (live JSON-lines schema 1.3: each epoch carries `position`, an `advisory` statement that the output is advisory, and its satellite `geometry` (good, degraded with reasons such as few-satellites or high-pdop, or unknown when the excerpt has no GSV or GSA) with a `label` (good, fair, poor; geometry deducts only when poor); every deduction carries a `class`: geometry (the sky, not a finding that no attack occurred), environment or inconsistency (attack-like)), the summary (counts by state, geometry and class, lowest and final score, when the first untrusted epoch came) and the last `$PKSHT` sentence."},{"name":"attach_evidence_timestamp","does":"Bind an RFC 3161 timestamp token to an evidence pack (`kshana evidence attach-timestamp`), in memory: `files` is a pack as `create_evidence_pack` returns it, `token_base64` the bytes of the `.tsr` file from a timestamp authority."},{"name":"build_interference_map","does":"Build a GNSS interference map from openly licensed aircraft (ADS-B NIC/NACp) or ship (AIS) position reports given as CSV text (`kshana interference-map adsb|ais`)."},{"name":"compliance_mapping","does":"The static public-framework mapping (`kshana compliance-report --mapping` / `--sources`) as Markdown: one table per framework with each row's paraphrased ask, the Kshana outputs that support evidence for it and the gap the outputs do not close; or, with `sources` true, the source documents the tables cite with versions and URLs."},{"name":"compliance_report","does":"Fill the public-framework mapping from Kshana result documents (`kshana compliance-report`): which rows of six resilience frameworks and standards (the US DHS Resilient PNT framework v2.0, IMO guidance for ships, EASA guidance for aviation, NIS2 Article 21, EN 16803, NIST IR 8323r1) the runs given support evidence for, which they do not, and the gap each row keeps."},{"name":"connect_map","does":"Map any receiver, timing or monitoring log to Kshana observations with a `kshana.connect/1` mapping file, no code (`kshana connect map`, docs/CONNECT.md)."},{"name":"create_evidence_pack","does":"Create a signed evidence pack for a window of a vessel's NMEA 0183 log (`kshana receiver-trust evidence`): the raw log bytes for the window, the configuration with every threshold, the per-epoch results and reasons, a self-contained summary page, and a manifest listing every file's SHA-256 with the full log's hash and a hash chain, signed with Ed25519."},{"name":"create_round_trip_pack","does":"Create the signed laboratory round-trip pack (`kshana evidence round-trip`, docs/spec/TEST-CONDITIONS.md): links by hash the scenario that produced the motion, the laboratory's `kshana.test-conditions/1` document, the receiver log and its score against the stated events, in a signed evidence pack whose `config.json` carries a `round_trip` block."},{"name":"ephem_export","does":"Write a JPL Horizons vector table (for example the CAPSTONE or Artemis I states of the mission thread) as a file flight-dynamics tools load (`kshana ephem-export`, docs/FLIGHT-DYNAMICS-EXPORT.md): a CCSDS OEM 2.0 of every state (`format` `oem`), a CCSDS OPM 3.0 of one state (`opm`, `index`), or a NAIF SPK kernel of type 13 or 9 (`spk`)."},{"name":"export_interop","does":"Export a Kshana scenario in one interoperability format: `czml` (Cesium Language, for CesiumJS), `kml` (Keyhole Markup Language, for Google Earth and geographic information system tools), `geojson` (RFC 7946), `stk` (Systems Tool Kit ephemeris `.e`, one file per satellite) or `sigmf` (Signal Metadata Format recording of a `spectrum` scenario's synthesised samples)."},{"name":"export_oem","does":"Export an `orbit` scenario's propagated constellation as CCSDS OEM 2.0 ephemeris text — the inertial (TEME) state time series carrying position AND velocity, which flight-dynamics tools (GMAT / Orekit / STK) read."},{"name":"export_omm","does":"Export an `orbit` scenario's mean elements as a CCSDS 502.0-B-2 OMM (Orbit Mean-Elements Message) catalogue — one OMM per satellite."},{"name":"export_sp3","does":"Export an `orbit` scenario's propagated constellation as SP3-c precise-ephemeris text (the standard GNSS post-processing format)."},{"name":"export_table_csv","does":"Run a Kshana scenario and return its reproducibility table as CSV text — the byte-stable table the CLI writes as `<scenario>.table.csv` and the papers cite."},{"name":"export_test_bench","does":"Export a scenario's vehicle motion and events for a laboratory GNSS simulator (`kshana bench-export`, docs/TEST-BENCH.md): a motion CSV and its JSON description (Earth-fixed and geodetic position, velocity, attitude, UTC), NMEA 0183 GGA/RMC sentences, a waypoint text when the sample grid is millisecond-regular, and the scenario's events as CSV and as `[[events]]` TOML for a `receiver-trust` scenario."},{"name":"fit_imu_log","does":"Fit the sensor parameters of the `hybrid` and `fusion` scenarios from a stationary IMU log (`kshana imu-fit`, docs/MACHINE-INPUTS.md)."},{"name":"generate_training_nmea","does":"Generate synthetic bridge NMEA 0183 for crew training from a `nmea-scenario` TOML (`kshana nmea-scenario`): a vessel track and a timeline of scripted events (jamming, position drag-off, time spoof, replay delay, with recovery)."},{"name":"get_example_scenario","does":"Return the TOML text of one bundled reference scenario, byte for byte the file the repository ships under `scenarios/`."},{"name":"import_route","does":"Write a GeoJSON route into a Kshana scenario that flies a waypoint track, and return the new scenario TOML (run it with run_scenario)."},{"name":"interference_emitter_regions","does":"Estimate emitter regions from openly licensed aircraft (ADS-B) or ship (AIS) reports given as CSV text (`kshana interference-map locate`): where, under stated assumptions, a source of the degraded reports could be, as regions at stated confidence levels with a centroid and an uncertainty ellipse, never a bare point."},{"name":"iq_acquire","does":"FFT acquisition of one or more PRNs over an IQ recording in the work directory (`kshana iq acquire`)."},{"name":"iq_campaign","does":"Run a lab-replay campaign held in the work directory (`kshana iq campaign`): recordings (each described by a `kshana.test-conditions/1` file stating the lab's known truth) x front-end chains x loop designs, each cell tracked and scored against the stated conditions (time to loss of lock, re-acquisition time, C/N0 degradation against the stated J/S beside an analytic reference labelled MODELLED, false-lock rate, PLL/DLL jitter, availability)."},{"name":"iq_campaign_status","does":"Report a lab-replay campaign's progress from its output folder in the work directory, reading files only: cells done and pending, the recordings, front ends and designs in the plan, and the `digest` once every cell is done."},{"name":"iq_frontend","does":"Apply receiver front-end and interference-mitigation DSP to an IQ recording in the work directory and write the result as a new raw recording with a `<out>.json` sidecar (`kshana iq frontend`)."},{"name":"iq_info","does":"Describe one IQ recording in the work directory without processing it: kind (raw with sidecar, SigMF, SigMF collection), sample format, sample rate, centre frequency, total samples, duration, data files and their size, capture boundaries and annotation count, as JSON (the same row `kshana iq info` prints)."},{"name":"iq_labfit","does":"Fit the tracking-loop loss-of-lock model to lab runs (`kshana iq labfit`): an `iq-labfit` scenario TOML names one or more runs, each a receiver log plus its stated test conditions; the engine loads each log, fits the loop and empirical models, bootstraps the uncertainty and computes the hold-out error."},{"name":"iq_monitor","does":"Run the interference and spoofing detection monitors over an IQ recording in the work directory (`kshana iq monitor`): the wideband `power` and `spectral` monitors, and, given `signal` + `prns`, the per-satellite C/N0 and signal-quality monitors, each against a baseline learned from the first `baseline_s` seconds (or from a settings file)."},{"name":"iq_scene","does":"Generate a multi-satellite GNSS IQ scene into a file in the work directory (`kshana iq scene`)."},{"name":"iq_signals","does":"The GNSS IQ layer's set-up, as JSON: `signals` (the signal names iq_scene, iq_acquire and iq_track accept), `enabled` (whether the IQ file tools are on), `work_dir` (the only folder they read and write; every path argument is relative to it), `max_samples` (the most complex samples one call may generate or process) and, when off, `reason`."},{"name":"iq_sweep","does":"Replay one IQ recording in the work directory across several tracking-loop designs and report each design's steady-state result (`kshana iq sweep`): the designs are every design of a `kshana.loop-design/1` file (`design`), or the product of the `pll_bws_hz`, `dll_bws_hz`, `spacings_chips` and `coherents` lists on the built-in design."},{"name":"iq_test_conditions","does":"Validate a lab test-condition file (`kshana iq conditions`): a `kshana.test-conditions/1` file, TOML or JSON text, stating the lab's known truth for a recording (the satellites expected, the settle time, the stated jamming or interference schedule)."},{"name":"iq_track","does":"Acquire then track one or more PRNs over an IQ recording in the work directory (`kshana iq track`): acquisition initialises each channel, then the DLL/PLL (optionally FLL-assisted) loop bank replays the recording once."},{"name":"jammertest_import","does":"Read the published Jammertest test catalogue and transmission plan (NPRA/jammertest-plan, MIT) as scheduled truth (`kshana jammertest import`): the slots of one test area become receiver-trust events with the catalogue id and year in each label."},{"name":"jammertest_score","does":"Score a receiver log against the Jammertest schedule (`kshana jammertest score`): per scheduled test the detection latency (first alarm minus planned start), whether it was detected within the tolerance, late or missed, and the time to recover (an alarm-free stretch of `recover_hold_s`), plus the false alarms outside every slot and its guard."},{"name":"list_example_scenarios","does":"List the bundled reference scenarios as JSON: `count`, and `scenarios`, an array of `name`, `kind` and `about` (the first sentence of the file's own header comment)."},{"name":"list_export_formats","does":"Report which interoperability export formats apply to a Kshana scenario, without running it: a JSON array with one entry per format (`czml`, `kml`, `geojson`, `stk`, `sigmf`) giving `applies`, the `reason` when it does not, and `spec_url`, the published specification the writer follows."},{"name":"list_scenario_kinds","does":"List every built-in Kshana scenario kind with its description and required/optional TOML fields, as a JSON array."},{"name":"list_standards_packs","does":"List the standards packs (`kshana standards-pack list`): scored scenario sets for the DHS Resilient PNT framework test profiles, IMO MSC.1/Circ.1575 and ICAO Doc 9849 Appendix F, each with the bars it states before the run and the compliance rows it supports evidence for."},{"name":"lunanet_afs_check","does":"Check the LunaNet Augmented Forward Signal (AFS) against the published specification, pinned to LNIS Version 5 Applicable Document 1 Volume A (LSIS-AFS V1.0, 29 January 2025) (`kshana lunanet-afs-check`, docs/LUNANET-AFS.md)."},{"name":"referee_location_score","does":"Score where a monitoring network said interference came from (`kshana jammertest locate-score`, 0.41 row B2): per report the event it belongs to (by id, or by time window and nearest truth), the horizontal geodesic error and vertical error, and for each region (an ellipse with its covariance, a polygon or grid cells) whether it contains the truth and its area; per event and pooled the median and 90th-percentile error, coverage per level with its binomial check, median region size, time to first location and time to locate within 100 m, 500 m, 1 km and 5 km; and false locations per hour of clean time."},{"name":"render_leaderboard","does":"Render kshana-bench result files (`kshana bench leaderboard`) as the static leaderboard page, HTML text in the reply: `results` is a list of `kshana-bench-result/1` JSON texts (at most 256, 4 MiB each), each validated first; a file scored under another major spec version is refused because results of different major versions are never put in one table."},{"name":"report_scenario","does":"Run a Kshana scenario and return its report: an executive summary, the inputs, every result figure with its unit and its VALIDATED or MODELLED label, the events, the capability rows the run exercised, and a reproducibility record (engine version, scenario and result SHA-256 digests, seed, the command that reproduces it)."},{"name":"route_exposure","does":"Summarise how much of a route runs through degraded cells of one or more interference maps (`kshana route-exposure`): for each map (one per source per UTC day, the GeoJSON `build_interference_map` returns), the route length and the shares of its length in degraded cells, in cells that were not degraded, in cells with too little sample to assess, and in cells not observed."},{"name":"run_scenario","does":"Run a Kshana PNT-resilience scenario from a TOML definition and return its figures of merit."},{"name":"run_standards_pack","does":"Run one standards pack (`kshana standards-pack run <id>`): every scenario in it, scored against bars stated before the run."},{"name":"score_benchmark","does":"Score a kshana-bench submission (`kshana bench score`, bench/SPEC.md, docs/BENCH.md): a predictions file (`kshana-bench-predictions/1`) against a truth file (`kshana-bench-truth/1`), both JSON text, at most 4 MiB each, and return the result file (`kshana-bench-result/1`) with the spec version, task (a detection on receiver logs, b detection on IQ, c timing holdover prediction, d out-of-distribution optimism gap), split, the SHA-256 of both inputs and the task's metrics (AUC, detection probability at a false-alarm cap, RMSE per horizon, or the optimism gap)."},{"name":"sky_geometry","does":"Sky geometry under an azimuth-dependent skyline (a street canyon, a harbour, a fjord, a container terminal): from a site, a time and constellation presets, two-line element sets (`tle`, with a UTC `epoch`) or satellites given as azimuth/elevation or ECEF, which satellites are visible and which are hidden by the skyline, GDOP/PDOP/HDOP/VDOP/TDOP from the gnss_lib_py-checked DOP kernel, the east-north-up cofactor and covariance with one receiver clock per system (or one in common), and the horizontal error ellipse at one sigma and at a stated confidence for a stated UERE."},{"name":"trust_telemetry","does":"Render a GNSS trust stream or a `receiver-trust` result as security telemetry text (`kshana trust-telemetry`, docs/TRUST-TELEMETRY.md), with the same encoders the command line uses: `prometheus` (the exposition of the final state), `cef` or `leef` (one RFC 5424 syslog line per band change, or per epoch with `syslog_all`; no timestamp, because no clock is read) or `otlp` (the OTLP/HTTP JSON metrics payload)."},{"name":"validate_scenario","does":"Pre-flight check of a Kshana scenario TOML: verify it parses as TOML and detect its scenario kind, without running it."},{"name":"verify_evidence_pack","does":"Verify a signed evidence pack (`kshana evidence verify`): every file's SHA-256 against the manifest, the hash chain, the Ed25519 signature, and with `public_key` (the signer's key, from the signer by another route) that the signer is the one expected, and with `full_log` that the log you hold is the one the pack records and that the slice came from it."}],"file":"clock-holdover.toml","tomlHead":["# Kshana reference scenario: 2 h run, 10 min GNSS sync then ~1.8 h denied.","# Clock white-FM noise calibrated to published sigma_y(1 s): q_wf = sigma_y(1s)^2.","# Validated against simulated Allan deviation in tests/calibration.rs (~2%).","seed = 42","threshold_ns = 20.0",""],"tomlLines":29,"validate":"valid: detected scenario kind `clock`","summary":"scenario 5ba83a232b94 | quantum holdover 6600s p95 1.20e-4ns integrity 1.000 security n/a (no attack) | classical holdover 2610s p95 19.7ns integrity 1.000 security n/a (no attack)","result":{"schema_version":"0.7","engine_version":"0.40.0","scenario_hash":"5ba83a232b94e902273fb6dcb71dd27d8109401dc8834d0a735eebf230ed5378","seed":42,"threshold_ns":20.0},"clocks":[{"role":"classical","id":"csac-sa45s","fom":{"holdover_s":2610.0,"timing_p95_ns":19.674897980377633,"timing_rms_ns":11.333583645771197,"availability":0.955617198335645},"series":[[0.0,0.0],[40.0,0.0],[80.0,0.0],[120.0,0.0],[160.0,0.0],[200.0,0.0],[240.0,0.0],[280.0,0.0],[320.0,0.0],[360.0,0.0],[400.0,0.0],[440.0,0.0],[480.0,0.0],[520.0,0.0],[560.0,0.0],[600.0,0.033634],[640.0,1.206448],[680.0,2.165169],[720.0,-0.15684