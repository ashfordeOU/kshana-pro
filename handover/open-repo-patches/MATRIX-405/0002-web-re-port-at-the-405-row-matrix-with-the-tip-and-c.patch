+{"acm-link.toml": "# DVB-S2 adaptive coding and modulation (ACM) along one satellite's passes over one station.\n# Along a pass the slant range and elevation change, so the downlink Es/N0 changes. The run\n# picks, at each step, the most efficient MODCOD whose ETSI EN 302 307-1 Table 13 threshold\n# plus an implementation margin the link clears. It reports each pass's Es/N0 range and the\n# data volume ACM moves, against the constant-coding baseline that closes at the mask\n# elevation and the longest range.\n#\n# Every number below is ILLUSTRATIVE: no operator's orbit, station or link budget. MODELLED.\nkind = \"acm-link\"\nepoch = [2024.0, 1.0, 1.0, 0.0, 0.0, 0.0]\nduration_hours = 12.0\nstep_s = 30.0\nrefraction = true\nlight_time = true\n\n[link]\nfrequency_ghz = 8.2            # X-band downlink\neirp_dbw = 7.0\nsymbol_rate_msps = 20.0\nother_losses_db = 2.0\nzenith_atm_loss_db = 0.3\nimplementation_margin_db = 1.0\nacm_step_s = 10.0\n\n[satellite]\nname = \"eo-sso-a\"\naltitude_km = 550.0\ninclination_deg = 97.6\nraan_deg = 0.0\narg_lat_deg = 0.0\nbacklog_mbit = 400000.0\npriority = 2.0\n\n[station]\nname = \"mid-latitude\"\nlat_deg = 52.2\nlon_deg = 5.0\nalt_m = 10.0\nmask_deg = 5.0\ng_over_t_db = 30.0\nsetup_s = 120.0\n", "aocs-slew-mekf.toml": "# Reaction-wheel attitude slew under MRP feedback, closed on an MEKF estimate.\n#\n# The slew of scenarios/aocs-slew.toml, but the controller sees a multiplicative EKF's\n# attitude and the gyro rate less its bias estimate. The gyro has an angle random walk of\n# 1e-5 rad/sqrt(s), a rate random walk of 1e-8 rad/s^1.5 and a true turn-on bias. The star\n# tracker gives 5 arcsec per axis at 1 Hz. The control law and wheel dynamics are VALIDATED\n# against Basilisk on the true-state loop; the estimator and this loop are MODELLED. Every\n# number is ILLUSTRATIVE.\nkind = \"aocs\"\nduration_s = 600.0\ndt_s = 0.1\nsample_s = 1.0\nhub_inertia_kg_m2 = [[900.0, 0.0, 0.0], [0.0, 800.0, 0.0], [0.0, 0.0, 600.0]]\nk_nm = 3.5\np_nms = 30.0\nsigma0 = [0.1, 0.2, -0.3]\nomega0_rad_s = [0.001, -0.01, 0.03]\npointing_threshold_deg = 0.1\n\n[[wheels]]\naxis = [0.5773502, 0.5773502, 0.5773504]   # 54.7356 deg from z, azimuth 45 deg\njs_kg_m2 = 0.08\nu_max_nm = 0.2\nspeed0_rpm = 100.0\n\n[[wheels]]\naxis = [-0.5773502, 0.5773502, 0.5773504]  # azimuth 135 deg\njs_kg_m2 = 0.08\nu_max_nm = 0.2\nspeed0_rpm = -200.0\n\n[[wheels]]\naxis = [-0.5773502, -0.5773502, 0.5773504] # azimuth 225 deg\njs_kg_m2 = 0.08\nu_max_nm = 0.2\nspeed0_rpm = 300.0\n\n[[wheels]]\naxis = [0.5773502, -0.5773502, 0.5773504]  # azimuth 315 deg\njs_kg_m2 = 0.08\nu_max_nm = 0.2\nspeed0_rpm = -400.0\n\n[estimator]\ngyro_arw_rad_sqrt_s = 1.0e-5\ngyro_rrw_rad_s_1p5 = 1.0e-8\ngyro_bias0_rad_s = [3.0e-6, -2.0e-6, 1.0e-6]\nstar_tracker_sigma_arcsec = 5.0\nstar_tracker_every_s = 1.0\ninitial_attitude_sigma_deg = 0.01\ninitial_bias_sigma_rad_s = 1.0e-5\nseed = 2026\n", "aocs-slew.toml": "# Reaction-wheel attitude slew under MRP feedback, closed on the true state.\n#\n# A rigid hub with four balanced reaction wheels in a pyramid (54.7356 deg from body z, at\n# azimuths 45, 135, 225 and 315 deg) slews from sigma_BN = [0.1, 0.2, -0.3] (about 82 deg) to\n# inertial pointing. The law is L = -K sigma - P omega; the wheel torques are the minimum-norm\n# solution clipped to 0.2 N m. This is the configuration of case B of the Basilisk 2.9.1\n# comparison (tests/aocs_basilisk_oracle.rs), so the control law and wheel dynamics on this\n# loop are VALIDATED. The gains, inertia and wheels are ILLUSTRATIVE, not any spacecraft's.\nkind = \"aocs\"\nduration_s = 600.0\ndt_s = 0.1\nsample_s = 1.0\nhub_inertia_kg_m2 = [[900.0, 0.0, 0.0], [0.0, 800.0, 0.0], [0.0, 0.0, 600.0]]\nk_nm = 3.5\np_nms = 30.0\nsigma0 = [0.1, 0.2, -0.3]\nomega0_rad_s = [0.001, -0.01, 0.03]\npointing_threshold_deg = 0.1\n\n[[wheels]]\naxis = [0.5773502, 0.5773502, 0.5773504]   # 54.7356 deg from z, azimuth 45 deg\njs_kg_m2 = 0.08\nu_max_nm = 0.2\nspeed0_rpm = 100.0\n\n[[wheels]]\naxis = [-0.5773502, 0.5773502, 0.5773504]  # azimuth 135 deg\njs_kg_m2 = 0.08\nu_max_nm = 0.2\nspeed0_rpm = -200.0\n\n[[wheels]]\naxis = [-0.5773502, -0.5773502, 0.5773504] # azimuth 225 deg\njs_kg_m2 = 0.08\nu_max_nm = 0.2\nspeed0_rpm = 300.0\n\n[[wheels]]\naxis = [0.5773502, -0.5773502, 0.5773504]  # azimuth 315 deg\njs_kg_m2 = 0.08\nu_max_nm = 0.2\nspeed0_rpm = -400.0\n", "aperture-duty-cycle.toml": "# Aperture duty-cycle demonstrator (ground segment & operations).\n#\n# How a contact plan divides a pool of steerable apertures between navigation\n# (ranging / tracking) and communications (data), and what each session loses when\n# more sessions are active than there are apertures.\n#\n# THE ARBITRATION POLICY IS AN INPUT. A duty figure is only meaningful relative to\n# a stated rule for who wins the aperture, so the policy is declared here, echoed\n# back in the report with its full definition, and named in the one-line summary.\n#   navigation-priority       (default) navigation preempts communications\n#   communications-priority             communications preempts navigation\n#   first-come-first-served             non-preemptive; the holder keeps the aperture\n#\n# Re-run with `apertures = 1` to see the one-aperture time-share: on this plan\n# navigation is served in full either way and the whole contention loss lands on\n# the communications sessions.\n#\n# HONEST SCOPE: MODELLED scheduling arithmetic over the supplied windows. No slew /\n# retune / changeover time is charged when an aperture changes service or session;\n# no data volume, buffer state, energy budget or link closure enters the decision;\n# and the contact windows are inputs -- their geometry is whatever produced them\n# (the `passes` scenario emits the same aos_s / los_s vocabulary). Not a\n# ground-segment scheduling product.\n# Run:  kshana scenarios/aperture-duty-cycle.toml\nkind = \"aperture-duty-cycle\"\n\napertures = 2\narbitration = \"navigation-priority\"\n\n# The reporting horizon defaults to the plan envelope (earliest aos_s -> latest\n# los_s), which is what sets the duty denominator (apertures * horizon_s). Override\n# it to score the plan over a fixed operational day instead:\n#   horizon_start_s = 0.0\n#   horizon_end_s = 86400.0\n\n# The contact plan. ILLUSTRATIVE: three navigation sessions and three\n# communications sessions over a 9 000 s envelope, each navigation session\n# overlapping a communications one.\n[[contacts]]\nname = \"nav-1\"\nservice = \"navigation\"\naos_s = 0.0\nlos_s = 600.0\n\n[[contacts]]\nname = \"comms-1\"\nservice = \"communications\"\naos_s = 300.0\nlos_s = 1500.0\n\n[[contacts]]\nname = \"nav-2\"\nservice = \"navigation\"\naos_s = 3600.0\nlos_s = 4500.0\n\n[[contacts]]\nname = \"comms-2\"\nservice = \"communications\"\naos_s = 4200.0\nlos_s = 6000.0\n\n[[contacts]]\nname = \"nav-3\"\nservice = \"navigation\"\naos_s = 7200.0\nlos_s = 7800.0\n\n[[contacts]]\nname = \"comms-3\"\nservice = \"communications\"\naos_s = 7200.0\nlos_s = 9000.0\n", "araim-gps-galileo.toml": "# Dual-constellation ARAIM availability: GPS + Galileo evaluated with the advanced\n# ARAIM engine, including the constellation-wide fault hypothesis (`araim_dual`).\n#\n# Unlike `integrity-raim.toml` (single-constellation solution-separation RAIM), this\n# runs `araim_dual_raim` at every epoch over a combined GPS + Galileo geometry: the\n# fault-free, single-satellite, AND per-constellation fault hypotheses all feed one\n# MHSS integrity-risk budget (P_HMI). The primary constellation is fault group 0 and\n# each `[[constellations]]` entry the next group.\n#\n# Constellation-fault-robust integrity (staying safe even if an entire constellation\n# fails) is the demanding mode: under the constellation-fault hypothesis the residual\n# constellation must carry the fix alone, so it always costs availability relative to\n# pooling. How much depends on the sky. On the real 2026-06-07 GPS + Galileo catalogue,\n# evaluated at one common epoch, it still reaches 0.990 at a 12 m VAL against 1.000\n# pooled (tests/araim_dual_real_data.rs) — two full constellations can carry it; a\n# depleted one is where a third constellation or SBAS augmentation earns its place.\n# The numerically exact EU ARAIM TN Table A-3 reproduction is an external follow-on\n# (docs/ARAIM_REFERENCE.md).\nkind = \"integrity\"\n\nmask_deg = 5.0\nsigma_uere_m = 0.75   # ISM σ_URA (dual-frequency, m)\np_fa = 1.0e-5         # false-alarm / continuity budget\np_md = 1.0e-3\nal_h_m = 40.0         # horizontal alert limit (APV-I)\nal_v_m = 50.0         # vertical alert limit (APV-I)\naraim_dual = true     # advanced dual-/multi-constellation ARAIM\np_hmi = 1.0e-7        # per-axis integrity-risk budget\n\n[time]\nstep_s = 300.0\nduration_s = 43200.0  # 12 h\n\n[user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n\n[constellation]       # GPS-like Walker 24/6/1\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n[[constellations]]    # Galileo-like Walker 24/3/1\naltitude_km = 23222.0\ninclination_deg = 56.0\nplanes = 3\nsats_per_plane = 8\nphasing_f = 1.0\n", "araim-reference-check.toml": "# The engine's ARAIM protection levels against the WG-C subgroup's OWN worked examples.\n#\n# This is an EXTERNAL check, not a self-test: two published certification reference vectors\n# are committed as fixtures, each carrying its retrieval URL, retrieval date, source-file\n# SHA-256 and page number, and the engine's numbers are run against them at the tolerance\n# (TOL_PL = 5e-2 m) those documents themselves state.\n#\n#   * Reference Airborne Algorithm Description Document v3.1 (2019), Appendix D — internally\n#     self-consistent, and the acceptance vector.\n#   * Milestone 3 Report (2016), Annex A section A.IX — the statement the research\n#     bibliographies cite.\n#\n# Every published input (the 10-satellite 2-constellation geometry matrix, the C_int and\n# C_acc variance diagonals, b_nom, P_sat, P_const and the LPV-200 constant set) and every\n# published output (VPL, HPL, EMT, sigma_v_acc, K_fa_3, and each constellation-fault mode's\n# sigma_3, sigma_ss_3 and b_3) is reported beside the engine's own number and their absolute\n# difference. A transcribed figure is labelled `published` so it can never be mistaken for a\n# computed one.\n#\n# The protection-level equation is NOT re-solved here. The reference's mode list is handed\n# to the engine's existing raim::araim_protection_level / araim_integrity_risk, so the\n# bisection and the Gaussian-tail algebra under test are the engine's own; only the geometry,\n# the sub-solutions, the detection thresholds and the published budget split are built for it.\n#\n# RESULT against the 2019 vector: VPL 18.2926 m vs 18.3 m published, HPL 13.4063 m vs\n# 13.45 m, EMT 7.2997 m vs 7.2998 m, sigma_v_acc 1.3694 m vs 1.3694 m, and all six published\n# intermediates to within half a unit in their last printed decimal.\n#\n# The 2016 vector carries two internal defects the report STATES rather than hides — a sign\n# typo in row 3 of G, and a K_fa_3 evaluated at 57 fault modes while the document states\n# N_fault_max = 1 (12 modes). Its geometry intermediates reproduce exactly; its protection\n# levels are reported as measured discrepancies and excluded from the acceptance figure.\n# The tolerance is never widened to absorb them.\n#\n# SCOPE: only N_fault_max = 1 (single-satellite and single-constellation fault modes) is\n# implemented, and a case whose priors require simultaneous multi-event fault subsets is\n# REFUSED rather than silently truncated. Fault detection, exclusion, the chi-square\n# consistency check and the double-counting re-allocation step are out of scope. This\n# reproduces a published reference algorithm's worked example — it is not a certification,\n# an airworthiness artefact, or an approval.\n#\n# Omit `vector` to run both; set it to select one.\n\nkind = \"araim-reference-check\"\n", "ascent-losses.toml": "# Gravity-turn ascent losses of an ILLUSTRATIVE two-stage kerosene/oxygen launcher (no real\n# vehicle): vertical rise to 1 km, a 3 deg pitch kick for 10 s, then thrust along the\n# velocity. The run integrates the gravity, drag, steering and back-pressure losses and checks\n# that ideal dv minus the losses equals the burnout speed. MODELLED: planar, non-rotating\n# Earth, constant C_D, no coast, no guidance beyond the kick.\nkind = \"ascent-losses\"\npayload_kg = 10000.0\ndrag_coefficient = 0.3\nreference_area_m2 = 10.5\nkick_altitude_m = 1000.0\nkick_angle_deg = 3.0\nkick_duration_s = 10.0\nstep_s = 0.1\n\n[[stages]]\ndry_mass_kg = 25000.0\npropellant_kg = 400000.0\nthrust_vac_n = 7600000.0\nisp_vac_s = 311.0\nexit_area_m2 = 6.0\n\n[[stages]]\ndry_mass_kg = 4000.0\npropellant_kg = 100000.0\nthrust_vac_n = 980000.0\nisp_vac_s = 348.0\nexit_area_m2 = 0.0\n", "attitude-budget.toml": "# 3-DOF attitude & pointing error budget demonstrator (pre-hardware AOCS/GNC).\n#\n# The worst-case gravity-gradient disturbance torque ((3/2)(mu/R^3)*dI) and a\n# root-sum-square pointing-error budget over named 1-sigma contributors, with the\n# dominant term -- a scalar pointing figure of merit to bracket before committing\n# to a control design.\n#\n# HONEST SCOPE: MODELLED scalar error budget -- a pre-hardware complement to\n# Basilisk/42, NOT a control-loop / 6-DoF / flexible-mode simulation. The\n# gravity-gradient term is reported as a torque (mapping it to pointing needs a\n# control stiffness the caller owns); the budget is the quadrature sum of the\n# supplied 1-sigma contributors.\n# Run:  kshana scenarios/attitude-budget.toml\nkind = \"attitude-budget\"\n\naltitude_km = 600.0\ni_max_kg_m2 = 100.0\ni_min_kg_m2 = 60.0\n\n[[contributors]]\nname = \"star_tracker_noise\"\nsigma_arcsec = 5.0\n[[contributors]]\nname = \"reaction_wheel_jitter\"\nsigma_arcsec = 8.0\n[[contributors]]\nname = \"thermal_distortion\"\nsigma_arcsec = 4.0\n[[contributors]]\nname = \"alignment\"\nsigma_arcsec = 3.0\n", "automotive-urban-canyon.toml": "# Road vehicle through an urban canyon: GNSS/INS dead-reckoning across an underpass and\n# a roadside jammer, against a lane-level budget.\n#\n# The mission question a driver-assistance or automated-driving team asks: a car's\n# Global Navigation Satellite System (GNSS) receiver loses the sky under an overpass and\n# then again near a roadside jammer (a low-power in-vehicle \"privacy\" jammer on a\n# neighbouring vehicle is the common case). How long does the fused GNSS/inertial\n# navigation system (INS) solution stay inside half a lane? The 1.5 m threshold is half\n# a 3.5 m lane less a margin, a budget chosen here, not a standard's figure.\n#\n# The pack is `gnss-ins`: a three-axis strapdown navigator disciplined by a 15-state\n# error-state extended Kalman filter (EKF), then coasting through the outages. The\n# GNSS timeline: open sky for 60 s, a 15 s underpass, 45 s of open sky, then 60 s\n# near the jammer.\n#\n# The pack has two fixed slots named `imu_quantum` and `imu_classical`. Here\n# `imu_quantum` carries the BETTER unit, a tactical-grade comparator, and\n# `imu_classical` carries an automotive MEMS (micro-electro-mechanical system) unit.\n# Nothing quantum is modelled in this file. Both use the representative class\n# coefficients from the engine's grade table (Groves 2013, Table 4.1 band; the same\n# figures as `imu_grade` in `ins-trn-coast`), NOT a datasheet for any part:\n#   - tactical: accelerometer bias 300 ug = 2.94e-3 m/s^2, gyro bias 1 deg/h =\n#     4.848e-6 rad/s;\n#   - industrial (automotive MEMS sits in this band): accelerometer bias 3000 ug =\n#     2.94e-2 m/s^2, gyro bias 20 deg/h = 9.696e-5 rad/s, accelerometer scale factor\n#     2000 ppm.\n#\n# Honest scope (inherited from the `gnss-ins` pack): loosely coupled, the pack's single\n# deterministic driving profile (a forward-acceleration and yaw square wave), not a\n# recorded drive; no odometer or wheel-speed aiding (the engine has none), no\n# multipath model, and constant biases, which the filter can learn while GNSS is up,\n# so the coast is a best case for these classes. MODELLED: every figure is modelled.\nkind = \"gnss-ins\"\nseed = 7\nthreshold_m = 1.5\nfix_interval_s = 1.0\nsigma_pos_m = 1.0\nsigma_vel_mps = 0.05\nlat_deg = 48.137\nlon_deg = 11.575\nalt_m = 520.0\n\n[time]\nstep_s = 0.1\nduration_s = 180.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 60.0,  state = \"nominal\" },\n  { t0 = 60.0,  t1 = 75.0,  state = \"denied\" },\n  { t0 = 75.0,  t1 = 120.0, state = \"nominal\" },\n  { t0 = 120.0, t1 = 180.0, state = \"denied\" },\n]\n\n[imu_quantum]\nid = \"tactical-imu\"\nprovenance = \"Tactical-grade class (Groves 2013 Table 4.1 band, engine grade table): accel bias 300 ug = 2.94e-3 m/s^2, gyro bias 1 deg/h = 4.848e-6 rad/s; signs chosen\"\naccel_bias = [2.94e-3, -2.94e-3, 0.0]\ngyro_bias = [0.0, 0.0, 4.848e-6]\n\n[imu_quantum.filter_prior]\nsigma_accel_bias = 2.94e-3\nsigma_gyro_bias = 4.848e-6\n\n[imu_classical]\nid = \"automotive-mems\"\nprovenance = \"Industrial-grade class, where automotive MEMS units sit (Groves 2013 Table 4.1 band, engine grade table): accel bias 3000 ug = 2.94e-2 m/s^2, gyro bias 20 deg/h = 9.696e-5 rad/s; signs chosen\"\naccel_bias = [2.94e-2, -2.94e-2, 0.0]\ngyro_bias = [9.696e-5, -9.696e-5, 9.696e-5]\n\n[imu_classical.filter_prior]\nsigma_accel_bias = 2.94e-2\nsigma_gyro_bias = 9.696e-5\n\n# The class's accelerometer scale-factor error (2000 ppm) layered on the constant bias.\n[imu_classical.error_model]\nscale_accel_ppm = [2000.0, 2000.0, 2000.0]\n", "campaign-jam-spoof-holdover-integrity.toml": "# A chained mission: nominal, jamming, spoofing, GNSS loss with clock holdover and\n# inertial coasting, an integrity alarm, and recovery, on one shared timeline.\n#\n# Every phase runs ordinary scenarios of existing kinds, each dispatched exactly as\n# `kshana <file>.toml` would run it. The campaign reads their outputs into channels\n# on one mission timeline (a 10 s grid, zero-order hold) and draws them as synced\n# panels: clock time error against its guard, the carrier-to-noise density ratio\n# (C/N0) against the tracking floor, the vertical protection level against the\n# alert limit, the inertial position error, and the alarm flags.\n#\n# State is handed on between phases in two ways here:\n# - `end_at`: the spoofing phase ends when the clock-aided spoofing monitor of the\n#   `spoof` run detects the ramp (its `classical.detect_time_s`), not at a fixed time.\n# - `carry`: the holdover and integrity-alarm phases continue the clock time error\n#   from where the previous phase left it, so the offset the spoofer pulled in before\n#   detection is where the free-running clock starts. Recovery re-synchronises to\n#   GNSS, so it carries nothing.\n#\n# The receiver is the jamming example's (52 N, 4 E) under a GPS-like 24-satellite\n# Walker shell; the jammer is 1 km away and its power sets the phase: off, -30 dBW\n# (links degraded but still tracking), 10 dBW (every satellite lost). The clock is a\n# chip-scale atomic clock (Microchip SA.45s datasheet sigma_y(1 s) = 3e-10), the\n# inertial unit the gnss-ins example's tactical class, and the integrity monitor the\n# integrity example's snapshot receiver autonomous integrity monitoring (RAIM) with\n# the approach-with-vertical-guidance (APV-I) alert limits, run on that example's\n# own user track (a 0.4 km-altitude circular track, not the jamming receiver's\n# fixed site). The integrity alarm is produced by a 25 deg elevation mask, standing\n# in for the partial sky a receiver has while reacquiring; recovery returns to 5 deg.\n#\n# MODELLED: the chaining is a modelling choice (additive carry, zero-order hold), and\n# each phase is as good as the kind that ran it.\nkind = \"campaign\"\ntitle = \"Jamming, spoofing, holdover and integrity: a chained mission\"\nseed = 20260928\n\n[timeline]\nstep_s = 10.0\n\n# ---------------------------------------------------------------- nominal\n[[phases]]\nname = \"nominal\"\nduration_s = 600.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 42\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 600.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# ---------------------------------------------------------------- jamming\n[[phases]]\nname = \"jamming\"\nduration_s = 600.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 43\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 600.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[phases.runs.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = -30.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# ---------------------------------------------------------------- spoofing\n# A time-push spoofer ramps the receiver clock at 0.1 ns/s from the start of the\n# phase. The phase ends when the clock-aided monitor detects it (end_at), capped at\n# 900 s. The RF detector (spoof-detect) sees a +1.5 dB, three-satellite position push\n# and alarms at phase start.\n[[phases]]\nname = \"spoofing\"\nduration_s = 900.0\nend_at = \"classical.detect_time_s\"\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"spoof\"\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 900.0\n[phases.runs.scenario.attack]\nstart_s = 0.0\nrate_ns_per_s = 0.1\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"spoof-detect\"\n[phases.runs.scenario.attack]\npower_advantage_db = 1.5\ncarrier_aligned = false\npush = \"position\"\npush_magnitude_m = 75.0\nnum_biased = 3\nel_imbalance = 0.12\n[phases.runs.scenario.detector]\nsat_power_dbm = -130.0\nagc_margin_db = 3.0\nsqm_tolerance = 0.10\nraim_p_fa = 1.0e-3\nsigma_m = 5.0\nfusion_threshold = 0.5\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 900.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[phases.runs.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = -30.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n# ---------------------------------------------------------------- holdover\n# The jammer goes to 10 dBW: every satellite is lost. The clock free-runs from its\n# last synchronisation, continuing the spoofed offset (carry), and the tactical\n# inertial unit coasts (the gnss-ins run is warmed up on GNSS for 100 s, skipped).\n[[phases]]\nname = \"holdover\"\nduration_s = 1800.0\ncarry = [\"time_error_ns\"]\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 44\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 1800.0\n[phases.runs.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 1.0, state = \"nominal\" },\n  { t0 = 1.0, t1 = 1800.0, state = \"denied\" },\n]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\nskip_s = 100.0\n[phases.runs.scenario]\nkind = \"gnss-ins\"\nseed = 7\nthreshold_m = 50.0\nfix_interval_s = 1.0\nsigma_pos_m = 1.0\nsigma_vel_mps = 0.05\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.time]\nstep_s = 0.5\nduration_s = 1900.0\n[phases.runs.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 100.0, state = \"nominal\" },\n  { t0 = 100.0, t1 = 1900.0, state = \"denied\" },\n]\n[phases.runs.scenario.imu_quantum]\nid = \"cold-atom-imu\"\nprovenance = \"Quantum-grade inertial unit: low residual accelerometer/gyro bias (cold-atom-class)\"\naccel_bias = [0.015, 0.0, 0.0]\ngyro_bias = [0.0, 0.0, 5.0e-5]\n[phases.runs.scenario.imu_classical]\nid = \"tactical-imu\"\nprovenance = \"Tactical-grade MEMS/quartz inertial unit: larger residual bias\"\naccel_bias = [0.03, -0.02, 0.0]\ngyro_bias = [0.0, 0.0, 1.0e-4]\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 1800.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[phases.runs.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = 10.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n# ---------------------------------------------------------------- integrity alarm\n# The jammer drops back to -30 dBW and satellites are reacquired, but only above a\n# 25 deg mask: at most epochs the vertical protection level exceeds the 50 m alert\n# limit, or too few satellites remain to form one, so the monitor alarms and the clock stays in holdover (carry) rather than trusting GNSS.\n[[phases]]\nname = \"integrity-alarm\"\nduration_s = 600.0\ncarry = [\"time_error_ns\"]\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 45\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 1.0, state = \"nominal\" },\n  { t0 = 1.0, t1 = 600.0, state = \"denied\" },\n]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 25.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[phases.runs.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = -30.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 25.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# ---------------------------------------------------------------- recovery\n[[phases]]\nname = \"recovery\"\nduration_s = 600.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 46\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 600.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n", "campaign-monte-carlo-clock-holdover.toml": "# A seeded Monte Carlo ensemble through a campaign, on a case with a closed form.\n#\n# A chip-scale atomic clock (Microchip SA.45s datasheet sigma_y(1 s) = 3e-10, so a\n# white-frequency-noise intensity q_wf = 9e-20 s^2/s and nothing else stochastic) is\n# disciplined to GNSS for 600 s and then coasts to 3600 s. The holdover predictor\n# removes the deterministic frequency offset exactly, so the time error at the end\n# of the run is the accumulated white-frequency noise since the last synchronisation\n# at 590 s: Gaussian, mean zero, variance q_wf * tau with tau = 3010 s, a standard\n# deviation of sqrt(9e-20 * 3010) s = 16.46 ns (NIST Technical Note 1337, the random\n# walk of phase under white frequency noise).\n#\n# Realisation k runs the scenario with `seed = 42 + k`, so the ensemble reproduces\n# exactly. The campaign reports, per metric, the mean, the standard deviation, the\n# 5th, 50th and 95th percentiles and a fixed-seed bootstrap 95% confidence interval\n# on the mean. The test suite checks that the mean falls inside that interval around\n# zero and that the spread matches 16.46 ns.\n#\n# MODELLED: the clock is a datasheet-level model, not a measurement of any unit.\nkind = \"campaign\"\ntitle = \"Monte Carlo: free-running clock error against its closed form\"\nseed = 20260928\n\n[monte_carlo]\nruns = 200\nseed_key = \"seed\"\nmetrics = [\n  { name = \"final_error\", path = \"classical.series[-1].error_ns\" },\n  { name = \"timing_rms\", path = \"classical.fom.timing_rms_ns\" },\n]\n\n[monte_carlo.scenario]\nseed = 42\nthreshold_ns = 20.0\n[monte_carlo.scenario.time]\nstep_s = 10.0\nduration_s = 3600.0\n[monte_carlo.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 600.0, state = \"nominal\" },\n  { t0 = 600.0, t1 = 3600.0, state = \"denied\" },\n]\n[monte_carlo.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[monte_carlo.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n", "campaign-optimize-link-budget.toml": "# An optimisation through a campaign: the link-budget example's X-band link\n# (55 dBW EIRP, 53 dB/K G/T, 3 dB other losses, 4.5 dB required Eb/N0), searched\n# over range and data rate for the operating point that leaves exactly 3 dB of\n# margin. Each evaluation is an ordinary `link-budget` run. The Nelder-Mead simplex\n# works in log-normalised coordinates inside the stated bounds, and every\n# evaluation is listed in the result's `trace`.\n#\n# The margin falls 20 dB per decade of range and 10 dB per decade of data rate, so\n# the 3 dB points form a line across this box. The optimiser returns one point on\n# it, nearest its start; the trace shows the path. Use `method = \"grid\"` with\n# `steps` on each param for an exhaustive search instead.\n#\n# MODELLED: a local search over the box, not a global guarantee, and as good as the\n# `link-budget` kind it runs. Protocol and pre-registered bars:\n# docs/design/evidence/cap32-optimize/.\nkind = \"campaign\"\ntitle = \"Link budget: range and rate for a 3 dB margin\"\nseed = 20261013\n\n[optimize]\nmethod = \"nelder-mead\"\nmax_evals = 300\n\n[optimize.objective]\nname = \"margin\"\npath = \"margin_db\"\ngoal = \"target\"\ntarget = 3.0\n\n[[optimize.params]]\nname = \"range\"\nkey = \"range_km\"\nunit = \"km\"\nlo = 1.0e6\nhi = 1.0e9\nscale = \"log\"\n\n[[optimize.params]]\nname = \"rate\"\nkey = \"data_rate_bps\"\nunit = \"bit/s\"\nlo = 1.0e3\nhi = 1.0e8\nscale = \"log\"\n\n[optimize.scenario]\nkind = \"link-budget\"\nband = \"x\"\neirp_dbw = 55.0\ng_over_t_db = 53.0\nrange_km = 2000.0\ndata_rate_bps = 1.0e6\nother_losses_db = 3.0\nrequired_eb_n0_db = 4.5\n", "campaign-shared-jammer-sea-road.toml": "# Cross-domain composition: one jammer, two platforms. A ship in the Gulf of Finland\n# (59.80 N, 24.90 E, the maritime-strait-jamming example's receiver) and a car on a\n# Helsinki coast road (60.17 N, 24.94 E) sit under the same broadband jammer, placed\n# at 59.80 N, 25.44 E, 30 m up (about 30 km from the ship and 50 km from the car).\n#\n# At 8 dBW (6.3 W) the ship loses every satellite (mean jammer-to-signal ratio,\n# J/S, about 39 dB) while the car, 20 km further off, keeps at least four (about\n# 35 dB): the combined summary names the ship as the worst platform.\n#\n# The jammer's power and position are declared once under [[compose.shared]] and\n# written into each member at the keys it binds them to, so the two runs cannot\n# disagree about the threat. Each member is an ordinary `jamming` run; the combined\n# summary names the best and worst platform for each metric.\n#\n# MODELLED: as the `jamming` kind is. The car is modelled with the same open-sky\n# receiver as the ship; urban masking and the vehicle antenna are not.\nkind = \"campaign\"\ntitle = \"One jammer, a ship and a car\"\nseed = 20260928\n\n[[compose.shared]]\nname = \"jammer_power\"\nunit = \"dBW\"\nvalue = 8.0\n\n[[compose.shared]]\nname = \"jammer_position\"\nunit = \"m\"\nvalue = [2904623.523, 1381438.498, 5489328.347]\n\n[[compose.members]]\nlabel = \"ship-strait\"\nbind = { jammer_power = \"jammer.power_dbw\", jammer_position = \"jammer.position_ecef_m\" }\nmetrics = [\n  { name = \"availability\", path = \"fom.availability_under_jamming\" },\n  { name = \"mean_js\", path = \"fom.mean_js_db\" },\n  { name = \"min_tracking\", path = \"fom.min_tracking\" },\n]\n[compose.members.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[compose.members.scenario.time]\nstep_s = 30.0\nduration_s = 1800.0\n[compose.members.scenario.receiver]\nlat_deg = 59.80\nlon_deg = 24.90\nalt_m = 0.0\n[compose.members.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[compose.members.scenario.jammer]\nposition_ecef_m = [0.0, 0.0, 0.0]\npower_dbw = 0.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n[[compose.members]]\nlabel = \"car-coast-road\"\nbind = { jammer_power = \"jammer.power_dbw\", jammer_position = \"jammer.position_ecef_m\" }\nmetrics = [\n  { name = \"availability\", path = \"fom.availability_under_jamming\" },\n  { name = \"mean_js\", path = \"fom.mean_js_db\" },\n  { name = \"min_tracking\", path = \"fom.min_tracking\" },\n]\n[compose.members.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[compose.members.scenario.time]\nstep_s = 30.0\nduration_s = 1800.0\n[compose.members.scenario.receiver]\nlat_deg = 60.17\nlon_deg = 24.94\nalt_m = 0.0\n[compose.members.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[compose.members.scenario.jammer]\nposition_ecef_m = [0.0, 0.0, 0.0]\npower_dbw = 0.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n", "campaign-spectrum-holdover-integrity.toml": "# A chained mission driven by the L-band spectrum: a chirp jammer takes GPS L1 C/A and\n# Galileo E1, the clock holds over, and a continuous-wave (CW) tone left on the L1\n# carrier keeps C/A down while E1 recovers, so the receiver falls back to Galileo and\n# its integrity monitor runs on a Galileo-only sky.\n#\n# Every phase runs ordinary scenarios of existing kinds, each dispatched exactly as\n# `kshana <file>.toml` would run it. The carrier-to-noise density ratio (C/N0) of each\n# band comes from the `spectrum` kind: the jammer's spectral separation coefficient\n# against that band's own modulation, through (C/N0)_eff = [1/(C/N0) + sum (J/S) kappa]^-1\n# (see docs/SPECTRUM.md). The campaign reads the L1 C/A and E1 rows of the spectrum\n# timeline into two channels on one mission timeline (a 1 s grid, zero-order hold).\n#\n# State is handed on between phases in two ways here:\n# - `end_at`: the onset phase ends when the spectrum run first loses L1 C/A\n#   (`timeline.bands[0].first_loss_t_s`, 10 s here), not at a fixed time; the clock's\n#   holdover starts at that instant.\n# - `carry`: the holdover phase continues the clock time error from the end of the\n#   onset phase. The fallback phase re-synchronises the clock to Galileo, so it\n#   carries nothing.\n#\n# The jammers are the ones in scenarios/l-band-waterfall-jamming.toml: a 16 MHz chirp\n# privacy device at -13 dBW EIRP, 100 m away, and a CW tone on 1575.42 MHz at -20 dBW\n# EIRP, 1 km away, both through the jamming kind's free-space path loss. The clock is\n# a chip-scale atomic clock (Microchip SA.45s datasheet sigma_y(1 s) = 3e-10). The\n# integrity monitor is the integrity example's snapshot receiver autonomous integrity\n# monitoring (RAIM) with the approach-with-vertical-guidance (APV-I) alert limits, on\n# a GPS-like 24-satellite Walker shell during onset and on a Galileo-like Walker\n# 24/3/1 (29 599.8 km semi-major axis, 56 deg; Galileo OS SDD 1.1) during fallback.\n#\n# MODELLED: the chaining is a modelling choice (additive carry, zero-order hold), and\n# each phase is as good as the kind that ran it. E1 recovering under the CW tone rests\n# on the spectrum kind's continuous-spectrum treatment (a CW tone on the MBOC carrier\n# null couples nothing); a real tone would couple through the code's spectral lines.\nkind = \"campaign\"\ntitle = \"L-band jamming from the spectrum, clock holdover and a Galileo-only fallback\"\nseed = 20260928\n\n[timeline]\nstep_s = 1.0\n\n# ---------------------------------------------------------------- onset\n# All bands nominal until the chirp switches on at 10 s. The phase ends at the first\n# loss of L1 C/A that the spectrum run computes.\n[[phases]]\nname = \"onset\"\nduration_s = 60.0\nend_at = \"timeline.bands[0].first_loss_t_s\"\nend_at_run = 1\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 42\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 1.0\nduration_s = 60.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 60.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_e1_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n  { channel = \"alarm\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\", compare = \"below\", threshold = 25.0 },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 60.0\nstep_s = 1.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1160.0\nf_max_mhz = 1590.0\nn_freq = 430\n[[phases.runs.scenario.jammers]]\nname = \"chirp privacy device\"\nwaveform = \"chirp\"\ncentre_mhz = 1575.42\nbandwidth_mhz = 16.0\nsweep_period_us = 9.0\neirp_dbw = -13.0\nrange_m = 100.0\non_s = 10.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 60.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# ---------------------------------------------------------------- holdover\n# The chirp stays on: L1 C/A and E1 are both below the 25 dB-Hz tracking floor, and\n# the clock free-runs from its last synchronisation, continuing the onset error.\n[[phases]]\nname = \"holdover\"\nduration_s = 600.0\ncarry = [\"time_error_ns\"]\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 43\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 1.0, state = \"nominal\" },\n  { t0 = 1.0, t1 = 600.0, state = \"denied\" },\n]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_e1_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n  { channel = \"alarm\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\", compare = \"below\", threshold = 25.0 },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 600.0\nstep_s = 10.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1160.0\nf_max_mhz = 1590.0\nn_freq = 430\n[[phases.runs.scenario.jammers]]\nname = \"chirp privacy device\"\nwaveform = \"chirp\"\ncentre_mhz = 1575.42\nbandwidth_mhz = 16.0\nsweep_period_us = 9.0\neirp_dbw = -13.0\nrange_m = 100.0\non_s = 0.0\n\n# ---------------------------------------------------------------- fallback\n# The chirp is gone; the CW tone on the L1 carrier remains. L1 C/A stays below the\n# floor; E1, whose MBOC spectrum has a null at its carrier, recovers. The receiver\n# re-synchronises the clock on Galileo and runs RAIM on a Galileo-only sky. The alarm\n# channel follows E1, the band the receiver now navigates on.\n[[phases]]\nname = \"galileo-fallback\"\nduration_s = 300.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 44\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 300.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 300.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_e1_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n  { channel = \"alarm\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\", compare = \"below\", threshold = 25.0 },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 300.0\nstep_s = 10.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1160.0\nf_max_mhz = 1590.0\nn_freq = 430\n[[phases.runs.scenario.jammers]]\nname = \"CW tone on L1\"\nwaveform = \"cw\"\ncentre_mhz = 1575.42\neirp_dbw = -20.0\nrange_m = 1000.0\non_s = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 300.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 23221.664\ninclination_deg = 56.0\nplanes = 3\nsats_per_plane = 8\nphasing_f = 1.0\n", "campaign-sweep-jammer-power.toml": "# A parameter sweep through a campaign: the jamming example's receiver (52 N, 4 E,\n# GPS-like 24-satellite Walker shell) under a broadband jammer 1 km away, with the\n# jammer's transmit power swept from -50 dBW (10 nW) to +10 dBW (10 W) in 5 dB\n# steps. Each node is an ordinary `jamming` run; the campaign records, per node,\n# the fraction of epochs with at least four satellites still tracking, the mean\n# jammer-to-signal ratio (J/S), and the fewest satellites tracking.\n#\n# The jamming chain (Kaplan and Hegarty, Understanding GPS/GNSS, 3rd ed., section\n# 9.4) is deterministic, so one run per node is the whole answer; add `runs` and a\n# `seed_key` to make every node a Monte Carlo ensemble for a stochastic kind.\n# J/S moves exactly 1 dB per dB of transmit power; availability falls from 1 to 0\n# where the effective carrier-to-noise density ratio crosses the 25 dB-Hz floor.\n#\n# MODELLED: as the `jamming` kind is.\nkind = \"campaign\"\ntitle = \"Jammer power sweep: availability and J/S against transmit power\"\nseed = 20260928\n\n[sweep]\nmetrics = [\n  { name = \"availability\", path = \"fom.availability_under_jamming\" },\n  { name = \"mean_js\", path = \"fom.mean_js_db\" },\n  { name = \"min_tracking\", path = \"fom.min_tracking\" },\n]\n\n[[sweep.axes]]\nname = \"jammer_power\"\nkey = \"jammer.power_dbw\"\nunit = \"dBW\"\nstart = -50.0\nstop = 10.0\nsteps = 13\n\n[sweep.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[sweep.scenario.time]\nstep_s = 60.0\nduration_s = 1800.0\n[sweep.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[sweep.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[sweep.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = 10.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n", "cislunar-arc-recovery.toml": "# Independent-estimator test of the cislunar arc-length observability threshold (R6, paper B).\n#\n# Paper B's threshold is a RANK read on an observability matrix assembled from the ANALYTIC\n# range Jacobian rows and the ANALYTIC variational state-transition matrix, and its\n# square-root-information-filter cross-check folds those same rows. The paper says so: that\n# is a consistency check between two numerical machines, not corroboration. This scenario is\n# the missing arbiter — a batch least-squares estimator that actually RECOVERS the chief's\n# initial state from simulated measurements, with the measurement partials taken as CENTRAL\n# FINITE DIFFERENCES of the composed forward model.\n#\n# It calls no analytic Jacobian row, no variational STM, no singular-value or eigen\n# decomposition, no rank tolerance and no square-root information filter. That is enforced,\n# not promised: a source-text guard in tests/cislunar_arc_recovery_reference.rs fails if any\n# of them appears. The dynamics (the same RK4 CR3BP flow), the initial conditions (the same\n# differential-corrected constellation), the scalar observable and the epoch grid ARE shared,\n# deliberately and by name, in the emitted `independence` block — two analyses of one\n# physical problem must agree about the physics to be comparable.\n#\n# Two criteria, each swept over five decades of its own bound:\n#   * NOISE-FREE RECOVERY — every seeded trial's final state error at most recovery_factor\n#     times its a-priori displacement. The rank analogue, with no singular-value tolerance\n#     anywhere in it.\n#   * MONTE-CARLO ESTIMABILITY — measured RMS position error over a seeded noise ensemble\n#     below a stated bound. The estimability analogue, measured rather than predicted.\n#\n# MEASURED on the published planar DRO grid: the estimator recovers the four-state from\n# 0.782609 h against the rank criterion's 2.086957 h at rel_tol 1e-6, a ratio of 0.375 — so\n# the rank threshold is NOT corroborated as a recoverability boundary. The measured\n# estimability boundary lands in the same grid cell as the formal one, 5.739130 h, and the\n# measured error curve reproduces the formal 1-sigma over 21 arc lengths to a geometric-mean\n# ratio of 0.98.\n#\n# MODELLED: the constellation design, the epoch grid, the single tracked link, the\n# displacement magnitude, the measurement sigma and the two stated bounds.\n# Not a certified navigation-performance product.\n\nkind = \"cislunar-arc-recovery\"\n", "cislunar-observability.toml": "# Planar cislunar constellation observability over a tracking arc (P6).\n#\n# A small four-spacecraft near-DRO planar constellation near the Moon is tracked by\n# inter-satellite ranging. The scenario answers the batch-estimator question: how much of a\n# spacecraft's four-state [x, y, xdot, ydot] does the arc actually make observable, and how\n# does that grow with arc length? It assembles the observability structure from the crate's\n# finite-difference-validated CR3BP variational STM (src/cr3bp.rs) and the analytic\n# inter-satellite range / range-rate Jacobians (src/intersat_range.rs), and emits:\n#   1. the rank-vs-arc-length table for a single range-only link -- instantaneously rank-1,\n#      growing toward the full four-state as the arc lengthens (P6 Table 1);\n#   2. the observability-Gramian eigen-spectrum + condition number over the arc; and\n#   3. the range-only vs range+range-rate instantaneous-rank comparison (the Doppler design\n#      lever) plus range-only-singular / range+rate-defined GDOP reporting.\n# (src/cislunar_observability.rs, src/observability_gramian.rs)\n#\n# Honesty: MODELLED. VALIDATED core -- the observable RANK is a rank-revealing\n# singular-value threshold cross-checked against the Gramian eigen-rank; the eigen-spectrum\n# obeys the spectral invariants (trace = sum eig, det = prod eig, Frobenius^2 = sum eig^2);\n# the variational STM is the finite-difference-validated CR3BP STM; the range / range-rate\n# Jacobian rows are finite-difference-validated analytic partials (cross-checked against the\n# crate's 3-D range-rate observable); a rank-deficient snapshot is flagged GDOP-undefined\n# (fim condition = inf), never a bogus finite value -- the same singular-geometry guard\n# pvt::solve_spp applies. MODELLED -- the four near-DRO planar initial conditions (a\n# differential-corrected DRO seeder is a follow-on) and the specific rank progression they\n# produce. Not a certified navigation-performance product.\nkind = \"cislunar-observability\"\n\n# Every field is optional and shown at its default. Uncomment to override.\n# mu        = 0.012150585609624   # Earth-Moon mass ratio\n# arc_hours = 6.0                 # tracking-arc length (hours)\n# epochs    = 24                  # epochs sampled along the arc\n# steps     = 2000                # RK4 sub-steps per STM propagation\n# rel_tol   = 1.0e-6              # singular-value threshold for the observable-rank read\n", "clock-ensemble.toml": "# Monte Carlo ensemble of the clock-holdover scenario.\n#\n# Identical to clock-holdover.toml but run as many realizations (`runs`), so the\n# result is a confidence band rather than a single trajectory: each figure of\n# merit is reported as a mean with a 5th-95th-percentile spread, and the error\n# chart shades the 5-95% envelope around the median for each clock. This is the\n# statistically meaningful view — one run is only a single draw of the noise.\nseed = 42\nthreshold_ns = 20.0\nruns = 200\n\n[time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,    t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0,  t1 = 7200.0, state = \"denied\" },\n]\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (Origlia/Schiller/Bongs et al., arXiv:1503.08457); q_wf=sigma_y(1s)^2; ground-demonstrator maturity, not flown; flicker floor modeled at sigma_y=1e-16\"\ny0   = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\nflicker_floor = 1.0e-16\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2; flicker floor modeled at sigma_y=2e-11\"\ny0   = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\nflicker_floor = 2.0e-11\n", "clock-holdover-labsr.toml": "# Variant: laboratory-grade strontium optical clock vs CSAC.\n# Lab Sr clocks reach sigma_y(1 s) = 4.8e-17 (Oelker et al. 2019, Nature Photonics).\nseed = 42\nthreshold_ns = 20.0\n\n[time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,    t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0,  t1 = 7200.0, state = \"denied\" },\n]\n\n[clock_quantum]\nid = \"optical-lab-sr\"\nprovenance = \"Laboratory Sr optical lattice clock, sigma_y(1s)=4.8e-17 (Oelker et al. 2019, Nature Photonics); q_wf=sigma_y(1s)^2; laboratory maturity, not flown; flicker/aging not modeled\"\ny0   = 2.0e-18\nq_wf = 2.304e-33\nq_rw = 0.0\ndrift = 0.0\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2; flicker/aging not modeled\"\ny0   = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\ndrift = 0.0\n", "clock-holdover.toml": "# Kshana reference scenario: 2 h run, 10 min GNSS sync then ~1.8 h denied.\n# Clock white-FM noise calibrated to published sigma_y(1 s): q_wf = sigma_y(1s)^2.\n# Validated against simulated Allan deviation in tests/calibration.rs (~2%).\nseed = 42\nthreshold_ns = 20.0\n\n[time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,    t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0,  t1 = 7200.0, state = \"denied\" },\n]\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (Origlia/Schiller/Bongs et al., arXiv:1503.08457); q_wf=sigma_y(1s)^2; ground-demonstrator maturity, not flown; flicker/aging not modeled\"\ny0   = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2; flicker/aging not modeled\"\ny0   = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n", "combined-altpnt.toml": "# Combined gravity + magnetic + terrain GPS-denied navigator — fused alt-PNT.\n#\n# The capstone alternative-PNT demo: a vehicle flying with no GNSS takes THREE scalar\n# measurements at each waypoint — gravity anomaly (mGal), magnetic-anomaly total intensity\n# (nT), and ground elevation (m). For a candidate constant drift offset the joint likelihood\n# is the PRODUCT of the three field likelihoods, so the information adds: the joint posterior\n# is sharper (a lower CRLB) than any single field. The demo shows a bounded error under 500 m\n# over the outage that is never worse than the best single channel — exactly why sensor fusion\n# is the path where any one weak field alone would struggle.\n#\n# Consumed by `kshana::altpnt::terrain::run_combined_altpnt` (and its unit tests), dispatched\n# as `kind = \"combined-altpnt\"`. The gravity field is a low-degree spherical-harmonic trend +\n# synthetic mascons; the magnetic channel is the smooth IGRF-14 main field minus its regional\n# mean PLUS synthetic crustal-anomaly mascons (the IGRF main field alone is too smooth to\n# localise — the real crustal map is a follow-on, see docs/CAPABILITY.md); the terrain channel\n# is the self-contained synthetic DEM. Recovery is checked against the INDEPENDENTLY injected\n# drift, never any field's own value (non-circular).\n#\n# NOTE: every top-level scalar key precedes the `[[...]]` array-of-tables blocks — a scalar\n# after an array-of-table would be absorbed into that table by TOML.\nkind = \"combined-altpnt\"\n\n# Track + drift + search (shared across the three channels).\nstart_lat_deg = 12.05\nstart_lon_deg = 20.05\nstep_lat_deg = 0.004\nstep_lon_deg = 0.003\nwaypoints = 60\n\ndrift_lat_deg = 0.5\ndrift_lon_deg = -0.4\n\nsearch_half_deg = 0.8\nsearch_step_deg = 0.08\nrefine_stages = 3\nrefine_factor = 8.0\nnoise_seed = 1\n\n# ---- Gravity channel ----\n# Each single-channel σ is set so that channel ALONE recovers only to ~600–900 m (well above\n# the ~140 m grid floor), making the fusion gain visible: the three-channel product collapses\n# to ~250 m (< 500 m), no worse than the best single channel.\nnmax = 3\ngravity_sigma_mgal = 3.0\n\n# ---- Magnetic channel (IGRF main field + synthetic crustal anomaly mascons, nT) ----\nigrf_year = 2025.0\nigrf_alt_km = 0.0\nmagnetic_sigma_nt = 30.0\n\n# ---- Terrain channel (synthetic DEM) ----\ndem_seed = 1\nterrain_sigma_m = 40.0\n\n# Low-degree anomalous gravity coefficients (the regional trend).\n[[coeffs]]\nn = 2\nm = 0\ncbar = 6.0e-6\nsbar = 0.0\n\n[[coeffs]]\nn = 3\nm = 1\ncbar = 3.0e-6\nsbar = 2.0e-6\n\n# Localized gravity mascons (mGal) the track crosses.\n[[mascons]]\nlat_deg = 12.18\nlon_deg = 20.16\namp_mgal = 45.0\nsigma_deg = 0.05\n\n[[mascons]]\nlat_deg = 12.26\nlon_deg = 20.22\namp_mgal = -38.0\nsigma_deg = 0.045\n\n# Synthetic crustal magnetic-anomaly mascons (nT) the track crosses.\n[[magnetic_mascons]]\nlat_deg = 12.20\nlon_deg = 20.18\namp_mgal = 250.0\nsigma_deg = 0.05\n\n[[magnetic_mascons]]\nlat_deg = 12.24\nlon_deg = 20.20\namp_mgal = -200.0\nsigma_deg = 0.045\n", "conflict-resilience.toml": "# Layered-PNT conflict resilience (paper P7).\n#\n# A contested-environment user fields four RF PNT layers that all ride the same band\n# and therefore share the jamming/spoofing denial vector — the fragile, correlated\n# case. The scenario reports:\n#   * total-loss probability vs threat intensity (Monte-Carlo vs the closed-form\n#     independent product it converges to),\n#   * the ~7x layered-vs-single-layer resilience ratio under the independence\n#     assumption,\n#   * how that ~7x collapses toward 1 as the denial correlation rises (a one-factor\n#     Gaussian copula) — correlation defeats layering, and\n#   * a §4.2 per-vector usable-PNT survival breakdown: for each named threat vector\n#     (jamming/spoofing/kinetic/cyber) acting alone, the graceful-degradation curve\n#     S_v(x) = 1 - Prod_i (1 - a_i*(1 - clamp(susceptibility_i,v * x, 0, 1))). Jamming\n#     is the sharpest vector for this correlated-RF stack.\n#\n# Every per-layer magnitude is a MODELLED input with provenance; see\n# src/conflict_threat_params.rs for the sourced [min, nominal, max] priors and the\n# per-vector susceptibility profiles (JammerTest 2024, TEXBAT, EASA SIB 2022-02,\n# RTCA DO-229, LunaNet/IOAG). Leaving `layers` out runs the same sourced four-layer\n# baseline; it is written out here — including each layer's vector_profile — for\n# transparency.\n\nkind = \"conflict-resilience\"\ntrials = 4000\nseed = 20260709\nprimary_layer = 0\n\n[intensity]\nmin = 0.0\nmax = 1.0\nsteps = 11\n\n[correlation]\nvalues = [0.0, 0.2, 0.4, 0.6, 0.8, 0.95]\n\n[[layers]]\nname = \"GNSS L1 C/A (open service)\"\navailability = 0.99\nsigma_m = 4.0\nvulnerability = 0.90\nvector_weight = 0.58\n# Denied at the lowest jammer power of any tracked signal; unauthenticated ⇒ spoofable.\n[layers.vector_profile]\njamming = 0.98\nspoofing = 0.85\nkinetic = 0.12\ncyber = 0.18\n\n[[layers]]\nname = \"GNSS L5 / E5a (wideband)\"\navailability = 0.97\nsigma_m = 3.0\nvulnerability = 0.85\nvector_weight = 0.60\n# Wideband ⇒ more jam-resistant than L1 C/A but still RF-denied.\n[layers.vector_profile]\njamming = 0.90\nspoofing = 0.80\nkinetic = 0.12\ncyber = 0.18\n\n[[layers]]\nname = \"Galileo E1 OS + OSNMA\"\navailability = 0.98\nsigma_m = 4.0\nvulnerability = 0.88\nvector_weight = 0.59\n# OSNMA authentication sharply lowers spoofing susceptibility; shared band keeps jamming high.\n[layers.vector_profile]\njamming = 0.92\nspoofing = 0.40\nkinetic = 0.12\ncyber = 0.22\n\n[[layers]]\nname = \"SBAS / augmentation (WAAS/EGNOS-class)\"\navailability = 0.96\nsigma_m = 3.0\nvulnerability = 0.86\nvector_weight = 0.60\n# Rides the L1/L5 band (jam-fragile) and, as a networked augmentation service, carries a\n# larger cyber and ground-segment kinetic surface.\n[layers.vector_profile]\njamming = 0.90\nspoofing = 0.68\nkinetic = 0.28\ncyber = 0.55\n", "constellation-multi-gnss-coverage.toml": "# Multi-constellation coverage: the four global navigation satellite systems (GNSS) together,\n# as a map of satellites in view, dilution of precision (DOP) and availability over the whole\n# Earth for one day.\n#\n# Each system is a preset built from its operator's published nominal elements:\n#   - GPS: the baseline 24-slot constellation, GPS Standard Positioning Service Performance\n#     Standard, 5th edition (2020), Tables 3.2-1 and 3.2-3;\n#   - Galileo: the Walker 24/3/1 reference constellation at 29 599.801 km semi-major axis and\n#     56 deg, Galileo Open Service Service Definition Document issue 1.1, Tables 1 and 23;\n#   - BeiDou: 24 medium Earth orbit satellites in a Walker 24/3/1 at 21 528 km and 55 deg,\n#     3 geostationary and 3 inclined geosynchronous satellites, BeiDou Open Service\n#     Performance Standard 3.0, section 4.1 (the medium-orbit phase and the inclined\n#     geosynchronous crossing longitude are modelled, the standard does not state them);\n#   - GLONASS: 24 satellites, 3 planes, 19 100 km, 64.8 deg, from the slot formula of the\n#     GLONASS Interface Control Document edition 5.1, section 5.2.\n#\n# The receiver estimates one clock per system (clock = \"per-constellation\"), so a fix needs\n# three position unknowns plus one clock for every system in view. The four systems' slot\n# tables come from different reference epochs, so their relative phase is not a snapshot of\n# any real date; the statistics over a day are what the run is for.\n#\n# What the run answers: how many satellites are in view, the position, horizontal, vertical\n# and geometric DOP per 10 deg cell, and the share of time the position DOP (PDOP) is at or\n# below 6 above a 10 deg mask. MODELLED: two-body orbits, a spherical Earth, geometry only.\n\nkind = \"constellation-design\"\nbody = \"earth\"\nduration_s = 86164.0\nstep_s = 900.0\nmask_deg = 10.0\npdop_threshold = 6.0\ngrid_step_deg = 10.0\nclock = \"per-constellation\"\ntrack_points = 25\nmax_tracks = 102\n\n[[constellation]]\nname = \"GPS\"\npreset = \"gps-baseline\"\n\n[[constellation]]\nname = \"Galileo\"\npreset = \"galileo\"\n\n[[constellation]]\nname = \"BeiDou\"\npreset = \"beidou\"\n\n[[constellation]]\nname = \"GLONASS\"\npreset = \"glonass\"\n", "contact-schedule.toml": "# Ground-contact planning: three illustrative satellites over three illustrative stations for\n# 12 hours. The run gives each satellite-station pass its access window and the data volume\n# DVB-S2 adaptive coding and modulation (ACM) can move in it (ETSI EN 302 307-1 Table 13\n# thresholds plus an implementation margin). It then builds a conflict-free contact plan in\n# which each antenna serves one satellite at a time, with a turnaround between contacts, and\n# each satellite downlinks to one station at a time. Delivery is weighted by priority and\n# capped at each satellite's backlog. Three plans are reported side by side: a marginal-value\n# greedy, a first-come baseline and, when the candidate set is small, the exact optimum, with\n# the greedy's optimality gap.\n#\n# Every number below is ILLUSTRATIVE: no operator's orbits, stations or link budget.\n# MODELLED: the scheduler is checked against its own exact solver, not an external tool.\nkind = \"contact-schedule\"\nepoch = [2024.0, 1.0, 1.0, 0.0, 0.0, 0.0]\nduration_hours = 12.0\nstep_s = 30.0\nrefraction = true\nlight_time = true\n\n[link]\nfrequency_ghz = 8.2            # X-band downlink\neirp_dbw = 7.0\nsymbol_rate_msps = 20.0\nother_losses_db = 2.0\nzenith_atm_loss_db = 0.3\nimplementation_margin_db = 1.0\nacm_step_s = 10.0\n\n[[satellites]]\nname = \"eo-sso-a\"\naltitude_km = 550.0\ninclination_deg = 97.6\nraan_deg = 0.0\narg_lat_deg = 0.0\nbacklog_mbit = 400000.0\npriority = 2.0\n\n[[satellites]]\nname = \"eo-sso-b\"\naltitude_km = 550.0\ninclination_deg = 97.6\nraan_deg = 0.0\narg_lat_deg = 180.0\nbacklog_mbit = 400000.0\npriority = 1.0\n\n[[satellites]]\nname = \"iot-mid\"\naltitude_km = 700.0\ninclination_deg = 53.0\nraan_deg = 60.0\narg_lat_deg = 90.0\nbacklog_mbit = 60000.0\npriority = 1.5\n\n[[stations]]\nname = \"polar-north\"\nlat_deg = 78.2\nlon_deg = 15.4\nalt_m = 450.0\nmask_deg = 5.0\ng_over_t_db = 30.0\nsetup_s = 120.0\n\n[[stations]]\nname = \"mid-latitude\"\nlat_deg = 52.2\nlon_deg = 5.0\nalt_m = 10.0\nmask_deg = 5.0\ng_over_t_db = 30.0\nsetup_s = 120.0\n\n[[stations]]\nname = \"southern\"\nlat_deg = -33.9\nlon_deg = 18.4\nalt_m = 100.0\nmask_deg = 5.0\ng_over_t_db = 30.0\nsetup_s = 120.0\n", "earth-gnss-lunar.toml": "# Earth-GNSS reception at lunar distance.\n#\n# A GNSS constellation is built to serve users under it. A receiver near the Moon is\n# roughly fifteen times the orbital radius away, outside that service volume entirely, and\n# three facts decide whether it can hear anything at all:\n#\n#   1. THE EARTH BLOCKS THE BORESIGHT. From 26,560 km the Earth subtends a half-angle of\n#      about 13.9 deg. Any ray that reaches the Moon must therefore leave the transmitter\n#      at least that far off nadir — the peak of the beam is geometrically unavailable\n#      before a single dB is computed.\n#   2. WHAT IS LEFT IS THE EDGE OF THE MAIN LOBE AND THE SIDELOBES. The usable rays sit in\n#      a thin annulus just outside the limb, where the transmit gain is already falling.\n#      This is the regime the LuGRE payload operated in when it tracked GNSS at the Moon\n#      in 2025.\n#   3. THE PATH LOSS IS ABOUT 208 dB AT L1 — some 25 dB more than a terrestrial user pays.\n#      The budget closes only with a high-gain receiving antenna, and it closes narrowly.\n#\n# The run reports one row per satellite (off-boresight angle, Earth occultation, range,\n# path loss, transmit gain at that angle, received power, C/N0) and then aggregates only\n# the links that clear the tracking threshold.\n#\n# READ THE CONDITIONING, NOT JUST THE COUNT\n# Every satellite the receiver can hear lies inside a cone a couple of degrees wide, so the\n# lines of sight are nearly parallel and the dilution of precision is enormous. That is not\n# a defect of the model; it is the defining property of the layer. An Earth-GNSS fix at\n# lunar distance is a TIMING-grade observation far more than a position-grade one, and the\n# report prints the DOP rather than quietly omitting it.\n#\n# WHAT IS MODELLED, AND WHY IT IS NOT VALIDATED\n# The transmit gain at angle is a uniformly illuminated circular aperture — an Airy\n# pattern. A real GPS L1 antenna is a twelve-element helical array whose measured pattern\n# has a shaped main lobe, deliberately peaked off-boresight to even out power across the\n# Earth disc, and sidelobes that are not Airy at all. Measured patterns are published; they\n# are not vendored in this repository, so they are not used here. Orderings and orders of\n# magnitude are meaningful. The dB of any single satellite is not.\n#\n# Also absent, and every one of these makes the budget OPTIMISTIC: no ionospheric or\n# tropospheric loss on the limb-grazing rays (which do clip the upper atmosphere at small\n# clearance angles), no polarisation mismatch, no pointing loss, no receiver implementation\n# loss, and a spherical Earth with no refractive extension of the occultation.\n#\n# Upgrading this to Validated needs two things the repository does not hold: a measured\n# transmit pattern, and LuGRE normal points to check against. Neither is invented here.\n#\n# The Moon position is an INPUT — a range and an inertial direction — not an ephemeris\n# lookup. What is under test is the link and the beam geometry; the engine models the lunar\n# ephemeris elsewhere and coupling them would only obscure which part is being checked.\n\nkind = \"earth-gnss-lunar\"\n\n# The constellation: a 24-satellite Walker at GPS altitude and inclination.\naltitude_km = 20180.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 2.0\nepoch_s = 0.0\n\n# The receiver, at the mean lunar distance along the inertial x-axis.\nreceiver_range_m = 384400000.0\nreceiver_ra_deg = 0.0\nreceiver_dec_deg = 0.0\n\n# Transmitter: about 27 W into an aperture sized so the boresight gain lands near the\n# 13 dBi a GPS L1 antenna is usually quoted at.\ntx_power_dbw = 13.4\ntx_diameter_m = 0.35\ntx_efficiency = 0.6\nfreq_hz = 1575420000.0\n\n# Receiver: a modest high-gain lunar antenna and a room-temperature system.\nrx_gain_dbi = 12.0\nsystem_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n", "entry-heating-stardust.toml": "# Stardust sample-return capsule entry: the published case the `entry-heating` kind is checked\n# against (xval/entry-stardust/PREREGISTRATION.md; tests/entry_stardust_published.rs).\n#\n# Entry interface at a radius of 6503.14 km, inertial 12.9 km/s at -8.2 deg, 45.8 kg, 0.811 m\n# diameter, 0.2202 m nose radius (Desai et al., NASA NTRS 20050042027 and 20090004445). The\n# latitude and heading are an assumed approximate entry over the Pacific; C_D is the module's\n# 60 deg sphere-cone default. Published 6-DoF nominal peak deceleration: 33.4 g. The heating is\n# Sutton-Graves convective only, MODELLED.\nkind = \"entry-heating\"\nbody = \"earth\"\natmosphere = \"us76\"\nentry_interface_altitude_m = 125003.0\nvelocity_frame = \"inertial\"\nentry_speed_m_s = 12900.0\nflight_path_angle_deg = 8.2\nlatitude_deg = 41.0\nheading_deg = 100.0\nmass_kg = 45.8\nreference_area_m2 = 0.51657\nnose_radius_m = 0.2202\ndrag_coefficient = 1.4828\nlift_to_drag = 0.0\nrotating_planet = true\nstep_s = 0.05\nterminal_altitude_m = 10000.0\n", "eo-coverage.toml": "# Earth-observation payload footprint & coverage demonstrator (SMAD space triangle).\n#\n# Turns an orbit altitude + sensor field of view into the Earth angular radius,\n# swath width, nadir ground sample distance, maximum off-nadir access, circular\n# period and equatorial ground-track spacing (with a contiguous-coverage flag).\n#\n# HONEST SCOPE: MODELLED spherical-Earth geometry only -- no radiometry / MTF /\n# atmosphere / pointing-jitter / sun-glint model. Ground-track spacing is\n# R_e*(omega - dOmega/dt)*T_nodal with first-order J2 secular rates; the\n# inclination defaults to the sun-synchronous one for the altitude.\n# Run:  kshana scenarios/eo-coverage.toml\nkind = \"eo-coverage\"\n\naltitude_km = 700.0\nhalf_fov_deg = 7.5               # nadir half-angle from boresight\nifov_microrad = 14.0             # per-pixel IFOV for the nadir GSD\nmax_off_nadir_deg = 45.0         # slewable field of regard\n# inclination_deg = 98.19        # optional; sun-synchronous when absent\n", "eo-radiometry.toml": "# Nadir imager radiometry and image quality for an ILLUSTRATIVE small Earth-observation camera\n# (no operator's design): 0.40 m aperture, 3.6 m focal length (F/9), 5.5 um pixels, from\n# 500 km. The run gives the signal-to-noise budget of a 15 % reflectance scene, the system MTF\n# at Nyquist, the relative edge response and the GIQE version 4 NIIRS. MODELLED: the NIIRS is\n# an empirical regression evaluated on modelled inputs, not a rated image.\nkind = \"eo-radiometry\"\naltitude_m = 500000.0\nfocal_length_m = 3.6\naperture_m = 0.40\npixel_pitch_um = 5.5\nwavelength_um = 0.65\nbandwidth_um = 0.2\nfill_factor = 1.0\nsmear_px = 0.2\njitter_px_rms = 0.1\nreflectance = 0.15\nsolar_irradiance_w_m2_um = 1550.0\nsun_zenith_deg = 40.0\natmospheric_transmittance = 0.7\npath_radiance_w_m2_sr_um = 0.0\noptics_transmittance = 0.8\nintegration_s = 0.0005\nquantum_efficiency = 0.6\ndark_current_e_s = 50.0\nread_noise_e = 20.0\nfull_well_e = 30000.0\nadc_bits = 12\n", "ephemeris.toml": "kind = \"ephemeris\"\n\n# Ephemeris & ground track — \"where is the satellite right now\".\n#\n# Propagate the ISS (ZARYA) for one revolution and emit, at every 30 s step: the\n# inertial TEME and GCRS (≈ J2000) state (position AND velocity), the Earth-fixed\n# ITRF/ECEF position, the WGS-84 sub-satellite point (latitude / longitude /\n# altitude — the ground track drawn in the chart), and the topocentric azimuth /\n# elevation / range and range-rate (the geometric Doppler) seen from a ground\n# station. The frame chain is the one validated to the millimetre against the\n# published Vallado vectors; the velocity is validated against the official AIAA\n# tcppver vectors.\n#\n# A TLE's epoch is its own (UTC); the ground track therefore starts at the TLE\n# epoch. Swap in any current TLE (e.g. from CelesTrak) to track a live satellite.\ntle = \"\"\"\n1 25544U 98067A   20045.18587073  .00000950  00000-0  25302-4 0  9990\n2 25544  51.6443 242.0161 0004885 264.6060 207.3845 15.49165514212791\n\"\"\"\nstep_s = 30.0\nduration_s = 16740.0   # ~three ISS revolutions\n\n# Earth-orientation: dut1_s = UT1 - UTC (0 => the DUT1 ~ 0 approximation, a few-\n# arcsecond / few-hundred-metre longitude shift in the ground track); xp_arcsec /\n# yp_arcsec are the IERS polar-motion pole coordinates. Leave at 0 for a quick run,\n# or supply IERS values.\ndut1_s = 0.0\nxp_arcsec = 0.0\nyp_arcsec = 0.0\n\n# Optional ground station — ESA's European Space Operations Centre, Darmstadt.\n# Drives the az / el / range and the range-rate / Doppler columns.\n[station]\nlat_deg = 49.8707\nlon_deg = 8.6217\nalt_m = 144.0\n", "europa-surface-pnt.toml": "# Positioning a lander on Europa: the Jovian-moon case.\n#\n# A lander at 20 deg north, 60 deg east on Europa's surface navigates for one Europan day\n# (3.55 Earth days, the synchronous rotation period) with twelve navigation satellites at\n# 4 500 km in three planes inclined 55 deg, under a 10 deg elevation mask, and a two-way\n# range from Earth whenever the Earth is above the lander's horizon. Europa is tidally\n# locked, so from a fixed site Jupiter never moves in the sky, while the Earth, riding\n# with Jupiter, rises and sets once per Europan day: the Earth link is available only for\n# part of the run, and the report shows what the local constellation must carry alone.\n#\n# The Europa constants (gravitational parameter, mean radius, International Astronomical\n# Union (IAU) pole and prime meridian)\n# are the published values cited in src/body.rs; no J2 (second zonal harmonic) is carried\n# for Europa, so the relay\n# orbits are two-body. The Earth-Europa light time is about 36 minutes one way at this\n# epoch, near a Jupiter opposition.\n#\n# One simplification matters more here than at Mars: the relays orbit inside Europa's Hill\n# sphere (about 13 700 km) but Jupiter's pull on them is not modelled, so their orbits are\n# idealised. The run shows the geometry and what the Earth link adds (availability rises\n# from about half the Europan day to about three quarters), not a flyable design.\n#\n# MODELLED: the constellation, the noise and the measurement model are modelling choices.\nkind = \"body-pnt\"\nbody = \"Europa\"\nepoch = \"2027-02-19T00:00:00\"\nduration_s = 306822.0\nstep_s = 1800.0\nseed = 11\n\n[user]\nkind = \"surface\"\nlat_deg = 20.0\nlon_deg = 60.0\n\n[constellation]\nplanes = 3\nsats_per_plane = 4\naltitude_km = 4500.0\ninclination_deg = 55.0\nsigma_range_m = 1.0\nmask_deg = 10.0\n\n[earth_link]\nenabled = true\nsigma_range_m = 1.0\n", "fusion-pnt-coupled.toml": "# Coupled joint sensor-fusion PNT: the same suites and GNSS outage as `fusion-pnt.toml`, but\n# the navigator is ONE stacked Kalman filter over position, velocity, clock phase, clock\n# frequency and the accelerometer bias (the `[coupled]` table). While GNSS is nominal it takes\n# pseudoranges, each `rho = g * position + c * clock phase + noise` along a line-of-sight factor\n# g, so a single measurement constrains position and clock together and the filter carries\n# their cross-covariance; the optical time-transfer re-syncs during the outage are clock-only\n# pseudoranges. The accelerometers here carry a constant bias, which the bias state learns\n# before the outage (`fusion-pnt.toml` zeroes the biases because its filters have no bias\n# state). Vendor-neutral; clock and noise parameters as in `fusion-pnt.toml`, the biases are\n# illustrative. MODELLED.\nkind = \"fusion\"\nseed = 42\ntiming_spec_ns = 20.0\nposition_spec_m = 100.0\n\n[time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0, t1 = 7200.0, state = \"denied\" },\n]\n\n[resync]\nenabled = true\ninterval_s = 1800.0\nsigma_j_s = 1.0e-12\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457)\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\ndrift = 0.0\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\ndrift = 0.0\n\n[accel_quantum]\nid = \"cold-atom-quat\"\nprovenance = \"Cold-atom accelerometer, low long-tau velocity-random-walk; illustrative noise-driven value with an illustrative constant bias\"\nbias = 2.0e-5\nq_va = 1.0e-9\n\n[accel_classical]\nid = \"nav-grade-quartz\"\nprovenance = \"Navigation-grade quartz accelerometer; illustrative noise-driven value with an illustrative constant bias\"\nbias = 2.0e-4\nq_va = 1.0e-7\n\n[coupled]\nsigma_pr_m = 1.0\ngeometry = [1.0, -0.7, 0.4, -0.2]\nq_ba = 0.0\nbias_var = 1.0e-6\n\n", "fusion-pnt.toml": "# Joint sensor-fusion PNT: a single Kalman filter is the navigator, fusing the\n# clock and inertial states and aided by optical ISL time transfer, rather than\n# composing independent predictors. GNSS denied 1.8 h.\n#\n# The filter learns the clock frequency offset and the platform velocity while\n# GNSS is available, then coasts through the outage propagating those estimates;\n# its joint covariance gives the joint integrity. To keep the filter's process\n# noise consistent with truth, the accelerometers here are noise-driven (bias set\n# to zero) — augmented-state estimation of constant biases is future work.\n# Vendor-neutral; clock and noise parameters are public/cited or illustrative.\nkind = \"fusion\"\nseed = 42\ntiming_spec_ns = 20.0\nposition_spec_m = 100.0\n\n[time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0, t1 = 7200.0, state = \"denied\" },\n]\n\n[resync]\nenabled = true\ninterval_s = 1800.0\nsigma_j_s = 1.0e-12\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457)\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\ndrift = 0.0\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\ndrift = 0.0\n\n[accel_quantum]\nid = \"cold-atom-quat\"\nprovenance = \"Cold-atom accelerometer, low long-tau velocity-random-walk; illustrative noise-driven value (bias zeroed for filter consistency)\"\nbias = 0.0\nq_va = 1.0e-9\n\n[accel_classical]\nid = \"nav-grade-quartz\"\nprovenance = \"Navigation-grade quartz accelerometer; illustrative noise-driven value (bias zeroed for filter consistency)\"\nbias = 0.0\nq_va = 1.0e-7\n", "gnss-ins-aviation.toml": "# Aviation GNSS/INS with tight coupling: a light aircraft takes off, climbs at 6 deg, levels\n# off and flies a 25 deg-bank coordinated turn (trajectory profile `aircraft`); GNSS is\n# denied for two minutes that cover the turn, the hardest part of a coast because the\n# heading and attitude errors are then projected into the horizontal. Tightly coupled\n# (`[tight]`) on a GPS-like SGP4 Walker constellation.\n#\n# Illustrative sensors (assumed values, not a product's datasheet): a navigation-grade unit\n# against a tactical-grade unit, constant biases (a best-case coast); each sensor's filter prior\n# matches its grade.\n#\n# MODELLED: synthetic motion, constellation and sensors.\nkind = \"gnss-ins\"\nseed = 13\nthreshold_m = 100.0\nfix_interval_s = 1.0\nsigma_pos_m = 3.0\nsigma_vel_mps = 0.1\nlat_deg = 52.0\nlon_deg = 5.0\nalt_m = 10.0\n\n[time]\nstep_s = 0.1\nduration_s = 400.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 120.0, state = \"nominal\" },\n  { t0 = 120.0, t1 = 240.0, state = \"denied\" },\n  { t0 = 240.0, t1 = 400.0, state = \"nominal\" },\n]\n\n[trajectory]\nprofile = \"aircraft\"\nspeed_mps = 70.0\naccel_mps2 = 2.5\nclimb_deg = 6.0\nclimb_s = 60.0\nbank_deg = 25.0\nturn_s = 60.0\n\n[tight]\nsigma_range_m = 2.0\n\n[imu_quantum]\nid = \"navigation-grade-imu\"\nprovenance = \"Illustrative navigation-grade unit (assumed): residual accel bias 50 micro-g, gyro bias 0.01 deg/h\"\naccel_bias = [4.9e-4, -4.9e-4, 0.0]\ngyro_bias = [0.0, 0.0, 4.85e-8]\n\n# Filter prior matched to the sensor grade (the pack's default prior suits a tactical unit;\n# for a navigation-grade unit its bias-estimation noise over a short aided arc would exceed\n# the sensor's true bias).\n[imu_quantum.filter_prior]\nsigma_accel_bias = 1.0e-3\nsigma_gyro_bias = 1.0e-7\n\n[imu_classical]\nid = \"tactical-grade-imu\"\nprovenance = \"Illustrative tactical-grade unit (assumed): residual accel bias 1 mg, gyro bias 1 deg/h\"\naccel_bias = [9.8e-3, -9.8e-3, 0.0]\ngyro_bias = [0.0, 0.0, 4.85e-6]\n\n[imu_classical.filter_prior]\nsigma_accel_bias = 2.0e-2\nsigma_gyro_bias = 1.0e-5\n", "gnss-ins-maritime.toml": "# Maritime GNSS/INS: a vessel at 8 m/s (about 15.5 knots) weaving through full circles at\n# 1 deg/s, then a five-minute GNSS outage, on the same closed-loop 15-state GNSS/INS filter as\n# `gnss-ins.toml`. The motion comes from the trajectory library (`[trajectory]`,\n# profile `figure8`): slow, steady turning, the regime of a ship rather than a car.\n#\n# Illustrative sensors (assumed values, not a product's datasheet): a navigation-grade unit\n# (fibre-optic-gyro class, residual gyro bias 0.01 deg/h) against a tactical-grade unit\n# (residual gyro bias 1 deg/h). Constant biases: the filter learns them while GNSS is up, so\n# the coast is a best case for each sensor. Each sensor's filter prior matches its grade.\n#\n# MODELLED: synthetic motion and sensors; the figure of merit is the fused solution's\n# horizontal error against the scenario's own truth.\nkind = \"gnss-ins\"\nseed = 11\nthreshold_m = 50.0\nfix_interval_s = 1.0\nsigma_pos_m = 2.0\nsigma_vel_mps = 0.1\nlat_deg = 54.0\nlon_deg = 10.0\nalt_m = 0.0\n\n[time]\nstep_s = 0.1\nduration_s = 1200.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 900.0,  state = \"nominal\" },\n  { t0 = 900.0, t1 = 1200.0, state = \"denied\" },\n]\n\n[trajectory]\nprofile = \"figure8\"\nspeed_mps = 8.0\naccel_mps2 = 0.2\nturn_rate_dps = 1.0\n\n[imu_quantum]\nid = \"navigation-grade-imu\"\nprovenance = \"Illustrative navigation-grade unit (assumed): residual accel bias 50 micro-g, gyro bias 0.01 deg/h\"\naccel_bias = [4.9e-4, -4.9e-4, 0.0]\ngyro_bias = [0.0, 0.0, 4.85e-8]\n\n# Filter prior matched to the sensor grade (the pack's default prior suits a tactical unit;\n# for a navigation-grade unit its bias-estimation noise over a short aided arc would exceed\n# the sensor's true bias).\n[imu_quantum.filter_prior]\nsigma_accel_bias = 1.0e-3\nsigma_gyro_bias = 1.0e-7\n\n[imu_classical]\nid = \"tactical-grade-imu\"\nprovenance = \"Illustrative tactical-grade unit (assumed): residual accel bias 1 mg, gyro bias 1 deg/h\"\naccel_bias = [9.8e-3, -9.8e-3, 0.0]\ngyro_bias = [0.0, 0.0, 4.85e-6]\n\n[imu_classical.filter_prior]\nsigma_accel_bias = 2.0e-2\nsigma_gyro_bias = 1.0e-5\n", "gnss-ins-rail.toml": "# Rail GNSS/INS with tight coupling: a train runs between stops at 30 m/s with gentle 20 deg\n# curves (trajectory profile `stop_go`), passes a deep cutting where only two satellites stay\n# in view, then a two-minute tunnel. The receiver is tightly coupled (`[tight]`): it keeps\n# fusing the pseudoranges of the two satellites it still tracks in the cutting, where a\n# loosely-coupled receiver has no fix at all. Satellites come from a GPS-like SGP4 Walker\n# constellation.\n#\n# Illustrative sensors (assumed values, not a product's datasheet): a navigation-grade unit\n# against a tactical-grade unit, constant biases (a best-case coast); each sensor's filter prior\n# matches its grade.\n#\n# MODELLED: synthetic motion, constellation and sensors.\nkind = \"gnss-ins\"\nseed = 12\nthreshold_m = 30.0\nfix_interval_s = 1.0\nsigma_pos_m = 2.0\nsigma_vel_mps = 0.1\nlat_deg = 48.0\nlon_deg = 11.0\nalt_m = 500.0\n\n[time]\nstep_s = 0.1\nduration_s = 900.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 300.0, state = \"nominal\" },\n  { t0 = 300.0, t1 = 500.0, state = \"degraded\" },\n  { t0 = 500.0, t1 = 620.0, state = \"denied\" },\n  { t0 = 620.0, t1 = 900.0, state = \"nominal\" },\n]\n\n[trajectory]\nprofile = \"stop_go\"\nspeed_mps = 30.0\naccel_mps2 = 0.8\ncruise_s = 120.0\nstop_s = 30.0\nturn_deg = 20.0\n\n[tight]\nmask_deg = 10.0\nsigma_range_m = 1.5\ndegraded_max_sats = 2\n\n[imu_quantum]\nid = \"navigation-grade-imu\"\nprovenance = \"Illustrative navigation-grade unit (assumed): residual accel bias 50 micro-g, gyro bias 0.01 deg/h\"\naccel_bias = [4.9e-4, -4.9e-4, 0.0]\ngyro_bias = [0.0, 0.0, 4.85e-8]\n\n# Filter prior matched to the sensor grade (the pack's default prior suits a tactical unit;\n# for a navigation-grade unit its bias-estimation noise over a short aided arc would exceed\n# the sensor's true bias).\n[imu_quantum.filter_prior]\nsigma_accel_bias = 1.0e-3\nsigma_gyro_bias = 1.0e-7\n\n[imu_classical]\nid = \"tactical-grade-imu\"\nprovenance = \"Illustrative tactical-grade unit (assumed): residual accel bias 1 mg, gyro bias 1 deg/h\"\naccel_bias = [9.8e-3, -9.8e-3, 0.0]\ngyro_bias = [0.0, 0.0, 4.85e-6]\n\n[imu_classical.filter_prior]\nsigma_accel_bias = 2.0e-2\nsigma_gyro_bias = 1.0e-5\n", "gnss-ins.toml": "# Loosely-coupled GNSS/INS: the three-axis strapdown navigator disciplined by a\n# 15-state error-state EKF, then coasting through a 60 s GNSS outage. Unlike the\n# `inertial` pack (a 1-DOF scalar dead-reckoner with a truth-snap reset at every\n# fix), this runs the genuine closed-loop filter: it learns from noisy fixes while\n# GNSS is up and coasts on the corrected state during the gap. The reported error\n# is the real horizontal residual against truth; each sensor also carries its\n# open-loop free-INS RMS so the filter's value is explicit.\n#\n# Honest framing: loosely-coupled, a single deterministic driving trajectory, a\n# flat-Earth tangent-plane INS<->GNSS comparison. The lower-bias (quantum-grade)\n# sensor has the better unaided coast. Both biases here are constant and noise-free,\n# so the filter learns them while GNSS is up and the fused coast is a best case; a\n# bias that keeps drifting is what ends a real one (see small-uas-jammed-nav.toml).\n# Revised in 0.27.3: a sign error in the filter's gyro-bias coupling had put a floor\n# of tens of metres under the fused outage error; see the CHANGELOG.\nkind = \"gnss-ins\"\nseed = 7\nthreshold_m = 50.0\nfix_interval_s = 1.0\nsigma_pos_m = 1.0\nsigma_vel_mps = 0.05\nlat_deg = 45.0\nlon_deg = -57.3\nalt_m = 50.0\n\n[time]\nstep_s = 0.1\nduration_s = 160.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 100.0, state = \"nominal\" },\n  { t0 = 100.0, t1 = 160.0, state = \"denied\" },\n]\n\n[imu_quantum]\nid = \"cold-atom-imu\"\nprovenance = \"Quantum-grade inertial unit: low residual accelerometer/gyro bias (cold-atom-class); the better unaided coast\"\naccel_bias = [0.015, 0.0, 0.0]\ngyro_bias = [0.0, 0.0, 5.0e-5]\n\n[imu_classical]\nid = \"tactical-imu\"\nprovenance = \"Tactical-grade MEMS/quartz inertial unit: larger residual bias; the free-running INS diverges much faster\"\naccel_bias = [0.03, -0.02, 0.0]\ngyro_bias = [0.0, 0.0, 1.0e-4]\n\n# Optional: layer the full deterministic IMU error chain on top of the constant\n# biases above. Every field defaults to zero, so omitting this block leaves the\n# sensor a pure constant-bias source (the run is then identical to before this\n# schema existed). The terms drive the three-axis strapdown mechanization through\n# the IMU error model (IEEE Std 952-1997 §A.2; Groves 2013 §4.3). Scale-factor is\n# in ppm; misalignment in rad (off-diagonal); g-sensitivity in (rad/s)/(m/s²);\n# quantization in the sensor's output units; rate-ramp is a linear-in-time drift.\n# [imu_classical.error_model]\n# scale_gyro_ppm  = [1500.0, 1500.0, 1500.0]\n# scale_accel_ppm = [1000.0, 1000.0, 1000.0]\n# g_sensitivity   = [5.0e-5, 5.0e-5, 5.0e-5]\n# rate_ramp_gyro  = [0.0, 1.0e-6, 0.0]\n# quant_gyro      = [1.0e-5, 1.0e-5, 1.0e-5]\n", "gnss-sim-container-terminal-skyline.toml": "# Pseudoranges and RAIM for a straddle carrier on a container quay, with ship-to-shore\n# cranes to seaward and container stacks to landward: the `gnss-sim` scenario under the\n# `container-terminal` skyline preset.\n#\n# The question a terminal-automation team asks: a straddle carrier or an automated guided\n# vehicle positions itself on the quay with GNSS, and the cranes and the stacks hide part of\n# the sky; how many satellites are left, and what does that do to the RAIM protection levels?\n# The quay runs north-south with the water to the west. Container stacks rise to 12 deg over\n# the landward half (000-180 deg); two crane booms over the water are narrow sectors up to\n# 35 deg (245-255 deg) and 25 deg (285-295 deg); the receiver mask is 5 deg. Each epoch\n# reports `masked_by_skyline`. The site is a generic\n# North Sea port at 51.95 N, 4.05 E; the measurement model is that of `gnss-sim-raim.toml`\n# (Klobuchar ionosphere, Saastamoinen troposphere with Niell mapping, thermal noise,\n# multipath, satellite clock offsets) over a GPS-like Walker shell.\n#\n# The skyline preset is REPRESENTATIVE (provenance in docs/SKYLINE.md and `kshana skyline\n# --preset container-terminal`): stack height from the ISO 668 high-cube box, boom height\n# of the order of a post-Panamax crane; not a survey of any terminal. A crane sector is\n# treated as opaque, and the skyline is line of sight only: no diffraction, no reflection\n# from the steel. MODELLED.\nkind = \"gnss-sim\"\nseed = 7\nmask_deg = 5.0\nnoise_sigma_m = 1.5      # 1-sigma thermal noise per pseudorange\nmultipath_m = 0.5        # peak deterministic multipath, scaled by (1 - sin elevation)\nsat_clock_rms_m = 30.0   # peak per-PRN satellite clock offset\nuere_m = 3.0             # RAIM 1-sigma user-equivalent range error\np_fa = 1.0e-5\np_md = 1.0e-3\nalert_limit_h_m = 40.0\nalert_limit_v_m = 50.0\n\n[time]\nstep_s = 60.0\nduration_s = 3600.0\n\n[receiver]\nlat_deg = 51.95\nlon_deg = 4.05\nalt_m = 5.0\nclock_bias_m = 1500.0\n\n# A GPS-like 24-satellite Walker shell propagated through the validated SGP4 core.\n[constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# Klobuchar single-frequency ionosphere (IS-GPS-200 section 20.3.3.5.2.5): the eight\n# broadcast coefficients and the GPS seconds-of-day at the start of the run.\n[iono]\nalpha = [3.82e-8, 1.49e-8, -1.79e-7, 0.0]\nbeta = [1.43e5, 0.0, -3.28e5, 1.13e5]\ngps_seconds_of_day = 50400.0\n\n# Saastamoinen zenith troposphere (Davis 1985 / Groves section 9.4) with Niell (1996)\n# mapping: surface meteorology and the day-of-year.\n[tropo]\npressure_hpa = 1013.25\ntemp_k = 288.15\nhumidity = 0.7\nday_of_year = 180.0\n\n[skyline]\npreset = \"container-terminal\"\n", "gnss-sim-raim.toml": "# Measurement-domain GNSS simulation: pseudoranges with ionospheric and\n# tropospheric delays, fed to snapshot RAIM for protection levels.\n#\n# Unlike the purely-geometric `orbit` pack (visibility + DOP only), this synthesises\n# each visible satellite's pseudorange:\n#   ρ = geometric range + c·δt_rx − c·δt_sv + I(Klobuchar) + T(Saastamoinen·Niell)\n#       + thermal noise + multipath\n# and forms the measurement residuals that drive snapshot RAIM (HPL/VPL, fault\n# detection). The per-epoch per-satellite measurements are emitted in the JSON\n# `gnss_measurements` array for downstream tools.\nkind = \"gnss-sim\"\nseed = 7\nmask_deg = 5.0\nnoise_sigma_m = 1.5      # 1σ thermal noise per pseudorange (set 0 for a noise-free run)\nmultipath_m = 0.5        # peak deterministic multipath, scaled by (1 − sin elevation)\nsat_clock_rms_m = 30.0   # peak per-PRN satellite clock offset\nuere_m = 3.0             # RAIM 1σ user-equivalent range error\np_fa = 1.0e-5\np_md = 1.0e-3\nalert_limit_h_m = 40.0\nalert_limit_v_m = 50.0\n\n[time]\nstep_s = 60.0\nduration_s = 3600.0\n\n[receiver]\nlat_deg = 40.4\nlon_deg = -3.7\nalt_m = 660.0\nclock_bias_m = 1500.0\n\n# A GPS-like 24-satellite Walker shell propagated through the validated SGP4 core.\n[constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# Klobuchar single-frequency ionosphere (IS-GPS-200 §20.3.3.5.2.5): the eight\n# broadcast coefficients and the GPS seconds-of-day at the start of the run.\n[iono]\nalpha = [3.82e-8, 1.49e-8, -1.79e-7, 0.0]\nbeta = [1.43e5, 0.0, -3.28e5, 1.13e5]\ngps_seconds_of_day = 50400.0\n\n# Saastamoinen zenith troposphere (Davis 1985 / Groves §9.4) with Niell (1996)\n# mapping: surface meteorology and the day-of-year.\n[tropo]\npressure_hpa = 1013.25\ntemp_k = 288.15\nhumidity = 0.5\nday_of_year = 180.0\n", "gnss-ssv-formation-heo.toml": "# Relative navigation of a three-craft formation in the booklet's highly elliptical orbit.\n#\n# A chief and two deputies (offset in true anomaly at perigee by 0.02 and 0.05 degrees, a few kilometres apart) each run\n# the onboard filter on their own pseudoranges. The deputies' positions relative to the chief are estimated two ways: by\n# subtracting the independent absolute estimates, and by a relative filter on single-differenced pseudoranges of the signals\n# both craft track. Differencing removes what the two links share; the relative dynamics are the difference of two nonlinear\n# trajectories, so the relative filter keeps its accuracy through stretches with too few signals. The limb medium is on, and\n# its excess delay (which the filters do not model) is largely common to the two links and so cancels in the differences.\n#\n# MODELLED: simulated truth, forces and noise; no flight formation data.\n\nkind = \"gnss-ssv\"\nname = \"HEO formation relative navigation (reduced length)\"\n\n[constellations]\ninclude = [\"gps\", \"glonass\", \"galileo\", \"bds\"]\nbands = [\"l1\", \"l5\"]\n\n[receiver]\ncn0_min_dbhz = 20.0\n\n[atmosphere]\n\n[navigation]\npreset = \"heo\"\nduration_min = 400.0\nstep_s = 60.0\nantennas = [\"booklet-high-gain-nadir\", \"booklet-patch-zenith\"]\nseries_every_min = 40.0\n\n[formation]\noffsets_deg = [0.02, 0.05]\n", "gnss-ssv-heo.toml": "# A highly elliptical orbit through the GNSS orbits: what a user sees from perigee to apogee.\n#\n# The orbit is the booklet's table 5.10 (semi-major axis 35,937.5 km, eccentricity 0.8087, inclination 63.4 deg, argument of\n# perigee 270 deg). Near perigee the user is below the GNSS shells and sees the satellites over the Earth's limb; near\n# apogee (about 58,000 km altitude) it is far above them and hears only the signals that pass the opposite limb. A nadir\n# high-gain antenna and a zenith patch antenna are both fitted (table B10 of the booklet); each satellite is received on\n# whichever gives the higher gain.\n#\n# The transmit pattern is the parametric shaped-beam-plus-sidelobe stand-in, so signals that come through sidelobes are\n# counted and reported apart from main-lobe ones; the booklet's own model has no sidelobes. The [atmosphere] table switches on\n# the limb-ray medium (ionosphere, plasmasphere, and the neutral atmosphere's absorption and defocusing on rays that graze it),\n# which costs some of the weakest links and gives the slant TEC, the plasmaspheric part of it and the delay.\n#\n# MODELLED: the pattern is representative, not measured; the medium is a stated simple model (docs/SSV.md).\n\nkind = \"gnss-ssv\"\nname = \"HEO, high-gain nadir and patch zenith antennas, parametric sidelobes, limb medium\"\n\n[constellations]\ninclude = [\"gps\", \"glonass\", \"galileo\", \"bds\"]\nbands = [\"l1\", \"l5\"]\n\n[transmit]\npattern = \"parametric\"\n\n[receiver]\ncn0_min_dbhz = 20.0\n\n[atmosphere]\n\n[trajectory]\npreset = \"heo\"\nduration_periods = 1.0\nstep_min = 10.0\nantennas = [\"booklet-high-gain-nadir\", \"booklet-patch-zenith\"]\nseries_every_min = 60.0\n", "gnss-ssv-lunar-weak.toml": "# GNSS on a lunar transfer, with a weak-signal receiver that earns its sensitivity.\n#\n# A two-body outbound ellipse from a 185 km perigee to the Moon's distance. Beyond about 10 earth radii the signals are below\n# 20 dB-Hz; whether a receiver can use them depends on its design, so the threshold here is not a number but a receiver: a\n# 100 ms coherent integration on a pilot channel, 100 non-coherent sums, an Earth-orbit-aided Doppler search of +/-200 Hz over a\n# 50-chip code window, and a carrier loop of 1 Hz once the dynamics are aided away. The model derives the C/N0 at which such\n# a receiver acquires (detection 0.9 at a total false-alarm probability of 1e-3) and applies it as the availability threshold.\n#\n# A trajectory in the booklet's lunar case is a propagated one; this is a Keplerian stand-in with the same endpoints, so its\n# availability is indicative. MODELLED throughout.\n\nkind = \"gnss-ssv\"\nname = \"Lunar transfer, weak-signal receiver, parametric sidelobes\"\n\n[constellations]\ninclude = [\"gps\", \"galileo\", \"glonass\", \"bds\"]\nbands = [\"l1\", \"l5\"]\n\n[transmit]\npattern = \"parametric\"\n\n[receiver]\napply = \"acquisition\"\n\n[receiver.weak_signal]\nt_coh_s = 0.1\nn_noncoherent = 100.0\npilot_or_data_wipe = true\npfa_total = 1.0e-3\npd = 0.9\ndoppler_uncertainty_hz = 200.0\ncode_window_chips = 50.0\npll_bn_hz = 1.0\npll_t_s = 0.02\ndoppler_rate_hz_per_s = 0.05\n\n[trajectory]\npreset = \"lunar-transfer\"\nduration_min = 3600.0\nstep_min = 30.0\nantennas = [\"booklet-high-gain-nadir\"]\nseries_every_min = 240.0\n", "gnss-ssv-nav-lunar.toml": "# Onboard GNSS navigation on the way to the Moon: an extended Kalman filter on pseudoranges alone.\n#\n# The spacecraft leaves a 185 km parking orbit on a two-body transfer ellipse to the Moon's distance (perigee to apogee,\n# about 3.5 days). The filter has nine states: position, velocity, receiver clock bias and drift, and a solar-radiation-\n# pressure scale. Its dynamics are point-mass gravity, J2 and the Sun and Moon as third bodies; the true trajectory adds\n# radiation pressure with the Earth's shadow, which the filter has to estimate. Receive antennas are the booklet's high-gain\n# nadir antenna and zenith patch; the 20 dB-Hz threshold is the booklet's, so past a few tens of thousands of kilometres\n# few signals are left and the filter coasts on its dynamics. The result separates the part of the run inside the GNSS\n# orbits from the part above them, reports the longest gap with no measurement, and checks the covariance against the\n# error (mean NEES, 3 for a consistent filter).\n#\n# MODELLED: simulated truth and noise, low-precision circular Sun and Moon, no thrust or manoeuvres, no flight data.\n\nkind = \"gnss-ssv\"\nname = \"Lunar transfer, onboard GNSS EKF (reduced length)\"\n\n[constellations]\ninclude = [\"gps\", \"glonass\", \"galileo\", \"bds\"]\nbands = [\"l1\", \"l5\"]\n\n[receiver]\ncn0_min_dbhz = 20.0\n\n[navigation]\npreset = \"lunar-transfer\"\nduration_min = 1440.0\nstep_s = 300.0\nantennas = [\"booklet-high-gain-nadir\", \"booklet-patch-zenith\"]\nseries_every_min = 120.0\n", "gnss-ssv-shell.toml": "# GNSS signal availability on the upper-SSV shell: the booklet's global metric, at a size that runs in a second.\n#\n# The ICG Space Service Volume booklet (UN ST/SPACE/75, 2018) characterises each constellation by the share of time a user\n# on a sphere at 36,000 km altitude (the top of the upper SSV) has at least one, and at least four, signals, and by the\n# longest outage at the worst point of the sphere. This scenario computes the same metric by the same method (annex B):\n# Keplerian orbits of annex C, the main lobe of each transmitter modelled as a constant minimum radiated power inside the\n# documented off-boresight angle, a nadir-pointing hemispherical user antenna, Earth blockage by the sphere plus 50 km, and a\n# 20 dB-Hz C/N0 threshold for a 0 dBi user antenna.\n#\n# It is cut down to run quickly: a 162-point grid (the booklet uses 2,562) and 3 days at 10-minute steps (the booklet uses 14\n# days at 1 minute). The full-size comparison with the booklet's tables is the pre-registered check in xval/gnss-ssv/.\n# MODELLED: the booklet's own results are a simulation, and a main-lobe-only constant-power beam is not a measured pattern.\n\nkind = \"gnss-ssv\"\nname = \"Upper SSV shell, 20 dB-Hz (reduced size)\"\n\n[constellations]\ninclude = [\"gps\", \"glonass\", \"galileo\", \"bds\"]\nbands = [\"l1\", \"l5\"]\n\n[receiver]\ncn0_min_dbhz = 20.0\n\n[shell]\naltitude_km = 36000.0\nantenna = \"hemisphere\"\ngrid_levels = 2\nduration_min = 4320.0\nstep_min = 10.0\n", "gps-denied-gravity-nav-egm2008.toml": "# 60-minute GPS-denied gravity-map-matching benchmark on the REAL gravity field (WP-10, RM-17).\n#\n# Every parameter is `gps-denied-gravity-nav.toml`'s, unchanged: the same track, drift,\n# gravimeter, map sigma, search and noise seed. The synthetic trend and mascons are replaced by\n# the gravity anomaly synthesised from the bundled EGM2008 coefficients to degree 70 (WGS84,\n# zero-degree term on). That synthesis is checked against the ICGEM Calculation Service to\n# about 1e-8 mGal (tests/icgem_gravity_anomaly_oracle.rs). The navigation outcome has no\n# external oracle. Its bars and the prediction were pre-registered in\n# xval/icgem-egm2008/PREREGISTRATION.md before the first run; the outcome is in RESULTS.md\n# there.\n#\n# Degree 70 resolves features no shorter than about 285 km (half-wavelength), much smoother\n# than the synthetic mascons (sigma about 30 km), so the drift is only weakly observable.\n\n# Dispatched by the scenario engine as `kind = \"gravity-map\"`.\nkind = \"gravity-map\"\n\n# Unused when `reference` is set (the synthetic field is replaced); kept at the benchmark value.\nnmax = 3\n\n# Track flown GPS-denied: 90 waypoints, 40 s gravimeter averaging each ⇒ 3600 s = 60 min.\n# An oblique leg keeps the scalar gravimeter sequence observable in both north and east.\nstart_lat_deg = 10.0\nstart_lon_deg = 20.0\nstep_lat_deg = 0.06\nstep_lon_deg = 0.045\nwaypoints = 90\n\n# True constant INS position drift accumulated over the one-hour outage (≈ 70 km at ~13° lat,\n# i.e. far past the 10 km the matched solution must beat).\ndrift_lat_deg = 0.5\ndrift_lon_deg = -0.4\n\n# Cold-atom gravimeter: 1e-7 m/s²/√Hz ASD (≈10 µGal/√Hz), 40 s averaging ⇒ σ ≈ 1.6e-3 mGal.\ngravimeter_asd = 1.0e-7\naveraging_time_s = 40.0\n\n# Map/representation error (mGal): combined with the sensor white noise into the matching σ.\nmap_sigma_mgal = 2.0\n\n# Hierarchical offset search: ±0.8° at 0.08° to start, then three coarse-to-fine stages each\n# shrinking the window and step 8× ⇒ final offset resolution 0.08° / 8² ≈ 140 m.\nsearch_half_deg = 0.8\nsearch_step_deg = 0.08\nrefine_stages = 3\nrefine_factor = 8.0\nnoise_seed = 1\n\n# The real reference field: bundled EGM2008, degree 70, sampled on a 0.02 deg grid.\n[reference]\nmodel = \"egm2008\"\nnmax = 70\nellipsoid = \"wgs84\"\nzero_degree = true\ngrid_step_deg = 0.02\n", "gps-denied-gravity-nav.toml": "# 60-minute GPS-denied gravity-map-matching benchmark (quantum alt-PNT).\n#\n# The validation-grade form of `gravity-map-nav.toml`: a vehicle flies a ~700 km track for\n# a full one-hour GNSS outage, its inertial solution drifting to ≈ 70 km of position error.\n# A cold-atom gravimeter samples the gravity anomaly along the track (with its real, seeded\n# white-noise floor injected), and a hierarchical coarse-to-fine particle/grid matcher\n# recovers the constant INS drift to a few hundred metres — the < 500 m GPS-denied target\n# of ESA NAVISP's \"Quantum Wayfarer\" gravity-aided navigation.\n#\n# Consumed by `kshana::gravimeter::run_gps_denied_gravity_nav` (and its unit tests). The\n# reference field is a low-degree spherical-harmonic trend plus synthetic mascons; Kshana\n# does not bundle the full EGM2008 coefficient set, and a Monte-Carlo over map-representation\n# error realisations is a documented follow-on (see docs/CAPABILITY.md).\n\n# Dispatched by the scenario engine as `kind = \"gravity-map\"` (also consumed directly by\n# `run_gps_denied_gravity_nav` in the unit tests, which ignore this field).\nkind = \"gravity-map\"\n\n# Maximum spherical-harmonic degree/order of the reference field.\nnmax = 3\n\n# Track flown GPS-denied: 90 waypoints, 40 s gravimeter averaging each ⇒ 3600 s = 60 min.\n# An oblique leg keeps the scalar gravimeter sequence observable in both north and east.\nstart_lat_deg = 10.0\nstart_lon_deg = 20.0\nstep_lat_deg = 0.06\nstep_lon_deg = 0.045\nwaypoints = 90\n\n# True constant INS position drift accumulated over the one-hour outage (≈ 70 km at ~13° lat,\n# i.e. far past the 10 km the matched solution must beat).\ndrift_lat_deg = 0.5\ndrift_lon_deg = -0.4\n\n# Cold-atom gravimeter: 1e-7 m/s²/√Hz ASD (≈10 µGal/√Hz), 40 s averaging ⇒ σ ≈ 1.6e-3 mGal.\ngravimeter_asd = 1.0e-7\naveraging_time_s = 40.0\n\n# Map/representation error (mGal): combined with the sensor white noise into the matching σ.\nmap_sigma_mgal = 2.0\n\n# Hierarchical offset search: ±0.8° at 0.08° to start, then three coarse-to-fine stages each\n# shrinking the window and step 8× ⇒ final offset resolution 0.08° / 8² ≈ 140 m.\nsearch_half_deg = 0.8\nsearch_step_deg = 0.08\nrefine_stages = 3\nrefine_factor = 8.0\nnoise_seed = 1\n\n# Low-degree anomalous, fully-normalised coefficients (the always-on regional trend).\n[[coeffs]]\nn = 2\nm = 0\ncbar = 6.0e-6\nsbar = 0.0\n\n[[coeffs]]\nn = 3\nm = 1\ncbar = 3.0e-6\nsbar = 2.0e-6\n\n# Localized Gaussian anomalies (mascons) the track crosses — the distinctive high-degree\n# features that make the constant drift observable.\n[[mascons]]\nlat_deg = 11.0\nlon_deg = 20.8\namp_mgal = 45.0\nsigma_deg = 0.30\n\n[[mascons]]\nlat_deg = 12.4\nlon_deg = 21.9\namp_mgal = -38.0\nsigma_deg = 0.28\n\n[[mascons]]\nlat_deg = 13.8\nlon_deg = 23.0\namp_mgal = 50.0\nsigma_deg = 0.32\n", "gravity-map-error-mc.toml": "# Map-error Monte Carlo on the 60-minute GPS-denied gravity-map benchmark (WP-10, RM-15).\n#\n# Every parameter is `gps-denied-gravity-nav.toml`'s, unchanged. The `[map_error_mc]` block\n# then reruns the benchmark over seeded realisations of a Gaussian-correlated error added to\n# the STORED map (the gravimeter still measures the true field): realisation k uses map-error\n# seed `seed + k` and gravimeter-noise seed `noise_seed + k`. The document adds a\n# `map_error_mc` block with the distribution of the matched error (mean, median, 95th\n# percentile, max, and the fraction within `target_m`). The single-run fields are the\n# benchmark's own, with no map error. MODELLED: the error statistics are an assumption, not\n# a survey's.\n\n# Dispatched by the scenario engine as `kind = \"gravity-map\"` (also consumed directly by\n# `run_gps_denied_gravity_nav` in the unit tests, which ignore this field).\nkind = \"gravity-map\"\n\n# Maximum spherical-harmonic degree/order of the reference field.\nnmax = 3\n\n# Track flown GPS-denied: 90 waypoints, 40 s gravimeter averaging each ⇒ 3600 s = 60 min.\n# An oblique leg keeps the scalar gravimeter sequence observable in both north and east.\nstart_lat_deg = 10.0\nstart_lon_deg = 20.0\nstep_lat_deg = 0.06\nstep_lon_deg = 0.045\nwaypoints = 90\n\n# True constant INS position drift accumulated over the one-hour outage (≈ 70 km at ~13° lat,\n# i.e. far past the 10 km the matched solution must beat).\ndrift_lat_deg = 0.5\ndrift_lon_deg = -0.4\n\n# Cold-atom gravimeter: 1e-7 m/s²/√Hz ASD (≈10 µGal/√Hz), 40 s averaging ⇒ σ ≈ 1.6e-3 mGal.\ngravimeter_asd = 1.0e-7\naveraging_time_s = 40.0\n\n# Map/representation error (mGal): combined with the sensor white noise into the matching σ.\nmap_sigma_mgal = 2.0\n\n# Hierarchical offset search: ±0.8° at 0.08° to start, then three coarse-to-fine stages each\n# shrinking the window and step 8× ⇒ final offset resolution 0.08° / 8² ≈ 140 m.\nsearch_half_deg = 0.8\nsearch_step_deg = 0.08\nrefine_stages = 3\nrefine_factor = 8.0\nnoise_seed = 1\n\n# Low-degree anomalous, fully-normalised coefficients (the always-on regional trend).\n[[coeffs]]\nn = 2\nm = 0\ncbar = 6.0e-6\nsbar = 0.0\n\n[[coeffs]]\nn = 3\nm = 1\ncbar = 3.0e-6\nsbar = 2.0e-6\n\n# Localized Gaussian anomalies (mascons) the track crosses — the distinctive high-degree\n# features that make the constant drift observable.\n[[mascons]]\nlat_deg = 11.0\nlon_deg = 20.8\namp_mgal = 45.0\nsigma_deg = 0.30\n\n[[mascons]]\nlat_deg = 12.4\nlon_deg = 21.9\namp_mgal = -38.0\nsigma_deg = 0.28\n\n[[mascons]]\nlat_deg = 13.8\nlon_deg = 23.0\namp_mgal = 50.0\nsigma_deg = 0.32\n\n# 20 map-error realisations: 2 mGal 1-sigma (the matcher's own map_sigma_mgal budget), with\n# a correlation length of 0.2 deg (about 22 km, the scale of the mascons it corrupts), on a\n# 0.02 deg error lattice (a tenth of that length).\n[map_error_mc]\nrealisations = 20\nsigma_mgal = 2.0\ncorrelation_length_deg = 0.2\ngrid_step_deg = 0.02\nseed = 1\ntarget_m = 500.0\n", "gravity-map-nav.toml": "# Quantum gravity-map-matching navigation scenario (GPS-denied alt-PNT).\n#\n# Targets ESA NAVISP \"Quantum Wayfarer\" / QT-CCI gravity-map-matching vocabulary: a\n# vehicle with an inertial unit and a cold-atom-interferometer gravimeter navigates with\n# no GNSS by matching the gravity-anomaly signature it flies through against a stored\n# reference field. The reference field is a low-degree spherical-harmonic anomaly plus\n# synthetic mascons — Kshana does not bundle the full EGM2008 coefficient set (see\n# docs/CAPABILITY.md).\n#\n# This is a runnable scenario kind: the CLI dispatches `kind = \"gravity-map\"` to\n# `kshana::gravimeter::run_gps_denied_gravity_nav` (the validation-grade noisy/refined\n# form) and emits JSON + an SVG drift chart (free-inertial vs gravity-matched error).\n# The same config also backs `run_gravity_map_benchmark` (the noise-free geometric-\n# observability benchmark) and its unit test, which read this file directly.\nkind = \"gravity-map\"\n\n# Maximum spherical-harmonic degree/order of the reference field.\nnmax = 3\n\n# Track flown GPS-denied: an oblique leg so the scalar gravimeter sequence is observable\n# in both north and east (a single anomaly measurement only constrains a level set).\nstart_lat_deg = 12.0\nstart_lon_deg = 24.0\nstep_lat_deg = 0.18\nstep_lon_deg = 0.13\nwaypoints = 12\n\n# True constant INS position drift accumulated over the outage (≈ 80 km at ~13° lat).\ndrift_lat_deg = 0.55\ndrift_lon_deg = -0.45\n\n# Cold-atom gravimeter: 1e-7 m/s²/√Hz ASD (≈10 µGal/√Hz), 100 s averaging ⇒ σ ≈ 1e-3 mGal.\ngravimeter_asd = 1.0e-7\naveraging_time_s = 100.0\n\n# Map/representation error (mGal): reference-field inaccuracy + grid quantisation, combined\n# with the sensor white noise into the effective matching σ. Dominates a quantum gravimeter.\nmap_sigma_mgal = 2.0\n\n# Offset search grid (degrees): ±1.0° at 0.05° resolution around the no-drift prior.\nsearch_half_deg = 1.0\nsearch_step_deg = 0.05\n\n# Low-degree anomalous, fully-normalised coefficients (the regional trend).\n[[coeffs]]\nn = 2\nm = 0\ncbar = 4.0e-6\nsbar = 0.0\n\n[[coeffs]]\nn = 3\nm = 1\ncbar = 2.0e-6\nsbar = 1.0e-6\n\n# Localized Gaussian anomalies (mascons) the track crosses — the stand-in for the\n# high-degree EGM features that make gravity-map matching observable.\n[[mascons]]\nlat_deg = 13.0\nlon_deg = 25.0\namp_mgal = 32.0\nsigma_deg = 0.45\n\n[[mascons]]\nlat_deg = 12.6\nlon_deg = 24.6\namp_mgal = -26.0\nsigma_deg = 0.35\n", "holdover-test-example.toml": "# Holdover test, ingestion example: a time-error record scored by the holdover-test kind\n# (\"pull the antenna, score the holdover\"). The record is split at the two times the OPERATOR\n# states, here GNSS removed at 600 s and restored at 2 400 s, and each step is measured against\n# the ITU-T masks written for it.\n#\n# THE DATA BELOW IS NOT A MEASUREMENT. It is a record the engine's author generated for this\n# example (Python random.Random(20261018), 5 s sampling): 600 s of white noise of 1.5 ns about\n# zero while locked; then a holdover of a fractional frequency offset of 1.2e-10 (0.12 ns/s) and\n# a drift of 5e-5 ns/s^2 with a random walk of 0.35 ns per step; then an exponential return to\n# zero with a 60 s time constant. It shows the input shape and what the report does with it. It\n# says nothing about any real clock, and Kshana did not remove or restore anything: the two\n# times are a statement in this file.\n#\n# Give your own record as `samples` (time_s, time_error_ns pairs, uniformly sampled), as\n# `csv_path` on native builds, or as a measured log with `[series.clock_log]` (see\n# scenarios/holdover-test-ptp4l.toml and docs/CLOCK-LOG-FORMATS.md). The report says \"measured\n# against the mask\": it is not a statement that a system conforms to anything.\nkind = \"holdover-test\"\nmasks = [\"prtc-a\", \"eprtc-a-holdover\"]\n\n[test]\ngnss_removed_s = 600.0\ngnss_restored_s = 2400.0\nlocked_duration_days = 5.0\nrecovery_band_ns = 100.0\nrecovery_dwell_s = 60.0\n\n[series]\nsamples = [\n  [0, 0.62], [5, -0.79], [10, 0.58], [15, -2.94], [20, -1.88], [25, -0.03], [30, 0.79], [35, 0.70],\n  [40, 1.12], [45, 0.41], [50, -2.60], [55, -1.34], [60, 0.73], [65, 1.72], [70, 0.98], [75, -0.52],\n  [80, 0.94], [85, -3.06], [90, 1.53], [95, 1.28], [100, 1.84], [105, -0.90], [110, 1.28], [115, -2.78],\n  [120, -3.09], [125, -0.03], [130, 2.68], [135, 1.86], [140, -2.77], [145, 0.26], [150, -2.15],\n  [155, -0.80], [160, 0.47], [165, -2.05], [170, 1.72], [175, -0.91], [180, 1.85], [185, 0.38], [190, -0.75],\n  [195, -3.15], [200, 0.42], [205, 0.30], [210, -0.43], [215, -1.61], [220, 0.60], [225, 4.39], [230, -1.77],\n  [235, 0.30], [240, 1.08], [245, -1.17], [250, 0.81], [255, 2.36], [260, 1.85], [265, -0.63], [270, 0.46],\n  [275, -0.88], [280, 0.80], [285, -0.08], [290, 1.13], [295, 1.03], [300, 0.97], [305, 3.03], [310, -1.65],\n  [315, 1.66], [320, 0.21], [325, 0.71], [330, -1.77], [335, -1.11], [340, 0.10], [345, 0.85], [350, -0.61],\n  [355, -0.02], [360, 1.38], [365, -0.31], [370, -0.59], [375, -1.42], [380, -2.74], [385, 2.01],\n  [390, -1.34], [395, -0.93], [400, 0.42], [405, -1.08], [410, -2.09], [415, 1.96], [420, -0.13],\n  [425, 0.28], [430, 0.37], [435, -0.24], [440, 1.58], [445, -1.07], [450, -0.54], [455, -3.65], [460, 0.46],\n  [465, -0.02], [470, 0.20], [475, -1.49], [480, 0.01], [485, -1.46], [490, 1.10], [495, -2.42], [500, 1.28],\n  [505, 1.01], [510, 0.39], [515, 0.58], [520, 0.27], [525, 0.87], [530, 3.08], [535, -0.49], [540, 1.30],\n  [545, -2.85], [550, 2.27], [555, 0.72], [560, 1.05], [565, 1.79], [570, -1.60], [575, -1.33], [580, -0.25],\n  [585, 1.35], [590, -1.85], [595, -0.68], [600, -0.00], [605, 2.50], [610, 1.50], [615, 8.69], [620, 3.49],\n  [625, 8.05], [630, 6.83], [635, 8.40], [640, 6.58], [645, 7.04], [650, 9.54], [655, 9.05], [660, 10.57],\n  [665, 12.13], [670, 11.84], [675, 11.94], [680, 14.75], [685, 15.44], [690, 12.49], [695, 14.15],\n  [700, 17.28], [705, 15.93], [71