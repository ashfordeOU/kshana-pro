165, 6.599], [1166, 6.889], [1167, 7.386],\n  [1168, 7.622], [1169, 8.068], [1170, 7.996], [1171, 8.139], [1172, 7.789], [1173, 7.978], [1174, 8.190], [1175, 8.398],\n  [1176, 8.364], [1177, 8.383], [1178, 9.037], [1179, 9.335], [1180, 10.334], [1181, 10.099], [1182, 10.280], [1183, 10.132],\n  [1184, 10.105], [1185, 9.588], [1186, 9.964], [1187, 10.450], [1188, 10.637], [1189, 10.664], [1190, 10.431], [1191, 10.154],\n  [1192, 10.083], [1193, 10.254], [1194, 10.254], [1195, 10.277], [1196, 10.841], [1197, 11.186], [1198, 11.325], [1199, 11.156],\n]\n", "terrain-nav.toml": "# Terrain-referenced navigation (TERCOM/SITAN) — GPS-denied alt-PNT.\n#\n# A vehicle flies a known-shape track with no GNSS, its inertial solution drifting to ≈ 70 km\n# of position error. A radar/baro altimeter measures the ground elevation under each waypoint\n# (with its real, seeded white-noise floor injected), and a hierarchical coarse-to-fine\n# particle/grid matcher recovers the constant INS drift to a few hundred metres against a\n# stored digital elevation model — the classic terrain-contour-matching (TERCOM) / Sandia\n# inertial terrain-aided navigation (SITAN) technique, whose published CEP is \"as low as tens\n# of metres\" (en.wikipedia.org/wiki/TERCOM).\n#\n# Consumed by `kshana::altpnt::terrain::run_terrain_nav` (and its unit tests), and dispatched\n# by the scenario engine as `kind = \"terrain-nav\"`. The DEM is the self-contained synthetic\n# fixture (`DemGrid::synthetic_fixture`) — a deterministic multi-Gaussian + tilted-ridge relief\n# field, the terrain analogue of the gravity mascons. A real SRTM tile and a real crustal map\n# are documented follow-ons (see docs/CAPABILITY.md); the recovery is validated against the\n# INDEPENDENTLY injected drift, never the DEM's own value (non-circular).\nkind = \"terrain-nav\"\n\n# Synthetic-DEM seed (jitters the feature placement deterministically).\ndem_seed = 1\n\n# Track flown GPS-denied: 60 waypoints over an oblique leg so the scalar altimeter sequence\n# is observable in both north and east.\nstart_lat_deg = 12.05\nstart_lon_deg = 20.05\nstep_lat_deg = 0.004\nstep_lon_deg = 0.003\nwaypoints = 60\n\n# True constant INS position drift over the outage (≈ 70 km at ~12° lat — far past the 10 km\n# the matched solution must beat).\ndrift_lat_deg = 0.5\ndrift_lon_deg = -0.4\n\n# Radar/baro altimeter 1σ noise (m) and the DEM representation error (m); combined into the\n# matching σ = hypot(altimeter_sigma_m, map_sigma_m).\naltimeter_sigma_m = 8.0\nmap_sigma_m = 15.0\n\n# Hierarchical offset search: ±0.8° at 0.08° to start, then three coarse-to-fine stages each\n# shrinking the window and step 8× ⇒ final offset resolution 0.08° / 8² ≈ 140 m.\nsearch_half_deg = 0.8\nsearch_step_deg = 0.08\nrefine_stages = 3\nrefine_factor = 8.0\nnoise_seed = 1\n", "terrain-slam.toml": "# Sequential (recursive) terrain-referenced navigation — GPS-denied alt-PNT.\n#\n# The recursive counterpart to `terrain-nav`. There, a batch coarse-to-fine matcher recovers\n# a single CONSTANT inertial drift offset over the whole pass. That model breaks when the INS\n# error is not constant but GROWS with time (the realistic case for an unaided strapdown unit\n# during a GNSS outage). Here a particle filter runs the same altimeter-vs-DEM measurement\n# model EPOCH BY EPOCH: at each waypoint the cloud is propagated by the INS-reported increment\n# (itself corrupted by the per-step drift growth), reweighted by the terrain match, and\n# resampled when it degenerates — Sandia inertial terrain-aided navigation (SITAN) as a\n# running estimator, i.e. Monte-Carlo localization against a digital elevation model.\n#\n# Consumed by `kshana::altpnt::sequential::run_sequential_trn` (and its unit tests), and\n# dispatched by the scenario engine as `kind = \"terrain-slam\"`. The DEM is the self-contained\n# synthetic fixture (`DemGrid::synthetic_fixture`) — a 0.5°×0.5° multi-Gaussian + tilted-ridge\n# relief patch over [12.0–12.5, 20.0–20.5]; the track and the particle cloud stay inside it.\n#\n# Scope (honest): the map is KNOWN and FIXED — this is recursive localization against a stored\n# DEM, not joint map estimation (full SLAM). The injected drift ramp is the independent ground\n# truth and every reported error is measured against it, never the DEM's own value\n# (non-circular). A real SRTM tile and a real crustal map remain documented follow-ons\n# (docs/CAPABILITY.md).\nkind = \"terrain-slam\"\n\n# Synthetic-DEM seed (jitters the feature placement deterministically).\ndem_seed = 1\n\n# Track flown GPS-denied: 60 waypoints over an oblique leg (observable north and east),\n# entirely inside the DEM patch (12.08→12.316 lat, 20.08→20.257 lon).\nstart_lat_deg = 12.08\nstart_lon_deg = 20.08\nstep_lat_deg = 0.004\nstep_lon_deg = 0.003\nwaypoints = 60\n\n# True INS drift RATE (deg/waypoint): a linear ramp, zero at the first fix, reaching ≈ 5 km of\n# free-inertial error by the last waypoint — the moving error the recursive filter tracks.\ndrift_rate_lat_deg = 0.0006\ndrift_rate_lon_deg = -0.0005\n\n# Radar/baro altimeter 1σ noise (m) and the DEM representation error (m); combined into the\n# matching σ = hypot(altimeter_sigma_m, map_sigma_m).\naltimeter_sigma_m = 8.0\nmap_sigma_m = 15.0\n\n# Particle filter: cloud size, initial spread around the first INS fix, per-step process noise\n# (must span the per-step drift growth), and the resample-on-degeneracy threshold (fraction of\n# n_particles). Seed drives the deterministic filter / measurement-noise stream.\nn_particles = 4000\ninit_pos_sigma_deg = 0.006\nprocess_sigma_deg = 0.0025\nresample_ess_frac = 0.5\nseed = 1\n", "time-transfer-budget.toml": "# Two-way satellite time and frequency transfer (TWSTFT) between two ILLUSTRATIVE stations, one\n# in central Europe and one in eastern North America, through a geostationary relay at 10 deg W.\n# The run solves the two-way equation for T_A - T_B from the stated equipment, transponder,\n# ionospheric (Ku band, 14/11 GHz) and Sagnac terms. It forms an uncertainty budget whose\n# statistical term is the TDEV, at one day, of a simulated link with white and flicker phase\n# noise and a diurnal non-reciprocity. The delays and uncertainties are illustrative, not any\n# laboratory's calibration. MODELLED. A real UTC-UTC(k) or station-clock series can be added\n# under [[series]] (format circular-t, mjd-csv or rinex-clock) to report its stability.\nkind = \"time-transfer-budget\"\nsatellite_lon_deg = -10.0\ntransponder_ab_ns = 812.0\ntransponder_ba_ns = 809.5\nuplink_ghz = 14.0\ndownlink_ghz = 11.0\ntrue_offset_ns = 12.5\nwhite_noise_ns = 0.3\nflicker_noise_ns = 0.05\ndiurnal_amplitude_ns = 0.2\nreciprocity_bias_ns = 0.0\nstep_s = 300.0\nspan_days = 30.0\naveraging_s = 86400.0\nseed = 2026\n\n[station_a]\nname = \"europe\"\nlat_deg = 50.0\nlon_deg = 10.0\nheight_m = 100.0\ntx_delay_ns = 412.3\nrx_delay_ns = 398.7\nslant_tec_tecu = 30.0\n\n[station_b]\nname = \"north-america\"\nlat_deg = 39.0\nlon_deg = -77.0\nheight_m = 50.0\ntx_delay_ns = 501.9\nrx_delay_ns = 455.2\nslant_tec_tecu = 20.0\n\n[uncertainty]\nstation_calibration_ns = 1.0\nequipment_instability_ns = 0.3\ntransponder_ns = 0.3\nionosphere_ns = 0.02\nsagnac_ns = 0.01\n", "timetransfer.toml": "# Optical inter-satellite time transfer vs classical RF (TWSTFT).\n#\n# Each link is a two-way exchange: the reciprocal (common-mode) path delay\n# cancels in the (m_AB - m_BA)/2 estimate, so the error is the white measurement\n# jitter (`sigma_j_s`) plus the NON-reciprocal differential delay, modelled as a\n# random-walk-FM floor (`q_rw_s`, sigma_y^2(tau) = q_rw*tau/3) — equipment-delay\n# asymmetry and up/down-path variation. The reported `adev_tau0` is the link's\n# Allan deviation at the 1 s base step.\nkind = \"timetransfer\"\nseed = 42\nsamples = 600\nstep_s = 1.0\nrange_spec_mm = 10.0\n\n[link_quantum]\nid = \"optical-isl\"\nprovenance = \"Optical inter-satellite link, picosecond-level synchronization target; free-space optical two-way time-frequency transfer lab floor ~1 fs (Giorgetta 2013, Nature Photonics; Deschenes 2016, PRX). Using a 1 ps target as the on-orbit-credible figure.\"\nsigma_j_s = 1.0e-12\n# NON-reciprocity budget (NOT zero): the differential-delay floor — equipment-delay\n# asymmetry + up/down-path variation that does NOT cancel in the two-way estimate.\n# q_rw=1e-32 => sigma_x ~ 0.6 ps over the session, so the reported sub-mm figure is\n# jitter PLUS a conservative on-orbit non-reciprocity floor, not a jitter-only limit.\nq_rw_s = 1.0e-32\n\n[link_classical]\nid = \"twstft-rf\"\nprovenance = \"Two-way satellite time and frequency transfer (TWSTFT, Ku-band), single-session ~0.5 ns (BIPM/PTB/NIST).\"\nsigma_j_s = 5.0e-10\nq_rw_s = 1.0e-26   # diurnal/differential-delay random-walk floor of an RF link\n", "tip-and-cue-baltic-m2.toml": "# M2 (docs/design/evidence/m2-revisit-tip-and-cue/PREREGISTRATION.md): revisit, full-area refresh and\n# RF-to-optical reaction of a two-layer survey over the Baltic Sea, for the pre-registered primary\n# cases (16 and 32 satellites per layer) and variants V1 to V4, over 7 days at a 10 s step.\n# Readings: xval/m2-revisit-tip-and-cue/README.md. A cross-check of published simulation figures,\n# never a validation. Takes a few seconds in a release build.\nkind = \"tip-and-cue\"\ntitle = \"M2: revisit and tip-and-cue latency over the Baltic Sea\"\narea = \"baltic\"\nstep_s = 10\nspan_days = 7\nm2 = true\n", "tip-and-cue-short.toml": "# A short tip-and-cue run: the M2 primary 16-satellite RF layer cueing its optical layer over the\n# Baltic Sea for 2 days at a 60 s step (fast; for the full pre-registered run see\n# tip-and-cue-baltic-m2.toml). Geometry and timing only; MODELLED.\nkind = \"tip-and-cue\"\ntitle = \"Two-layer survey over the Baltic Sea, 2 days\"\nstep_s = 60\nspan_days = 2\n\n[[cases]]\nname = \"rf-16-optical-16\"\nrf = { total = 16, planes = 8, phasing = 1, node_offset = 0.0 }\nrf_mask_deg = 10.0\noptical = { total = 16, planes = 8, phasing = 1, node_offset = 0.5 }\noptical_off_nadir_deg = 45.0\n", "tracking-loop.toml": "# Tracking-loop loss of lock: C/N0 -> lock/unlock with hysteresis, the time it takes to\n# lose lock, and the spoof pull-in limits set by code and carrier offset RATE.\n#\n# The engine's existing denial and capture criteria are ratios on received power: a jammer\n# denies at J/S = 30 dB and a spoofer captures at J/S = 3 dB. Real loss of lock is not a\n# power ratio. A channel gives up when its loops can no longer hold the signal, and that\n# depends on the loop noise bandwidth, the predetection integration time, the correlator\n# spacing and the dynamics the loop is being asked to follow.\n#\n# This scenario computes that, and reports the denial radius it implies ALONGSIDE the\n# power-ratio radius, with the difference named (denial.denial_radius_delta_km). Neither\n# number replaces the other.\n#\n# Rules applied, both stated in the report rather than buried:\n#   carrier: 3*sigma_PLL + theta_e <= 45 deg  (the 15-degree Costas rule, three-sigma form)\n#   code:    3*sigma_DLL + ramp lag <= d/2 chips (the discriminator's linear half-range)\n#\n# Hysteresis is DERIVED, not asserted: re-lock is the same rule evaluated with the wider\n# bandwidth a receiver re-pulls-in at, so the width must fall between 5*log10(ratio) and\n# 10*log10(ratio) dB. The ratio itself is a modelled design choice.\n#\n# Every loop parameter below is a MODELLED representative band figure, not a datasheet.\nkind = \"tracking-loop\"\n\n# --- loop geometry -----------------------------------------------------------------\n# A 10 Hz Costas carrier loop and a 1 Hz carrier-aided code loop, 1 ms coherent\n# integration (one C/A code period, so no data-bit synchronisation is assumed), narrow\n# 0.5 chip correlator.\npll_bandwidth_hz = 10.0\ndll_bandwidth_hz = 1.0\npredetection_integration_s = 0.001\ncorrelator_spacing_chips = 0.5\ncarrier_allowance_deg = 45.0\n# code_allowance_chips defaults to half the correlator spacing.\n\n# Re-pull-in runs at twice the tracking bandwidth. This is the design choice that sets the\n# hysteresis width; no physics fixes it, so it is an explicit input.\npullin_bandwidth_ratio = 2.0\n\n# Lock-detector confirmation dwells, in epochs (1 ms each here): 50 ms to declare loss,\n# 200 ms of clean signal to declare recovery.\ndrop_confirm_epochs = 50\nrelock_confirm_epochs = 200\n\n# Dynamics the loop must follow while tracking. Zero here: a static user, so the whole\n# carrier budget is available to thermal jitter and the spoofer.\ndoppler_rate_hz_per_s = 0.0\ncode_slew_chips_per_s = 0.0\n\n# --- the C/N0 profile the lock detector is driven over ------------------------------\n# A linear ramp from 45 dB-Hz down to 15 dB-Hz over 60 s, then back up over 60 s. The\n# down leg gives the time to lose lock; the up leg shows the hysteresis as a recovery\n# that happens later and at a higher C/N0 than the drop.\ncn0_high_dbhz = 45.0\ncn0_low_dbhz = 15.0\nramp_duration_s = 60.0\n\n# C/N0 values the jitter / cycle-slip table is tabulated at.\njitter_table_cn0_dbhz = [45.0, 40.0, 35.0, 30.0, 27.5, 25.0, 22.5, 20.0]\n\n# --- the jammer link both denial radii are evaluated on -----------------------------\n# A 10 W broadband jammer against a zenith GPS L1 C/A signal at the IS-GPS-200 minimum\n# received power, 290 K system noise temperature, 0 dBi everywhere. The same radiometry\n# the `jamming` kind uses; this scenario only inverts it for a radius.\njammer_power_dbw = 10.0\njammer_gain_dbi = 0.0\nrx_gain_toward_jammer_db = 0.0\nrx_gain_toward_sat_db = 0.0\nsignal_power_dbw = -158.5\ntemp_k = 290.0\nfreq_hz = 1575420000.0\nchip_rate_hz = 1023000.0\njammer_type = \"broadband\"\n\n# The EXISTING power-ratio criteria, reported unchanged next to the loop-dynamics answer.\ndenial_js_threshold_db = 30.0\ncapture_js_threshold_db = 3.0\n\n# --- the spoof pull-in map ------------------------------------------------------------\n# A spoofer captures by slewing the victim's code and carrier away from truth. Too slow\n# and it never moves the victim anywhere useful; too fast and it outruns the victim's\n# loops, which is what makes this a RATE condition and not a power ratio.\nspoof_code_slew_chips_per_s = [0.1, 0.5, 1.0, 2.0, 5.0]\nspoof_doppler_rate_hz_per_s = [1.0, 10.0, 40.0, 100.0, 500.0]\n", "xona-pulsar-end-to-end.toml": "# Xona Pulsar end to end: the public X5 signal -> a Pulsar pass -> a LEO navigation message\n# -> GPS + Galileo + Pulsar fused fix and precise point positioning convergence.\n#\n# Every Pulsar number is public: Leclere, Marathe and Reid, \"Insights into Xona Pulsar LEO\n# PNT\", ION GNSS+ 2025, https://arxiv.org/abs/2509.19551 (X5 at 1190.51625 MHz, 10.23 Mchip/s,\n# data and pilot in quadrature with a 50/50 split, received power -144.9 to -136.2 dBW;\n# 258 satellites in 18 planes at about 1080 km, inclined 53 deg and polar 97 deg shells).\n#\n# - Signal: the `xona-x5` design from data/leo-signals/xona-pulsar.toml.\n# - Pass: a maritime user in the Bay of Biscay watches a Pulsar satellite of the inclined\n#   shell peak at 70 deg. The band is the link preset's X5 (flat pattern, the EIRP that\n#   delivers the published minimum power at 10 deg), carrying the X5 design.\n# - Navigation message: the Pulsar broadcast-ephemeris model is not public (the brief marks\n#   it UNCONFIRMED), so the message is Kshana's Galileo Keplerian set with along-track,\n#   cross-track and radial corrections, fitted every 300 s; 0.25 m of orbit-determination and\n#   clock error is added as a representative decimetre-level figure (not a Xona figure).\n# - Positioning: GPS and Galileo with the Pulsar inclined shell (192 satellites, 12 planes).\n# - Precise point positioning (PPP): GPS and Galileo alone and with both Pulsar shells.\n#\n# MODELLED: every stage keeps its own label.\nkind = \"leo-pnt-chain\"\nname = \"Xona Pulsar end to end\"\nseed = 9\nsignal_design = \"xona-x5\"\nod_sisre_m = 0.25\n\n[signal]\npresets = [\"xona-pulsar\"]\n\n[pass]\nepoch = \"2026-09-28T10:00:00\"\nduration_s = 1200.0\nstep_s = 5.0\n\n[pass.user]\nenvironment = \"maritime\"\nlat_deg = 45.5\nlon_deg = -5.0\nheight_m = 10.0\nspeed_m_s = 8.0\nheading_deg = 90.0\n\n[[pass.satellite]]\nid = \"Pulsar-pass\"\nsystem = \"xona-pulsar\"\nbands = [\"X5\"]\naltitude_km = 1080.0\ninclination_deg = 53.0\nmax_elevation_deg = 70.0\ntca_s = 600.0\n\n[[pass.satellite.band]]\nname = \"X5\"\nsignal = \"xona-x5\"\n\n[pass.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n\n[navmsg.message]\nmodel = \"kepler-rac\"\nfit_interval_s = 300.0\n\n[navmsg.trade]\nspan_s = 1200.0\n\n[fusion]\nmode = \"joint\"\nduration_s = 1800.0\nstep_s = 30.0\n\n[fusion.user]\nlat_deg = 45.5\nlon_deg = -5.0\nheight_m = 10.0\n\n[fusion.joint]\nmax_leo_sweep = 8\n\n[[fusion.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\n\n[[fusion.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\n\n[[fusion.system]]\nname = \"Pulsar X5\"\nrole = \"leo\"\nisb_ns = 40.0\n\n[[fusion.system.shell]]\ntotal = 192\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[ppp]\nduration_s = 1800.0\nstep_s = 10.0\nruns = 2\n\n[[ppp.site]]\nlat_deg = 45.5\nlon_deg = -5.0\n\n[[ppp.gnss]]\nname = \"GPS\"\npreset = \"gps-baseline\"\nmask_deg = 7.0\n\n[[ppp.gnss]]\nname = \"Galileo\"\npreset = \"galileo\"\nmask_deg = 7.0\n\n[[ppp.case]]\nname = \"Pulsar 258\"\n\n[[ppp.case.system]]\nname = \"Pulsar inclined\"\nmask_deg = 7.0\n\n[[ppp.case.system.shell]]\ntotal = 192\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[[ppp.case.system]]\nname = \"Pulsar polar\"\nmask_deg = 7.0\n\n[[ppp.case.system.shell]]\ntotal = 66\nplanes = 6\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 97.0\n", "xona-pulsar-signals.toml": "# Xona Pulsar signals: the X1 (L1 band) and X5 (L5 band) signals of a commercial low\n# Earth orbit (LEO) positioning, navigation and timing (PNT) constellation, from their\n# published signal table (Leclère, Marathe and Reid, ION GNSS+ 2025,\n# https://arxiv.org/abs/2509.19551), as the compiled-in `xona-pulsar` preset.\n#\n# The questions: how precisely can a receiver range on each signal at its minimum\n# received power; how large is the acquisition search from 1080 km, where the Doppler\n# reaches the 32 to 34 kHz the paper reports; and how much does each signal overlap the\n# GNSS signals near it? X5 sits at 1190.51625 MHz, inside the Galileo E5 band, so its\n# spectral separation coefficient (SSC) into Galileo E5a, E5b and AltBOC and into GPS L5\n# is the compatibility figure that matters; X1 sits 17.9 MHz above the GPS L1 carrier.\n#\n# Received power: the published minimum (X1 -148.2 dBW, X5 -144.9 dBW) against a 290 K\n# antenna and a 2 dB noise figure (floor -201.98 dBW/Hz), so the reference\n# carrier-to-noise density (C/N0) is about 53.8 and 57.1 dB-Hz. The enhanced Feher QPSK\n# spectrum is drawn with the rectangular-chip BPSK envelope, as the preset states.\n# MODELLED: the closed forms underneath are validated; the design approximations are not.\nkind = \"leo-signal\"\npresets = [\"xona-pulsar\"]\n\n[receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ncn0_dbhz = [35.0, 40.0, 45.0, 50.0, 55.0, 60.0]\nreference_cn0_dbhz = 45.0\nloop_bandwidth_hz = 1.0\nintegration_time_s = 0.02\ncorrelator_spacings_chips = [1.0, 0.5, 0.2, 0.1]\nreference_spacing_chips = 0.5\n\n[acquisition]\nelevation_mask_deg = 0.0\noscillator_ppm = 0.5\ncoherent_ms = 1.0\nnoncoherent = 1\npfa_cell = 1e-4\n\n[compatibility]\ngnss_aggregate_satellites = 1.0\n\n[trade]\nreference_signal = \"xona-x5\"\nslant_tec_tecu = 50.0\nslant_range_km = 1500.0\n"}
