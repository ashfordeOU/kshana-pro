 delay       501\nptp4l[3860.000]: master offset          0 s2 freq +  1202 path delay       502\nptp4l[3865.000]: master offset         -2 s2 freq +  1203 path delay       500\nptp4l[3870.000]: master offset         -5 s2 freq +  1204 path delay       501\nptp4l[3875.000]: master offset          2 s2 freq +  1200 path delay       502\nptp4l[3880.000]: master offset          1 s2 freq +  1201 path delay       500\nptp4l[3885.000]: master offset         -1 s2 freq +  1202 path delay       501\nptp4l[3890.000]: master offset          2 s2 freq +  1203 path delay       502\nptp4l[3895.000]: master offset          0 s2 freq +  1204 path delay       500\nptp4l[3900.000]: master offset         -3 s2 freq +  1200 path delay       501\nptp4l[3905.000]: master offset          0 s2 freq +  1201 path delay       502\nptp4l[3910.000]: master offset          2 s2 freq +  1202 path delay       500\nptp4l[3915.000]: master offset         -2 s2 freq +  1203 path delay       501\nptp4l[3920.000]: master offset         -2 s2 freq +  1204 path delay       502\nptp4l[3925.000]: master offset         -1 s2 freq +  1200 path delay       500\nptp4l[3930.000]: master offset          0 s2 freq +  1201 path delay       501\nptp4l[3935.000]: master offset          4 s2 freq +  1202 path delay       502\nptp4l[3940.000]: master offset          4 s2 freq +  1203 path delay       500\nptp4l[3945.000]: master offset          0 s2 freq +  1204 path delay       501\nptp4l[3950.000]: master offset          0 s2 freq +  1200 path delay       502\nptp4l[3955.000]: master offset          2 s2 freq +  1201 path delay       500\nptp4l[3960.000]: master offset          0 s2 freq +  1202 path delay       501\nptp4l[3965.000]: master offset          2 s2 freq +  1203 path delay       502\nptp4l[3970.000]: master offset         -2 s2 freq +  1204 path delay       500\nptp4l[3975.000]: master offset         -1 s2 freq +  1200 path delay       501\nptp4l[3980.000]: master offset         -4 s2 freq +  1201 path delay       502\nptp4l[3985.000]: master offset         -1 s2 freq +  1202 path delay       500\nptp4l[3990.000]: master offset          0 s2 freq +  1203 path delay       501\nptp4l[3995.000]: master offset          2 s2 freq +  1204 path delay       502\n\"\"\"\n", "hybrid-optical-rf.toml": "# Heterogeneous optical + RF PNT joint availability / precision / integrity (P5).\n#\n# Composes the Phase-7 pieces into one end-to-end analysis:\n#   * L26 optical link budget  -> photon-limited two-way ranging CRLB + diffraction footprint\n#   * L22 cross-modality RAIM   -> position AND timing protection level (loose RF x tight optical)\n#   * L24 optical availability  -> N-station clear-sky diversity (independent + correlated union)\n#   * L23 optical<->RF handoff  -> proven bit-continuous (no-jump) mean + NEES chi-square gate\n#   * L25 joint FoM             -> P(available AND precision-grade AND integrity-assured)\n#\n# MODELLED. Validated closed forms: ranging CRLB (sigma_tau/sqrt(N)), diffraction footprint\n# (lambda/D * range), chi-square protection-level quantile, union combinatorics, handoff\n# mean-continuity + NEES gate, and the joint independent product. The loss allocations,\n# sigma magnitudes, cloud-climatology inputs, correlations and P_HMI budget are Modelled\n# representative inputs. Every field below is optional and shown at its default.\nkind = \"hybrid-optical-rf\"\n\n# --- L26 optical (1550 nm) two-way link budget ---\nwavelength_nm      = 1550.0     # telecom C-band, eye-safe, low atmospheric loss\ntx_power_w         = 1.0e-3     # 1 mW mean optical power (photon-starved lunar regime)\ntx_aperture_m      = 0.85       # -> ~0.7 km diffraction footprint at lunar range (lambda/D)\nrx_aperture_m      = 0.85\nrange_km           = 384000.0   # mean Earth-Moon distance\npulse_rms_ps       = 50.0       # signal-pulse RMS temporal width\nintegration_s      = 1.0\natmospheric_loss_db = 3.0       # Modelled 1550 nm clear-sky allocation\npointing_loss_db    = 3.0       # Modelled terminal pointing/jitter allocation\noptics_efficiency   = 0.5       # Modelled\ndetector_efficiency = 0.7       # Modelled\ntwo_way             = true      # round-trip ranging: range = c*dt/2, double-pass geometry\n\n# --- RF (loose) reference solution ---\nrf_pos_sigma_m      = 1.0       # horizontal 1-sigma\nrf_vertical_sigma_m = 1.5       # vertical 1-sigma (vertical dilution)\nrf_clock_sigma_s    = 3.0e-9    # 3 ns clock 1-sigma\n\n# --- L22 cross-modality RAIM ---\np_fa              = 1.0e-5\np_md              = 1.0e-3\nalert_limit_h_m   = 10.0\nalert_limit_v_m   = 15.0\nalert_limit_t_s   = 20.0e-9\n\n# --- precision grade (the high-grade service the FoM scores) ---\ngrade_pos_m  = 0.1              # 10 cm position grade\ngrade_time_s = 1.0e-9           # 1 ns timing grade\n\n# --- L24 optical ground-network availability ---\nn_optical_sites  = 5\nsite_correlation = 0.15         # representative modest spatial (weather) correlation\n\n# --- L25 joint FoM + L23 handoff ---\nfom_correlation   = 0.5         # positive co-occurrence of the three P5 conditions\nhandoff_inflation = 0.2         # modality-transition covariance inflation at the switch\np_hmi             = 1.0e-7      # integrity-risk budget\n\n# --- G15 bias / ramp fault injection against the cross-modality monitor ---\n# The minimum detectable bias and the detection-power curve are ANALYTIC (non-central\n# chi-square inversion), so they need no inputs of their own. These two only set the ramp\n# rate the reported time-to-detect is a rate conversion of. Both MODELLED.\nfault_ramp_rate_pos_m_s   = 0.05      # position-axis bias growth (m/s)\nfault_ramp_rate_clock_s_s = 1.0e-11   # clock-axis bias growth (s/s)\n\n# --- G17 post-handover coast: process noise and the alert-limit crossing ---\n# Random walk on the existing 4-state (east, north, up, clock) handoff filter. The alert\n# limits are the ones already declared above; only the process noise and the coverage\n# factor are new. Both PSDs are MODELLED representative inputs and the crossing times\n# scale directly with them.\nprocess_noise_pos_psd_m2_s   = 1.0e-3   # 1 m (1-sigma) of unmodelled growth per 1000 s, per axis\nprocess_noise_clock_psd_s2_s = 1.0e-22  # white-FM phase random walk at sigma_y(1 s) = 1e-11\n# coast_coverage_k                      # default Phi^-1(1 - P_HMI/2) = 5.327; uncomment to override\n\n# --- G16 RF link leg: availability, and the like-for-like ranging comparison ---\n# The RF side of a hybrid service needs its own link, and this is it. Both the RF\n# availability block (A_rf = I_closure * I_track over the Eb/N0 margin and the tracking\n# threshold) and the RF leg of the optical-versus-RF ranging ratio are evaluated from\n# exactly these values, at the range_km and integration_s already declared above, so the\n# two modalities can never be compared at different operating points.\nrf_band                     = \"x\"       # s | x | ka -> the CCSDS-401 / DSN-810-005 band centre\nrf_eirp_dbw                 = 26.0      # MODELLED: the lunar augmented-forward-signal EIRP\nrf_g_over_t_db              = 53.0      # MODELLED: DSN 34 m beam-waveguide X-band figure of merit\nrf_other_losses_db          = 3.0       # MODELLED: lumped pointing/polarisation/atmosphere/implementation\nrf_data_rate_bps            = 1.0e6     # sets Eb/N0 and the closure margin; does not touch C/N0\nrf_required_eb_n0_db        = 4.5\nrf_chip_rate_hz             = 1.023e6   # GPS C/A reference chip rate\nrf_correlator_spacing_chips = 0.5       # standard half-chip early-late correlator\nrf_tracking_threshold_dbhz  = 25.0      # MODELLED receiver loss-of-lock threshold\nrf_degraded_margin_db       = 6.0       # MODELLED: DEGRADED band above that threshold\n# rf_dll_bandwidth_hz                   # DERIVED as 1/(2*integration_s) = 0.5 Hz, the loop\n#                                       # noise bandwidth whose equivalent averaging time is\n#                                       # exactly the optical accumulation time. Overriding it\n#                                       # so the two disagree REFUSES the ranging ratio rather\n#                                       # than quoting one at two operating points.\n", "hybrid-pnt.toml": "# Hybrid PNT capstone: all-quantum suite (optical clock + cold-atom IMU + optical ISL\n# time-transfer aiding) vs all-classical suite (CSAC + nav-grade IMU + RF). GNSS denied 1.8 h.\nkind = \"hybrid\"\nseed = 42\ntiming_spec_ns = 20.0\nposition_spec_m = 100.0\n\n[time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0, t1 = 7200.0, state = \"denied\" },\n]\n\n[resync]\nenabled = true\ninterval_s = 60.0\nsigma_j_s = 1.0e-12\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457)\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\ndrift = 0.0\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\ndrift = 0.0\n\n[accel_quantum]\nid = \"cold-atom-quat\"\nprovenance = \"Exail hybrid quantum accelerometer triad, bias stability 5.88e-7 m/s^2 (Templier et al. 2022, arXiv:2209.13209)\"\nbias = 5.88e-7\nq_va = 4.6656e-8\n\n[accel_classical]\nid = \"nav-grade-quartz\"\nprovenance = \"Navigation-grade quartz accelerometer (Honeywell QA-2000 / Groves), bias stability 1.57e-3 m/s^2\"\nbias = 1.57e-3\nq_va = 3.8416e-8\n", "hybrid-ukf.toml": "# 17-state hybrid quantum + classical tightly-coupled GNSS/INS UKF (MODELLED).\n#\n# Surfaces the 17-state error-state unscented Kalman filter (src/fusion/tightly_coupled17.rs)\n# as a runnable scenario. The state is:\n#\n#   x = [ p(3) | v(3) | psi(3) | b_a(3) | b_g(3) | b  d ]\n#        position velocity attitude  accel-bias gyro-bias  clock(phase,freq)\n#\n#   * 15 INS error states (position, velocity, attitude misalignment, accel + gyro bias)\n#     propagated through the strapdown mechanization driven by the IMU — the CLASSICAL\n#     short-term inertial solution.\n#   * the accel-bias triad b_a is the CAI-DERIVED inertial bias correction: the cold-atom\n#     interferometer below sets the velocity-random-walk floor q_va, so the long-term coast\n#     drift is the QUANTUM-sensor-limited one — the quantum long-term half of the hybrid.\n#   * the two-state clock [b, d] (phase + frequency, in range units) is driven by the\n#     q-parameter clock engine (clock_state::q_from_allan) from the Allan profile below.\n#\n# The platform is GNSS-aided for a 100 s lead-in (the filter learns the biases, velocity and\n# clock), then coasts through a 120 s GNSS outage on the CAI IMU + clock alone.\n#\n# FIGURE OF MERIT — filter self-consistency (NEES + innovation-whiteness), the only thing a\n# simulation can honestly assert about an estimator. Over a Monte-Carlo ensemble whose truth\n# is generated from exactly the noise the filter assumes, the pooled NIS (whiteness) and NEES\n# means must land inside their 95% chi-squared bands. This is a SELF-CONSISTENCY statement,\n# NOT a real-world accuracy guarantee.\n#\n# HONESTY: everything here is MODELLED / SIMULATION. The CAI and clock inputs are bracketed,\n# literature-representative values, not measured hardware; the CAI hardware and its Key-Person\n# stay partner-owned. No TRL>3, no flight heritage, no external validation.\nkind = \"hybrid-ukf\"\nseed = 1771\n\n# Residual accelerometer bias the CAI-derived correction state estimates (m/s^2), body x-axis.\n# A cold-atom-grade post-calibration residual (illustrative, bracketed).\nresidual_accel_bias_m_s2 = 1.0e-4\n\n# Constant-velocity surface trajectory (+y, m/s).\nspeed_m_s = 100.0\n\n# GNSS measurement noise (1-sigma): ~1 m code pseudorange, ~5 cm/s Doppler (Groves 2013 §9.3).\nsigma_pr_m = 1.0\nsigma_rr_mps = 0.05\n\n# Monte-Carlo seeds the consistency oracle pools over, and the filter mistuning multipliers.\n# 24 seeds give run-based chi-squared NEES bands (8*24 DOF) tight enough to discriminate a\n# matched from a mistuned filter while keeping the run cheap. Set q_factor / r_factor away\n# from 1.0 to mistune the filter and watch the consistency gate reject it (q_factor scales the\n# assumed process noise, r_factor the assumed measurement noise).\nconsistency_seeds = 24\nq_factor = 1.0\nr_factor = 1.0\n\n[time]\nstep_s = 0.5\nduration_s = 220.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 100.0, state = \"nominal\" },\n  { t0 = 100.0, t1 = 220.0, state = \"denied\" },\n]\n\n# Inertial sensor. The [accel.cai] block makes this the QUANTUM cold-atom interferometer: its\n# velocity-random-walk floor q_va is derived from the interferometer physics (k_eff = 4*pi/lambda,\n# projection noise 1/(C*sqrt(N)), cycle time), NOT from the supplied q_va. Remove the [accel.cai]\n# block to fall back to a classical datasheet sensor at the supplied q_va.\n[accel]\nid = \"cold-atom-interferometer\"\nprovenance = \"Cold-atom (Rb-87 D2) interferometric accelerometer; bracketed parameters in the GAIN/MAIUS literature range (Freier et al. arXiv:1512.05660; Becker et al. Nature 2018). Modelled, partner-owned hardware.\"\nbias = 0.0\nq_va = 1.0e-9          # fallback classical value (overridden by the [accel.cai] physics below)\n\n[accel.cai]\nwavelength_m = 780.241209e-9   # Rb-87 D2 line (RB87_D2_WAVELENGTH_M)\npulse_sep_t = 0.02              # interrogation pulse separation T (s)\natom_number = 1.0e6            # detected atoms per shot N\ncontrast = 0.5                # initial fringe contrast C0\ncycle_time_s = 0.5            # measurement cycle time T_c (s)\n\n# Onboard clock Allan profile, fed to the q-parameter clock engine. A space-oriented optical /\n# ultra-stable oscillator class: white-FM sigma_y(1 s) ~ 1e-13, random-walk-FM two decades below.\n[clock]\nid = \"ultrastable-optical\"\nprovenance = \"Ultra-stable/optical onboard oscillator class, white-FM sigma_y(1 s) ~ 1e-13 (Riley NIST SP 1065; bracketing the achievable, not a flight unit). Modelled.\"\nwhite_fm_adev_1s = 1.0e-13\nrw_fm_level = 1.0e-15\n", "impairment-eval.toml": "# AI/ML RF-impairment detection evaluation testbed (ESA AO/1-13494 demonstrator).\n#\n# Generates a labelled, parameter-grounded SYNTHETIC corpus (nominal / jamming /\n# spoof-time / spoof-position / multipath), scores a detector with the\n# detector-agnostic harness, and reports AUC / ROC / confusion + per-class Pd at a\n# target Pfa, PLUS the in- vs out-of-distribution optimism gap a hostile reviewer\n# cares about.\n#\n# HONEST SCOPE: MODELLED operating characteristics only. The corpus is synthetic and\n# parameter-grounded (composed from Kshana's jamming/AGC/SQM/parity models) — never\n# field captures or raw IQ. The harness is a referee; it reports characteristics, it\n# does not pass a good/bad verdict. Run:  kshana scenarios/impairment-eval.toml\nkind = \"impairment-eval\"\n\nseed = 42\nn_per_class = 200\nnominal_cn0_dbhz = 45.0\nmeas_noise = 0.6\n\n# Detector under test: energy | agc | sqm | parity | fused\ndetector = \"fused\"\ntarget_pfa = 0.05\n\n# Out-of-distribution corpus = subtler (out-of-tuning-regime) impairments.\n# optimism_gap = auc_in - auc_out; flagged optimistic above optimism_tol.\nshift_severity_scale = 0.5\noptimism_tol = 0.05\n", "imu-deadreckoning.toml": "# Dead-reckoning during GNSS outage: cold-atom quantum accelerometer vs navigation-grade.\n# Bias = post-GNSS-calibration residual = published bias stability; q_va = (noise root-PSD)^2.\nkind = \"inertial\"\nseed = 42\nthreshold_m = 100.0\n\n[time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0, t1 = 7200.0, state = \"denied\" },\n]\n\n[accel_quantum]\nid = \"cold-atom-quat\"\nprovenance = \"Exail hybrid quantum accelerometer triad: bias stability 6e-8 g = 5.88e-7 m/s^2 after 24 h (Templier et al., Science Advances 2022, arXiv:2209.13209); noise 22 ug/sqrtHz = 2.16e-4 (m/s^2)/sqrtHz; laboratory maturity, not deployed\"\nbias = 5.88e-7\nq_va = 4.6656e-8\n\n[accel_classical]\nid = \"nav-grade-quartz\"\nprovenance = \"Navigation-grade quartz accelerometer (Honeywell QA-2000 / Groves AESS Tutorial): bias stability ~160 ug = 1.57e-3 m/s^2; noise ~20 ug/sqrtHz = 1.96e-4 (m/s^2)/sqrtHz; bias instability ~1 ug = 1e-5 m/s^2; modest acceleration random walk\"\nbias = 1.57e-3\nq_va = 3.8416e-8\nbias_instability = 1.0e-5\nq_aa = 1.0e-13\n", "ins-trn-coast.toml": "# INS/TRN coasting error model — position error against coast duration, and the coast\n# durations at which it crosses 10 m and 50 m.\n#\n# The question this answers: when a GNSS (or aperture-duty-cycled) study says \"assume a\n# dead-reckoning drift of 0.001–0.050 m/s\", where does that number come from? It comes\n# from the IMU, and this scenario computes it instead of sweeping it. Five growth terms —\n# accelerometer bias (t^2), gyro-bias tilt through gravity (t^3), velocity random walk\n# (t^1.5), angle random walk (t^2.5) and scale factor times the travelled distance — are\n# combined under a stated rule, and the threshold crossings are located by bisection on\n# the combined model. Every crossing carries the per-contribution breakdown that says\n# which error source put it there.\n#\n# Consumed by `kshana::inertial::coast` and dispatched as `kind = \"ins-trn-coast\"`. The\n# growth laws are cross-checked against the engine's own stochastic dead-reckoner\n# (`inertial::AccelModel`, Monte-Carlo) and its IMU error model\n# (`inertial::imu_errors::ImuErrorModel`, double-integrated); the IMU class coefficients\n# are representative Groves-Table-4.1-band figures, NOT a datasheet for any part.\nkind = \"ins-trn-coast\"\n\n# Representative IMU class: navigation, tactical, industrial or consumer. Any individual\n# coefficient below can be overridden, which relabels the reported grade as `custom`.\nimu_grade = \"navigation\"\n\n# Airborne cruise. The scale-factor error mis-scales the TRAVELLED DISTANCE, so the speed\n# is part of the error model, not decoration: at 250 m/s a 100 ppm scale factor is a\n# 0.025 m/s floor on the mean drift rate that no coast duration falls below.\nspeed_m_s = 250.0\nref_accel_m_s2 = 0.0\n\n# How the five contributions combine into one number. A MODELLING CHOICE, stated: `rss`\n# reads each coefficient as a 1-sigma spec, `linear-sum` is the coherent worst case, and\n# `det-sum-stoch-rss` adds the systematic terms while root-sum-squaring the independently\n# driven random walks. All three are reported in `combination_sensitivity` either way.\ncombination = \"rss\"\n\n# The crossings to report (m). These are inputs: the 10 m / 50 m pair is the default, not\n# a constant compiled into the model.\ncrossing_thresholds_m = [10.0, 50.0]\n\n# The drift-rate band a duty-cycle study sweeps (m/s), checked against per grade.\ndrift_band_lo_m_per_s = 0.001\ndrift_band_hi_m_per_s = 0.050\n\n# Terrain-referenced aiding. TRN in this engine (`altpnt::terrain`, `altpnt::sequential`)\n# recovers a POSITION offset by matching measured ground elevation against a stored DEM,\n# so it bounds the coast with a fix rather than slowing the growth between fixes.\n# `position-only` is what a bare position fix does — velocity error and tilt keep\n# integrating across it; `full-reset` re-zeroes the whole error state, as\n# `AccelModel::reset` does for a GNSS re-alignment.\ntrn_fix_mode = \"position-only\"\ntrn_fix_interval_s = 120.0\n# The matching sigma of the shipped terrain-nav configuration: hypot(altimeter 8 m,\n# DEM 15 m). NOT the achieved batch-matcher residual on that scenario's track.\ntrn_fix_residual_m = 17.0\nmission_duration_s = 1200.0\n", "integrity-harbour-approach.toml": "# ARAIM availability for a vessel entering a harbour: the `integrity` kind with a ground-site\n# user (`user_site`) under the `harbour-approach` skyline preset.\n#\n# The question a pilot or a port authority asks: in the last mile into port, the quay\n# buildings ahead and the breakwater either side hide the low satellites in those directions,\n# so do GPS plus Galileo still give dual-constellation ARAIM protection levels inside the\n# alert limits? The vessel heads north into the port: the sea astern (090-270 deg) is open,\n# quay buildings stand 8 deg high over 315-045 deg, and the breakwater and its light 3 deg\n# over the remaining landward sectors, under the 5 deg receiver mask. The site is a generic\n# Baltic port approach (59.45 N, 24.75 E, antenna 15 m above the ellipsoid). Remove the\n# [skyline] section to compare with open water.\n#\n# The ARAIM evaluation is the engine's multiple-hypothesis solution separation over the\n# satellites in view (single-satellite and constellation-wide faults, `araim_dual`), with\n# sigma_URA defaulting to sigma_URE (1 m) and the APV-I alert limits (HAL 40 m, VAL 50 m) as\n# in `araim-gps-galileo.toml`. `user_site` gives geodetic elevation and azimuth; an orbiting\n# `user` refuses a skyline. Each epoch reports `masked_by_skyline`, the satellites above the\n# mask that the harbour hides.\n#\n# The skyline preset is REPRESENTATIVE (provenance in docs/SKYLINE.md and `kshana skyline\n# --preset harbour-approach`): stated dimensions, not a survey of any port. Line of sight only.\n# The constellations are Walker patterns with their public parameters. MODELLED.\nkind = \"integrity\"\n\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0   # 1-sigma user-equivalent range error (dual-frequency, smoothed)\np_fa = 1.0e-5        # allowed false-alarm probability\np_md = 1.0e-3        # allowed missed-detection probability\nal_h_m = 40.0        # horizontal alert limit (APV-I)\nal_v_m = 50.0        # vertical alert limit (APV-I)\naraim_dual = true\n\n[time]\nstep_s = 300.0\nduration_s = 43200.0  # 12 h\n\n[user_site]\nlat_deg = 59.45\nlon_deg = 24.75\nheight_m = 15.0\n\n# GPS-like Walker 24/6/1 (IS-GPS-200 / USCG NAVCEN public constellation parameters).\n[constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# Galileo-like Walker 24/3/1 (Galileo OS SDD issue 1.1).\n[[constellations]]\naltitude_km = 23222.0\ninclination_deg = 56.0\nplanes = 3\nsats_per_plane = 8\nphasing_f = 1.0\n\n[skyline]\npreset = \"harbour-approach\"\n", "integrity-raim.toml": "# GNSS integrity (RAIM) availability over a GPS-like constellation.\n#\n# At each epoch the visible satellites are propagated, the snapshot-RAIM\n# horizontal/vertical protection levels are computed from the geometry and the\n# user-equivalent range error, and availability is judged against the APV-I\n# alert limits (HAL 40 m, VAL 50 m). The output is an HPL/VPL availability map:\n# per-epoch protection levels and the fraction of epochs that meet the limits.\n#\n# The ranging error here (1 m, 1-sigma) is representative of a modern\n# dual-frequency, carrier-smoothed receiver — single-frequency RAIM (~5-6 m) does\n# not meet the vertical APV-I limit on a single constellation, which is why\n# vertical guidance uses SBAS / dual-frequency / ARAIM. The constellation is a\n# synthetic 24-satellite Walker-delta pattern (6 planes of 4), illustrative of\n# GPS geometry; swap in a `tle` block for a real one.\n#\n# The result also carries a vertical Stanford(-ESA) integrity diagram: at each\n# protected epoch a seeded no-fault range-error draw is mapped through the\n# geometry to an actual vertical error and classified against the VPL and the\n# vertical alert limit (Available / System-Unavailable / Misleading / Hazardously\n# Misleading). `seed` makes that error realization reproducible.\nkind = \"integrity\"\n\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0   # 1-sigma user-equivalent range error (dual-frequency, smoothed)\np_fa = 1.0e-5        # allowed false-alarm probability\np_md = 1.0e-3        # allowed missed-detection probability\nal_h_m = 40.0        # horizontal alert limit (APV-I)\nal_v_m = 50.0        # vertical alert limit (APV-I)\n\n[time]\nstep_s = 120.0\nduration_s = 43200.0  # 12 h\n\n[user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n\n[constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n", "jamming-demo.toml": "# RF jamming: a ground-based broadband jammer denying GNSS to a nearby receiver.\n#\n# The chain (Kaplan & Hegarty, Understanding GPS/GNSS, 3rd ed. §9.4): the jammer's\n# received power (transmit power + gains − free-space path loss) sets the\n# jammer-to-signal ratio J/S at the receiver; the despreading processing gain\n# (C/A chip rate) and the spectral-separation factor Q convert that into an\n# effective C/N0 per satellite; a satellite loses lock when its effective C/N0\n# falls below the tracking threshold (25 dB-Hz here).\n#\n# A 10 W (10 dBW) broadband jammer 1 km from the receiver produces J/S ≈ 72 dB —\n# far beyond the ~35 dB a C/A loop can tolerate — so every visible satellite drops\n# below the tracking threshold and the receiver is denied (availability → 0) while\n# the satellites remain geometrically visible. Move the jammer out or cut its\n# power and J/S falls ~40 dB per decade of range: the same jammer at 100 km only\n# degrades the links (J/S ≈ 32 dB, effective C/N0 ≈ 28 dB-Hz) without losing lock.\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n\n[time]\nstep_s = 30.0\nduration_s = 1800.0\n\n[receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n\n# A GPS-like 24-satellite Walker shell (6 planes × 4), propagated through the\n# 4.12 mm-validated SGP4 core.\n[constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# 10 W broadband jammer 1 km East of the receiver (ECEF; J/S depends only on\n# range, so the exact direction is immaterial).\n[jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = 10.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n", "jamming-harbour-approach-skyline.toml": "# A ship entering a harbour under a shore jammer, with the quay buildings ahead taking the\n# low satellites in that direction: the `jamming` scenario under the `harbour-approach`\n# skyline preset.\n#\n# The question a pilot or a port authority asks: with the jammer of\n# `maritime-strait-jamming.toml` turned down to 2 W (3 dBW), how many satellites does the\n# ship keep, and how many of them does the harbour itself hide? The vessel heads north into\n# the port: quay buildings stand 8 deg high over 315-045 deg, the breakwater and its light\n# 3 deg over the other landward sectors (below the 5 deg receiver mask, so they hide nothing\n# here), and the sea astern (090-270 deg) is open. Each epoch reports `masked_by_skyline`,\n# the satellites above the mask that the quay hides: 83 satellite-epochs of 3051 over the six\n# hours. Under this jammer they cost no tracking: the satellites the quay hides are low ones\n# whose C/N0 the jammer has already taken, so the same 2473 satellite-epochs track with the\n# skyline or without it. Remove the [skyline] section to compare.\n#\n# The skyline preset is REPRESENTATIVE (provenance in docs/SKYLINE.md and `kshana skyline\n# --preset harbour-approach`): stated dimensions, not a survey of any port. Geometric line of\n# sight only; free-space jammer path as in the strait scenario; a GPS-like 24-satellite Walker\n# shell. MODELLED.\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n\n[time]\nstep_s = 60.0\nduration_s = 21600.0   # six hours\n\n[receiver]\nlat_deg = 59.80\nlon_deg = 24.90\nalt_m = 0.0\n\n# A GPS-like 24-satellite Walker shell (6 planes x 4), propagated through the SGP4 core.\n[constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# 2 W broadband jammer on a 30 m mast, 30 km due east of the ship (ECEF, metres).\n[jammer]\nposition_ecef_m = [2904623.523, 1381438.498, 5489328.347]\npower_dbw = 3.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n[skyline]\npreset = \"harbour-approach\"\n", "l-band-waterfall-jamming.toml": "# L-band waterfall under jamming: the whole Global Navigation Satellite System (GNSS)\n# L band as one power spectral density (PSD), frequency across, time down, while a\n# scripted sequence of jammers switches on.\n#\n# The question a spectrum monitor or a receiver designer asks: what does the band look\n# like while this happens, and which signals does each jammer actually take away? The\n# navigation signals sit about 20 dB below the thermal noise floor, so the picture shows\n# the floor and the jammers; the per-band carrier-to-noise density (C/N0) bars show what\n# despreading recovers. Each jammer is scored against each band by its spectral\n# separation coefficient (SSC), the overlap of the two spectra over the receiver band\n# (Betz 2001; Kaplan & Hegarty, Understanding GPS/GNSS, 3rd ed., section 9.4), so a\n# jammer only hurts the bands its spectrum reaches.\n#\n# Timeline (60 s, one row per second):\n#   10 s  a swept (chirp) jammer, 16 MHz wide around L1, a 9 microsecond sawtooth, the\n#         shape of a car-cigarette-lighter privacy device: 50 mW (-13 dBW) at 100 m.\n#         It takes GPS L1 coarse/acquisition (C/A) and Galileo E1 away together.\n#   30 s  a continuous-wave (CW) tone exactly on the L1 carrier, 10 mW at 1 km. On C/A\n#         it lands on the peak of the binary phase-shift keying (BPSK) spectrum; on\n#         Galileo E1 it lands in the null of the multiplexed binary offset carrier (MBOC)\n#         spectrum, so E1 recovers when the chirp stops at 40 s while C/A stays lost.\n#   45 s  flat 2 MHz noise on the L2 carrier, received at -135 dBW: GPS L2 civil (L2C)\n#         is degraded but keeps tracking.\n# GPS L5 and Galileo E5a, at 1176.45 MHz, are outside every jammer's spectrum.\n#\n# The [iq] section draws the model at 35 s as complex IQ samples (20.48 MHz around L1),\n# writes them as a Signal Metadata Format (SigMF) recording and reads them back, and\n# compares a Welch estimate with the model: a check of the synthesis, the SigMF codec and\n# the estimator, not a measurement. A real recording can be compared instead with a\n# [recording] section (meta_path = \"capture.sigmf-meta\"), native builds only.\n#\n# Assumptions: signal powers are the interface-specification minimum received powers\n# (IS-GPS-200, IS-GPS-705, Galileo Open Service Signal-in-Space Interface Control\n# Document); a 290 K antenna and a 2 dB receiver noise figure; free-space propagation\n# to the jammers, 0 dBi receive gain toward them. MODELLED: the signal spectra are\n# validated closed forms, but every jammer, power and timing here is a scenario input.\nkind = \"spectrum\"\nseed = 7\nduration_s = 60.0\nstep_s = 1.0\n\n[receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n\n[grid]\nf_min_mhz = 1160.0\nf_max_mhz = 1590.0\nn_freq = 430\n\n[[jammers]]\nname = \"chirp privacy device\"\nwaveform = \"chirp\"\ncentre_mhz = 1575.42\nbandwidth_mhz = 16.0\nsweep_period_us = 9.0\neirp_dbw = -13.0\nrange_m = 100.0\non_s = 10.0\noff_s = 40.0\n\n[[jammers]]\nname = \"CW tone on L1\"\nwaveform = \"cw\"\ncentre_mhz = 1575.42\neirp_dbw = -20.0\nrange_m = 1000.0\non_s = 30.0\n\n[[jammers]]\nname = \"L2 narrowband noise\"\nwaveform = \"narrowband\"\ncentre_mhz = 1227.60\nbandwidth_mhz = 2.0\nreceived_power_dbw = -135.0\non_s = 45.0\n\n[iq]\ncentre_mhz = 1575.42\nsample_rate_mhz = 20.48\nt_s = 35.0\nlog2_samples = 16\nnfft = 1024\ndatatype = \"cf32_le\"\n", "launch-window.toml": "# Launch-window & ascent geometry demonstrator (mission analysis, trade-study tier).\n#\n# Two-body spherical-Earth geometry: launch azimuth(s) from site latitude + target\n# inclination (sin Az = cos i / cos lat), minimum reachable inclination, circular\n# velocity, the Earth-rotation eastward bonus, dogleg plane-change Dv when the\n# target inclination is below the site latitude, and daily launch opportunities.\n#\n# HONEST SCOPE: MODELLED. Geometric azimuth only -- no rotating-Earth\n# velocity-triangle correction (the bonus is reported separately to fold in), no\n# ascent trajectory / drag-loss / steering model. Pre-Phase-A geometry.\n# Run:  kshana scenarios/launch-window.toml\nkind = \"launch-window\"\n\nsite_lat_deg = 28.5             # Kennedy Space Center\ntarget_inclination_deg = 51.6   # ISS inclination\naltitude_km = 400.0\n", "leo-band-trade.toml": "# LEO-PNT band trade, UHF to wide C band: what a low Earth orbit (LEO) positioning,\n# navigation and timing (PNT) signal gains and loses in each band, independent of any\n# particular system.\n#\n# Five REPRESENTATIVE designs from the compiled-in `generic-bands` preset, each a pilot\n# and data pair with a 50/50 power split sized to its band:\n#   UHF   465 MHz,      BPSK(5) in 10 MHz\n#   L     1191.795 MHz, BPSK(10) in 20.46 MHz (the Galileo E5 centre)\n#   S     2492.028 MHz, BPSK(5) in 16.5 MHz (the NavIC S-band carrier, in the RDSS band)\n#   C     5020 MHz,     BPSK(10) in 20 MHz (the middle of the 5010-5030 MHz RNSS band)\n#   wide C 5100 MHz,    BPSK(50) in 120 MHz\n# (BPSK binary phase-shift keying; RDSS Radio Determination Satellite Service; RNSS Radio\n# Navigation Satellite Service.)\n#\n# The trade table puts four things side by side:\n#   * ionospheric delay: first order, 40.3 TEC / f^2, for a 50 TECU slant total electron\n#     content: UHF carries (1191.795/465)^2 = 6.6 times the L-band delay, C band 0.056;\n#   * free-space loss at a 1000 km slant range: +20 log10(f/f_L) dB relative to L;\n#   * ranging accuracy (delay-lock-loop thermal-noise jitter, 0.5 chip coherent\n#     early-late spacing, 1 Hz loop) at equal C/N0 (45 dB-Hz for all), and at equal\n#     radiated power (C/N0 falls with the free-space loss: isotropic antennas at both\n#     ends, so the higher band's smaller receive aperture is charged in full);\n#   * the J/S a CW tone, wideband noise and matched noise may reach before the tracked\n#     pilot falls below 25 dB-Hz, at the equal-power C/N0.\n# MODELLED: the closed forms are validated; the designs, the TEC, the range and the\n# equal-power assumption are inputs. No rain or atmospheric loss (it matters at C band).\nkind = \"leo-signal\"\npresets = [\"generic-bands\"]\n\n[receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ncn0_dbhz = [30.0, 35.0, 40.0, 45.0, 50.0, 55.0]\nreference_cn0_dbhz = 45.0\nloop_bandwidth_hz = 1.0\nintegration_time_s = 0.02\ncorrelator_spacings_chips = [1.0, 0.5, 0.2, 0.1]\nreference_spacing_chips = 0.5\ntracking_threshold_dbhz = 25.0\n\n[acquisition]\naltitude_km = 550.0\noscillator_ppm = 0.5\ncoherent_ms = 1.0\nnoncoherent = 1\npfa_cell = 1e-4\n\n[trade]\nreference_signal = \"generic-l\"\nslant_tec_tecu = 50.0\nslant_range_km = 1000.0\n", "leo-doppler-positioning.toml": "# Positioning from LEO Doppler alone, over a generic LEO navigation constellation.\n#\n# A receiver near Munich measures the Doppler shift of every satellite of a 258-satellite\n# LEO navigation constellation (the public Xona Pulsar X1 signal table and constellation,\n# arXiv:2509.19551; the split between its two inclinations is representative) for ten\n# minutes and solves for its position and clock drift by batch least squares. Doppler gives\n# range rate, and only the part of the satellite velocity across the line of sight carries\n# position information, so the geometry is the change of the lines of sight over the pass,\n# not the spread of satellites at one instant.\n#\n# The report gives the full-window error, the error against window length (how quickly a\n# Doppler fix forms), the Doppler, Doppler-rate and jerk envelope of the system over an\n# overhead pass, and a single-pass table: the formal along-track and cross-track errors of a\n# fix from ONE satellite pass against the user's distance from the ground track. The\n# cross-track error grows without bound as the pass goes overhead, where the Doppler curve\n# stops depending on the cross-track distance (and the mirror image across the track fits\n# almost as well).\n#\n# MODELLED. Doppler noise 1 Hz one sigma (0.19 m/s at 1593 MHz), perfect ephemeris, no\n# ionosphere or troposphere rate, a height-free three-dimensional fit.\nkind = \"leo-pvt\"\nmode = \"doppler\"\nseed = 7\nduration_s = 600.0\nstep_s = 10.0\n\n[user]\nlat_deg = 48.14\nlon_deg = 11.58\nheight_m = 520.0\n\n[doppler]\npass_offsets_km = [25.0, 100.0, 250.0, 500.0, 1000.0, 1500.0]\n\n[[system]]\nname = \"Pulsar X1\"\nleo_preset = \"xona-pulsar\"\nsignal = \"X1\"\nsigma_doppler_hz = 1.0\n", "leo-focus-data-services.toml": "# LEO-PNT focus area: additional PNT data services in the navigation message.\n#\n# A low Earth orbit (LEO) navigation message carries, besides the ephemeris and clock,\n# service data: ionospheric corrections for single-frequency users (a Klobuchar-style set\n# and a NeQuick-G-style set) and the system-time-to-UTC (Coordinated Universal Time)\n# offset. Each service costs bits in every frame. The campaign composes four\n# `leo-navmsg` encode-and-decode runs of the engine's documented Kshana LEO message frame\n# (its own encoding modelled on the published message components, not any system's bit\n# layout), from ephemeris and clock only to every service, and records the frame length\n# and the ephemeris-and-clock share of it. A frame of B bytes takes 8*B/R seconds to\n# broadcast at R bit/s, so each service's bytes are airtime on the data channel.\n#\n# Every frame is checked by the kind itself: a CRC-24Q (the 24-bit cyclic redundancy\n# check of RTCM and SBAS) against its published check value, a decode round trip and a\n# corrupted frame that must be rejected.\n#\n# MODELLED: bit counts of the Kshana frame; broadcast integrity flags and differential\n# corrections beyond these services are not modelled.\nkind = \"campaign\"\ntitle = \"Navigation-message service data against frame length\"\nseed = 20260929\n\n[[compose.shared]]\nname = \"fit_interval\"\nunit = \"s\"\nvalue = 300.0\n\n[[compose.members]]\nlabel = \"ephemeris-clock\"\nbind = { fit_interval = \"message.fit_interval_s\" }\nmetrics = [\n  { name = \"frame_bytes\", path = \"encode_decode.frame_bytes\", unit = \"byte\" },\n  { name = \"ephemeris_clock_bits\", path = \"encode_decode.ephemeris_clock_bits\", unit = \"bit\" },\n]\n[compose.members.scenario]\nkind = \"leo-navmsg\"\nseed = 14\nanalysis = [\"encode-decode\"]\n[compose.members.scenario.orbit]\naltitude_km = 550.0\ninclination_deg = 97.6\ngravity_degree = 20\n[compose.members.scenario.message]\nmodel = \"kepler-rac\"\nrac_degrees = [7, 5, 6]\nfit_interval_s = 300\nupdate_period_s = 300\nsvid = 4\nklobuchar = false\nnequick = false\nutc = false\n\n[[compose.members]]\nlabel = \"plus-klobuchar\"\nbind = { fit_interval = \"message.fit_interval_s\" }\nmetrics = [\n  { name = \"frame_bytes\", path = \"encode_decode.frame_bytes\", unit = \"byte\" },\n  { name = \"ephemeris_clock_bits\", path = \"encode_decode.ephemeris_clock_bits\", unit = \"bit\" },\n]\n[compose.members.scenario]\nkind = \"leo-navmsg\"\nseed = 14\nanalysis = [\"encode-decode\"]\n[compose.members.scenario.orbit]\naltitude_km = 550.0\ninclination_deg = 97.6\ngravity_degree = 20\n[compose.members.scenario.message]\nmodel = \"kepler-rac\"\nrac_degrees = [7, 5, 6]\nfit_interval_s = 300\nupdate_period_s = 300\nsvid = 4\nklobuchar = true\nnequick = false\nutc = false\n\n[[compose.members]]\nlabel = \"plus-nequick\"\nbind = { fit_interval = \"message.fit_interval_s\" }\nmetrics = [\n  { name = \"frame_bytes\", path = \"encode_decode.frame_bytes\", unit = \"byte\" },\n  { name = \"ephemeris_clock_bits\", path = \"encode_decode.ephemeris_clock_bits\", unit = \"bit\" },\n]\n[compose.members.scenario]\nkind = \"leo-navmsg\"\nseed = 14\nanalysis = [\"encode-decode\"]\n[compose.members.scenario.orbit]\naltitude_km = 550.0\ninclination_deg = 97.6\ngravity_degree = 20\n[compose.members.scenario.message]\nmodel = \"kepler-rac\"\nrac_degrees = [7, 5, 6]\nfit_interval_s = 300\nupdate_period_s = 300\nsvid = 4\nklobuchar = true\nnequick = true\nutc = false\n\n[[compose.members]]\nlabel = \"all-services\"\nbind = { fit_interval = \"message.fit_interval_s\" }\nmetrics = [\n  { name = \"frame_bytes\", path = \"encode_decode.frame_bytes\", unit = \"byte\" },\n  { name = \"ephemeris_clock_bits\", path = \"encode_decode.ephemeris_clock_bits\", unit = \"bit\" },\n]\n[compose.members.scenario]\nkind = \"leo-navmsg\"\nseed = 14\nanalysis = [\"encode-decode\"]\n[compose.members.scenario.orbit]\naltitude_km = 550.0\ninclination_deg = 97.6\ngravity_degree = 20\n[compose.members.scenario.message]\nmodel = \"kepler-rac\"\nrac_degrees = [7, 5, 6]\nfit_interval_s = 300\nupdate_period_s = 300\nsvid = 4\nklobuchar = true\nnequick = true\nutc = true\n", "leo-focus-fused-pnt-sisre.toml": "# LEO-PNT focus area: MEO + LEO fused PNT.\n#\n# A receiver in Madrid fuses GPS, Galileo and the Xona Pulsar X5 signal (public signal\n# table, arXiv 2509.19551; the inclined 1080 km shell) in one weighted least-squares\n# pseudorange solution with an inter-system bias per system. How good must the LEO orbit\n# and clock be for the LEO layer to help? The campaign sweeps the LEO signal-in-space\n# range error (SISRE) from 5 cm to 5 m and records the root-mean-square (RMS) 3D error of\n# the GNSS-only, LEO-only and fused solutions over half an hour, and the fused median\n# position dilution of precision (PDOP).\n#\n# The GNSS-only solution does not change; the fused one approaches it when the LEO SISRE\n# is metres and improves on it by the LEO geometry when the SISRE is decimetres: the\n# broadcast-message and orbit-determination quality (see `leo-pnt-end-to-end`, which\n# hands the navigation message's SISRE to this stage) decides whether fusing pays.\n#\n# MODELLED: stated per-system SISRE and loop noise from C/N0; no multipath.\nkind = \"campaign\"\ntitle = \"Fused MEO + LEO positioning against the LEO SISRE\"\nseed = 20260929\n\n[sweep]\nmetrics = [\n  { name = \"gnss_rms_3d\", path = \"joint.gnss.rms_error_3d_m\" },\n  { name = \"leo_rms_3d\", path = \"joint.leo.rms_error_3d_m\" },\n  { name = \"fused_rms_3d\", path = \"joint.fused.rms_error_3d_m\" },\n  { name = \"fused_median_pdop\", path = \"joint.fused.median_pdop\" },\n]\n\n[[sweep.axes]]\nname = \"leo_sisre\"\nkey = \"system.2.sisre_m\"\nunit = \"m\"\nstart = 0.05\nstop = 5.0\nsteps = 7\nscale = \"log\"\n\n[sweep.scenario]\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 3\nduration_s = 1800.0\nstep_s = 30.0\n\n[sweep.scenario.user]\nlat_deg = 40.42\nlon_deg = -3.70\nheight_m = 650.0\n\n[[sweep.scenario.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\n\n[[sweep.scenario.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\n\n[[sweep.scenario.system]]\nname = \"Pulsar X5\"\nleo_preset = \"xona-pulsar\"\nsignal = \"X5\"\nsisre_m = 0.5\nisb_ns = 40.0\n", "leo-focus-indoor-uhf.toml": "# LEO-PNT focus area: indoor navigation with UHF.\n#\n# Building entry loss grows with frequency, and modern thermally efficient buildings\n# (metallised glass, foil-backed insulation) add far more than traditional ones. The\n# campaign composes two `leo-pass` runs of one generic low Earth orbit (LEO) satellite\n# passing 60 deg over a user inside a building in Rome, in the UHF, L, S and C bands, one\n# per ITU-R P.2109 building class (median loss, 50 % probability), and records the peak\n# carrier-to-noise density (C/N0) of each band.\n#\n# UHF keeps the highest indoor C/N0 in both buildings and is the only band above a\n# 25 dB-Hz tracking threshold in the traditional one (about 34 dB-Hz, against 24 for L,\n# 16 for S and 9 for C). The thermally efficient building takes every band below it, UHF\n# least (about 15 dB-Hz). The two members differ only in the building class.\n#\n# MODELLED: ITU-R P.2109-2 building entry loss (VALIDATED against the ITU workbook) on\n# representative EIRPs; no indoor multipath or fading beyond the P.2109 statistics.\nkind = \"campaign\"\ntitle = \"Indoor LEO-PNT by band and building class\"\nseed = 20260929\n\n[[compose.members]]\nlabel = \"traditional-building\"\nmetrics = [\n  { name = \"uhf_peak_cn0\", path = \"satellites[0].bands[0].peak_cn0_dbhz\" },\n  { name = \"l_peak_cn0\", path = \"satellites[0].bands[1].peak_cn0_dbhz\" },\n  { name = \"s_peak_cn0\", path = \"satellites[0].bands[2].peak_cn0_dbhz\" },\n  { name = \"c_peak_cn0\", path = \"satellites[0].bands[3].peak_cn0_dbhz\" },\n]\n[compose.members.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T12:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[compose.members.scenario.user]\nenvironment = \"indoor\"\nlat_deg = 41.9\nlon_deg = 12.49\nheight_m = 50.0\nbuilding_probability = 0.5\nantenna = \"hemispherical\"\ngain_dbi = 0.0\npolarisation = \"linear\"\nbuilding = \"traditional\"\n[[compose.members.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\", \"S\", \"C\"]\nmax_elevation_deg = 60.0\ntca_s = 450.0\n[compose.members.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\n\n[[compose.members]]\nlabel = \"thermally-efficient-building\"\nmetrics = [\n  { name = \"uhf_peak_cn0\", path = \"satellites[0].bands[0].peak_cn0_dbhz\" },\n  { name = \"l_peak_cn0\", path = \"satellites[0].bands[1].peak_cn0_dbhz\" },\n  { name = \"s_peak_cn0\", path = \"satellites[0].bands[2].peak_cn0_dbhz\" },\n  { name = \"c_peak_cn0\", path = \"satellites[0].bands[3].peak_cn0_dbhz\" },\n]\n[compose.members.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T12:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[compose.members.scenario.user]\nenvironment = \"indoor\"\nlat_deg = 41.9\nlon_deg = 12.49\nheight_m = 50.0\nbuilding_probability = 0.5\nantenna = \"hemispherical\"\ngain_dbi = 0.0\npolarisation = \"linear\"\nbuilding = \"thermally-efficient\"\n[[compose.members.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\", \"S\", \"C\"]\nmax_elevation_deg = 60.0\ntca_s = 450.0\n[compose.members.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\n", "leo-focus-iot-eirp.toml": "# LEO-PNT focus area: low-energy positioning for the Internet of Things (IoT) and mobile.\n#\n# A battery-powered tag in Hamburg takes a hot-start fix from a generic low Earth orbit\n# (LEO) UHF signal (465 MHz) during a 55 deg pass. How much transmit power does the\n# satellite need for the tag to last? The campaign sweeps the UHF band's equivalent\n# isotropically radiated power (EIRP) from -35 to +5 dBW and records, from the\n# `leo-pass` kind's `[iot]` section, the median carrier-to-noise density (C/N0), the\n# hot-start time to first fix (TTFF), the energy per fix and the battery life at one fix\n# per hour (20 mW active, 5 microwatt asleep, 2000 mWh battery; all stated inputs).\n#\n# Higher received power shortens the acquisition dwell the receiver needs to reach its\n# detection threshold, and energy per fix follows the time the receiver is awake. Below\n# a median C/N0 of about 35 dB-Hz the receiver needs non-coherent sums and the energy per\n# fix grows steeply; above it one coherent dwell suffices and the battery life at one fix\n# per hour is set by the sleep current.\n#\n# MODELLED: acquisition, TTFF and energy from stated receiver assumptions; not a measured\n# receiver. The UHF EIRP of the generic preset is representative, not a real system's.\nkind = \"campaign\"\ntitle = \"IoT energy per fix against LEO UHF transmit power\"\nseed = 20260929\n\n[sweep]\nmetrics = [\n  { name = \"uhf_median_cn0\", path = \"iot.rows[0].cn0_dbhz\" },\n  { name = \"hot_ttff\", path = \"iot.rows[0].hot.ttff_s\" },\n  { name = \"hot_energy_per_fix\", path = \"iot.rows[0].hot.energy_per_fix_mj\" },\n  { name = \"battery_life_hourly\", path = \"iot.rows[0].duty_cycle_hot[4].battery_life_days\" },\n]\n\n[[sweep.axes]]\nname = \"uhf_eirp\"\nkey = \"satellite.0.band.0.eirp_dbw\"\nunit = \"dBW\"\nstart = -35.0\nstop = 5.0\nsteps = 9\n\n[sweep.scenario]\nkind = \"leo-pass\"\nname = \"IoT energy per fix\"\nepoch = \"2026-09-28T06:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n\n[sweep.scenario.user]\nenvironment = \"ground\"\nlat_deg = 53.55\nlon_deg = 9.99\nheight_m = 10.0\n\n[[sweep.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\"]\nmax_elevation_deg = 55.0\ntca_s = 450.0\n\n[[sweep.scenario.satellite.band]]\nname = \"UHF\"\neirp_dbw = 0.0\n\n[sweep.scenario.gnss]\nenabled = false\n\n[sweep.scenario.iot]\nactive_power_mw = 20.0\nsleep_power_uw = 5.0\nbattery_mwh = 2000.0\ndetection_snr_db = 16.0\nmax_coherent_ms = 20.0\nparallel_code_search = true\naided_doppler_uncertainty_hz = 500.0\nfix_intervals_s = [1.0, 10.0, 60.0, 600.0, 3600.0, 86400.0]\ncn0_from = \"median\"\n", "leo-focus-ntn-bandwidth.toml": "# LEO-PNT focus area: 5G/6G non-terrestrial network (NTN) compatibility.\n#\n# A 5G NTN user terminal can position itself from the downlink of a low Earth orbit (LEO)\n# NTN constellation: time of arrival (TOA) from the positioning reference signal, whose\n# ranging precision is set by its bandwidth through the Cramer-Rao bound (CRB), and\n# Doppler over a pass. The campaign sweeps the reference signal's occupied bandwidth from\n# 180 kHz (one narrowband-IoT resource block, as in 5G NR NTN narrowband) to 20 MHz, in\n# the S-band mobile-satellite-service (MSS) downlink around 2172.5 MHz, over a generic\n# 324-satellite NTN shell at 600 km, and records the CRB range sigma at the zenith and the\n# resulting root-mean-square 3D TOA position error.\n#\n# The range sigma falls as 1/(RMS bandwidth), about 6.5 m at the zenith for 180 kHz and\n# 6 cm for 20 MHz; the 3D error falls from about 30 m to about 2 m, where the 1 m network\n# synchronisation error (a scenario input) sets the floor.\n#\n# MODELLED: positioning from Cramer-Rao bounds with a stated synchronisation error; no\n# multipath, no 3GPP (Third Generation Partnership Project) waveform detail beyond the\n# bandwidth.\nkind = \"campaign\"\ntitle = \"NTN positioning against reference-signal bandwidth\"\nseed = 20260929\n\n[sweep]\nmetrics = [\n  { name = \"range_sigma_zenith\", path = \"signals[0].range_sigma_zenith_m\" },\n  { name = \"toa_rms_error_3d\", path = \"signals[0].toa_rms_error_3d_m\" },\n  { name = \"toa_availability\", path = \"signals[0].toa_availability\" },\n]\n\n[[sweep.axes]]\nname = \"bandwidth\"\nkey = \"signal.0.bandwidth_hz\"\nunit = \"Hz\"\nstart = 180000.0\nstop = 20000000.0\nsteps = 9\nscale = \"log\"\n\n[sweep.scenario]\nkind = \"ntn-positioning\"\nseed = 5\ncarrier_hz = 2172.5e6\nintegration_s = 0.1\ndoppler_integration_s = 1.0\ncn0_dbhz = [38.0, 50.0]\nsync_error_m = 1.0\nduration_s = 600.0\nstep_s = 30.0\n\n[sweep.scenario.user]\nlat_deg = 52.5\nlon_deg = 13.4\nheight_m = 40.0\n\n[[sweep.scenario.signal]]\nname = \"NTN positioning reference signal\"\nbandwidth_hz = 4.5e6\n\n[[sweep.scenario.system]]\nname = \"NTN shell\"\nrole = \"leo\"\nmask_deg = 10.0\n\n[[sweep.scenario.system.shell]]\ntotal = 324\nplanes = 18\nphasing = 1\naltitude_km = 600.0\ninclination_deg = 55.0\n", "leo-focus-ppp-altitude.toml": "# LEO-PNT focus area: high-accuracy positioning (precise point positioning, PPP).\n#\n# Adding a low Earth orbit (LEO) layer shortens PPP convergence because the LEO geometry\n# changes in minutes rather than hours, which separates the float ambiguities from the\n# position quickly. The trade: a lower orbit changes geometry faster but puts fewer\n# satellites in view. The campaign sweeps the altitude of a 192-satellite Walker layer\n# (12 planes, 60 deg) at 500, 1000 and 1500 km over a multi-GNSS float PPP (GPS, Galileo,\n# BeiDou and GLONASS, ionosphere-free code and phase) at one mid-latitude site, and\n# records the median time for the horizontal and vertical errors to stay under 10 cm\n# (six noise realisations per altitude, 30 s epochs, so times come in half minutes).\n#\n# Reference trend: Li et al. 2019 (J Geodesy, doi 10.1007/s00190-018-1195-2) simulated\n# 60, 96, 192 and 288 LEO satellites at 1000 km cutting multi-GNSS convergence from 9.6\n# to 7.0, 3.2, 2.1 and 1.3 min; `leo-ppp-convergence` compares the engine with that\n# table. This sweep is a design study around it, not a reproduction.\n#\n# MODELLED: float PPP with white code and phase noise and a random-walk zenith wet\n# delay; no ambiguity resolution, no multipath.\nkind = \"campaign\"\ntitle = \"PPP convergence against the altitude of a 192-satellite LEO layer\"\nseed = 20260929\n\n[sweep]\nmetrics = [\n  { name = \"gnss_only_convergence\", path = \"cases[0].median_convergence_min\" },\n  { name = \"gnss_leo_convergence\", path = \"cases[1].median_convergence_min\" },\n  { name = \"mean_sats_in_view\", path = \"cases[1].mean_sats\" },\n]\n\n[[sweep.axes]]\nname = \"leo_altitude\"\nkey = \"case.0.system.0.shell.0.altitude_km\"\nunit = \"km\"\nstart = 500.0\nstop = 1500.0\nsteps = 3\n\n[sweep.scenario]\nkind = \"leo-ppp\"\nseed = 20\nduration_s = 1800.0\nstep_s = 30.0\nruns = 6\n\n[[sweep.scenario.site]]\nlat_deg = 48.1\nlon_deg = 11.6\n\n[[sweep.scenario.gnss]]\nname = \"GPS\"\npreset = \"gps-baseline\"\nmask_deg = 7.0\n\n[[sweep.scenario.gnss]]\nname = \"Galileo\"\npreset = \"galileo\"\nmask_deg = 7.0\n\n[[sweep.scenario.gnss]]\nname = \"BeiDou\"\npreset = \"beidou-meo\"\nmask_deg = 7.0\n\n[[sweep.scenario.gnss]]\nname = \"GLONASS\"\npreset = \"glonass\"\nmask_deg = 7.0\n\n[[sweep.scenario.case]]\nname = \"192 LEO\"\n\n[[sweep.scenario.case.system]]\nname = \"LEO-192\"\nmask_deg = 7.0\n\n[[sweep.scenario.case.system.shell]]\ntotal = 192\nplanes = 12\nphasing = 1\naltitude_km = 1000.0\ninclination_deg = 60.0\n", "leo-focus-science-iono-sounding.toml": "# LEO-PNT focus area: LEO-PNT science, ionosphere sounding from the dual-band delay.\n#\n# The first-order ionospheric group delay is 40.3*STEC/f^2 (STEC slant total electron\n# content), so the difference of two bands' pseudoranges to one satellite measures the\n# slant TEC below the satellite: STEC = (P2 - P1)*f1^2*f2^2 / (40.3*(f1^2 - f2^2)). A low\n# Earth orbit (LEO) positioning, navigation and timing (PNT) satellite transmitting in\n# several bands is therefore also an ionosphere sounder, and one below most of the\n# plasmasphere: it sees only the electron content under its own altitude.\n#\n# One generic LEO satellite at 550 km passes 70 deg over the Tromso ionospheric\n# observatory region (69.66 N) in UHF, L, S and C bands; the ionosphere is a 25 TEC-unit\n# vertical content on a 350 km shell, scaled by the fraction of a Chapman layer below the\n# satellite. For every band pair the report gives the slant TEC the geometry-free\n# combination recovers at the pass peak and its 1-sigma from the two bands' code noise.\n# Pairs with UHF sound best (UHF with L to about 0.02 TEC units): UHF carries the largest\n# delay and, here, the strongest signal. The close S and C bands sound worst (about 3 TEC\n# units): their delay difference is small against their code noise.\n#\n# MODELLED: the recovered TEC equals the model's by construction (the combination is exact\n# at first order); the precision is the thermal code noise alone, without multipath or\n# inter-frequency biases, which a real sounder must calibrate.\nkind = \"leo-pass\"\nname = \"LEO ionosphere sounding from multi-band delays\"\nepoch = \"2026-09-28T11:00:00\"\nduration_s = 900.0\nstep_s = 5.0\n\n[user]\nenvironment = \"ground\"\nlat_deg = 69.66\nlon_deg = 18.94\nheight_m = 20.0\nmask_deg = 10.0\n\n[ionosphere]\nmodel = \"vtec\"\nvtec_tecu = 25.0\n\n[[satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\", \"S\", \"C\"]\nmax_elevation_deg = 70.0\ntca_s = 450.0\n\n[gnss]\nconstellation = \"galileo\"\nband = \"E1\"\n", "leo-indoor-uhf.toml": "# Indoor LEO-PNT: why a UHF carrier reaches inside a building when L, S and C bands struggle.\n#\n# A user inside a traditional building in Rome receives one pass of a generic multi-band LEO\n# satellite (the representative generic-leo preset: UHF 450 MHz, L 1191.795 MHz, S 2492.028 MHz\n# and C 5020 MHz, each 0 dBW EIRP, 550 km sun-synchronous) and the Galileo E1 carriers. The\n# building entry loss is the ITU-R P.2109-2 median (probability 0.5) for a traditional\n# building, evaluated at each satellite's elevation, which is also the elevation of the path\n# at the facade. Outdoors, a 30 mm/h rain rate exceeded 0.01 % of the year (at a 3.5 km rain\n# height) adds ITU-R P.618 rain attenuation, which matters at C band and not at UHF.\n#\n# UHF enters the building with several dB less loss than C band and loses less to free space\n# at the same range, while its first-order ionospheric delay is about 125 times that at C band\n# (the 1/f^2 law): the report lists both, and the ionosphere-free combination of each band pair\n# with its noise amplification.\n#\n# MODELLED. The building model is statistical (ITU-R P.2109 is not site-specific); the EIRPs\n# and beams are representative. No workshop data is used.\nkind = \"leo-pass\"\nname = \"Indoor UHF LEO-PNT\"\nepoch = \"2026-09-28T12:00:00\"\nduration_s = 900.0\nstep_s = 5.0\n\n[user]\nenvironment = \"indoor\"\nlat_deg = 41.9\nlon_deg = 12.49\nheight_m = 50.0\nbuilding = \"traditional\"\nbuilding_probability = 0.5\nantenna = \"hemispherical\"\ngain_dbi = 0.0\npolarisation = \"linear\"\n\n[atmosphere]\nrain_rate_mm_h = 30.0\nrain_height_km = 3.5\nrain_exceedance_percent = 0.01\n\n[ionosphere]\nmodel = \"vtec\"\nvtec_tecu = 30.0\n\n[[satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\", \"S\", \"C\"]\nmax_elevation_deg = 60.0\ntca_s = 450.0\n\n[gnss]\nconstellation = \"galileo\"\nband = \"E1\"\n", "leo-iot-energy.toml": "# Low-energy LEO-PNT for an IoT (Internet of Things) tracker: energy per fix against duty cycle.\n#\n# A static asset tracker in Hamburg with a patch antenna sees one pass of a generic LEO\n# satellite (the representative generic-leo preset, UHF and L bands) and the GPS L1 C/A\n# carriers. From the pass it takes the median C/N0 of each signal, the worst-case Doppler rate\n# and the orbit's static-user Doppler envelope, and budgets a receiver that draws 20 mW awake\n# and 5 microwatts asleep from a 2000 mWh battery: acquisition time (coherent integration capped\n# by the Doppler rate, non-coherent sums to a 16 dB detection threshold, a parallel code\n# search over a Doppler window), the navigation-message time on a cold start, time to first\n# fix, energy per fix, and battery life at fix intervals from one second to one day for a hot\n# start (Doppler known to +/-500 Hz from an almanac and a coarse position).\n#\n# The LEO signal is stronger, so each dwell is shorter, but its Doppler window is about ten\n# times wider than GPS's on a cold start; with aiding the stronger signal wins. Every power,\n# threshold and search choice is a stated input.\n#\n# MODELLED. The receiver is a design assumption, not a measured chip. No workshop data is used.\nkind = \"leo-pass\"\nname = \"IoT energy per fix\"\nepoch = \"2026-09-28T06:00:00\"\nduration_s = 900.0\nstep_s = 5.0\n\n[user]\nenvironment = \"ground\"\nlat_deg = 53.55\nlon_deg = 9.99\nheight_m = 10.0\n\n[[satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\"]\nmax_elevation_deg = 55.0\ntca_s = 450.0\n\n[gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n\n[iot]\nactive_power_mw = 20.0\nsleep_power_uw = 5.0\nbattery_mwh = 2000.0\ndetection_snr_db = 16.0\nmax_coherent_ms = 20.0\nparallel_code_search = true\naided_doppler_uncertainty_hz = 500.0\nfix_intervals_s = [1.0, 10.0, 60.0, 600.0, 3600.0, 86400.0]\ncn0_from = \"median\"\n", "leo-navmsg-encode-decode.toml": "# LEO navigation message: Kshana's binary encoding, its quantisation budget, and the\n# RINEX-style and CSV exports.\n#\n# The binary frame is Kshana's own documented encoding (preamble, version, model, length,\n# payload, CRC-24Q). It carries the published components of a LEO message (a Galileo-\n# style Keplerian set with along/cross/radial corrections, a second-order clock\n# polynomial, SVID, issue of data, band and health, a Klobuchar and a NeQuick-G\n# ionospheric set, and UTC parameters) with steps sized so that every field's half-step\n# error stays under a millimetre over the validity window. It is not the bit layout of\n# any operational or demonstration system; none is public.\n#\n# The run fits three consecutive messages, encodes the first, decodes it, checks the\n# CRC (and that a flipped bit is rejected), prints the per-field half-step budget and\n# the SISRE of the exact and decoded message against the truth, then writes all three as\n# a RINEX-4-style block (a documented Kshana extension: RINEX 4.02 has no LEO records;\n# prior art arXiv 2401.17767) and as a CSV table, and reads both back.\nkind = \"leo-navmsg\"\nname = \"LEO message encode and decode\"\nseed = 14\nanalysis = [\"encode-decode\"]\n\n[orbit]\naltitude_km = 550.0\ninclination_deg = 97.6\ngravity_degree = 20\n\n[message]\nmodel = \"kepler-rac\"\nrac_degrees = [7, 5, 6]\nfit_interval_s = 300\nupdate_period_s = 300\nsvid = 4\nklobuchar = true\nnequick = true\nutc = true\n", "leo-navmsg-fit-interval-trade.toml": "# LEO navigation message: signal-in-space range error (SISRE) versus fit interval.\n#\n# A low Earth orbit (LEO) positioning, navigation and timing (PNT) satellite broadcasts\n# its orbit as a compact parameter set fitted to a short arc. The question: how long can\n# one message cover before its representation error outgrows the target, and what does a\n# set of along-track, cross-track and radial (RAC) correction polynomials buy?\n#\n# Truth: a 550 km, 97.6 deg orbit integrated with the EGM2008 gravity field to degree 20\n# and drag. Each message is fitted over its interval and used over a period centred in\n# it. Two models: the Galileo Open Service Signal-in-Space Interface Control Document\n# (OS SIS ICD) 16-parameter Keplerian set, and that set plus RAC polynomials of degree\n# 7 (along), 5 (cross) and 6 (radial). Why so high: the least-squares Keplerian residual\n# is what the 16 parameters cannot span, so it oscillates across the window, and only a\n# polynomial of higher degree than the Keplerian set already spans removes it (a\n# cross-track polynomial of lower degree removes almost nothing). SISRE uses the\n# global-average weights for the\n# orbit altitude (Montenbruck et al. 2018 method): at 550 km the radial weight is about\n# 0.47 and the transverse weight squared about 1/2.6, so along- and cross-track errors\n# count far more than for medium Earth orbit.\n#\n# The first table sets the usage period equal to the fit interval (1 to 15 minutes);\n# the second holds a 5-minute fit and shortens the update period. No preset is used: the\n# numbers are Kshana's own truth and fit, the representation error only (no orbit\n# determination or prediction error). MODELLED.\nkind = \"leo-navmsg\"\nname = \"LEO message fit-interval trade\"\nseed = 11\nanalysis = [\"fit-interval-trade\"]\n\n[orbit]\naltitude_km = 550.0\ninclination_deg = 97.6\ngravity_degree = 20\ncd_area_over_mass = 0.005\n\n[message]\nmodel = \"kepler-rac\"\nrac_degrees = [7, 5, 6]\n\n[trade]\nspan_s = 1800\nfit_intervals_s = [60, 120, 180, 300, 450, 600, 900]\nupdate_periods_s = [30, 60, 150, 300]\nupdate_fit_interval_s = 300\nmodels = [\"kepler16\", \"kepler-rac\"]\n", "leo-navmsg-midpass-update.toml": "# LEO navigation message: a message update in the middle of a pass, and whether the user\n# sees a jump.\n#\n# A LEO pass lasts minutes, so a satellite may switch to a new message while a user is\n# tracking it. At each switch the user's modelled pseudorange changes by the difference\n# of the two messages' positions projected on the line of sight, minus the difference of\n# their clocks. This run finds the highest pass over a user at 45 deg N, 10 deg E within\n# a day, fits messages every 150 s (each over a 300 s interval centred on its\n# usage period) and reports every switch in the pass: the 3D position jump, the clock\n# jump, the user's range jump, the largest jump any visible user could see, and a PASS or\n# FAIL against a 5 cm continuity threshold. A range-error series along the pass shows the\n# message error itself around each switch. No preset; MODELLED.\nkind = \"leo-navmsg\"\nname = \"LEO message mid-pass update\"\nseed = 13\nanalysis = [\"midpass-update\"]\n\n[orbit]\naltitude_km = 550.0\ninclination_deg = 97.6\ngravity_degree = 20\n\n[message]\nmodel = \"kepler-rac\"\nrac_degrees = [7, 5, 6]\nfit_interval_s = 300\nupdate_period_s = 150\n\n[midpass]\nuser_lat_deg = 45.0\nuser_lon_deg = 10.0\nmask_deg = 10.0\nsearch_s = 86400\nthreshold_m = 0.05\n", "leo-navmsg-model-comparison.toml": "# LEO navigation message: four ephemeris models on one orbit, and the Liu et al. 2025\n# SISRE-versus-altitude table.\n#\n# Models: the Galileo 16-parameter Keplerian set; that set plus along/cross/radial\n# polynomials; the 22-parameter extension of Liu, Su, Xie, Zhou and Qu (2025, Remote\n# Sensing 17(16):2894, doi 10.3390/rs17162894), which adds a semi-major-axis rate, a\n# mean-motion rate and once- and three-per-revolution radius harmonics; and the Earth-\n# centred Earth-fixed (ECEF) 6th-order polynomial with no clock terms that the ATOMIC\n# payload flew (\"zero-clock\": the satellite clock is steered to system time, and the\n# message is scored against a steered clock with a 0.24 m residual). Each at fit\n# intervals of 1, 5 and 10 minutes, with its parameter count and its size in Kshana's\n# binary encoding.\n#\n# The Liu table fits Kshana's 22-parameter model over 20-minute arcs at the five\n# altitudes of the paper (320, 475, 786, 966, 1336 km) and prints the published SISRE\n# beside it. The paper fitted real precise science orbits of named satellites; Kshana\n# fits its own integrated orbit at the same altitude and inclination, so the comparison\n# is MODELLED, not VALIDATED.\nkind = \"leo-navmsg\"\nname = \"LEO message model comparison\"\nseed = 12\nanalysis = [\"model-comparison\"]\n\n[orbit]\naltitude_km = 550.0\ninclination_deg = 97.6\ngravity_degree = 20\n\n[message]\nmodel = \"kepler-rac\"\nrac_degrees = [7, 5, 6]\n\n[comparison]\nmodels = [\"kepler16\", \"kepler-rac\", \"liu22\", \"ecef-poly\"]\nfit_intervals_s = [60, 300, 600]\nspan_s = 1200\nliu_table = true\nliu_arcs = 3\n", "leo-pass-iridium.toml": "# Iridium STL (satellite time and location) bursts seen from an aircraft.\n#\n# An airliner at 10 km over the Atlantic, flying at 230 m/s heading west, sees a designed\n# Iridium pass (781 km, 86.4 deg, peaking at 65 deg) on the STL band at 1621 MHz, and GPS L1\n# C/A. Iridium's 66 satellites transmit PNT bursts inside one 90 ms frame at 1616-1626 MHz,\n# with Doppler up to +/-36 kHz and a raw power 300 to 2400 times that of GPS (Resilient\n# Navigation and Timing Foundation,\n# https://rntfnd.org/wp-content/uploads/Recent-PNT-Improvements-and-Test-Results-Based-on-Low-Earth-Orbit-Satellites.pdf).\n# The preset turns \"300 times GPS\" into an EIRP at 10 deg elevation with a flat pattern; the\n# zenith then lands near the published \"2400 times\". The aircraft's own motion adds to the\n# Doppler, and the report checks the closed-form Doppler and Doppler rate against a numerical\n# derivative of the range.\n#\n# MODELLED. The spot beams, the burst schedule and the STL waveform are not modelled.\nkind = \"leo-pass\"\nname = \"Iridium STL from an aircraft\"\nepoch = \"2026-09-28T14:00:00\"\nduration_s = 900.0\nstep_s = 5.0\n\n[user]\nenvironment = \"air\"\nlat_deg = 50.0\nlon_deg = -30.0\nheight_m = 10000.0\nspeed_m_s = 230.0\nheading_deg = 270.0\n\n[[satellite]]\nid = \"Iridium-pass\"\nsystem = \"iridium-stl\"\nmax_elevation_deg = 65.0\ntca_s = 450.0\ndirection = \"descending\"\n\n[gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n", "leo-pass-vs-gnss-cn0.toml": "# A LEO-PNT pass against the Galileo satellites in view: C/N0 over one pass.\n#\n# LEO-PNT is positioning, navigation and timing from satellites in low Earth orbit (LEO). A\n# ground user near Munich watches one pass of a generic LEO navigation satellite (the\n# representative generic-leo preset: 550 km sun-synchronous, an L-band carrier at the Galileo\n# E5 centre frequency of 1191.795 MHz, 0 dBW EIRP from a nadir-pointing 110 deg Gaussian beam)\n# and the Galileo satellites above a 5 deg mask on E1, all through the same patch antenna and\n# receiver noise model. The pass is designed to peak at 80 deg elevation mid-window.\n#\n# The result reproduces, qualitatively, what LEO-PNT demonstrations show: the LEO carrier-to-\n# noise density (C/N0) rises and falls in a bell a few minutes long, peaking several dB above\n# the flat MEO (medium Earth orbit) GNSS carriers, which sit in the mid-40s to about 50 dB-Hz.\n# The larger LEO signal comes from a range some forty times shorter than to a MEO satellite\n# (about 26 to 32 dB less free-space loss), not from a stronger transmitter. The Galileo\n# carriers use the minimum received power of the Galileo OS SIS ICD Issue 2.1 Table 12, plus\n# 2 dB, scaled by range.\n#\n# MODELLED. No Celeste or other workshop data is used: every LEO number here comes from the\n# representative preset in src/leo_link/presets/generic.rs.\nkind = \"leo-pass\"\nname = \"LEO pass versus MEO GNSS C/N0\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 2.0\n\n[user]\nenvironment = \"ground\"\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\nmask_deg = 5.0\n\n[[satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"L\"]\norbit = \"pass\"\nmax_elevation_deg = 80.0\ntca_s = 450.0\n\n[gnss]\nconstellation = \"galileo\"\nband = \"E1\"\nmax_satellites = 8\n", "leo-pass-xona-pulsar.toml": "# Xona Pulsar X1 and X5 over one pass, with the Pulsar constellation's highest passes.\n#\n# A maritime user in the Bay of Biscay (moving at 8 m/s, heading east) sees a designed pass of a\n# Pulsar satellite at the full-constellation altitude of 1080 km and 53 deg inclination\n# peaking at 70 deg, and the four highest passes of the inclined Pulsar shell (192 satellites,\n# 12 planes, Walker phasing 1) built by the constellation-design code, next to GPS L1 C/A.\n#\n# Every Pulsar signal number is public: Leclere, Marathe and Reid, ION GNSS+ 2025,\n# https://arxiv.org/abs/2509.19551, Tables 1 and 2 (X1 at 1593.3225 MHz, 1.023 Mchip/s; X5 at\n# 1190.51625 MHz, 10.23 Mchip/s; received power -148.2 to -139.1 dBW on X1 and -144.9 to\n# -136.2 dBW on X5). The paper gives received powers, not an EIRP or a pattern: the preset\n# takes a flat pattern and the EIRP that delivers the published minimum at 10 deg elevation.\n# The maximum carrier Doppler a static user can see from each orbit (33.6 kHz on X1 for the\n# polar shell, 31.8 kHz for the inclined one) is validated against the paper's Table 1.\n#\n# MODELLED as a whole: the pattern and EIRP are inferred from the published powers.\nkind = \"leo-pass\"\nname = \"Xona Pulsar pass\"\nepoch = \"2026-09-28T10:00:00\"\nduration_s = 1200.0\nstep_s = 5.0\n\n[user]\nenvironment = \"maritime\"\nlat_deg = 45.5\nlon_deg = -5.0\nheight_m = 10.0\nspeed_m_s = 8.0\nheading_deg = 90.0\n\n[[satellite]]\nid = \"Pulsar-pass\"\nsystem = \"xona-pulsar\"\naltitude_km = 1080.0\ninclination_deg = 53.0\nmax_elevation_deg = 70.0\ntca_s = 600.0\n\n[[leo_constellation]]\nsystem = \"xona-pulsar\"\nmax_satellites = 4\n\n[leo_constellation.design]\nname = \"Pulsar inclined\"\n\n[[leo_constellation.design.shell]]\ntotal = 192\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n", "leo-pnt-end-to-end.toml": "# LEO-PNT end to end on a generic constellation: signal design -> pass link budget ->\n# navigation message -> fused MEO + LEO fix and precise point positioning convergence.\n#\n# One low Earth orbit (LEO) positioning, navigation and timing (PNT) system is followed\n# through every stage of the engine, with no named system's data at all:\n#\n# - Signal: the representative L-band design `generic-l` (binary phase-shift keying at\n#   10.23 Mchip/s, pilot and data halves, 20.46 MHz transmit bandwidth) from the public\n#   preset file data/leo-signals/generic-bands.toml.\n# - Pass: a user in Madrid watches a designed pass of a 1080 km, 53 deg satellite peaking at\n#   75 deg. The band takes the design's centre, bandwidth and chip rate and splits its\n#   EIRP (equivalent isotropically radiated power) across the design's components; every\n#   epoch gives the tracked (pilot) component's C/N0 (carrier-to-noise density) and its\n#   band-limited code-tracking jitter.\n# - Navigation message: the Galileo Keplerian set with along-track, cross-track and radial\n#   correction polynomials, fitted every 300 s to a truth orbit at the pass satellite's\n#   altitude and inclination; its broadcast signal-in-space range error (SISRE) is the LEO\n#   orbit-and-clock error downstream.\n# - Positioning: GPS and Galileo with a generic 240-satellite LEO layer (Walker 240/12/1\n#   at 1080 km, 53 deg). The LEO system takes the pass's C/N0 line, the message's SISRE\n#   and the design's carrier and chip rate.\n# - Precise point positioning (PPP): GPS and Galileo alone and with the same LEO layer, the\n#   LEO orbit-and-clock error taken from the message.\n#\n# MODELLED: every stage keeps its own label; the chain adds no physics.\nkind = \"leo-pnt-chain\"\nname = \"LEO-PNT end to end, generic 1080 km constellation\"\nseed = 5\nsignal_design = \"generic-l\"\n# Orbit determination and clock prediction, as a range error (m): representative of on-board\n# GNSS orbit determination with a steered chip-scale clock at the decimetre level (the ATOMIC\n# payload reports under 10 cm per axis in orbit and 24 cm in clock: InsideGNSS,\n# https://insidegnss.com/first-steps-toward-a-fully-operational-leo-pnt-payload/).\nod_sisre_m = 0.25\n\n[signal]\npresets = [\"generic-bands\"]\n\n[pass]\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 1200.0\nstep_s = 5.0\n\n[pass.user]\nenvironment = \"ground\"\nlat_deg = 40.42\nlon_deg = -3.70\nheight_m = 650.0\nmask_deg = 10.0\n\n[[pass.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"L\"]\norbit = \"pass\"\naltitude_km = 1080.0\ninclination_deg = 53.0\nmax_elevation_deg = 75.0\ntca_s = 600.0\n\n[[pass.satellite.band]]\nname = \"L\"\nsignal = \"generic-l\"\neirp_dbw = 10.0\n\n[pass.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n\n[navmsg.message]\nmodel = \"kepler-rac\"\nfit_interval_s = 300.0\n\n[navmsg.trade]\nspan_s = 1200.0\n\n[fusion]\nmode = \"joint\"\nduration_s = 1800.0\nstep_s = 30.0\n\n[fusion.user]\nlat_deg = 40.42\nlon_deg = -3.70\nheight_m = 650.0\n\n[fusion.joint]\nmax_leo_sweep = 8\n\n[[fusion.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\n\n[[fusion.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\n\n[[fusion.system]]\nname = \"Generic LEO\"\nrole = \"leo\"\nisb_ns = 25.0\n\n[[fusion.system.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[ppp]\nduration_s = 1800.0\nstep_s = 10.0\nruns = 2\n\n[[ppp.site]]\nlat_deg = 40.42\nlon_deg = -3.70\n\n[[ppp.gnss]]\nname = \"GPS\"\npreset = \"gps-baseline\"\nmask_deg = 7.0\n\n[[ppp.gnss]]\nname = \"Galileo\"\npreset = \"galileo\"\nmask_deg = 7.0\n\n[[ppp.case]]\nname = \"240 LEO\"\n\n[[ppp.case.system]]\nname = \"Generic LEO\"\nmask_deg = 7.0\n\n[[ppp.case.system.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n", "leo-pnt-mega-shell.toml": "# A low-Earth-orbit positioning, navigation and timing (PNT) mega-constellation: 5 000\n# satellites in four Walker shells, scored as a coverage and dilution-of-precision (DOP) map.\n#\n# The shells are an illustrative design, not any operator's filing:\n#   - 1 600 satellites, Walker delta 1600/32/1 at 550 km and 53 deg;\n#   - 1 600 satellites, Walker delta 1600/32/7 at 540 km and 53.2 deg;\n#   - 1 000 satellites, Walker delta 1000/20/3 at 570 km and 70 deg;\n#   -   800 satellites, Walker star 800/16/1 at 560 km and 97.6 deg (near-polar, planes\n#       spread over 180 deg) to fill the high latitudes.\n#\n# At this size the visibility prefilter matters: each epoch the satellites are sorted by\n# sub-satellite latitude and a grid row only tests those within one coverage half-angle of\n# it. The `work` block of the result states how many satellite-point pair tests a brute-force\n# scan would have made and how many were made. The secular J2 drift of the nodes is on, and\n# the tracks are downsampled to 120 satellites.\n#\n# What the run answers: satellites in view, PDOP/HDOP/VDOP/GDOP per 10 deg cell, and the\n# share of time with PDOP at or below 3 above a 20 deg mask over two hours. The weak spot the\n# map shows is the polar caps: no shell reaches above about 82 deg latitude, so a user near a\n# pole sees every satellite on one side of the sky and the vertical geometry degrades. MODELLED: an\n# illustrative design, two-body orbits with J2, a spherical Earth, geometry only.\n\nkind = \"constellation-design\"\nbody = \"earth\"\nduration_s = 7200.0\nstep_s = 600.0\nmask_deg = 20.0\npdop_threshold = 3.0\ngrid_step_deg = 10.0\nclock = \"common\"\nj2 = true\ntrack_points = 13\nmax_tracks = 120\n\n[[constellation]]\nname = \"LEO-PNT\"\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 1600\nplanes = 32\nphasing = 1\naltitude_km = 550.0\ninclination_deg = 53.0\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 1600\nplanes = 32\nphasing = 7\naltitude_km = 540.0\ninclination_deg = 53.2\nraan0_deg = 5.625\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 1000\nplanes = 20\nphasing = 3\naltitude_km = 570.0\ninclination_deg = 70.0\n\n[[constellation.shell]]\npattern = \"star\"\ntotal = 800\nplanes = 16\nphasing = 1\naltitude_km = 560.0\ninclination_deg = 97.6\n", "leo-ppp-convergence.toml": "# Precise point positioning (PPP) convergence with LEO augmentation.\n#\n# A float PPP filter on ionosphere-free code and phase runs at three mid-latitude sites with\n# GPS, Galileo, BeiDou (medium Earth orbit) and GLONASS, and then with each of four LEO\n# constellations added. Li et al. (\"LEO constellation-augmented multi-GNSS for rapid PPP\n# convergence\", Journal of Geodesy 93:749-764, 2019, doi 10.1007/s00190-018-1195-2) report\n# multi-GNSS convergence shortened from 9.6 min to 7.0, 3.2, 2.1 and 1.3 min with 60, 96, 192\n# and 288 LEO satellites; `compare_li_2019` puts those figures beside the modelled ones.\n#\n# The four LEO constellations here are representative Walker delta shells at 1000 km and\n# 60 deg with 60, 96, 192 and 288 satellites; they are NOT the paper's designs, and the noise,\n# stations and convergence definition (horizontal and vertical errors below 10 cm until the\n# end of the run) are this model's. The comparison is therefore a MODELLED consistency check\n# on the trend: convergence must shorten monotonically with the number of LEO satellites.\nkind = \"leo-ppp\"\nseed = 20\nduration_s = 1800.0\nstep_s = 10.0\nruns = 4\ncompare_li_2019 = true\n\n[[site]]\nlat_deg = 30.5\nlon_deg = 114.4\n\n[[site]]\nlat_deg = 48.1\nlon_deg = 11.6\n\n[[site]]\nlat_deg = 39.0\nlon_deg = -77.0\n\n[[gnss]]\nname = \"GPS\"\npreset = \"gps-baseline\"\nmask_deg = 7.0\n\n[[gnss]]\nname = \"Galileo\"\npreset = \"galileo\"\nmask_deg = 7.0\n\n[[gnss]]\nname = \"BeiDou\"\npreset = \"beidou-meo\"\nmask_deg = 7.0\n\n[[gnss]]\nname = \"GLONASS\"\npreset = \"glonass\"\nmask_deg = 7.0\n\n[[case]]\nname = \"60 LEO\"\n[[case.system]]\nname = \"LEO-60\"\nmask_deg = 7.0\n[[case.system.shell]]\ntotal = 60\nplanes = 6\nphasing = 1\naltitude_km = 1000.0\ninclination_deg = 60.0\n\n[[case]]\nname = \"96 LEO\"\n[[case.system]]\nname = \"LEO-96\"\nmask_deg = 7.0\n[[case.system.shell]]\ntotal = 96\nplanes = 8\nphasing = 1\naltitude_km = 1000.0\ninclination_deg = 60.0\n\n[[case]]\nname = \"192 LEO\"\n[[case.system]]\nname = \"LEO-192\"\nmask_deg = 7.0\n[[case.system.shell]]\ntotal = 192\nplanes = 12\nphasing = 1\naltitude_km = 1000.0\ninclination_deg = 60.0\n\n[[case]]\nname = \"288 LEO\"\n[[case.system]]\nname = \"LEO-288\"\nmask_deg = 7.0\n[[case.system.shell]]\ntotal = 288\nplanes = 16\nphasing = 1\naltitude_km = 1000.0\ninclination_deg = 60.0\n", "leo-pvt-fjord-skyline.toml": "# Fused MEO and LEO positioning for a vessel deep in a fjord, where the valley walls hide\n# everything low across the channel: the `leo-pvt` joint mode under the `fjord` skyline\n# preset.\n#\n# The question a coastal-navigation or ferry operator asks: the walls of a deep fjord leave\n# a strip of sky along the channel, so how much does a low Earth orbit (LEO) layer add to GPS\n# and Galileo there, where the passes are short and fast? The fjord runs north-south with\n# walls rising to 600 m above the antenna 1.5 km either side: 21.8 deg across the channel,\n# below 1 deg along it, each wall point lowered by the Earth's curvature (4/3 effective\n# radius). The site is a generic point in western Norway at 61.1 N, 6.6 E; the systems are\n# those of `meo-leo-fused-pvt.toml` (GPS baseline, Galileo, the public Xona Pulsar X5\n# signal), each with its own receiver clock, and the same skyline applies over each system's\n# own elevation mask. Each epoch reports `masked_by_skyline`.\n#\n# The skyline preset is REPRESENTATIVE (provenance in docs/SKYLINE.md and `kshana skyline\n# --preset fjord`): the order of the width and relief of the deep west-Norwegian fjords, not\n# a survey of any fjord. Line of sight only: no diffraction, reflection or non-line-of-sight\n# reception. Remove the [skyline] section to compare with open sky. MODELLED.\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 3\nduration_s = 1800.0\nstep_s = 30.0\n\n[user]\nlat_deg = 61.1\nlon_deg = 6.6\nheight_m = 20.0\n\n[joint]\nmax_leo_sweep = 12\n\n[[system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\n\n[[system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\n\n[[system]]\nname = \"Pulsar X5\"\nleo_preset = \"xona-pulsar\"\nsignal = \"X5\"\nisb_ns = 40.0\n\n[skyline]\npreset = \"fjord\"\n", "leo-resilience-gnss-jammed-leo-carries.toml": "# LEO-PNT resilience mission: GNSS jammed, LEO-PNT carries the user, integrity maintained.\n#\n# Three phases on one 30 s timeline, each running a `spectrum` receiver (what it can still\n# track) and an `integrity` run (receiver autonomous integrity monitoring, RAIM, against a\n# 40 m horizontal and 50 m vertical alert limit):\n#\n#   nominal   GPS L1 C/A, Galileo E5a and a generic low Earth orbit (LEO) positioning,\n#             navigation and timing (PNT) layer in the S and C bands all track; integrity\n#             uses the GNSS layer (24 satellites at 20 200 km) and the LEO layer (240 at\n#             1080 km, 53 deg, and 72 at 1080 km, 97 deg) together.\n#   jammed    two barrage jammers, one over L1 and one over L5/E5, at -95 dBW received:\n#             both GNSS signals fall below the 25 dB-Hz tracking floor; the S- and C-band\n#             LEO signals are untouched. Integrity runs on the LEO layer alone.\n#   recovery  the jammers stop; both layers again.\n#\n# The alarm channel is the integrity kind's own: raised at epochs where the protection\n# level cannot be formed or exceeds the alert limit. With GNSS jammed the LEO layer alone\n# still forms a protection level at every epoch; it is under the 50 m alert limit at 28\n# of the 30 grid times and the alarm is raised at the other two. That is integrity\n# working: the user is warned whenever the bound is too large, and availability, not\n# integrity, is what the jamming costs.\n#\n# The integrity runs use that kind's own user track (a circular track 0.4 km up, the\n# convention of the other bundled integrity runs), not the spectrum receiver's site, and\n# a 1 m user-equivalent range error for both layers; those are scenario choices, stated\n# here. The integrity kind does not see the jammer: the jammed phase's LEO-only\n# constellation is the campaign's statement of what the spectrum run says is left.\n# MODELLED.\nkind = \"campaign\"\ntitle = \"GNSS jammed, LEO-PNT carries the user, integrity maintained\"\nseed = 20260929\n\n[timeline]\nstep_s = 30.0\n\n[[phases]]\nname = \"nominal\"\nduration_s = 600.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_gps_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_galileo_e5a_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_leo_s_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[2].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_leo_c_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[3].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 600.0\nstep_s = 30.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1150.0\nf_max_mhz = 1600.0\nn_freq = 90\n[[phases.runs.scenario.panels]]\nname = \"S band\"\nf_min_mhz = 2482.0\nf_max_mhz = 2502.0\nn_freq = 40\n[[phases.runs.scenario.panels]]\nname = \"C band\"\nf_min_mhz = 5005.0\nf_max_mhz = 5035.0\nn_freq = 40\n[[phases.runs.scenario.bands]]\nname = \"gps-l1ca\"\n[[phases.runs.scenario.bands]]\nname = \"galileo-e5a\"\n[[phases.runs.scenario.bands]]\nname = \"generic-s\"\nsignal = \"generic-s\"\nsignal_power_dbw = -150.0\n[[phases.runs.scenario.bands]]\nname = \"generic-c\"\nsignal = \"generic-c\"\nsignal_power_dbw = -152.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 10.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[[phases.runs.scenario.constellations]]\naltitude_km = 1080.0\ninclination_deg = 53.0\nplanes = 12\nsats_per_plane = 20\nphasing_f = 1.0\n[[phases.runs.scenario.constellations]]\naltitude_km = 1080.0\ninclination_deg = 97.0\nplanes = 6\nsats_per_plane = 12\nphasing_f = 1.0\n\n[[phases]]\nname = \"jammed\"\nduration_s = 900.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_gps_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_galileo_e5a_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_leo_s_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[2].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_leo_c_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[3].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 900.0\nstep_s = 30.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1150.0\nf_max_mhz = 1600.0\nn_freq = 90\n[[phases.runs.scenario.panels]]\nname = \"S band\"\nf_min_mhz = 2482.0\nf_max_mhz = 2502.0\nn_freq = 40\n[[phases.runs.scenario.panels]]\nname = \"C band\"\nf_min_mhz = 5005.0\nf_max_mhz = 5035.0\nn_freq = 40\n[[phases.runs.scenario.bands]]\nname = \"gps-l1ca\"\n[[phases.runs.scenario.bands]]\nname = \"galileo-e5a\"\n[[phases.runs.scenario.bands]]\nname = \"generic-s\"\nsignal = \"generic-s\"\nsignal_power_dbw = -150.0\n[[phases.runs.scenario.bands]]\nname = \"generic-c\"\nsignal = \"generic-c\"\nsignal_power_dbw = -152.0\n[[phases.runs.scenario.jammers]]\nname = \"L1 barrage\"\nwaveform = \"wideband\"\ncentre_mhz = 1575.42\nbandwidth_mhz = 20.0\nreceived_power_dbw = -95.0\non_s = 0.0\n[[phases.runs.scenario.jammers]]\nname = \"L5/E5 barrage\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 50.0\nreceived_power_dbw = -95.0\non_s = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 10.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 900.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 1080.0\ninclination_deg = 53.0\nplanes = 12\nsats_per_plane = 20\nphasing_f = 1.0\n[[phases.runs.scenario.constellations]]\naltitude_km = 1080.0\ninclination_deg = 97.0\nplanes = 6\nsats_per_plane = 12\nphasing_f = 1.0\n\n[[phases]]\nname = \"recovery\"\nduration_s = 600.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_gps_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_galileo_e5a_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_leo_s_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[2].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_leo_c_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[3].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 600.0\nstep_s = 30.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1150.0\nf_max_mhz = 1600.0\nn_freq = 90\n[[phases.runs.scenario.panels]]\nname = \"S band\"\nf_min_mhz = 2482.0\nf_max_mhz = 2502.0\nn_freq = 40\n[[phases.runs.scenario.panels]]\nname = \"C band\"\nf_min_mhz = 5005.0\nf_max_mhz = 5035.0\nn_freq = 40\n[[phases.runs.scenario.bands]]\nname = \"gps-l1ca\"\n[[phases.runs.scenario.bands]]\nname = \"galileo-e5a\"\n[[phases.runs.scenario.bands]]\nname = \"generic-s\"\nsignal = \"generic-s\"\nsignal_power_dbw = -150.0\n[[phases.runs.scenario.bands]]\nname = \"generic-c\"\nsignal = \"generic-c\"\nsignal_power_dbw = -152.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 10.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[[phases.runs.scenario.constellations]]\naltitude_km = 1080.0\ninclination_deg = 53.0\nplanes = 12\nsats_per_plane = 20\nphasing_f = 1.0\n[[phases.runs.scenario.constellations]]\naltitude_km = 1080.0\ninclination_deg = 97.0\nplanes = 6\nsats_per_plane = 12\nphasing_f = 1.0\n", "leo-resilience-js-margin.toml": "# LEO-PNT resilience from received power: the jammer-to-signal (J/S) margin.\n#\n# A jammer denies a signal when the jammer power it lets through, relative to the signal's\n# own received power, pushes the effective carrier-to-noise density (C/N0) below the\n# tracking threshold. A low Earth orbit (LEO) satellite is about 20 to 40 times closer than\n# a medium Earth orbit (MEO) GNSS satellite, so the same transmitter delivers 26 to 32 dB\n# more power, and every dB of received power is a dB of J/S margin.\n#\n# One wideband (barrage) noise jammer, 40 MHz wide at 1185 MHz, covers GPS L5, Galileo E5a\n# and two LEO signals in the same band. Its received power steps up by 5 dB every 10 s\n# from -125 dBW at 10 s to -90 dBW at 80 s. The `spectrum` kind's first-loss time of\n# each band is where the jammer takes it:\n#   gps-l5       interface-document minimum, -157.9 dBW\n#   galileo-e5a  interface-document minimum, -155.0 dBW\n#   xona-x5      the published minimum received power, -144.9 dBW (arXiv 2509.19551)\n#   generic-l    a representative LEO L-band signal at -135 dBW, 1191.795 MHz\n# GPS L5 is lost at the -105 dBW step, Galileo E5a at -100 dBW, Xona X5 at -95 dBW; the\n# generic signal still tracks at -90 dBW. Received power buys J/S margin dB for dB.\n# Received powers are those at the stated minimum; a real pass varies over it (see the\n# leo-pass scenarios).\n#\n# MODELLED: the signal spectra are validated closed forms; the jammer steps and the\n# received powers are scenario inputs.\nkind = \"spectrum\"\nseed = 12\nduration_s = 100.0\nstep_s = 1.0\n\n[receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n\n[grid]\nf_min_mhz = 1150.0\nf_max_mhz = 1220.0\nn_freq = 140\n\n[[bands]]\nname = \"gps-l5\"\n\n[[bands]]\nname = \"galileo-e5a\"\n\n[[bands]]\nname = \"xona-x5\"\nsignal = \"xona-x5\"\n\n[[bands]]\nname = \"generic-l\"\nsignal = \"generic-l\"\nsignal_power_dbw = -135.0\n\n[[jammers]]\nname = \"barrage -125 dBW\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 40.0\nreceived_power_dbw = -125.0\non_s = 10.0\noff_s = 20.0\n\n[[jammers]]\nname = \"barrage -120 dBW\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 40.0\nreceived_power_dbw = -120.0\non_s = 20.0\noff_s = 30.0\n\n[[jammers]]\nname = \"barrage -115 dBW\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 40.0\nreceived_power_dbw = -115.0\non_s = 30.0\noff_s = 40.0\n\n[[jammers]]\nname = \"barrage -110 dBW\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 40.0\nreceived_power_dbw = -110.0\non_s = 40.0\noff_s = 50.0\n\n[[jammers]]\nname = \"barrage -105 dBW\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 40.0\nreceived_power_dbw = -105.0\non_s = 50.0\noff_s = 60.0\n\n[[jammers]]\nname = \"barrage -100 dBW\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 40.0\nreceived_power_dbw = -100.0\non_s = 60.0\noff_s = 70.0\n\n[[jammers]]\nname = \"barrage -95 dBW\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 40.0\nreceived_power_dbw = -95.0\non_s = 70.0\noff_s = 80.0\n\n[[jammers]]\nname = \"barrage -90 dBW\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 40.0\nreceived_power_dbw = -90.0\non_s = 80.0\noff_s = 90.0\n", "leo-resilience-multiband-diversity.toml": "# LEO-PNT resilience by band diversity: one jammer, a four-band receiver.\n#\n# A receiver tracks a low Earth orbit (LEO) positioning, navigation and timing (PNT)\n# system in four bands (UHF, L, S and C) beside GPS L5 and Galileo E5a. One wideband\n# (barrage) noise jammer, 50 MHz wide and centred at 1185 MHz, covers the whole L5/E5\n# band. The campaign sweeps its received power from -140 to -80 dBW and records each\n# band's effective carrier-to-noise density (C/N0) from the `spectrum` kind's spectral\n# separation coefficient (SSC) chain.\n#\n# What the sweep shows: the jammer takes every L-band signal, GNSS and LEO alike, in\n# order of their received power; the UHF, S- and C-band LEO signals keep their nominal\n# C/N0 at every power, because no jammer power falls in their bands. A system that\n# spreads its signals over several bands is only denied by a jammer in every band.\n#\n# Signals (every one public or representative; no system-specific data):\n#   gps-l5, galileo-e5a   interface-document minimum received power\n#   generic-uhf  465 MHz, BPSK(5), 10 MHz, -150 dBW          [representative]\n#   generic-l    1191.795 MHz (the Galileo E5 centre), -150 dBW  [representative]\n#   generic-s    2492.028 MHz (the NavIC S carrier), -150 dBW    [representative]\n#   generic-c    5020 MHz (the 5010-5030 MHz RNSS allocation), -152 dBW [representative]\n# (BPSK binary phase-shift keying; RNSS radionavigation-satellite service.)\n#\n# MODELLED: the spectra are validated closed forms; the jammer and the received powers\n# are scenario inputs. This is the \"PNT resilience in L, S and C bands\" focus area.\nkind = \"campaign\"\ntitle = \"LEO-PNT band diversity against an L-band barrage jammer\"\nseed = 20260929\n\n[sweep]\nmetrics = [\n  { name = \"cn0_gps_l5\", path = \"timeline.bands[0].min_cn0_dbhz\" },\n  { name = \"cn0_galileo_e5a\", path = \"timeline.bands[1].min_cn0_dbhz\" },\n  { name = \"cn0_leo_uhf\", path = \"timeline.bands[2].min_cn0_dbhz\" },\n  { name = \"cn0_leo_l\", path = \"timeline.bands[3].min_cn0_dbhz\" },\n  { name = \"cn0_leo_s\", path = \"timeline.bands[4].min_cn0_dbhz\" },\n  { name = \"cn0_leo_c\", path = \"timeline.bands[5].min_cn0_dbhz\" },\n  { name = \"tracking_leo_l\", path = \"timeline.bands[3].tracking_fraction\" },\n]\n\n[[sweep.axes]]\nname = \"jammer_power\"\nkey = \"jammers.0.received_power_dbw\"\nunit = \"dBW\"\nstart = -140.0\nstop = -80.0\nsteps = 13\n\n[sweep.scenario]\nkind = \"spectrum\"\nseed = 11\nduration_s = 2.0\nstep_s = 1.0\n\n[sweep.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n\n[sweep.scenario.grid]\nf_min_mhz = 1150.0\nf_max_mhz = 1220.0\nn_freq = 70\n\n[[sweep.scenario.panels]]\nname = \"UHF\"\nf_min_mhz = 455.0\nf_max_mhz = 475.0\nn_freq = 40\n\n[[sweep.scenario.panels]]\nname = \"S band\"\nf_min_mhz = 2482.0\nf_max_mhz = 2502.0\nn_freq = 40\n\n[[sweep.scenario.panels]]\nname = \"C band\"\nf_min_mhz = 5005.0\nf_max_mhz = 5035.0\nn_freq = 40\n\n[[sweep.scenario.bands]]\nname = \"gps-l5\"\n\n[[sweep.scenario.bands]]\nname = \"galileo-e5a\"\n\n[[sweep.scenario.bands]]\nname = \"generic-uhf\"\nsignal = \"generic-uhf\"\nsignal_power_dbw = -150.0\n\n[[sweep.scenario.bands]]\nname = \"generic-l\"\nsignal = \"generic-l\"\nsignal_power_dbw = -150.0\n\n[[sweep.scenario.bands]]\nname = \"generic-s\"\nsignal = \"generic-s\"\nsignal_power_dbw = -150.0\n\n[[sweep.scenario.bands]]\nname = \"generic-c\"\nsignal = \"generic-c\"\nsignal_power_dbw = -152.0\n\n[[sweep.scenario.jammers]]\nname = \"L5-band barrage\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 50.0\nreceived_power_dbw = -140.0\non_s = 0.0\n", "leo-resilience-spoof-doppler.toml": "# LEO-PNT resilience against spoofing: Doppler and pass-geometry consistency.\n#\n# A timing receiver at a surveyed site (Frankfurt, position known to 1 m, velocity known\n# to be zero within 2 mm/s) tracks Galileo E1 and a generic low Earth orbit (LEO)\n# positioning, navigation and timing (PNT) layer (240 satellites at 1080 km, 53 deg; the\n# 16 highest passes of the half hour). At 300 s a spoofer captures every channel and\n# presents a position 30 m east of the true one, self-consistently in range and range\n# rate: the counterfeit signals are what a receiver 30 m away would see, the ionospheric\n# delay included (so the cross-band monitor has nothing to see; `leo-resilience-spoof-\n# monitors` shows the spoofers it does catch).\n#\n# The receiver predicts each satellite's range rate from the broadcast orbit and its\n# surveyed position and tests the measured range rates (chi-square, false-alarm\n# probability 1e-5 per epoch, detection declared at 99.9 % probability). A 30 m error\n# changes a MEO GNSS range rate by about 4 mm/s, inside the frequency-lock-loop noise;\n# it changes a LEO range rate by about 10 cm/s, because a LEO satellite's transverse\n# velocity over its range is about 25 times larger. The GNSS-only test never sees the\n# spoofer; the test on every channel (GNSS and LEO, sharing one receiver clock drift, which\n# the GNSS channels pin) detects it once enough LEO satellites are in view, 105 s after\n# the onset.\n#\n# MODELLED: the monitor's statistics are exact for the stated Gaussian noise; the spoofer\n# is an idealised position jump (its power, angle of arrival and correlation-peak\n# signatures are not modelled), and the prior is independent of the spoofed fixes.\nkind = \"leo-pass\"\nname = \"Spoofing detection by LEO Doppler consistency\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 1800.0\nstep_s = 5.0\n\n[user]\nenvironment = \"ground\"\nlat_deg = 50.11\nlon_deg = 8.68\nheight_m = 110.0\nmask_deg = 10.0\n\n[[leo_constellation]]\nsystem = \"generic-leo\"\nbands = [\"L\", \"C\"]\nmax_satellites = 16\n\n[leo_constellation.design]\nname = \"Generic 1080 km\"\n\n[[leo_constellation.design.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[gnss]\nconstellation = \"galileo\"\nband = \"E1\"\nmax_satellites = 8\n\n[spoofer]\nonset_s = 300.0\noffset_m = 30.0\npush_rate_m_s = 0.0\npush_azimuth_deg = 90.0\nsimulate_iono = true\nprior_sigma_m = 1.0\nprior_velocity_sigma_m_s = 0.002\np_fa = 1.0e-5\np_md = 1.0e-3\n", "leo-resilience-spoof-monitors.toml": "# LEO-PNT resilience against spoofing: which monitor sees which spoofer.\n#\n# Four spoofers attack the same receiver (Frankfurt, surveyed position known to 1 m,\n# static), which tracks Galileo E1 and a generic low Earth orbit (LEO) layer in its L\n# and C bands (240 satellites at 1080 km). Each spoofer moves the position the receiver\n# computes 30 m east at 300 s (a shared value, so the four cannot disagree). Two monitors\n# run on every member (the `leo-pass` kind's `[spoofer]` section):\n#   * Doppler and pass-geometry consistency: measured range rates against those predicted\n#     from the broadcast orbits and the surveyed position (chi-square, false-alarm\n#     probability 1e-5 per epoch);\n#   * cross-band consistency: the step of each LEO satellite's L-minus-C geometry-free\n#     pseudorange combination, which should hold only the slowly changing ionospheric\n#     delay.\n# The members:\n#   l-band-only          counterfeits GNSS and the LEO L band, not the C band (a spoofer\n#                        built for the GNSS band): the L and C pseudoranges of one\n#                        satellite disagree by the push, so both monitors see it;\n#   all-bands-no-iono    counterfeits every band from the ground, where no ionosphere\n#                        delays its signals: the geometry-free combination collapses to\n#                        zero at the onset, a step of the L-minus-C ionospheric delay;\n#   all-bands-with-iono  counterfeits every band and simulates the ionosphere: the\n#                        cross-band monitor cannot see it, the Doppler monitor can;\n#   gnss-only            counterfeits GNSS alone: a 30 m push moves GNSS range rates by\n#                        millimetres per second, which neither monitor sees; a cross-check\n#                        of the GNSS and LEO pseudorange positions would (not modelled).\n#\n# MODELLED: the monitors' statistics are exact for the stated Gaussian noise; each\n# spoofer is an idealised position jump, and the receiver's ionosphere model is the\n# engine's, so only the tolerated unmodelled rate (1 cm/s) stands for its error.\nkind = \"campaign\"\ntitle = \"Spoofing monitors against four spoofers\"\nseed = 20260929\n\n[[compose.shared]]\nname = \"jump\"\nunit = \"m\"\nvalue = 30.0\n\n[[compose.members]]\nlabel = \"l-band-only\"\nbind = { jump = \"spoofer.offset_m\" }\nmetrics = [\n  { name = \"doppler_gnss_detect\", path = \"spoof.gnss.detect_time_s\" },\n  { name = \"doppler_all_detect\", path = \"spoof.fused.detect_time_s\" },\n  { name = \"cross_band_detect\", path = \"spoof.cross_band.detect_time_s\" },\n  { name = \"first_detect\", path = \"spoof.first.detect_time_s\" },\n]\n[compose.members.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 5.0\n[compose.members.scenario.user]\nenvironment = \"ground\"\nlat_deg = 50.11\nlon_deg = 8.68\nheight_m = 110.0\nmask_deg = 10.0\n[[compose.members.scenario.leo_constellation]]\nsystem = \"generic-leo\"\nbands = [\"L\", \"C\"]\nmax_satellites = 12\n[compose.members.scenario.leo_constellation.design]\nname = \"Generic 1080 km\"\n[[compose.members.scenario.leo_constellation.design.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n[compose.members.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\nmax_satellites = 8\n[compose.members.scenario.spoofer]\nonset_s = 300.0\noffset_m = 0.0\npush_rate_m_s = 0.0\npush_azimuth_deg = 90.0\nprior_sigma_m = 1.0\nprior_velocity_sigma_m_s = 0.002\nbands = [\"L\"]\n\n[[compose.members]]\nlabel = \"all-bands-no-iono\"\nbind = { jump = \"spoofer.offset_m\" }\nmetrics = [\n  { name = \"doppler_gnss_detect\", path = \"spoof.gnss.detect_time_s\" },\n  { name = \"doppler_all_detect\", path = \"spoof.fused.detect_time_s\" },\n  { name = \"cross_band_detect\", path = \"spoof.cross_band.detect_time_s\" },\n  { name = \"first_detect\", path = \"spoof.first.detect_time_s\" },\n]\n[compose.members.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 5.0\n[compose.members.scenario.user]\nenvironment = \"ground\"\nlat_deg = 50.11\nlon_deg = 8.68\nheight_m = 110.0\nmask_deg = 10.0\n[[compose.members.scenario.leo_constellation]]\nsystem = \"generic-leo\"\nbands = [\"L\", \"C\"]\nmax_satellites = 12\n[compose.members.scenario.leo_constellation.design]\nname = \"Generic 1080 km\"\n[[compose.members.scenario.leo_constellation.design.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n[compose.members.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\nmax_satellites = 8\n[compose.members.scenario.spoofer]\nonset_s = 300.0\noffset_m = 0.0\npush_rate_m_s = 0.0\npush_azimuth_deg = 90.0\nprior_sigma_m = 1.0\nprior_velocity_sigma_m_s = 0.002\nsimulate_iono = false\n\n[[compose.members]]\nlabel = \"all-bands-with-iono\"\nbind = { jump = \"spoofer.offset_m\" }\nmetrics = [\n  { name = \"doppler_gnss_detect\", path = \"spoof.gnss.detect_time_s\" },\n  { name = \"doppler_all_detect\", path = \"spoof.fused.detect_time_s\" },\n  { name = \"cross_band_detect\", path = \"spoof.cross_band.detect_time_s\" },\n  { name = \"first_detect\", path = \"spoof.first.detect_time_s\" },\n]\n[compose.members.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 5.0\n[compose.members.scenario.user]\nenvironment = \"ground\"\nlat_deg = 50.11\nlon_deg = 8.68\nheight_m = 110.0\nmask_deg = 10.0\n[[compose.members.scenario.leo_constellation]]\nsystem = \"generic-leo\"\nbands = [\"L\", \"C\"]\nmax_satellites = 12\n[compose.members.scenario.leo_constellation.design]\nname = \"Generic 1080 km\"\n[[compose.members.scenario.leo_constellation.design.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n[compose.members.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\nmax_satellites = 8\n[compose.members.scenario.spoofer]\nonset_s = 300.0\noffset_m = 0.0\npush_rate_m_s = 0.0\npush_azimuth_deg = 90.0\nprior_sigma_m = 1.0\nprior_velocity_sigma_m_s = 0.002\nsimulate_iono = true\n\n[[compose.members]]\nlabel = \"gnss-only\"\nbind = { jump = \"spoofer.offset_m\" }\nmetrics = [\n  { name = \"doppler_gnss_detect\", path = \"spoof.gnss.detect_time_s\" },\n  { name = \"doppler_all_detect\", path = \"spoof.fused.detect_time_s\" },\n  { name = \"cross_band_detect\", path = \"spoof.cross_band.detect_time_s\" },\n  { name = \"first_detect\", path = \"spoof.first.detect_time_s\" },\n]\n[compose.members.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 5.0\n[compose.members.scenario.user]\nenvironment = \"ground\"\nlat_deg = 50.11\nlon_deg = 8.68\nheight_m = 110.0\nmask_deg = 10.0\n[[compose.members.scenario.leo_constellation]]\nsystem = \"generic-leo\"\nbands = [\"L\", \"C\"]\nmax_satellites = 12\n[compose.members.scenario.leo_constellation.design]\nname = \"Generic 1080 km\"\n[[compose.members.scenario.leo_constellation.design.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n[compose.members.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\nmax_satellites = 8\n[compose.members.scenario.spoofer]\nonset_s = 300.0\noffset_m = 0.0\npush_rate_m_s = 0.0\npush_azimuth_deg = 90.0\nprior_sigma_m = 1.0\nprior_velocity_sigma_m_s = 0.002\nbands = []\n", "leo-timing-utc.toml": "# Time transfer to UTC from LEO satellites, against C/N0 and the receiver oscillator.\n#\n# A timing receiver at a surveyed site in Boulder, Colorado recovers its clock from the\n# Iridium constellation (the `iridium-stl` preset: 66 satellites at 780 km, L-band bursts,\n# received power 300 to 2400 times GPS), holds time with its own oscillator when no\n# satellite is in view, and converts the system time to UTC with the broadcast offset\n# (IS-GPS-200 expression; the parameters below are illustrative, with a 5 ns uncertainty).\n# Four oscillator classes (TCXO, OCXO, chip-scale atomic clock, rubidium) and four C/N0\n# offsets are compared over six hours, every row with the same seed so the rows differ only\n# in C/N0 and oscillator. The Iridium bursts arrive 25 to 34 dB above GPS, so the loop noise\n# of the 25 000 symbol/s ranging signal matters only when the C/N0 is cut by 20 dB or more;\n# at nominal power the 5 m representative signal-in-space range error and the UTC-offset\n# uncertainty set the floor, and with a satellite in view about 93% of the time the\n# oscillator matters little.\n#\n# NIST measured Iridium PNT timing receivers with a miniature atomic clock within 40 ns of\n# UTC(NIST) over 40 days (https://www.nist.gov/publications/validating-timing-performance-improvement-ionospheric-corrections-iridium-pnt-receivers).\n# The modelled figures are a consistency comparison with that, not a reproduction of the test.\n# `trace = true` adds each row's time error at every epoch, so the run animates\n# (`--animate html`); the row statistics are the same with or without it.\n# MODELLED.\nkind = \"leo-pvt\"\nmode = \"timing\"\nseed = 9\nduration_s = 21600.0\nstep_s = 10.0\n\n[user]\nlat_deg = 39.99\nlon_deg = -105.26\nheight_m = 1655.0\n\n[timing]\nclocks = [\"tcxo\", \"ocxo\", \"csac\", \"rafs\"]\ncn0_offsets_db = [-30.0, -20.0, -10.0, 0.0]\nweek = 2436\ntow0_s = 172800.0\ntrace = true\n\n[timing.utc]\na0_s = 4.0e-9\na1_s_per_s = 1.0e-14\nt_ot_s = 147456.0\nwn_t = 2436\ndelta_t_ls_s = 18.0\nsigma_s = 5.0e-9\n\n[[system]]\nname = \"Iridium\"\nleo_preset = \"iridium-stl\"\nmask_deg = 15.0\n", "leo-vertical-5g-network-timing.toml": "# LEO-PNT vertical: wireless networks, 5G/6G base-station timing.\n#\n# A 5G time-division-duplex (TDD) base station in Madrid needs its time within 1.5\n# microseconds of every other cell's (ITU-T G.8271 accuracy class 4 at the end\n# application; 1.1 microseconds at the network reference point, G.8271.1). Its\n# oven-controlled crystal oscillator (OCXO) is disciplined to GNSS. When GNSS is lost for\n# a day:\n#\n#   * the `telecom-timing` kind runs the operator's own holdover analysis of the OCXO\n#     (temperature cycling of 2 K, the kind's G.8271.1 and G.8272 budgets): the events mark\n#     when its time error crosses the 1100 ns network limit and the 1500 ns end-application\n#     limit;\n#   * a `leo-pvt` timing run disciplines the same class of oscillator to the Xona Pulsar X5\n#     signal (public signal table, arXiv 2509.19551; both published shells, 258 satellites\n#     at about 1080 km) and converts system time to UTC (Coordinated Universal Time) with\n#     the broadcast offset, holding between passes;\n#   * a `leo-pass` run of the four highest Pulsar passes over the site carries the geometry\n#     the campaign exports.\n#\n# The alarm is raised on the LEO-disciplined time error against the 1100 ns network limit.\n#\n# MODELLED: the two oscillator models are each kind's own (the telecom kind's OCXO with\n# temperature and ageing terms, the timing run's OCXO class noise), so the comparison is\n# between the two analyses, not one oscillator; the X5 range error is the preset's.\nkind = \"campaign\"\ntitle = \"5G base-station timing: holdover and LEO time\"\nseed = 20260929\n\n[timeline]\nstep_s = 300.0\n\n[[phases]]\nname = \"gnss-lost\"\nduration_s = 86400.0\n\n[[phases.runs]]\nevents = [\n  { label = \"OCXO holdover exceeds the 1100 ns network limit\", at = \"budgets[0].time_to_exceed_s\" },\n  { label = \"OCXO holdover exceeds the 1500 ns end-application limit\", at = \"budgets[1].time_to_exceed_s\" },\n]\n[phases.runs.scenario]\nkind = \"telecom-timing\"\nseed = 20260929\nmasks = [\"prtc-a\"]\n[phases.runs.scenario.holdover]\noscillator = \"ocxo\"\ngnss_loss_s = 0.0\nduration_s = 86400.0\nsample_interval_s = 1.0\nlocked_te_sigma_ns = 1.0\ninitial_frequency_offset = 0.0\ntemperature_amplitude_k = 2.0\ntemperature_period_s = 86400.0\nlocked_duration_days = 5.0\n[[phases.runs.scenario.budgets]]\nname = \"network limit at reference point C\"\nmax_abs_te_ns = 1100.0\nsource = \"ITU-T G.8271.1 (2022) Amd. 3 (05/2025) clause 7.3.1 (max|TE_L|, compared unfiltered)\"\n[[phases.runs.scenario.budgets]]\nname = \"end application, accuracy class 4\"\nmax_abs_te_ns = 1500.0\nsource = \"ITU-T G.8271 (03/2020) Amd. 1 (08/2024) Table 1, class 4\"\n\n[[phases.runs]]\nseries = [\n  { channel = \"leo_time_error_ns\", unit = \"ns\", t = \"timing.rows[0].series[].t_s\", y = \"timing.rows[0].series[].error_ns\" },\n  { channel = \"leo_time_sigma_ns\", unit = \"ns\", t = \"timing.rows[0].series[].t_s\", y = \"timing.rows[0].series[].sigma_ns\" },\n]\nalarms = [{ channel = \"leo_time_error_ns\", compare = \"abs_above\", threshold = 1100.0 }]\n[phases.runs.scenario]\nkind = \"leo-pvt\"\nmode = \"timing\"\nseed = 21\nduration_s = 86400.0\nstep_s = 60.0\n[phases.runs.scenario.user]\nlat_deg = 40.42\nlon_deg = -3.70\nheight_m = 650.0\n[phases.runs.scenario.timing]\nclocks = [\"ocxo\"]\ncn0_offsets_db = [0.0]\nweek = 2436\ntow0_s = 172800.0\ntrace = true\n[phases.runs.scenario.timing.utc]\na0_s = 4.0e-9\na1_s_per_s = 1.0e-14\nt_ot_s = 147456.0\nwn_t = 2436\ndelta_t_ls_s = 18.0\nsigma_s = 5.0e-9\n[[phases.runs.scenario.system]]\nname = \"Pulsar X5\"\nleo_preset = \"xona-pulsar\"\nsignal = \"X5\"\nmask_deg = 10.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"pulsar_pass_elevation_deg\", unit = \"deg\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].elevation_deg\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Pulsar passes over the base station\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 40.42\nlon_deg = -3.70\nheight_m = 650.0\nmask_deg = 10.0\n[[phases.runs.scenario.leo_constellation]]\nsystem = \"xona-pulsar\"\nbands = [\"X5\"]\nmax_satellites = 4\n[phases.runs.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\n", "leo-vertical-asset-tracking-iot.toml": "# LEO-PNT vertical: asset tracking and the Internet of Things (IoT), energy per fix.\n#\n# A battery-powered tag on a shipping container reports its position once an hour along\n# a journey in three phases, each a pass of a generic low Earth orbit (LEO) satellite\n# (550 km, sun-synchronous) in its UHF (465 MHz) and L bands, with the `leo-pass` kind's\n# `[iot]` section (20 mW active, 5 microwatt asleep, 2000 mWh battery, 16 dB detection\n# threshold, parallel code search; every assumption a stated input):\n#\n#   port-hamburg      on the quay, open sky;\n#   north-sea         on deck at sea (maritime user, 8 m/s);\n#   inland-warehouse  inside a traditional building (ITU-R P.2109 median building entry\n#                     loss), where the tag still fixes from the UHF band.\n#\n# Channels: the UHF and L-band carrier-to-noise densities (C/N0) over the pass, and the\n# hot-start energy per UHF fix and battery life at one fix per hour that the pass's\n# median C/N0 gives (constant within a phase). Indoors the lower C/N0 lengthens the\n# acquisition and the energy per fix grows.\n#\n# MODELLED: acquisition, time to first fix and energy from stated receiver assumptions;\n# representative EIRPs; not a measured tag.\nkind = \"campaign\"\ntitle = \"Container tracking with LEO UHF: energy per fix along a journey\"\nseed = 20260929\n\n[timeline]\nstep_s = 10.0\n\n[[phases]]\nname = \"port-hamburg\"\nduration_s = 480.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"uhf_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[0].cn0_dbhz\" },\n  { channel = \"l_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[1].cn0_dbhz\" },\n  { channel = \"uhf_hot_energy_per_fix_mj\", unit = \"mJ\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].hot.energy_per_fix_mj\" },\n  { channel = \"uhf_battery_life_hourly_days\", unit = \"day\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].duty_cycle_hot[4].battery_life_days\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Container tag, port-hamburg\"\nepoch = \"2026-09-28T06:00:00\"\nduration_s = 480.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 53.54\nlon_deg = 9.97\nheight_m = 5.0\nspeed_m_s = 0.0\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\"]\nmax_elevation_deg = 60.0\ntca_s = 240.0\n[phases.runs.scenario.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n[phases.runs.scenario.iot]\nactive_power_mw = 20.0\nsleep_power_uw = 5.0\nbattery_mwh = 2000.0\ndetection_snr_db = 16.0\nmax_coherent_ms = 20.0\nparallel_code_search = true\naided_doppler_uncertainty_hz = 500.0\nfix_intervals_s = [1.0, 10.0, 60.0, 600.0, 3600.0, 86400.0]\ncn0_from = \"median\"\n\n[[phases]]\nname = \"north-sea\"\nduration_s = 480.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"uhf_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[0].cn0_dbhz\" },\n  { channel = \"l_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[1].cn0_dbhz\" },\n  { channel = \"uhf_hot_energy_per_fix_mj\", unit = \"mJ\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].hot.energy_per_fix_mj\" },\n  { channel = \"uhf_battery_life_hourly_days\", unit = \"day\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].duty_cycle_hot[4].battery_life_days\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Container tag, north-sea\"\nepoch = \"2026-09-28T06:00:00\"\nduration_s = 480.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"maritime\"\nlat_deg = 54.5\nlon_deg = 6.5\nheight_m = 15.0\nspeed_m_s = 8.0\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\"]\nmax_elevation_deg = 60.0\ntca_s = 240.0\n[phases.runs.scenario.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n[phases.runs.scenario.iot]\nactive_power_mw = 20.0\nsleep_power_uw = 5.0\nbattery_mwh = 2000.0\ndetection_snr_db = 16.0\nmax_coherent_ms = 20.0\nparallel_code_search = true\naided_doppler_uncertainty_hz = 500.0\nfix_intervals_s = [1.0, 10.0, 60.0, 600.0, 3600.0, 86400.0]\ncn0_from = \"median\"\n\n[[phases]]\nname = \"inland-warehouse\"\nduration_s = 480.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"uhf_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[0].cn0_dbhz\" },\n  { channel = \"l_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[1].cn0_dbhz\" },\n  { channel = \"uhf_hot_energy_per_fix_mj\", unit = \"mJ\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].hot.energy_per_fix_mj\" },\n  { channel = \"uhf_battery_life_hourly_days\", unit = \"day\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].duty_cycle_hot[4].battery_life_days\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Container tag, inland-warehouse\"\nepoch = \"2026-09-28T06:00:00\"\nduration_s = 480.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"indoor\"\nlat_deg = 52.37\nlon_deg = 9.73\nheight_m = 60.0\nspeed_m_s = 0.0\nbuilding = \"traditional\"\nbuilding_probability = 0.5\nantenna = \"hemispherical\"\ngain_dbi = 0.0\npolarisation = \"linear\"\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\"]\nmax_elevation_deg = 60.0\ntca_s = 240.0\n[phases.runs.scenario.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n[phases.runs.scenario.iot]\nactive_power_mw = 20.0\nsleep_power_uw = 5.0\nbattery_mwh = 2000.0\ndetection_snr_db = 16.0\nmax_coherent_ms = 20.0\nparallel_code_search = true\naided_doppler_uncertainty_hz = 500.0\nfix_intervals_s = [1.0, 10.0, 60.0, 600.0, 3600.0, 86400.0]\ncn0_from = \"median\"\n", "leo-vertical-autonomous-vehicle-skyline.toml": "# LEO-PNT vertical: the autonomous-vehicle urban canyon, as a flat cut-off and as a street.\n#\n# The `leo-vertical-autonomous-vehicle` urban canyon twice over: once as that campaign's flat\n# 35 deg elevation cut-off (the phase copied unchanged) and once as a street, the\n# `city-street` skyline preset turned to run east along the car's heading\n# (`street_az_deg = 90`) over a 10 deg receiver mask. The street is 20 m between 30 m walls\n# with the antenna 1.5 m up, so the walls rise to 70.7 deg across it and fall to the mask\n# along it. Each phase runs the same `leo-pvt` joint fix (GPS, Galileo and a generic low\n# Earth orbit (LEO) layer of 240 satellites at 1080 km, 53 deg, 0.25 m signal-in-space range\n# error) against the 1.5 m lane-level threshold, and a `leo-pass` run of one LEO pass seen\n# from the car. The existing campaign is not changed, so its outputs stay byte-identical.\n#\n# What the run shows: the flat cut-off keeps 8 GPS and Galileo satellites (mean GNSS-only\n# error 5.8 m); the street keeps 4 to 5 of them, the ones along it or high overhead (mean\n# 7.3 m, no GNSS-only fix at 2 of 90 epochs), and 1 to 4 LEO satellites against 4 to 5. The\n# fused mean error is 2.1 m in both, and the alarm is raised at about 51 % of the flat-cut\n# epochs and 59 % of the street epochs. A single cut-off and a street of the same severity\n# are not interchangeable: the street keeps fewer satellites but along one axis.\n#\n# The skyline preset is REPRESENTATIVE (provenance in docs/SKYLINE.md and `kshana skyline\n# --preset city-street`), not a survey of any Munich street. Line of sight only: no\n# multipath, diffraction or non-line-of-sight reception. MODELLED.\nkind = \"campaign\"\ntitle = \"Autonomous vehicle in an urban canyon: a flat cut-off and a city-street skyline\"\nseed = 20260929\n\n[timeline]\nstep_s = 10.0\n\n[[phases]]\nname = \"urban-canyon\"\nduration_s = 900.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"gnss_error_m\", unit = \"m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_gnss_m\" },\n  { channel = \"position_error_m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_fused_m\" },\n  { channel = \"gnss_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_gnss\" },\n  { channel = \"leo_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_leo\" },\n]\nalarms = [{ channel = \"position_error_m\", compare = \"above\", threshold = 1.5 }]\n[phases.runs.scenario]\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 3\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\n[[phases.runs.scenario.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [35.0, 45.0]\nsisre_m = 0.6\nmask_deg = 35.0\n[[phases.runs.scenario.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [35.0, 45.0]\nsisre_m = 0.3\nisb_ns = 12.0\nmask_deg = 35.0\n[[phases.runs.scenario.system]]\nname = \"Generic LEO\"\nrole = \"leo\"\ncarrier_hz = 1191.795e6\nchip_rate_hz = 10.23e6\ncn0_dbhz = [45.0, 58.0]\nsisre_m = 0.25\nisb_ns = 25.0\nmask_deg = 35.0\n[[phases.runs.scenario.system.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"leo_pass_elevation_deg\", unit = \"deg\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].elevation_deg\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\nspeed_m_s = 14.0\nheading_deg = 90.0\nmask_deg = 35.0\nantenna = \"patch\"\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"L\"]\nmax_elevation_deg = 80.0\ntca_s = 450.0\naltitude_km = 1080.0\ninclination_deg = 53.0\n[phases.runs.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\n\n[[phases]]\nname = \"city-street-skyline\"\nduration_s = 900.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"gnss_error_m\", unit = \"m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_gnss_m\" },\n  { channel = \"position_error_m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_fused_m\" },\n  { channel = \"gnss_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_gnss\" },\n  { channel = \"leo_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_leo\" },\n]\nalarms = [{ channel = \"position_error_m\", compare = \"above\", threshold = 1.5 }]\n[phases.runs.scenario]\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 3\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\n[[phases.runs.scenario.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [35.0, 45.0]\nsisre_m = 0.6\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [35.0, 45.0]\nsisre_m = 0.3\nisb_ns = 12.0\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Generic LEO\"\nrole = \"leo\"\ncarrier_hz = 1191.795e6\nchip_rate_hz = 10.23e6\ncn0_dbhz = [45.0, 58.0]\nsisre_m = 0.25\nisb_ns = 25.0\nmask_deg = 10.0\n[phases.runs.scenario.skyline]\npreset = \"city-street\"\nstreet_az_deg = 90.0\n[[phases.runs.scenario.system.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"leo_pass_elevation_deg\", unit = \"deg\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].elevation_deg\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\nspeed_m_s = 14.0\nheading_deg = 90.0\nmask_deg = 10.0\nantenna = \"patch\"\n[phases.runs.scenario.skyline]\npreset = \"city-street\"\nstreet_az_deg = 90.0\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"L\"]\nmax_elevation_deg = 80.0\ntca_s = 450.0\naltitude_km = 1080.0\ninclination_deg = 53.0\n[phases.runs.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\n", "leo-vertical-autonomous-vehicle.toml": "# LEO-PNT vertical: autonomous vehicles, an urban canyon with a LEO layer.\n#\n# A car drives east through Munich. On the open road every satellite above 10 deg is\n# usable; in the urban canyon the buildings hide everything below 35 deg. Each phase runs\n# a `leo-pvt` joint fix (GPS, Galileo and a generic low Earth orbit (LEO) layer of 240\n# satellites at 1080 km, 53 deg, with a 0.25 m signal-in-space range error), comparing the\n# GNSS-only error with the fused GNSS + LEO error against a 1.5 m lane-level threshold,\n# and a `leo-pass` run of one LEO pass seen from the moving car (its geometry is what the\n# campaign exports).\n#\n# In the canyon GPS and Galileo keep 8 satellites above 35 deg and their geometry turns\n# poor; the LEO layer adds 4 to 5 more and cuts the mean error from about 5.8 m to about\n# 2.1 m, but a single elevation cut-off still leaves the fused error above the lane-level\n# threshold at about half the canyon epochs, where the alarm is raised.\n#\n# MODELLED: a building mask as a single elevation cut-off (no multipath, no\n# non-line-of-sight signals); representative LEO signal and range error. The\n# `automotive-urban-canyon` scenario covers the inertial side of the same drive.\nkind = \"campaign\"\ntitle = \"Autonomous vehicle in an urban canyon with a LEO layer\"\nseed = 20260929\n\n[timeline]\nstep_s = 10.0\n\n[[phases]]\nname = \"open-road\"\nduration_s = 600.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"gnss_error_m\", unit = \"m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_gnss_m\" },\n  { channel = \"position_error_m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_fused_m\" },\n  { channel = \"gnss_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_gnss\" },\n  { channel = \"leo_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_leo\" },\n]\nalarms = [{ channel = \"position_error_m\", compare = \"above\", threshold = 1.5 }]\n[phases.runs.scenario]\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 3\nduration_s = 600.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\n[[phases.runs.scenario.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [35.0, 45.0]\nsisre_m = 0.6\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [35.0, 45.0]\nsisre_m = 0.3\nisb_ns = 12.0\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Generic LEO\"\nrole = \"leo\"\ncarrier_hz = 1191.795e6\nchip_rate_hz = 10.23e6\ncn0_dbhz = [45.0, 58.0]\nsisre_m = 0.25\nisb_ns = 25.0\nmask_deg = 10.0\n[[phases.runs.scenario.system.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"leo_pass_elevation_deg\", unit = \"deg\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].elevation_deg\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 600.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\nspeed_m_s = 14.0\nheading_deg = 90.0\nmask_deg = 10.0\nantenna = \"patch\"\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"L\"]\nmax_elevation_deg = 75.0\ntca_s = 300.0\naltitude_km = 1080.0\ninclination_deg = 53.0\n[phases.runs.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\n\n[[phases]]\nname = \"urban-canyon\"\nduration_s = 900.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"gnss_error_m\", unit = \"m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_gnss_m\" },\n  { channel = \"position_error_m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_fused_m\" },\n  { channel = \"gnss_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_gnss\" },\n  { channel = \"leo_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_leo\" },\n]\nalarms = [{ channel = \"position_error_m\", compare = \"above\", threshold = 1.5 }]\n[phases.runs.scenario]\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 3\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\n[[phases.runs.scenario.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [35.0, 45.0]\nsisre_m = 0.6\nmask_deg = 35.0\n[[phases.runs.scenario.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [35.0, 45.0]\nsisre_m = 0.3\nisb_ns = 12.0\nmask_deg = 35.0\n[[phases.runs.scenario.system]]\nname = \"Generic LEO\"\nrole = \"leo\"\ncarrier_hz = 1191.795e6\nchip_rate_hz = 10.23e6\ncn0_dbhz = [45.0, 58.0]\nsisre_m = 0.25\nisb_ns = 25.0\nmask_deg = 35.0\n[[phases.runs.scenario.system.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"leo_pass_elevation_deg\", unit = \"deg\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].elevation_deg\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\nspeed_m_s = 14.0\nheading_deg = 90.0\nmask_deg = 35.0\nantenna = \"patch\"\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"L\"]\nmax_elevation_deg = 80.0\ntca_s = 450.0\naltitude_km = 1080.0\ninclination_deg = 53.0\n[phases.runs.scenario.gnss]\nconstellation = \"galileo\"\nband = \"E1\"\n", "leo-vertical-critical-infrastructure-timing.toml": "# LEO-PNT vertical: critical infrastructure timing, holdover with LEO time.\n#\n# A grid-edge time server at a substation in Boulder, Colorado must hold the 1 microsecond\n# synchronisation that power-system protection and phasor measurement need (the IEC/IEEE\n# 61850-9-3 power profile). Its oscillator is a temperature-compensated crystal (TCXO)\n# class part, disciplined to GNSS. When GNSS is lost:\n#\n#   gnss-locked  (10 min) the `clock` kind's TCXO tracks GNSS: time error near zero.\n#   gnss-denied  (24 h) the same TCXO coasts on its own: its random-walk frequency noise\n#                makes the time error grow as t^1.5, through the 1000 ns guard a little\n#                over an hour after the loss and to about 29 microseconds by the end of\n#                the day. Beside it, a `leo-pvt` timing run disciplines the same TCXO class\n#                to the Iridium constellation (the public `iridium-stl` preset: 66\n#                satellites at 780 km, L-band bursts 25 to 34 dB above GPS), holding\n#                between passes, and converts system time to UTC (Coordinated Universal\n#                Time) with the broadcast offset. A `leo-pass` run of one Iridium pass over\n#                the site carries the geometry the campaign exports.\n#\n# The alarm is raised on the LEO-disciplined time error against the 1000 ns guard; it\n# stays down. The free-running error is shown for comparison and is not alarmed. Both\n# runs use the same oscillator noise (the engine's TCXO class); the deterministic\n# frequency offset and ageing are taken as calibrated at the loss of GNSS.\n#\n# NIST measured Iridium PNT timing receivers with a miniature atomic clock within 40 ns of\n# UTC(NIST) over 40 days (https://www.nist.gov/publications/validating-timing-performance-improvement-ionospheric-corrections-iridium-pnt-receivers);\n# the modelled figures are a consistency comparison with that, not a reproduction.\n# MODELLED.\nkind = \"campaign\"\ntitle = \"Critical infrastructure timing: holdover with LEO time\"\nseed = 20260929\n\n[timeline]\nstep_s = 300.0\n\n[[phases]]\nname = \"gnss-locked\"\nduration_s = 600.0\n\n[[phases.runs]]\nalarms = []\n[phases.runs.scenario]\nseed = 42\nthreshold_ns = 1000.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 600.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown. Not read by this campaign.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"tcxo-class\"\nprovenance = \"The engine's TCXO class (EndRun Technologies disciplined-oscillator data sheet, basic TCXO, Allan deviation 2.0e-10 at 1 s): q_wf = (2e-10)^2, q_rw = 3*(2e-12)^2, the same PSDs the leo-pvt timing run uses for class tcxo\"\ny0 = 0.0\nq_wf = 4.0e-20\nq_rw = 1.2e-23\n\n[[phases]]\nname = \"gnss-denied\"\nduration_s = 86400.0\n\n[[phases.runs]]\nalarms = []\n[phases.runs.scenario]\nseed = 43\nthreshold_ns = 1000.0\n[phases.runs.scenario.time]\nstep_s = 300.0\nduration_s = 86400.0\n[phases.runs.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 300.0, state = \"nominal\" },\n  { t0 = 300.0, t1 = 86400.0, state = \"denied\" },\n]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown. Not read by this campaign.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"tcxo-class\"\nprovenance = \"The engine's TCXO class (EndRun Technologies disciplined-oscillator data sheet, basic TCXO, Allan deviation 2.0e-10 at 1 s): q_wf = (2e-10)^2, q_rw = 3*(2e-12)^2, the same PSDs the leo-pvt timing run uses for class tcxo\"\ny0 = 0.0\nq_wf = 4.0e-20\nq_rw = 1.2e-23\n\n[[phases.runs]]\nseries = [\n  { channel = \"leo_time_error_ns\", unit = \"ns\", t = \"timing.rows[0].series[].t_s\", y = \"timing.rows[0].series[].error_ns\" },\n  { channel = \"leo_time_sigma_ns\", unit = \"ns\", t = \"timing.rows[0].series[].t_s\", y = \"timing.rows[0].series[].sigma_ns\" },\n]\nalarms = [{ channel = \"leo_time_error_ns\", compare = \"abs_above\", threshold = 1000.0 }]\n[phases.runs.scenario]\nkind = \"leo-pvt\"\nmode = \"timing\"\nseed = 9\nduration_s = 86400.0\nstep_s = 30.0\n[phases.runs.scenario.user]\nlat_deg = 39.99\nlon_deg = -105.26\nheight_m = 1655.0\n[phases.runs.scenario.timing]\nclocks = [\"tcxo\"]\ncn0_offsets_db = [0.0]\nweek = 2436\ntow0_s = 172800.0\ntrace = true\n[phases.runs.scenario.timing.utc]\na0_s = 4.0e-9\na1_s_per_s = 1.0e-14\nt_ot_s = 147456.0\nwn_t = 2436\ndelta_t_ls_s = 18.0\nsigma_s = 5.0e-9\n[[phases.runs.scenario.system]]\nname = \"Iridium\"\nleo_preset = \"iridium-stl\"\nmask_deg = 15.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"iridium_pass_elevation_deg\", unit = \"deg\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].elevation_deg\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Iridium pass over the substation\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 39.99\nlon_deg = -105.26\nheight_m = 1655.0\nmask_deg = 15.0\n[[phases.runs.scenario.satellite]]\nid = \"Iridium-pass\"\nsystem = \"iridium-stl\"\nmax_elevation_deg = 70.0\ntca_s = 450.0\n[phases.runs.scenario.gnss]\nenabled = false\n", "leo-vertical-polar-arctic.toml": "# LEO-PNT vertical: polar and Arctic users.\n#\n# GNSS medium Earth orbit (MEO) planes are inclined 55 to 56 deg, so from the Arctic every\n# GNSS satellite sits in the southern half of the sky at low elevation, and the vertical\n# geometry suffers. A polar low Earth orbit (LEO) constellation passes overhead there\n# most often. A user travels north through three phases of an hour each, Tromso (69.7 N),\n# Longyearbyen on Svalbard (78.2 N) and the North Pole drift ice (89.5 N); each phase runs\n# a `leo-pvt` joint fix of GPS and Galileo, with and without the Iridium constellation (the\n# public `iridium-stl` preset: 66 satellites at 780 km, 86.4 deg, with its representative\n# 5 m signal-in-space range error), and a `leo-pass` run of the three highest Iridium\n# passes of a quarter hour over the site, whose geometry the campaign exports.\n#\n# Channels: the GNSS-only and fused 3D errors, their position dilution of precision\n# (PDOP) and the satellites in view. The alarm is raised where the fused error exceeds\n# 3 m. `polar-arctic-leo-coverage` gives the same comparison as a table over latitude.\n#\n# MODELLED: two-body orbits with J2 from each constellation preset; no ionospheric\n# scintillation, which the auroral zone would add.\nkind = \"campaign\"\ntitle = \"Polar and Arctic users with a polar LEO layer\"\nseed = 20260929\n\n[timeline]\nstep_s = 60.0\n\n[[phases]]\nname = \"tromso\"\nduration_s = 3600.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"gnss_error_m\", unit = \"m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_gnss_m\" },\n  { channel = \"position_error_m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_fused_m\" },\n  { channel = \"pdop_gnss\", unit = \"1\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].pdop_gnss\" },\n  { channel = \"pdop_fused\", unit = \"1\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].pdop_fused\" },\n  { channel = \"gnss_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_gnss\" },\n  { channel = \"leo_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_leo\" },\n]\nalarms = [{ channel = \"position_error_m\", compare = \"above\", threshold = 3.0 }]\n[phases.runs.scenario]\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 4\nduration_s = 3600.0\nstep_s = 60.0\n[phases.runs.scenario.user]\nlat_deg = 69.65\nlon_deg = 18.96\nheight_m = 20.0\n[[phases.runs.scenario.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Iridium\"\nleo_preset = \"iridium-stl\"\nisb_ns = 30.0\nmask_deg = 10.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"iridium_pass_elevation_deg\", unit = \"deg\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].elevation_deg\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Iridium pass, tromso\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 69.65\nlon_deg = 18.96\nheight_m = 20.0\nmask_deg = 10.0\n[[phases.runs.scenario.leo_constellation]]\nsystem = \"iridium-stl\"\nmax_satellites = 3\n[phases.runs.scenario.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n\n[[phases]]\nname = \"svalbard\"\nduration_s = 3600.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"gnss_error_m\", unit = \"m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_gnss_m\" },\n  { channel = \"position_error_m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_fused_m\" },\n  { channel = \"pdop_gnss\", unit = \"1\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].pdop_gnss\" },\n  { channel = \"pdop_fused\", unit = \"1\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].pdop_fused\" },\n  { channel = \"gnss_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_gnss\" },\n  { channel = \"leo_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_leo\" },\n]\nalarms = [{ channel = \"position_error_m\", compare = \"above\", threshold = 3.0 }]\n[phases.runs.scenario]\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 4\nduration_s = 3600.0\nstep_s = 60.0\n[phases.runs.scenario.user]\nlat_deg = 78.22\nlon_deg = 15.65\nheight_m = 10.0\n[[phases.runs.scenario.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Iridium\"\nleo_preset = \"iridium-stl\"\nisb_ns = 30.0\nmask_deg = 10.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"iridium_pass_elevation_deg\", unit = \"deg\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].elevation_deg\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Iridium pass, svalbard\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 78.22\nlon_deg = 15.65\nheight_m = 10.0\nmask_deg = 10.0\n[[phases.runs.scenario.leo_constellation]]\nsystem = \"iridium-stl\"\nmax_satellites = 3\n[phases.runs.scenario.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n\n[[phases]]\nname = \"north-pole\"\nduration_s = 3600.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"gnss_error_m\", unit = \"m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_gnss_m\" },\n  { channel = \"position_error_m\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].error_fused_m\" },\n  { channel = \"pdop_gnss\", unit = \"1\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].pdop_gnss\" },\n  { channel = \"pdop_fused\", unit = \"1\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].pdop_fused\" },\n  { channel = \"gnss_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_gnss\" },\n  { channel = \"leo_in_view\", unit = \"count\", t = \"joint.epochs[].t_s\", y = \"joint.epochs[].n_leo\" },\n]\nalarms = [{ channel = \"position_error_m\", compare = \"above\", threshold = 3.0 }]\n[phases.runs.scenario]\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 4\nduration_s = 3600.0\nstep_s = 60.0\n[phases.runs.scenario.user]\nlat_deg = 89.5\nlon_deg = 0.0\nheight_m = 0.0\n[[phases.runs.scenario.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\nmask_deg = 10.0\n[[phases.runs.scenario.system]]\nname = \"Iridium\"\nleo_preset = \"iridium-stl\"\nisb_ns = 30.0\nmask_deg = 10.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"iridium_pass_elevation_deg\", unit = \"deg\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].elevation_deg\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Iridium pass, north-pole\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 89.5\nlon_deg = 0.0\nheight_m = 0.0\nmask_deg = 10.0\n[[phases.runs.scenario.leo_constellation]]\nsystem = \"iridium-stl\"\nmax_satellites = 3\n[phases.runs.scenario.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n", "leo-vertical-rail-maritime.toml": "# LEO-PNT vertical: railway and maritime, the bundled maritime and rail scenarios plus LEO.\n#\n# Three phases reuse the engine's own maritime and rail scenarios unchanged and add a low\n# Earth orbit (LEO) positioning, navigation and timing (PNT) pass for the same platform:\n#\n#   strait-jammed  `maritime-strait-jamming` (a ship in the Gulf of Finland, a 17 dBW\n#                  broadband L1 jammer about 30 km away): the GNSS carriers fall below\n#                  the 25 dB-Hz floor. A `leo-pass` run of the same ship (maritime user,\n#                  8 m/s) tracks a generic LEO satellite (1080 km, 97 deg polar orbit)\n#                  in its S and C bands, which the L1 jammer does not reach.\n#   rail-tunnel    `rail-tunnel-coast` (a train at 44.4 m/s coasting on a tactical inertial\n#                  unit in a tunnel, no aiding): the event marks the moment its position\n#                  error reaches 2 m, the kind's own crossing time.\n#   rail-open      back in the open, a `leo-pass` run of the train (160 km/h east of\n#                  Hamburg) tracks a generic LEO satellite (1080 km, 97 deg) in its L\n#                  and S bands, the signals a re-acquiring receiver would use to end\n#                  the coast.\n#\n# The alarm follows the jamming kind's own rule (fewer than four GNSS satellites\n# tracking) in the strait. The jamming and LEO runs do not share a model: the leo-pass kind\n# has no jammer, and the S and C bands are outside the L1 jammer's 20 MHz by construction.\n# MODELLED.\nkind = \"campaign\"\ntitle = \"Railway and maritime with a LEO layer\"\nseed = 20260929\n\n[timeline]\nstep_s = 10.0\n\n[[phases]]\nname = \"strait-jammed\"\nduration_s = 1800.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 1800.0\n[phases.runs.scenario.receiver]\nlat_deg = 59.80\nlon_deg = 24.90\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[phases.runs.scenario.jammer]\nposition_ecef_m = [2904623.523, 1381438.498, 5489328.347]\npower_dbw = 17.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"leo_cn0_s_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[0].cn0_dbhz\" },\n  { channel = \"leo_cn0_c_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[1].cn0_dbhz\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Ship in the Gulf of Finland\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"maritime\"\nlat_deg = 59.8\nlon_deg = 24.9\nheight_m = 10.0\nspeed_m_s = 8.0\nheading_deg = 45.0\nmask_deg = 5.0\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"S\", \"C\"]\nmax_elevation_deg = 75.0\ntca_s = 450.0\naltitude_km = 1080.0\ninclination_deg = 97.0\n[phases.runs.scenario.gnss]\nenabled = false\n\n[[phases]]\nname = \"rail-tunnel\"\nduration_s = 120.0\n\n[[phases.runs]]\nevents = [{ label = \"inertial coast error reaches 2 m\", at = \"crossings[0].coast_s\" }]\n[phases.runs.scenario]\nkind = \"ins-trn-coast\"\nimu_grade = \"tactical\"\nspeed_m_s = 44.4\nref_accel_m_s2 = 0.0\ncombination = \"rss\"\ncrossing_thresholds_m = [2.0, 20.0]\ndrift_band_lo_m_per_s = 0.001\ndrift_band_hi_m_per_s = 0.050\ntrn_fix_mode = \"none\"\nmission_duration_s = 600.0\n\n[[phases]]\nname = \"rail-open\"\nduration_s = 600.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"leo_cn0_l_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[0].cn0_dbhz\" },\n  { channel = \"leo_cn0_s_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[1].cn0_dbhz\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Train east of Hamburg\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 600.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 53.55\nlon_deg = 10.3\nheight_m = 20.0\nspeed_m_s = 44.4\nheading_deg = 90.0\nmask_deg = 5.0\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"L\", \"S\"]\nmax_elevation_deg = 70.0\ntca_s = 300.0\naltitude_km = 1080.0\ninclination_deg = 97.0\n[phases.runs.scenario.gnss]\nenabled = false\n", "link-budget.toml": "# One-way link budget demonstrator (comms & link budgets, trade-study tier).\n#\n# Applies the CCSDS 401 / DSN 810-005 link equation\n#   C/N0 = EIRP - FSPL - L_other + G/T - k ;  Eb/N0 = C/N0 - 10log10(R_b)\n# and reports free-space path loss, C/N0, Eb/N0, margin and whether the link closes\n# against a required Eb/N0.\n#\n# HONEST SCOPE: a deterministic engineering calculation from the supplied inputs\n# (EIRP / G/T / range / rate / losses) -- NOT a calibrated terminal datasheet.\n# Run:  kshana scenarios/link-budget.toml\nkind = \"link-budget\"\n\nband = \"x\"                  # s | x | ka (sets the free-space-loss frequency)\neirp_dbw = 55.0\ng_over_t_db = 53.0\nrange_km = 2000.0\ndata_rate_bps = 1.0e6\nother_losses_db = 3.0\nrequired_eb_n0_db = 4.5\n\n# Optional: the receive system noise temperature (K). It is NOT an input to the link\n# equation -- that needs only the ratio G/T -- but stating it lets the report also give\n# the receive antenna gain the figure of merit implies (G = G/T + 10*log10(T_sys)).\n# Left out, the gain split is absent from the report rather than assumed.\n# tsys_k = 300.0\n", "lunanet-araim.toml": "# Lunar south-pole integrity: an Artemis-region landed receiver against a\n# representative LunaNet relay set, ARAIM protection levels over a 24 h pass.\n#\n# The lunar navigation signal is far weaker and the relay constellation far sparser\n# than GPS (LunaNet LNIS: σ_URE ≈ 30 m vs GPS ≈ 0.6 m), and the protection level\n# scales linearly with σ_URE — so this honestly surfaces the integrity gap: with\n# 30 m ranging the HPL is finite but exceeds a 50 m surface-ops alert limit, i.e. the\n# surface user is not yet \"available\". This is the quantitative statement that lunar\n# PNT integrity is hard, not a claim that it is met.\n#\n# Scope: a representative selenocentric relay sky (src/lunar.rs south_pole_hpl_pass),\n# not the precise differential-corrected 9:2 LANS NRHO — the CR3BP three-body core is\n# in src/cr3bp.rs; wiring real NRHO relay ephemerides + DE421 libration are follow-ons.\nkind = \"lunar-integrity\"\n\nstep_s = 3600.0        # 1 h samples\nduration_s = 86400.0   # 24 h pass\nalert_limit_m = 50.0   # LunaNet surface-ops alert limit\np_hmi = 1.0e-4         # lunar surface integrity-risk budget (not aviation 1e-7)\n", "lunar-attack-surface.toml": "# Lunar surface-navigation signal-security attack surface (paper P1).\n#\n# Composes the open signal-security analyses into one binary-reachable run:\n#   * link-budget power deficit vs a terrestrial GPS reference + the 12-18 dB\n#     sensitivity band (a genuine reference x EIRP x slant-range sweep) with the\n#     32x-rounded / 36x-unrounded linear-factor reconciliation,\n#   * the attacker transmit power required to spoof (J/S = 3 dB) and to deny\n#     (J/S = 30 dB) at each standoff (the inverse of the J/S link),\n#   * the orbital capture footprint under a real uniform-aperture antenna pattern\n#     (an altitude-limited sub-hemispheric cap whose limb is NOT captured),\n#   * a computed tracking-loop spoof-capture pull-in outcome (does a matched-code\n#     spoofer at +6 dB / 0.3-chip actually drag the DLL/PLL) rather than the\n#     asserted 3 dB threshold,\n#   * the airless-body geometric horizon reach of a raised surface transmitter, and\n#   * the OSNMA/TESLA authentication budget (20 bit/s = ~40 % of a 50 bit/s AFS nav\n#     message, key-disclosure latency, 2^-40 forgery).\n#\n# Every input is defaulted to the P1 baseline; the body below leaves them at their\n# defaults (so this reproduces the paper's headline figures) while naming the knobs.\n# Override any field to explore a different attacker / link geometry.\n\nkind = \"lunar-attack-surface\"\n\n# Link geometry (defaults shown for transparency).\nafs_eirp_dbw = 26.0\nuser_gain_dbi = 3.0\nslant_range_m = 3.0e6\ncarrier_hz = 2.4e9\ngps_reference_dbw = -155.0       # GPS L1 C/A typical received power, dBW (was -125.0, which is dBm)\ngps_reference_min_dbw = -158.5   # ICD-GPS-200 specification minimum, dBW (was -128.5, which is dBm)\n\n# Orbital transmitter + footprint.\ntransmitter_altitude_m = 100_000.0\nantenna_diameter_m = 1.0\nfootprint_grid = 400\n\n# Attacker standoffs (m) for the required-transmit-power curve.\nstandoffs_m = [1_000.0, 10_000.0, 100_000.0]\n\n# Representative spoofer for the tracking-loop pull-in.\nspoof_power_advantage_db = 6.0\nspoof_code_offset_chips = 0.3\n\n# Capture-footprint sweep axes: the captured fraction above is ONE operating point\n# (100 km, 1 m dish); these sweep it over transmitter altitude x beamwidth so the\n# fraction is read against the two inputs that set it, and so limb capture is reported\n# as a threshold (the altitude / beamwidth / transmit power at which it switches on)\n# rather than a boolean at a single point. Both defaults are chosen so the baseline\n# operating point above is an exact sample of the grid.\nfootprint_altitude_min_m = 20_000.0    # 20 km ... 500 km in 80 km steps\nfootprint_altitude_max_m = 500_000.0\nfootprint_altitude_steps = 7\nfootprint_altitude_scale = \"linear\"\nfootprint_diameter_min_m = 0.25        # 0.25 m ... 4 m, i.e. HPBW 29.2 deg ... 1.83 deg\nfootprint_diameter_max_m = 4.0\nfootprint_diameter_steps = 5\nfootprint_diameter_scale = \"log\"\n", "lunar-beacon.toml": "# Surface-beacon augmentation of a lunar orbital navigation service.\n#\n# A south-polar lunar user sees a sparse orbital constellation inside a narrow, slowly\n# moving patch of sky. Every line of sight points into roughly the same direction, so the\n# ranging design matrix is ill-conditioned and the dilution of precision is large — the\n# geometry problem, not a signal-power problem. A handful of SURVEYED SURFACE BEACONS fix\n# it cheaply: a beacon near the local horizon contributes the low-elevation, wide-azimuth\n# line-of-sight rows an all-overhead orbital set structurally cannot supply, and the\n# horizontal DOP collapses.\n#\n# This run reports three configurations at one epoch, so the two routes to usable geometry\n# can be compared directly:\n#\n#   * the satellites alone,\n#   * the satellites plus whichever beacons clear the horizon, and\n#   * a larger constellation instead — the expensive alternative to the same end.\n#\n# Each row carries its visible-source counts, its full DOP, and the realised 1-sigma\n# accuracy in METRES. That last step is the point: a bare \"PDOP 1.6\" is dimensionless and\n# easy to over-read, so the report multiplies it through a per-beacon user-equivalent\n# ranging error (the root-sum-square of the clock-synchronisation, multipath and survey\n# terms below) and states the answer as a distance.\n#\n# WHY THIS FILE EXISTS\n# The module behind this kind has been in the engine since L08/L09 and is checked against\n# an independent DOP path in tests/validate_p2_beacon_before_after_independent_dop.rs. But\n# it was not reachable from a run — no scenario kind, no dispatch arm, no bundled example.\n# The README advertised the capability; the verification matrix carried NO row for it at all.\n# So it was claimed in prose, unclaimed in the ledger, and unreachable in the engine at the\n# same time. A capability the engine cannot be ASKED to perform is not a capability of the\n# engine, and one the ledger does not list is not accounted for either.\n#\n# DEFAULTS ARE THE GOLDEN GEOMETRY\n# Every value below is the configuration that already carries a committed golden\n# (tests/validate_p2_beacon_before_after_table.rs against\n# tests/fixtures/lunar_service/beacon_before_after_golden.csv). Running this file therefore\n# reproduces a table an oracle already covers, instead of inventing a fresh configuration\n# whose numbers nothing checks. Change them freely — they are inputs, not constants.\n#\n# WHAT IS ANCHORED AND WHAT IS NOT\n# Anchored: the DOP assembly is the kernel cross-checked against gnss_lib_py in\n# tests/dop_reference.rs; beacon visibility is the airless-Moon two-height geometric horizon\n# closed form (no atmosphere, so there is no refractive extension and the bound is exact);\n# and sigma = DOP x sigma_URE is the standard relation (Kaplan & Hegarty, Understanding\n# GPS/GNSS, section 7).\n# NOT anchored — MODELLED inputs, every one: the constellation design, the beacon\n# placement, the antenna heights, and all three error-budget magnitudes. They are\n# representative choices, not a fielded survey or a measured link. Nothing here is a\n# service-performance commitment, a TRL claim, or affiliated with any agency's programme.\n\nkind = \"lunar-beacon\"\n\n# EVERY SCALAR KEY MUST STAY ABOVE THE [[beacons]] ARRAY BELOW.\n# In TOML, a bare key after an array-of-tables header belongs to that TABLE, not to the\n# document root. These keys were originally written underneath [[beacons]] and were\n# therefore parsed as fields of the LAST beacon, where serde silently dropped them: the\n# scenario ran entirely on its defaults, and because the defaults matched what was written\n# here, every printed number looked correct. `deny_unknown_fields` on BeaconSite now makes\n# that mistake an error instead of silence, and\n# tests/lunar_beacon_scenario_reference.rs asserts the parsed scenario really carries\n# these values.\n\n# A sparse six-satellite service, and a 24-satellite service as the contrast.\nn_satellites = 6\ncomparison_n_satellites = 24\nepoch_s = 0.0\nelevation_mask_deg = 5.0\n\n# Per-beacon ranging error budget, in metres of range. Root-sum-squared into sigma_URE.\nclock_sync_m = 1.0\nmultipath_m = 0.5\nsurvey_m = 0.3\n\n# The user: a south-polar site with a 2 m antenna.\n[user]\nlat_deg = -80.0\nlon_deg = 0.0\nalt_m = 2.0\n\n# Three surveyed beacons on 2 km relief, spread in azimuth about the user. The two flanking\n# sites at +/-60 deg longitude are what supply the wide-azimuth rows.\n[[beacons]]\nlat_deg = -80.0\nlon_deg = 0.0\nalt_m = 2000.0\n\n[[beacons]]\nlat_deg = -79.0\nlon_deg = 60.0\nalt_m = 2000.0\n\n[[beacons]]\nlat_deg = -79.0\nlon_deg = -60.0\nalt_m = 2000.0\n", "lunar-differential-pnt.toml": "# Lunar DIFFERENTIAL PNT — a lunar DGNSS / SBAS analogue.\n#\n# A NovaMoon-class reference station at a KNOWN selenographic location computes\n# per-satellite differential corrections from an ILLUSTRATIVE Moonlight / LCNS-class\n# constellation; a roving user offset from it by baseline_km applies those corrections so\n# the COMMON-MODE broadcast-ephemeris errors (orbit + clock) cancel.\n#\n# THE IDENTITY (what src/lunar_dpnt.rs implements):\n#   ref_error_i      = -e_i . u_ref_i  + c_i           (the correction the station broadcasts)\n#   user_raw_i       = -e_i . u_user_i + c_i\n#   corrected_user_i = user_raw_i - correction_i = -e_i . (u_user_i - u_ref_i)\n# The clock term c_i CANCELS EXACTLY (it is identical in both observations); the orbit\n# term collapses to the projection onto the DIFFERENCE of the two line-of-sight unit\n# vectors, which -> 0 as the baseline -> 0 (the spatial-decorrelation floor) and grows\n# ~linearly with baseline. Mapping the corrected per-satellite range errors through the\n# user geometry (a weighted-least-squares snapshot solve) gives the user POSITION error.\n#\n# NovaMoon is referenced only as a system CLASS (a public description of a lunar reference\n# station); the constellation reuses the illustrative public-source LCNS-class set. These\n# are illustrative parameters for exercising the differential method, NOT a real ephemeris,\n# and imply NO affiliation, endorsement, heritage, certification or TRL.\n#\n# HONESTY: MODELLED. The common-mode cancellation is an EXACT algebraic identity; the\n# spatial-decorrelation residual is a FIRST-ORDER geometric model (the LOS-difference\n# projection of an injected orbit error), not a fitted decorrelation model from real lunar\n# tracking. The user protection level REUSES the DO-229E SBAS protection-level machinery\n# (crate::sbas) with the differential residual sigma as the per-satellite error budget.\n# Deterministic given the seed. No real-data validation; no TRL/heritage/agency endorsement.\nkind = \"lunar-differential-pnt\"\n\n# Illustrative LCNS-class constellation (public-source approximation; not affiliated).\nn_sats = 8\nsma_km = 9737.4        # ~8000 km perilune altitude above the mean lunar radius\neccentricity = 0.6\ninc_deg = 57.7\nargp_deg = 90.0        # apolune over the southern hemisphere (south-pole favouring)\n\n# NovaMoon-class reference station at a known south-polar selenographic location.\nref_lat_deg = -89.0\nref_lon_deg = 0.0\n\n# User offset from the reference station along the surface (the baseline).\nbaseline_km = 50.0\n\n# Injected COMMON-MODE per-satellite broadcast errors (the errors the correction removes).\norbit_err_m = 100.0    # orbit-error vector magnitude (random direction per satellite)\nclock_err_m = 30.0     # clock error in range units (random sign per satellite)\nnoise_m = 0.0          # per-receiver measurement noise (0 => exact cancellation at 0 baseline)\n\nseed = 42\nt_s = 0.0              # epoch (seconds past the MCI/MCMF-aligned epoch)\n\n# Differential residual sigma fed to the SBAS DO-229E protection-level reuse.\nresidual_sigma_m = 5.0\np_hmi = 1e-4           # integrity-risk budget (interface parity; DO-229E K-factors fixed)\n\n# ── THE CORRECTION LINK ──────────────────────────────────────────────────────────────\n# The identity above assumes a PERFECT correction: computed by a station that knows\n# exactly where it stands, delivered instantly, at infinite resolution. None of the three\n# holds, and the three inputs below model what each costs. They feed the `correction_link`\n# block of the result document ONLY -- with all three at the values written here, every\n# number this scenario emitted before they existed is bit-for-bit unchanged.\n#\n# 1. SURVEY ERROR. The station forms its correction against the coordinate it BELIEVES.\n#    An error there rides on every correction it broadcasts and reaches the user as\n#    -delta . u_ref -- which contains no user geometry at all, so unlike the orbit term it\n#    neither vanishes at zero baseline nor grows with baseline, and it transfers about\n#    one-for-one into the user's position. Default 0.30 m is the crate's own lunar\n#    reference-frame position-realisation allocation (lunar_time_budget frame_pos_error_m),\n#    itself MODELLED: no lunar surface station has a published surveyed accuracy.\nsurvey_sigma_m = 0.30      # reference-station 3-D coordinate 1-sigma (m), isotropic\n\n# 2. CORRECTION AGEING. A correction computed at t and applied at t+tau is stale two ways.\n#    Orbit: the satellite has MOVED, so the frozen orbit-error vector now projects onto a\n#    rotated line of sight; the rotation comes from this crate's own propagator, so no\n#    orbit-error rate is assumed anywhere. Clock: the satellite clock has drifted by\n#    c*sigma_y(tau)*tau for the full-RAFS power law in crate::clock_specs, calibrated there\n#    to a published one-day spec row. ILLUSTRATIVE default -- no lunar correction link has\n#    a published latency -- which is why the report also emits a 0-300 s latency curve.\nlatency_s = 10.0           # age of the correction when the user applies it (s)\n\n# 3. QUANTIZATION. The correction crosses a finite-rate link. The quantizer range is NOT a\n#    free parameter: it is +/-(orbit_err_m + clock_err_m), an exact bound on the correction\n#    magnitude for the injected error model, so the step is 2*(100+30)/2^bits = 1.0156 m at\n#    8 bits and the residual variance is the uniform quantizer's step^2/12. The bit count\n#    itself is an ILLUSTRATIVE input; 0 disables the term.\nquantization_bits = 8      # bits per transmitted correction\n", "lunar-frame-campaign.toml": "# Seven-parameter Helmert lunar frame datum driven by a SIMULATED OBSERVING CAMPAIGN (G9).\n#\n# The lunar-frame-realisation scenario injects a known similarity transform and recovers\n# it — a solver unit test wearing the clothes of a result. This kind removes the planted\n# answer: a network of Earth stations observes a catalogue of lunar-surface beacons over an\n# explicit schedule, the lunar-VLBI delay partials are accumulated over that schedule into\n# a beacon-coordinate Fisher information matrix exactly as lunar-vlbi-fim does, and that\n# information is propagated through the Helmert design A = [I3 | [p]_x | p] at the\n# catalogue points into the datum covariance H = A^T M_b A.\n#\n# Nothing is recovered from a planted transform, so the reported datum accuracy derives\n# from the observing programme: halving the delay sigma halves it exactly, and lengthening\n# the arc improves it because the libration the report MEASURES\n# (sub_earth_direction_sweep_deg) is what separates the line-of-sight beacon coordinate\n# from the plane-of-sky ones.\n#\n# Beacon-error correlation is MEASURED, not assumed. With the stations held fixed no\n# observation touches two beacons, so the information matrix is exactly block-diagonal\n# (offblock_fraction 0); with the stations estimated the Schur-marginalised block is\n# coupled, the induced correlation is printed, and the whole propagation is re-run with it\n# discarded so the price of an independence assumption is a number rather than a claim.\n#\n# The same propagation under an isotropic per-coordinate sigma, and the recovery error the\n# lunar-frame-realisation scenario reports, are both run here and printed beside the\n# campaign value with their ratios.\n#\n# MODELLED: the beacon catalogue is sourced but the CAMPAIGN is simulated — the station\n# network and the delay sigma are illustrative inputs, individual delay observations are\n# treated as independent, and the Moon-centre ephemeris, station clocks, troposphere and\n# Earth-orientation parameters are held FIXED. Not a geodetic product.\n\nkind = \"lunar-frame-campaign\"\n", "lunar-frame-realisation.toml": "# Lunar reference-frame realisation — a 7-parameter Helmert (similarity) datum fit.\n#\n# Where src/lunar_frame.rs APPLIES the IAU 2015 WGCCRE lunar body orientation (a forward model),\n# src/lunar_frame_realise.rs ESTIMATES (realises) a lunar reference frame from a network of point\n# coordinates tied to a datum. The estimation core is a classic 7-parameter similarity transform\n# mapping points p_i (estimated frame) to q_i (datum frame):\n#\n#     q_i = t + (1 + s) * R(theta) * p_i\n#\n# with translation t (m), scale s (dimensionless, ~1e-6 level) and the small rotation\n# R(theta) = rz(theta_z) * ry(theta_y) * rx(theta_x). The seven parameters\n# [tx, ty, tz, theta_x, theta_y, theta_z, s] are estimated from >= 3 non-collinear point pairs by\n# weighted least squares via crate::batch_ls::gauss_newton (forward model flattens every q_i over\n# all three components; weights = 1/sigma^2; x0 = zeros). A small orientation tie expresses the\n# realised small rotation about the ICRF axes (relative to the IAU body orientation).\n#\n# THIS SCENARIO injects a KNOWN small Helmert transform (translation ~tens of m, rotation ~uradian,\n# scale ~1e-7) into a well-spread synthetic point network (varied selenographic lat/lon mapped to\n# MCMF, some points at altitude), adds seeded Gaussian noise, recovers the datum with helmert_fit,\n# and reports the recovered transform, the per-parameter recovery error vs the injected truth, and\n# the post-fit RMS residual.\n#\n# Honesty: MODELLED self-consistency. The oracle is the recovery of an injected 7-parameter\n# similarity transform (noiseless to ~machine precision) plus the algebraic round-trip identity of\n# apply_helmert. This is NOT a realisation of the lunar reference frame against real tracking / VLBI\n# data and claims no absolute frame accuracy. Deterministic (seeded). No TRL, flight heritage or\n# agency endorsement is claimed.\nkind = \"lunar-frame-realisation\"\n\n# Number of well-spread selenographic network points (>= 3).\nn_points = 8\n\n# Injected (truth) translation (m).\ntx_m = 25.0\nty_m = -40.0\ntz_m = 15.0\n\n# Injected (truth) small rotation (micro-radians).\nrot_x_urad = 3.0\nrot_y_urad = -2.0\nrot_z_urad = 5.0\n\n# Injected (truth) scale (parts-per-billion; 100 ppb = 1e-7).\nscale_ppb = 100.0\n\n# Per-coordinate measurement noise standard deviation (m); weights = 1/sigma^2.\nnoise_sigma_m = 1.0\n\n# Deterministic seed (measurement noise).\nseed = 42\n\n# Epoch (UTC) for the ICRF orientation tie.\nepoch_year = 2024\nepoch_month = 1\nepoch_day = 1\n", "lunar-infrastructure-carrier-phase.toml": "# Kshana lunar-infrastructure scenario: carrier-phase, the QUICK example (two short arcs, 10 draws, seconds;\n# the scored configuration, three arcs and 400 draws, is xval/lunar-infra/scenarios/carrier-phase-scored.toml). MODELLED; the design, inputs and bars are\n# fixed in xval/lunar-infra/PREREGISTRATION.md (committed before any run). ILLUSTRATIVE inputs\n# are labelled with their public sources there.\nkind = \"lunar-infrastructure\"\nstudy = \"carrier-phase\"\nseed = 20261019\n\n[orbit]\nfamily = \"nrho\"\nx0 = 1.0220\nz0 = -0.1800\nvy0 = -0.1020\nsample_s = 600.0\narcs_days = [0.25, 0.5]\n\n[surface]\nlat_deg = 0.0\nlon_deg = 0.0\n\n[gnss]\naltitude_km = 20180.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 2.0\ntx_power_dbw = 13.4\ntx_diameter_m = 0.35\ntx_efficiency = 0.6\nfreq_hz = 1575.42e6\nrx_gain_dbi = 25.0\nsystem_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\ndll_bn_hz = 0.25\nphase_bn_hz = 1.0\nsis_sigma_m = 0.5\n\n[monte_carlo]\ntrials = 10\n", "lunar-infrastructure-frame-coestimation.toml": "# Kshana lunar-infrastructure scenario: frame-coestimation. MODELLED; the design, inputs and bars are\n# fixed in xval/lunar-infra/PREREGISTRATION.md (committed before any run). ILLUSTRATIVE inputs\n# are labelled with their public sources there.\nkind = \"lunar-infrastructure\"\nstudy = \"frame-coestimation\"\nseed = 20261019\n\n[orbit]\nfamily = \"nrho\"\nx0 = 1.0220\nz0 = -0.1800\nvy0 = -0.1020\narc_days = 6.56\nsample_s = 900.0\n\n[llr]\nsigma_m = 0.05\nepochs = 200\n\n[surface]\nstations = [[-89.0, 0.0], [-45.0, 90.0], [0.0, 0.0], [30.0, -60.0]]\norbiter_range_sigma_m = 1.0\n", "lunar-infrastructure-geodesy-sensitivity.toml": "# Kshana lunar-infrastructure scenario: geodesy-sensitivity. MODELLED; the design, inputs and bars are\n# fixed in xval/lunar-infra/PREREGISTRATION.md (committed before any run). ILLUSTRATIVE inputs\n# are labelled with their public sources there.\nkind = \"lunar-infrastructure\"\nstudy = \"geodesy-sensitivity\"\nseed = 20261019\n\n[nominal]\nh2 = 0.0424\nk2 = 0.024116\nl2 = 0.0106\n\n[llr]\nsigma_m = 0.05\nepochs = 400\n\n[orbiter]\nsigma_mm_s = 0.05\narc_days = 27.3\nsample_s = 3600.0\n\n[gravimeter]\nsigma_nm_s2 = 10.0\nepochs = 1000\n\n[clock]\nsigma_fractional = 1.0e-16\nepochs = 100\n", "lunar-infrastructure-od-consistency-model-error.toml": "# Kshana lunar-infrastructure scenario: od-consistency with an unmodelled acceleration. MODELLED; the design, inputs and bars are\n# fixed in xval/lunar-infra/PREREGISTRATION.md (committed before any run). ILLUSTRATIVE inputs\n# are labelled with their public sources there.\nkind = \"lunar-infrastructure\"\nstudy = \"od-consistency\"\nseed = 20261019\n\n[orbit]\nfamily = \"nrho\"\nx0 = 1.0220\nz0 = -0.1800\nvy0 = -0.1020\narc_days = 3.0\nsample_s = 600.0\n\n[gnss]\naltitude_km = 20180.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 2.0\ntx_power_dbw = 13.4\ntx_diameter_m = 0.35\ntx_efficiency = 0.6\nfreq_hz = 1575.42e6\nrx_gain_dbi = 12.0\nsystem_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\ndll_bn_hz = 0.25\nsis_sigma_m = 1.0\n\n[ground]\nstations = [\"DSS-14\", \"DSS-63\", \"DSS-43\"]\nrange_sigma_m = 5.0\ndoppler_sigma_mm_s = 0.05\nmin_elevation_deg = 10.0\nearth_rotation_phase_deg = 0.0\n\n[monte_carlo]\ntrials = 400\nmodel_error_accel_m_s2 = 3.0e-10\n", "lunar-infrastructure-od-consistency.toml": "# Kshana lunar-infrastructure scenario: od-consistency. MODELLED; the design, inputs and bars are\n# fixed in xval/lunar-infra/PREREGISTRATION.md (committed before any run). ILLUSTRATIVE inputs\n# are labelled with their public sources there.\nkind = \"lunar-infrastructure\"\nstudy = \"od-consistency\"\nseed = 20261019\n\n[orbit]\nfamily = \"nrho\"\nx0 = 1.0220\nz0 = -0.1800\nvy0 = -0.1020\narc_days = 3.0\nsample_s = 600.0\n\n[gnss]\naltitude_km = 20180.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 2.0\ntx_power_dbw = 13.4\ntx_diameter_m = 0.35\ntx_efficiency = 0.6\nfreq_hz = 1575.42e6\nrx_gain_dbi = 12.0\nsystem_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\ndll_bn_hz = 0.25\nsis_sigma_m = 1.0\n\n[ground]\nstations = [\"DSS-14\", \"DSS-63\", \"DSS-43\"]\nrange_sigma_m = 5.0\ndoppler_sigma_mm_s = 0.05\nmin_elevation_deg = 10.0\nearth_rotation_phase_deg = 0.0\n\n[monte_carlo]\ntrials = 400\nmodel_error_accel_m_s2 = 0.0\n", "lunar-infrastructure-space-tie.toml": "# Kshana lunar-infrastructure scenario: space-tie. MODELLED; the design, inputs and bars are\n# fixed in xval/lunar-infra/PREREGISTRATION.md (committed before any run). ILLUSTRATIVE inputs\n# are labelled with their public sources there.\nkind = \"lunar-infrastructure\"\nstudy = \"space-tie\"\nseed = 20261019\n\n[orbit]\nfamily = \"nrho\"\nx0 = 1.0220\nz0 = -0.1800\nvy0 = -0.1020\narc_days = 6.56\nsample_s = 900.0\n\n[techniques]\ngnss_sigma_m = 10.0\nvlbi_sigma_m = 1.0\nslr_sigma_m = 0.1\nlocal_tie_sigma_m = 0.001\n", "lunar-interop-export.toml": "# Lunar interoperability export — LunaNet / IOAG-aligned, CCSDS-based interchange.\n#\n# Exports the lunar reference frame, the lunar time scale and a lunar ephemeris in\n# CCSDS-based interchange forms, with round-trip / field conformance as the oracle.\n#\n# WHAT src/lunar_interop.rs does:\n#   * export_lunar_oem  — REUSES the crate's CCSDS OEM 2.0 emitter (crate::oem),\n#     re-tagged for the lunar context: REF_FRAME = the IAU 2015 WGCCRE lunar body\n#     frame (MOON_ME / MOON_PA), TIME_SYSTEM = the lunar time scale (LTC / TCL / UTC),\n#     CENTER_NAME = MOON, over a sample ILLUSTRATIVE LCNS-class ephemeris (positions\n#     from crate::lunar_service, velocity by central finite difference).\n#   * export_lunar_time_metadata — a LunaNet/IOAG-aligned lunar-time descriptor (scale\n#     id, secular rate µs/day from crate::lunar_time, the published 56-59 µs/day band,\n#     reference surface) that round-trips via serde_json.\n#   * export_kif_lunar — wraps the OEM + time descriptor + frame label in the existing\n#     KIF envelope (crate::interchange) with the MODELLED honesty label.\n#   * oem_conformance — checks the required CCSDS/LunaNet header fields are present, the\n#     REF_FRAME/TIME_SYSTEM carry the expected lunar tokens, the META_START..META_STOP\n#     framing and the position+velocity data lines are well-formed.\n#\n# HONESTY: MODELLED. The field NAMES and units are aligned with PUBLIC standards\n# (CCSDS 502.0-B OEM, IAU WGCCRE 2015 lunar frames, LunaNet Interoperability\n# Specification / IOAG lunar architecture). The deterministic round-trip and the\n# field-name conformance are the oracle. This is NOT a certified interoperability\n# conformance test. The ephemeris is illustrative, public-source, NOT affiliated with\n# ESA, and implies no TRL / heritage / agency endorsement.\nkind = \"lunar-interop-export\"\n\n# Lunar body frame: MOON_ME (mean-Earth / polar-axis) or MOON_PA (principal-axis).\nframe = \"MOON_ME\"\n\n# Lunar time scale tag: LTC (Lunar Coordinate Time), TCL or UTC (the Earth tie).\ntime_system = \"LTC\"\n\n# Sample ephemeris grid.\nn_states = 9\nstep_min = 30.0\n\n# Informational epoch label (the OEM grid hangs off a fixed deterministic epoch).\nepoch = \"2030-01-01T00:00:00\"\n\n# Object name written to the OEM OBJECT_NAME / OBJECT_ID.\nobject = \"LCNS-ILLUSTRATIVE-1\"\n", "lunar-jamming.toml": "# Lunar-native RF jamming: per-satellite J/S for a lunar surface user.\n#\n# The `jamming` kind is Earth-shaped — it takes a Walker/SGP4 shell and a WGS-84\n# geodetic receiver, so a lunar case could only be assembled outside the engine by\n# running `link-budget` twice (once for the jammer leg, once for the satellite leg)\n# and subtracting the two received powers by hand. This kind runs that subtraction\n# inside the engine, per satellite, per epoch.\n#\n# It composes, and re-derives nothing:\n#   * jamming::j_over_s_db, effective_cn0_dbhz, rx_antenna_gain_db, lock_status,\n#     q_factor, nominal_cn0_dbhz, free_space_path_loss_db  (the interference chain),\n#   * lunar_service::LunarConstellation + topocentric, lunar::selenographic_to_mcmf\n#     (the lunar sky geometry: MCI -> MCMF, then az / el / slant range from a\n#     selenographic surface user).\n#\n# Unlike the Earth kind, the signal leg is not a fixed received power: each\n# satellite's isotropic received power is its own link budget,\n# `sat_eirp_dbw - FSPL(slant range, carrier)`, so the J/S moves satellite by\n# satellite with lunar range and elevation. The result is a TABLE — one row per\n# visible (epoch, satellite) link — published as JSON and as `*.table.csv`. The\n# aggregate figures of merit sit beside that table, never in place of it.\n#\n# Every field below is optional; the values shown are the defaults except for the\n# jammer block. Run it with:  kshana scenarios/lunar-jamming.toml\n#\n# MODELLED. The constellation is the illustrative, public-source Moonlight/LCNS-class\n# geometry (not the real ephemeris; no affiliation or endorsement implied), and the\n# interference model is a link budget: no terrain shadowing of the jammer (a\n# first-order effect in south-polar terrain), no multipath, no AGC near/far dynamics,\n# no adaptive nulling, no acquisition-vs-tracking hysteresis.\n\nkind = \"lunar-jamming\"\n\n# --- constellation (illustrative LCNS-class; apolune over the south) ------------\nn_sats = 4\nsma_km = 9737.4          # R_moon + 8000 km\neccentricity = 0.6\ninc_deg = 57.7\nargp_deg = 90.0\n\n# --- surface user (selenographic) ----------------------------------------------\nsite_lat_deg = -89.67    # Shackleton crater rim\nsite_lon_deg = 129.78\nsite_alt_m = 0.0\n\n# --- epoch grid ------------------------------------------------------------------\nhorizon_hours = 12.0\nstep_min = 60.0\nelev_mask_deg = 5.0\n\n# --- signal leg (link-budget leg 2, evaluated per satellite) ---------------------\nsat_eirp_dbw = 26.0            # representative lunar AFS EIRP\ncarrier_hz = 2.4e9             # S-band AFS carrier\nchip_rate_hz = 1.023e6         # despreading processing gain\nuser_boresight_gain_dbi = 3.0  # J/S is invariant to this; it moves C/N0 only\n\n# --- receiver ---------------------------------------------------------------------\ntemp_k = 290.0\ntracking_threshold_dbhz = 25.0\ndegraded_margin_db = 6.0\n\n# --- jammer (link-budget leg 1). Omit this whole block for a clean-sky baseline. --\n# Placed directly by standoff here. Give `lat_deg` and `lon_deg` instead to place it\n# selenographically, and its range and elevation come from the same lunar geometry\n# the satellites use (on an airless body a distant surface jammer then lands below\n# the local horizon, and the antenna pattern hands it the horizon gain).\n#\n# 25 km is chosen because it splits the table: part of the visible set holds on and\n# part does not. A single median J/S over these rows classifies the whole set as\n# lost, which is exactly the collapse this kind exists to avoid.\n[jammer]\npower_dbw = 10.0        # 10 W\ngain_dbi = 0.0\nrange_m = 25000.0\nel_deg = 0.0            # a surface jammer on the user's local horizon\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n", "lunar-joint-od-clock.toml": "# Lunar joint multi-technique OD + clock determination (a SIMULATED network).\n#\n# A single-epoch (snapshot) batch least-squares fit (src/lunar_combination.rs, on top of\n# crate::batch_ls::gauss_newton) that FUSES three observation techniques to recover, together:\n#   * a lunar surface station's 3-D position (NovaMoon-class, MCI metres),\n#   * a small lunar constellation's per-satellite positions (MCI metres), and\n#   * every asset's clock offset (station + each satellite, seconds).\n#\n# The three techniques:\n#   1. Earth-baseline geodetic VLBI delays to the lunar station treated as the VLBI beacon\n#      (reusing src/lunar_vlbi.rs, in geocentric inertial) — these make the station's FULL\n#      3-D position observable;\n#   2. lunar-local station<->satellite ranges (MCI Euclidean distance + the differenced clock\n#      term scaled by c) — these tie the satellite positions and clock differences;\n#   3. inter-satellite ranges (same form) — these tie the constellation's relative geometry.\n#\n# THE HEADLINE HONEST RESULT: lunar-local ranging alone leaves the station's position weakly\n# observed along one direction (the range-only solve is ill-conditioned and the recovered\n# station 3-D error is large). Adding the Earth-baseline VLBI delays makes the station's full\n# 3-D position observable, and the recovered station error collapses to the metre level. The\n# report runs the solve WITH and WITHOUT the VLBI legs on the same seed/truth and reports the\n# station-observability improvement factor.\n#\n# Honesty: MODELLED simulated closed-loop recovery. An injected truth is mapped to synthetic\n# observables through the SAME geometry model the solver inverts, seeded Gaussian noise is added,\n# and the estimator recovers the injected truth within the noise. The oracle is internal\n# consistency (truth recovery + NEES covariance realism), NOT real-data validation. There is no\n# force-model propagation inside the solver — the satellites are fixed, distinct, illustrative\n# points on a representative lunar orbit. No TRL, flight heritage or agency endorsement claimed.\nkind = \"lunar-joint-od-clock\"\n\n# Network size.\nn_sat = 3     # constellation satellites\nn_earth = 6   # Earth ground stations (more stations -> more independent VLBI baselines and\n              # better Earth->sat radiometric multilateration geometry)\n\n# Deterministic seed (measurement noise + truth jitter).\nseed = 42\n\n# Per-observable measurement noise standard deviations (weights = 1/sigma^2). Illustrative,\n# representative of the modelled class (geodetic VLBI, coherent two-way + optical ISL ranging).\nsigma_vlbi_s = 1.0e-11   # VLBI delay sigma (s) ~ 3 mm path length\nsigma_range_m = 0.1      # radiometric / lunar-local range sigma (m)\nsigma_isl_m = 0.1        # inter-satellite (optical) range sigma (m)\n\n# Lunar surface station (south-polar NovaMoon-class site), selenographic.\nstation_lat_deg = -88.0\nstation_lon_deg = 23.0\nstation_alt_m = 0.0\n\n# Representative constellation orbit radius (km, MCI) the illustrative fixed satellites sit on.\norbit_radius_km = 6000.0\n\n# Snapshot epoch (UTC).\nepoch_year = 2024\nepoch_month = 1\nepoch_day = 1\n", "lunar-llr-datum.toml": "# Seven-parameter Helmert lunar frame datum from a REAL, ARCHIVED observing campaign (V3).\n#\n# Where lunar-frame-campaign removed the injected transform but still stated its station\n# network, its schedule and its per-observation sigma as ILLUSTRATIVE inputs, this kind\n# takes all three from measurement:\n#\n#   * the epochs are the ground-transmit times of archived ILRS Consolidated Laser Ranging\n#     Data normal points;\n#   * the observations are the laser ranges really fired at the five retroreflector arrays\n#     on the Moon;\n#   * every observation weight is that normal point's OWN archived precision,\n#     bin_rms/sqrt(n_raw), read out of the file rather than assumed.\n#\n# Station coordinates come from the IERS ITRF2020 SLR solution propagated to epoch by their\n# published velocities; reflector coordinates from JPL DE430 Table 7 in the\n# mean-Earth/mean-rotation frame the IAU 2015 WGCCRE model realises.\n#\n# WHICH LINKS ARE MEASURED AND WHICH ARE MODELLED IS THE REPORT, NOT A FOOTNOTE. The\n# Moon-centre ephemeris and the IAU body orientation stay modelled, and their combined size\n# is emitted as the observed-minus-computed one-way range residual over every point used;\n# troposphere, solid-body tides, station eccentricity, polar motion, UT1-UTC, relativistic\n# delay and station clocks are absent and sit inside that residual. Because an ephemeris\n# error reaches a covariance only through the DIRECTION of each line of sight, every run\n# also re-solves the whole datum with all partials tilted by sensitivity_tilt_deg (sign\n# alternating) and emits the ratio — so the covariance's insensitivity to the modelled\n# ephemeris is a number, not an argument.\n#\n# Inter-array correlation is MEASURED at exactly zero rather than assumed, because a laser\n# range touches one array. A record the catalogues cannot place — a station with no\n# published ITRF position — is SKIPPED AND COUNTED, never given a substituted coordinate.\n# The simulated campaign's own figures are RUN and printed beside the measured ones.\n#\n# MODELLED: the seven-parameter figures are a Cramer-Rao bound for a reduced parameter set\n# on a real schedule. Not a solved datum, not an LLR analysis, not a geodetic product.\n#\n# DATA: the committed real-data slice ships with the repository but NOT with the published\n# crate. From a repository checkout this file runs as written; from the crate, set\n# data_dir to a copy of that slice.\n\nkind = \"lunar-llr-datum\"\n", "lunar-relay-constellation.toml": "# A lunar relay and navigation constellation: satellites in elliptical lunar frozen orbits\n# (ELFO) plus a circular low-lunar-orbit shell, scored as a coverage and dilution-of-precision\n# (DOP) map over the whole Moon for one day.\n#\n# The central body is the Moon: gravitational parameter, 1 737.4 km radius and spin rate come\n# from the body module (the DE and IAU values cited there). The design is illustrative, not\n# any agency's:\n#   - an ELFO shell: 8 satellites as a Walker 8/4/1 with perilune about 720 km and apolune\n#     about 7 500 km (semi-major axis 5 847.4 km, eccentricity 0.58), 57.8 deg inclination\n#     and argument of perilune 90 deg, so every satellite lingers at apolune over the south\n#     polar region;\n#   - a circular shell: 6 satellites as a Walker 6/3/1 at 1 500 km and 85 deg.\n#\n# One receiver clock is shared (clock = \"common\"): the relay set is one system on one time\n# scale. Latitude is lunar body-fixed; the map is an equirectangular projection with no land\n# outline.\n#\n# What the run answers: where on the Moon four or more of these satellites are in view above\n# a 10 deg mask, the PDOP/HDOP/VDOP/GDOP per 10 deg cell, and the share of the day with PDOP\n# at or below 6. MODELLED: two-body orbits around a spherical Moon (no Earth third-body\n# perturbation, which a real frozen-orbit design depends on), geometry only.\n\nkind = \"constellation-design\"\nbody = \"moon\"\nduration_s = 86400.0\nstep_s = 1800.0\nmask_deg = 10.0\npdop_threshold = 6.0\ngrid_step_deg = 10.0\nclock = \"common\"\ntrack_points = 49\nmax_tracks = 14\n\n[[constellation]]\nname = \"Lunar relay\"\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 8\nplanes = 4\nphasing = 1\nsemi_major_axis_km = 5847.4\neccentricity = 0.58\ninclination_deg = 57.8\nargp_deg = 90.0\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 6\nplanes = 3\nphasing = 1\naltitude_km = 1500.0\ninclination_deg = 85.0\n", "lunar-station-coverage-public-sources.toml": "# Lunar reference-station coverage under the PUBLICLY STATED assumptions: the same kind as\n# lunar-station-coverage.toml, with every input that a public source states set from it and\n# cited by source id; every input no source states is kept from the in-tree default and\n# labelled ILLUSTRATIVE. Sources (retrieved 2026-10-12; titles, identifiers and licences in\n# docs/LUNAR-REFERENCE-STATION.md):\n#   S1  arXiv:2602.08432v3\n#   S2  IOAG Cislunar PNT Workshop 2025, \"Lunar local Differential PNT and Selenodetic\n#       Reference Station\" (slides)\n#   S3  UNOOSA ICG WG-B, Lunar PNT, June 2024 (LunarPNT_Jun24_01_04.pdf)\n#   S4  IOAG Cislunar 2026, \"Moonlight Programme Development Status\"\n#\n# HONESTY: MODELLED. Under these stated public assumptions the model gives the figures this\n# run reports. Not a statement about the performance of any real system; not affiliated with\n# or endorsed by any agency; no TRL or heritage claim. Omitted: terrain and horizon masking at\n# the pole, multipath, receiver hardware.\nkind = \"lunar-station-coverage\"\n\n# Constellation: four satellites in an elliptical lunar frozen orbit with a 24 h period\n# favouring the south pole (S4 p6, p10, p12; S2 p14). The element set is not public.\nn_sats = 4                 # S4 p10/p12; S2 p14\nsma_km = 9737.4            # S4 p6 (24 h period); value in-tree\neccentricity = 0.6         # ILLUSTRATIVE (not public)\ninc_deg = 57.7             # ILLUSTRATIVE (not public)\nargp_deg = 90.0            # ILLUSTRATIVE (not public)\nmask_deg = 5.0             # ILLUSTRATIVE\n\n# Station: an example simulation site near the south pole (S2 p19).\nstation_lat_deg = -89.4765 # S2 p19\nstation_lon_deg = -138.135 # S2 p19\nstation_height_m = 0.0     # ILLUSTRATIVE (on the mean lunar sphere)\nsurvey_sigma_m = 0.30      # ILLUSTRATIVE (S1 p4 gives sub-decimetre as the end-state target)\n\n# Error model. SISE 10 m at least 95 % of the time over any 24 h (S4 p8; S2 p14, p21), read\n# as a zero-mean Gaussian 1-sigma of 10 / 1.96 m; the orbit/clock split is ILLUSTRATIVE.\nsise_sigma_m = 5.10                 # S4 p8 (10 m at 95 %, as 10 / 1.96)\nsise_orbit_variance_fraction = 0.5  # ILLUSTRATIVE\nnoise_m = 0.30             # S2 p14 (high-quality code, at zenith)\nlatency_s = 1.0            # S2 p15 (1 s transmission period)\nquantization_bits = 8      # ILLUSTRATIVE (the message format is not modelled)\n\n# The region: 80 deg S to the pole, about 300 km around the pole (S2 p10; S3 p23).\ngrid_lat_max_deg = -80.0   # S2 p10; S3 p23\ngrid_lat_step_deg = 1.0\nt_start_s = 0.0\nt_span_s = 86400.0\nt_step_s = 600.0\nn_trials = 200\n\n# Thresholds, stated before the run and never fitted.\naccuracy_threshold_m = 1.0\npercentile = 95.0\nalert_limit_m = 10.0       # ILLUSTRATIVE: no public alert limit exists\nresidual_sigma_m = 5.0     # ILLUSTRATIVE\np_hmi = 1e-4\nseed = 42\n", "lunar-station-coverage-terrain.toml": "# Lunar reference-station coverage with terrain: the bundled lunar-station-coverage scenario\n# with a per-site horizon ray-marched over a real lunar digital elevation model at the\n# station and at every user point, in place of the flat elevation mask alone.\n#\n# Terrain: [terrain] below. Each site's horizon is ray-marched (src/lunar_terrain.rs) over\n# the vendored LRO LOLA south-polar DEM crop, data/lunar-dem/ (public domain; NOTICE.md\n# there gives the source URL, SHA-256, crop and resample steps), at 1200 m per pixel, with\n# the Moon's radius and curvature, from a 2 m mast, every 1 deg of azimuth out to 150 km. A\n# satellite counts at a site when it clears both the flat mask_deg and the horizon at its\n# azimuth. A stated profile can be added with station_horizon or user_horizon (rows\n# [azimuth_deg, elevation_deg], labelled with a source); with both, the cut is their maximum.\n#\n# HONESTY: MODELLED. Under the stated assumptions below the model gives these figures. Not\n# a statement about the performance of any real system; no TRL or heritage claim. The\n# horizon is line of sight over a 1.2 km grid: relief below a pixel is smoothed away, a ray\n# leaving the crop ends there, and there is no diffraction or terrain multipath. Site\n# positions used for ranging stay on the mean lunar sphere; the DEM sets the horizon only.\n# The station site (89 S, 0 E) and the constellation are ILLUSTRATIVE, as in\n# lunar-station-coverage.toml; the terrain is the measured DEM, resampled.\n#\n# This scenario reads the DEM from the repository (data/lunar-dem/), so it is not bundled\n# in the binary: run `kshana scenarios/lunar-station-coverage-terrain.toml` from a checkout.\nkind = \"lunar-station-coverage\"\n\n# Constellation. ILLUSTRATIVE: the in-tree LCNS-class Keplerian set (an elliptical orbit\n# favouring the south pole), the same as lunar-differential-pnt's.\nn_sats = 8             # ILLUSTRATIVE\nsma_km = 9737.4        # ILLUSTRATIVE (about 8000 km above the mean lunar radius)\neccentricity = 0.6     # ILLUSTRATIVE\ninc_deg = 57.7         # ILLUSTRATIVE\nargp_deg = 90.0        # ILLUSTRATIVE (apolune over the southern hemisphere)\nmask_deg = 5.0         # ILLUSTRATIVE (the moonlight-service-volume default)\n\n# Station: a known site near the south pole.\nstation_lat_deg = -89.0    # ILLUSTRATIVE (a south-polar site; not a published location)\nstation_lon_deg = 0.0      # ILLUSTRATIVE\nstation_height_m = 0.0     # ILLUSTRATIVE (on the mean lunar sphere)\nsurvey_sigma_m = 0.30      # ILLUSTRATIVE (the in-tree lunar frame-realisation allocation, itself MODELLED)\n\n# Error model: common-mode orbit and clock errors, as in lunar-differential-pnt. The\n# line-of-sight SISE this gives is sqrt(orbit_err_m^2 / 3 + clock_err_m^2) = 65 m.\norbit_err_m = 100.0        # ILLUSTRATIVE\nclock_err_m = 30.0         # ILLUSTRATIVE\nnoise_m = 0.0              # ILLUSTRATIVE (no receiver noise)\nlatency_s = 10.0           # ILLUSTRATIVE (no published correction latency)\nquantization_bits = 8      # ILLUSTRATIVE (no published correction message)\n\n# User grid and time.\ngrid_lat_max_deg = -80.0   # the region: 80 deg S to the pole\ngrid_lat_step_deg = 2.0    # rings every 2 degrees (coarser than the flat scenario, to keep the DEM ray march light), plus the pole\nt_start_s = 0.0\nt_span_s = 86400.0         # one day\nt_step_s = 600.0           # every 10 min\nn_trials = 100             # Monte Carlo trials per epoch (fewer than the flat scenario, for run time)\n\n# Thresholds, stated before the run and never fitted.\naccuracy_threshold_m = 1.0 # coverage: the percentile 3-D error at most this\npercentile = 95.0\nalert_limit_m = 10.0       # ILLUSTRATIVE: no public alert limit exists\nresidual_sigma_m = 5.0     # ILLUSTRATIVE (lunar-differential-pnt's default)\np_hmi = 1e-4\nseed = 42\n\n# Terrain horizon masks (src/lunar_terrain.rs). Source: LRO LOLA LDEM_75S_240M (PDS data set\n# LRO-L-LOLA-4-GDR-V1.0), cropped and 5 x 5 block-mean resampled to 1200 m; data/lunar-dem/NOTICE.md.\n[terrain]\ndem_path = \"data/lunar-dem/lola_ldem_75s_1200m_crop.toml\"\nantenna_height_m = 2.0     # ILLUSTRATIVE (a mast on a lander deck)\nazimuth_step_deg = 1.0\nmax_range_km = 150.0       # ILLUSTRATIVE (rays end here or at the crop edge, about 420 km from the pole)\n", "lunar-station-coverage.toml": "# Lunar reference-station coverage: what positioning accuracy and protection level a user\n# gets from a lunar differential reference station at a known south-polar site, over the\n# south-polar region and a day.\n#\n# A Monte Carlo sweep of the lunar differential-PNT model (src/lunar_dpnt.rs, the same\n# functions the lunar-differential-pnt kind runs) over a ring grid from 80 deg S to the pole\n# and a day of epochs. No new physics: per epoch and trial the common-mode orbit and clock\n# errors are drawn, the station's corrections carry a survey, ageing and quantization\n# error, and each user's corrected and raw range errors go through the same least-squares\n# solve. Per point and over the region: percentile corrected and uncorrected error (3-D,\n# horizontal, vertical), availability, coverage against a threshold stated before the run,\n# DO-229E protection levels, the coverage radius per azimuth, and the correction-link\n# budget at the station and at the worst point.\n#\n# HONESTY: MODELLED. Under the stated assumptions below the model gives these figures. Not\n# a statement about the performance of any real system; not affiliated with or endorsed by\n# any agency; no TRL or heritage claim. Omitted: terrain and horizon masking at the pole\n# (the first limitation), multipath, receiver hardware.\n#\n# Every input names its source: an id S1..S6 from docs/LUNAR-REFERENCE-STATION.md, or\n# ILLUSTRATIVE (no public source used). Inputs not set here take the defaults of the\n# lunar-differential-pnt kind, which mean the same.\nkind = \"lunar-station-coverage\"\n\n# Constellation. ILLUSTRATIVE: the in-tree LCNS-class Keplerian set (an elliptical orbit\n# favouring the south pole), the same as lunar-differential-pnt's.\nn_sats = 8             # ILLUSTRATIVE\nsma_km = 9737.4        # ILLUSTRATIVE (about 8000 km above the mean lunar radius)\neccentricity = 0.6     # ILLUSTRATIVE\ninc_deg = 57.7         # ILLUSTRATIVE\nargp_deg = 90.0        # ILLUSTRATIVE (apolune over the southern hemisphere)\nmask_deg = 5.0         # ILLUSTRATIVE (the moonlight-service-volume default)\n\n# Station: a known site near the south pole.\nstation_lat_deg = -89.0    # ILLUSTRATIVE (a south-polar site; not a published location)\nstation_lon_deg = 0.0      # ILLUSTRATIVE\nstation_height_m = 0.0     # ILLUSTRATIVE (on the mean lunar sphere)\nsurvey_sigma_m = 0.30      # ILLUSTRATIVE (the in-tree lunar frame-realisation allocation, itself MODELLED)\n\n# Error model: common-mode orbit and clock errors, as in lunar-differential-pnt. The\n# line-of-sight SISE this gives is sqrt(orbit_err_m^2 / 3 + clock_err_m^2) = 65 m.\norbit_err_m = 100.0        # ILLUSTRATIVE\nclock_err_m = 30.0         # ILLUSTRATIVE\nnoise_m = 0.0              # ILLUSTRATIVE (no receiver noise)\nlatency_s = 10.0           # ILLUSTRATIVE (no published correction latency)\nquantization_bits = 8      # ILLUSTRATIVE (no published correction message)\n\n# User grid and time.\ngrid_lat_max_deg = -80.0   # the region: 80 deg S to the pole\ngrid_lat_step_deg = 1.0    # rings every degree, round(360 cos lat) points each, plus the pole\nt_start_s = 0.0\nt_span_s = 86400.0         # one day\nt_step_s = 600.0           # every 10 min\nn_trials = 200             # Monte Carlo trials per epoch\n\n# Thresholds, stated before the run and never fitted.\naccuracy_threshold_m = 20.0 # ILLUSTRATIVE: sized to this example's illustrative 65 m SISE so the map shows where coverage holds; the public-sources example uses 1 m\npercentile = 95.0\nalert_limit_m = 10.0       # ILLUSTRATIVE: no public alert limit exists\nresidual_sigma_m = 5.0     # ILLUSTRATIVE (lunar-differential-pnt's default)\np_hmi = 1e-4\nseed = 42\n", "lunar-station-geodesy-baseline.toml": "# Lunar reference station geodesy, BASELINE: today's five retroreflector arrays alone.\n#\n# The seven-parameter Helmert lunar frame datum from the committed slice of archived lunar laser\n# ranging normal points (the lunar-llr-datum kind, src/lunar_llr.rs), with no added site. This\n# file is the \"before\" of the pair; scenarios/lunar-station-geodesy-with-station.toml is the\n# \"after\" and uses the same archived schedule and the same VLBI campaign block below, so the only\n# difference between the two runs is the added sites.\n#\n# The [beacon_campaign] block is carried here only so the two files state the same schedule: with\n# no extra_beacons it is not used, and this run's report is exactly the lunar-llr-datum default.\n#\n# MODELLED: a Cramer-Rao bound for a reduced parameter set on a real schedule; not a solved datum,\n# not an LLR analysis and not a geodetic product. Not a statement about any real station; not\n# affiliated with or endorsed by any agency.\n#\n# DATA: the committed real-data slice ships with the repository but not with the published crate.\nkind = \"lunar-llr-datum\"\n\n[beacon_campaign]\n# The lunar-frame-campaign network defaults (three illustrative deep-space-network-like sites),\n# observed for 28 days from 2024-01-01 at one epoch per hour, so a south-polar beacon's Earth\n# visibility over a libration cycle is sampled rather than one day of it.\nepoch_year = 2024\nepoch_month = 1\nepoch_day = 1\narc_hours = 672.0\nstep_min = 60.0\ndelay_sigma_s = 1.0e-11       # ILLUSTRATIVE, the lunar-frame-campaign default\nelevation_mask_deg = 10.0\nearth_elevation_mask_deg = 0.0\n", "lunar-station-geodesy-with-station.toml": "# Lunar reference station geodesy, WITH STATION: the five retroreflector arrays plus one\n# retroreflector and one VLBI beacon at a south-polar lunar reference station site.\n#\n# The question: how much does adding one retroreflector and one VLBI beacon at the station site\n# tighten the lunar frame datum, compared with today's five retroreflector arrays alone?\n#\n# The run reports the five-array datum exactly as the baseline does, plus a station_geodesy block\n# with each Helmert parameter's 1-sigma before and after and their ratio:\n#   * the added reflector is ranged at the archived normal-point epochs at which the ranging\n#     station is above the site's horizon (the existing look-angle test), each with that normal\n#     point's archived weight. A south-polar site sees the Earth low on its horizon or not at all,\n#     so this is far from continuous ranging; reusing epochs scheduled for the five existing\n#     arrays is an ILLUSTRATIVE schedule, not a plan of any station;\n#   * the added beacon is observed by the [beacon_campaign] network and schedule, with the Earth\n#     stations held fixed (the lunar-frame-campaign and lunar-vlbi-fim delay partials).\n#\n# Site: latitude -89.0, longitude 0.0, height 0 m, the study's default station site\n# (ILLUSTRATIVE; no surveyed position is used).\n#\n# MODELLED: Cramer-Rao bounds for a reduced parameter set; not a solved datum and not a geodetic\n# product. Not a statement about any real station; not affiliated with or endorsed by any agency.\n#\n# DATA: the committed real-data slice ships with the repository but not with the published crate.\nkind = \"lunar-llr-datum\"\n\nextra_earth_elevation_mask_deg = 0.0\n\n[[extra_reflectors]]\nname = \"lunar-reference-station-reflector\"\nlat_deg = -89.0\nlon_deg = 0.0\nalt_m = 0.0\n\n[[extra_beacons]]\nname = \"lunar-reference-station-beacon\"\nlat_deg = -89.0\nlon_deg = 0.0\nalt_m = 0.0\n\n[beacon_campaign]\n# Identical to the baseline file.\nepoch_year = 2024\nepoch_month = 1\nepoch_day = 1\narc_hours = 672.0\nstep_min = 60.0\ndelay_sigma_s = 1.0e-11       # ILLUSTRATIVE, the lunar-frame-campaign default\nelevation_mask_deg = 10.0\nearth_elevation_mask_deg = 0.0\n", "lunar-station-time-lab.toml": "# Lunar reference station time laboratory: a miniature rubidium clock (miniRAFS) steered to\n# Coordinated Lunar Time (LTC) and then left to free-run.\n#\n# The question: after the station clock was last steered to LTC, how does its time error grow,\n# how long does it stay within 1, 10 and 100 ns, and which term dominates at each horizon?\n# (src/lunar_time_lab.rs, the optional [time_lab] block of the lunar-time-budget kind.)\n#\n# The time error is the root-sum-square of four terms, each a function of the time since the\n# last steer:\n#   clock           the clock's power-law time error, the same curve the budget uses;\n#   steer-residual  a constant offset left by each steer (ILLUSTRATIVE, no public figure);\n#   ltc-realisation the constant LTC realisation residual (a budget allocation); the LTC rate\n#                   itself is not re-derived here and keeps its own VALIDATED ledger row;\n#   station-height  zero unless station_height_sigma_m is set: a height error biases the\n#                   gravitational rate and grows linearly.\n# No lunar thermal model is included, because none is sourced.\n#\n# Source statement, not a claim: the ICG WG-B Lunar PNT material of June 2024 (unoosa.org,\n# source S3 of the study) describes a lunar time reference laboratory at the station with a\n# nanosecond-level time target. It is quoted for context only.\n#\n# MODELLED. Under the stated assumptions the model gives the numbers in the report; they are not\n# a statement about any real system. Not affiliated with or endorsed by any agency.\nkind = \"lunar-time-budget\"\n\n# The budget part of the report is the default passive-H-maser budget; the time lab below runs\n# its own clock over the same grid.\nclock = \"passive-h-maser\"\n\n[time_lab]\n# One of optical-master | passive-h-maser | rafs | mini-rafs, or a device_card instead:\n#   device_card = { name = \"my-clock\", points = [[1.0, 5e-10, 100.0], [10.0, 1.6e-10, 100.0], [100.0, 5e-11, 100.0]] }\nclock = \"mini-rafs\"\n\n# Absent: free-run after the initial steer. Set to re-steer every N seconds, e.g. 3600.0.\n# steer_interval_s = 3600.0\n\n# ILLUSTRATIVE constant offset left by each steer (ns).\nsteer_residual_ns = 0.5\n\n# Default: the budget's relativistic-residual allocation, 0.05 ns.\nltc_realisation_ns = 0.05\n\n# 0 means the station height is modelled exactly and the topographic rate term is not applied.\nstation_height_sigma_m = 0.0\n\nthresholds_ns = [1.0, 10.0, 100.0]\nhorizons_s = [3600.0, 86400.0, 604800.0, 2592000.0]\n", "lunar-time-budget.toml": "# Coordinated Lunar Time (LTC) end-to-end time-error budget over a tau grid.\n#\n# A single averaging-time (tau) error table invites the objection \"you picked the tau that\n# flatters your clock.\" This scenario answers it: the seven LTC error terms are assembled as\n# time-error curves x_i(tau) (seconds) across a whole grid of averaging times, root-summed into\n# x_Sigma(tau), and the clock-vs-frame CROSSOVER tau is located — the tau at which the growing\n# clock term overtakes the constant real-time frame-realisation term. Below the crossover the\n# budget is frame-limited (the reference-frame realisation dominates, not the clock); above it the\n# clock dominates. Where the crossover falls depends entirely on the clock class — for the default\n# passive H-maser it is far out in tau, for a coarse mini-RAFS it is seconds — which is exactly why\n# a single-tau number is misleading. (src/lunar_time_budget.rs)\n#\n# Honesty: MODELLED. The tau-slopes are closed-form and analytically checkable (clock tau^{+1/2}\n# or tau^{+1}, floors tau^0, measurement tau^{-1/2}) and the clock rows reproduce the published\n# one-day clock specs; but the RF/optical-link, frame-realisation, relativistic-residual and\n# ephemeris floor MAGNITUDES are Modelled budget allocations (documented defaults, caller-\n# overridable), not measurements. The contribution is the reproducible crossover tau, not a\n# certified per-term number. Nothing here is certified for operational timekeeping.\nkind = \"lunar-time-budget\"\n\n# On-board clock class driving the (growing) clock term. One of:\n#   optical-master | passive-h-maser | rafs | mini-rafs\nclock = \"passive-h-maser\"\n\n# The averaging-time (tau) grid is the default 1 s ... 1e7 s log-spaced grid (8 points/decade).\n# Uncomment to override:\n# tau_min_s = 1.0\n# tau_max_s = 1.0e7\n# points_per_decade = 8\n", "lunar-time-offset.toml": "# Lunar coordinate time (LTC/TCL): the relativistic Earth-Moon clock rate.\n#\n# A clock on the lunar surface ticks faster than an Earth-geoid (TT) clock. A\n# first-principles post-Newtonian identity (src/lunar_time.rs) sums two named terms:\n#   - self-potential difference: the IAU L_G geoid potential (W0 = L_G*c^2) minus the\n#     Moon's surface self-potential GM_moon/R_moon -> the dominant ~ +57.5 us/day; and\n#   - kinetic (second-order Doppler): -<v^2>/2c^2 from the geocentric Moon velocity\n#     (finite-differenced from the Montenbruck-Gill lunar series) -> ~ -0.5 us/day.\n# The total secular rate ~ 57 us/day is reported with the published 56-59 us/day band.\n#\n# Honesty: MODELLED, not certified. The headline us/day figure is reference-dependent\n# (Earth geoid W0 vs a lunar selenoid, the time-averaging window, neglected sub-us/day\n# centrifugal/J2 corrections) -> a band, not a single number, is the honest output.\n# Nothing here is validated to sub-nanosecond absolute accuracy or certified for\n# operational timekeeping. The report also gives the accumulated LTC-TT offset over the\n# horizon and supports an inverse-variance ensemble (a minimal lunar paper-clock).\nkind = \"lunar-time-offset\"\n\nepoch_year = 2000    # LTC origin epoch (UTC); rate varies < 1e-3 us/day over the J2000 era\nepoch_month = 1\nepoch_day = 1\nhorizon_days = 1.0   # accumulate the LTC-TT offset over one day (~57 us)\n", "lunar-vlbi-fim.toml": "# Lunar-VLBI station-coordinate covariance from an explicit observing schedule (G8, paper D3).\n#\n# D3's published chain goes from a per-observation delay precision to a station coordinate\n# uncertainty through an assumed ISOTROPIC equipartition factor g = 3. That step is the one\n# the paper's own abstract calls modelled rather than measured. This scenario removes it:\n# the lunar-VLBI delay partials are accumulated over a real schedule of (baseline x epoch)\n# pairs into a Fisher information matrix, inverted, and reported as the station coordinate\n# covariance — so the station sigma is an engine output.\n#\n# The state carries Earth-FIXED (ITRS) coordinates, so the Jacobian is the inertial partial\n# rotated by each epoch's GCRS->ITRS matrix: Earth rotation is what makes those coordinates\n# observable at all, and the report MEASURES the Earth-fixed line-of-sight sweep and the\n# beacon declination rather than assuming them. One observation is one (baseline, epoch)\n# pair with BOTH stations above the elevation mask, weighted 1/delay_sigma_s^2.\n#\n# What to read in the report\n#   * per-station per-axis and 3-D sigmas — the computed answer;\n#   * the equipartition value c*delay_sigma_s*sqrt(g/N) for the SAME schedule, printed\n#     beside it with the ratio. That ratio IS the anisotropy the assumption discarded, and\n#     the isotropic trace bound sqrt(p/trace(M)) makes AM-HM a hard floor, so the\n#     assumption can only ever understate;\n#   * rank, datum defect, condition number, the full spectrum and the free-network null\n#     space, on every run. Under a rank deficiency the headline sigma is published NULL\n#     with a status, never read out of a near-singular inverse;\n#   * both baseline counts: delay closure tau_ik = tau_ij + tau_jk leaves only n-1 of the\n#     n(n-1)/2 baselines geometrically independent.\n#\n# MODELLED: the Moon-centre ephemeris, station clocks, troposphere and Earth-orientation\n# parameters are held FIXED and observations are treated as independent, so this is a\n# Cramer-Rao bound for a reduced parameter set, not a predicted session result. The\n# omitted differenced-Shapiro partial is measured by finite difference and emitted.\n# Not a geodetic product.\n#\n# Every field below is the module default, written out so the run is reproducible from\n# this file alone. Delete any line to fall back to the same value.\n\nkind = \"lunar-vlbi-fim\"\n", "lunar-vlbi.toml": "# Lunar geodetic VLBI: an Earth baseline observing a lunar-surface beacon.\n#\n# Two ground stations (a VLBI baseline, here a Goldstone-like and a Canberra-like site)\n# observe a one-way signal from a NovaMoon-class transmitter on the lunar near side. The\n# geodetic observable (src/lunar_vlbi.rs) is the NEAR-FIELD two-range difference\n#   tau_geom = (|r2 - r_B| - |r1 - r_B|) / c\n# (the Moon is near-field, not a plane wave), plus the station clock-offset difference and a\n# differenced Earth-potential Shapiro term. The report gives the delay, its finite-difference\n# rate, and the wavefront-curvature near-field correction over the pass, with partials\n# available for OD/frame work.\n#\n# Oracle: in the far-field limit the geometric delay collapses to the same-codebase plane-wave\n# delta-DOR observable (src/radiometric.rs), matched to machine precision; the partials are\n# finite-difference checked. At true lunar distance the near-field correction is a non-zero\n# tens-to-hundreds-of-microseconds term.\n#\n# Honesty: MODELLED, NOT validated against real VLBI data. Polar motion is dropped\n# (xp = yp = 0) so station inertial positions carry a few-metre frame error; the beacon mixes\n# a mean-equator-of-date Moon series with an ICRF body-fixed offset (jd_tdb ~ jd_tt), a\n# frame-consistency mismatch below model fidelity; no light-time iteration, media or aberration\n# beyond the differenced Shapiro. No TRL, flight heritage or agency endorsement is claimed.\nkind = \"lunar-vlbi\"\n\n# Station 1 (DSN Goldstone-like, California).\nstation1_lat_deg = 40.4256\nstation1_lon_deg = -116.8893\nstation1_alt_m = 1000.0\n\n# Station 2 (DSN Canberra-like, Australia) — a long intercontinental baseline.\nstation2_lat_deg = -35.4014\nstation2_lon_deg = 148.9819\nstation2_alt_m = 688.0\n\n# Beacon on the lunar near side (equatorial, sub-Earth point).\nbeacon_lat_deg = 0.0\nbeacon_lon_deg = 0.0\nbeacon_alt_m = 0.0\n\n# Epoch (UTC) and pass sampling.\nepoch_year = 2024\nepoch_month = 1\nepoch_day = 1\nhorizon_hours = 6.0\nstep_min = 30.0\n\n# Opt-in kernel path: set all three to run every sample on JPL DE440, the DE440 lunar principal\n# axes and the ITRF93 Earth orientation, with each light time converged in the barycentric frame\n# (station at reception, beacon at emission). The stations' WGS-84 coordinates are then read as\n# ITRF93 positions and the report adds the epoch's beacon and station partials. This path's\n# Newtonian delay agrees with NAIF SPICE converged light times to 0.06 ps\n# (tests/lunar_vlbi_spice_oracle.rs); the Shapiro term in delay_s stays analytic.\n# planetary_kernel_path = \"de440s.bsp\"\n# earth_orientation_kernel_path = \"earth_latest_high_prec.bpc\"\n# moon_orientation_kernel_path = \"moon_pa_de440_200625.bpc\"\n", "maritime-port-approach-coast.toml": "# Maritime port approach with GNSS jammed: how long an inertial navigation system\n# (INS) keeps a ship inside the harbour-approach accuracy budget once the Global\n# Navigation Satellite System (GNSS) is lost.\n#\n# The mission question: a vessel fitted with an INS enters a harbour approach at\n# 12 knots (6.17 m/s) when GNSS is jammed (see `maritime-strait-jamming.toml` for why).\n# How many seconds of free-inertial coast does it have before its position error passes\n# 10 m, and before it passes 100 m? Those are the two accuracy figures that\n# International Maritime Organization (IMO) Resolution A.1046(27), on the World-Wide\n# Radionavigation System, gives for harbour entrances and approaches (10 m, 95 %) and\n# for ocean waters (100 m, 95 %). They are used here as budgets, not as a claim of\n# compliance.\n#\n# The model is `ins-trn-coast`: five growth terms (accelerometer bias, gyro-bias tilt\n# through gravity, velocity random walk, angle random walk and scale factor times the\n# distance run), combined root-sum-square and searched for the crossing times. The IMU\n# (inertial measurement unit) is the representative navigation-grade class from the\n# engine's grade table (Groves 2013, Table 4.1 band), the class of INS fitted to naval\n# and high-end offshore vessels. It is NOT a datasheet for any product. Change\n# `imu_grade` to \"tactical\" or \"industrial\" to see how a cheaper unit shortens the coast.\n#\n# Honest scope: most merchant ships carry no INS; they dead-reckon on a gyrocompass and\n# a speed log, which this engine does not model. No terrain or radar aiding is applied\n# (`trn_fix_mode = \"none\"`), so this is the unaided coast. MODELLED: every figure is\n# modelled from class coefficients, not measured on a vessel.\nkind = \"ins-trn-coast\"\n\nimu_grade = \"navigation\"\n\n# 12 knots, a typical harbour-approach speed. The scale-factor term grows with the\n# distance run, so speed is part of the error model.\nspeed_m_s = 6.17\nref_accel_m_s2 = 0.0\n\ncombination = \"rss\"\n\n# IMO A.1046(27) harbour-approach and ocean-waters figures, used as budgets (m).\ncrossing_thresholds_m = [10.0, 100.0]\n\ndrift_band_lo_m_per_s = 0.001\ndrift_band_hi_m_per_s = 0.050\n\n# No aiding: the free-inertial coast over the whole approach.\ntrn_fix_mode = \"none\"\n\n# A one-hour approach and berthing window.\nmission_duration_s = 3600.0\n", "maritime-spoof-position-push.toml": "# Maritime GNSS spoofing: detecting a transmitter that drags a ship's reported position.\n#\n# The mission question: a spoofer near a shipping lane broadcasts counterfeit Global\n# Navigation Satellite System (GNSS) signals slightly stronger than the real ones and\n# pulls the ship's position fix several hundred metres off its true track. Position\n# spoofing affecting ships has been publicly reported, for example vessels whose\n# reported positions appeared on land; this file describes that pattern generically and\n# models no particular incident. Would the receiver's own monitors catch it?\n#\n# The pack runs the combined spoof detector (`spoof-detect`): receiver autonomous\n# integrity monitoring (RAIM) parity across satellites, automatic gain control (AGC)\n# power monitoring and signal quality monitoring (SQM) of correlation distortion, fused\n# into one decision. The attack is described in the parameters of the public TEXBAT test\n# battery (Humphreys et al., ION GNSS 2012): the spoofer's power advantage, whether it\n# is carrier-phase aligned, and whether it pushes position (a subset of satellites,\n# visible to RAIM) or time.\n#\n# Here: a +2 dB power advantage (under the 3 dB AGC margin, so power alone misses it),\n# not carrier aligned, pushing four satellites to drag the fix by 500 m. Try\n# `carrier_aligned = true`, `push = \"time\"` and a smaller `power_advantage_db` to see\n# the hard case that defeats these receiver-level layers.\n#\n# Honest scope: parameterised receiver observables, not raw signal samples; Kshana is a\n# simulator, not a receiver. MODELLED: every figure is modelled, not validated against\n# recorded maritime spoofing.\n\nkind = \"spoof-detect\"\n\n[attack]\npower_advantage_db = 2.0\ncarrier_aligned = false\npush = \"position\"\npush_magnitude_m = 500.0\nnum_biased = 4\nel_imbalance = 0.12\n\n[detector]\nsat_power_dbm = -130.0\nagc_margin_db = 3.0\nsqm_tolerance = 0.10\nraim_p_fa = 1.0e-3\nsigma_m = 5.0\nfusion_threshold = 0.5\n", "maritime-strait-jamming.toml": "# Maritime GNSS jamming: a shore- or vessel-borne broadband jammer denying the Global\n# Navigation Satellite System (GNSS) to a ship crossing open water.\n#\n# The mission question a ship's navigator or a coastal authority asks: how far across\n# the water does a modest jammer take GNSS away? Over the sea there is no terrain or\n# clutter between the jammer and the ship's antenna, so free-space path loss is the\n# only thing that weakens the jammer, and a low-power device reaches a long way.\n# Widespread GNSS interference affecting shipping has been publicly reported in several\n# sea areas; this file does not model any particular incident.\n#\n# The chain is the one in `jamming-demo.toml` (Kaplan & Hegarty, Understanding GPS/GNSS,\n# 3rd ed., §9.4): jammer received power sets the jammer-to-signal ratio J/S, despreading\n# and the spectral-separation factor turn it into an effective carrier-to-noise density\n# C/N0 per satellite, and a satellite is lost below the 25 dB-Hz tracking threshold.\n# Here a 50 W (17 dBW) broadband jammer on a 30 m mast sits 30 km from a ship at sea\n# level. Free-space loss over 30 km at the L1 frequency (1575.42 MHz) is about 126 dB,\n# which leaves a mean J/S of about 48 dB, well past the roughly 35 dB a coarse/acquisition (C/A)\n# code tracking loop tolerates, so the receiver loses every satellite. Move the jammer\n# out or cut its power to find the range at which tracking returns (J/S falls about\n# 20 dB per decade of range).\n#\n# Assumptions: 0 dBi jammer and ship antennas toward each other (a ship's GNSS antenna\n# is not a controlled-reception pattern antenna (CRPA)), free-space propagation with no\n# sea-surface multipath, a GPS-like 24-satellite Walker shell. The receiver position is\n# a generic point in the northern Baltic Sea. MODELLED: every figure is modelled, not\n# validated against measured maritime interference.\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n\n[time]\nstep_s = 30.0\nduration_s = 1800.0\n\n[receiver]\nlat_deg = 59.80\nlon_deg = 24.90\nalt_m = 0.0\n\n# A GPS-like 24-satellite Walker shell (6 planes x 4), propagated through the SGP4 core.\n[constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# 50 W broadband jammer on a 30 m mast, 30 km due east of the ship (ECEF, metres).\n[jammer]\nposition_ecef_m = [2904623.523, 1381438.498, 5489328.347]\npower_dbw = 17.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n", "mars-orbit-pnt.toml": "# Positioning a low Mars orbiter with a Mars navigation constellation and a deep-space link.\n#\n# A 300 km near-polar orbiter navigates around Mars for one sol (88 775 s) from the\n# 2027-02-19 opposition, when the Earth is closest and far from a solar conjunction. Two\n# kinds of measurement:\n#\n#   1. ONE-WAY PSEUDORANGES from twelve navigation satellites at 10 000 km in three planes\n#      inclined 60 deg (a Walker delta, phasing 1), flown as two-body orbits with the secular\n#      drift from Mars' J2 (the second zonal harmonic, its oblateness). The user clock is\n#      unknown, so these rows carry a clock column.\n#   2. A TWO-WAY RANGE FROM EARTH, clock-free, whenever the Earth is above the Mars limb\n#      for the orbiter. The Earth's direction and distance come from the analytic\n#      solar-system ephemeris at every epoch.\n#\n# The report gives, per epoch, the relays in view, the constellation-only dilution of\n# precision, the formal position uncertainty with and without the Earth row, and the\n# error of a seeded least-squares fix each way; over the sol, the availability and the\n# root-mean-square errors, and the Earth-Mars light time and round trip.\n#\n# MODELLED. The relay orbits, the 1 m range noise and the instantaneous measurement model\n# are modelling choices; nothing here is validated against a mission's navigation data.\n# The Mars constants are the published values cited in src/body.rs.\nkind = \"body-pnt\"\nbody = \"Mars\"\nepoch = \"2027-02-19T00:00:00\"\nduration_s = 88775.0\nstep_s = 300.0\nseed = 7\n\n[user]\nkind = \"orbiter\"\naltitude_km = 300.0\ninclination_deg = 93.0\n\n[constellation]\nplanes = 3\nsats_per_plane = 4\naltitude_km = 10000.0\ninclination_deg = 60.0\nsigma_range_m = 1.0\n\n[earth_link]\nenabled = true\nsigma_range_m = 1.0\n", "mars-pnt-lmo.toml": "# Mars PNT — Low-Mars-Orbit user navigated against the simulated MARCONI relay\n# constellation (areostationary relays broadcasting one-way + relaying two-way to a\n# deep-space station) through the joint one-way/two-way radiometric fusion estimator.\n#\n# Figures of merit are the estimator's FORMAL COVARIANCE bounds (1σ / 3σ position) and\n# the achieved RMS vs a synthetic closed-loop truth — a simulated navigation FoM, NOT an\n# aviation-certified protection level (no certified fault model or integrity monitor here).\nkind = \"mars-pnt\"\n\nuser = \"lmo\"                 # ~400 km circular Low-Mars-Orbit, inclined 60°\nclock_class = \"uso\"          # onboard ultra-stable oscillator\nstep_s = 60.0                # observation cadence\nduration_s = 7200.0          # ~one LMO orbit (period ≈ 7100 s)\nnmax = 4                     # Mars gravity field degree/order (mars_gmm3, shipped to 4)\nrange_sigma_m = 1.0          # DSN-class range noise\ndoppler_sigma_mps = 1.0e-4   # 0.1 mm/s Doppler noise\ndynamic_tightness = 0.1      # reduced-dynamic knob (dynamic → kinematic), 0..1\ntwo_way_period_s = 1800.0    # a coherent two-way (clock-free, orbit-pinning) pass every 30 min\nseed = 331514052             # deterministic noise seed\n", "mars-pnt-surface.toml": "# Mars PNT — a fixed surface user (a lander / rover on the rotating Mars surface)\n# navigated against the simulated MARCONI relay constellation through the joint\n# one-way/two-way radiometric fusion estimator.\n#\n# A surface point is NOT in free-fall — it co-rotates rigidly with Mars (held up by the\n# ground), so its dynamics are pure centripetal co-rotation, not orbital free-flight. The\n# relays sweeping overhead give the geometric diversity that makes the near-static point\n# observable.\n#\n# Figures of merit are the estimator's FORMAL COVARIANCE bounds (1σ / 3σ position) and\n# the achieved RMS vs a synthetic closed-loop truth — a simulated navigation FoM, NOT an\n# aviation-certified protection level.\nkind = \"mars-pnt\"\n\nuser = \"surface\"             # fixed point on the equator at the prime meridian (co-rotating)\nclock_class = \"uso\"\nstep_s = 30.0                # tighter cadence (the relays sweep overhead quickly)\nduration_s = 7200.0          # 2 h (several relay passes)\nnmax = 4\nrange_sigma_m = 1.0\ndoppler_sigma_mps = 1.0e-4\ndynamic_tightness = 0.1\ntwo_way_period_s = 1800.0\nseed = 331514052\n", "mars-pnt-transfer.toml": "# Mars PNT — a Mars transfer / capture user (a high, eccentric areocentric arc — the\n# long arc a vehicle flies on approach / in a capture orbit) navigated against the\n# simulated MARCONI relay constellation through the joint one-way/two-way radiometric\n# fusion estimator.\n#\n# Figures of merit are the estimator's FORMAL COVARIANCE bounds (1σ / 3σ position) and\n# the achieved RMS vs a synthetic closed-loop truth — a simulated navigation FoM, NOT an\n# aviation-certified protection level.\nkind = \"mars-pnt\"\n\nuser = \"transfer\"            # high eccentric capture-class arc (perigee ~500 km, apogee ~6 Rm)\nclock_class = \"dsac\"         # a deep-space atomic clock (the most stable class)\nstep_s = 120.0               # coarser cadence over the long arc\nduration_s = 28800.0         # 8 h\nnmax = 4\nrange_sigma_m = 1.0\ndoppler_sigma_mps = 1.0e-4\ndynamic_tightness = 0.1\ntwo_way_period_s = 3600.0    # a two-way pass every hour\nseed = 331514052\n", "meo-leo-fused-pvt.toml": "# Fused MEO and LEO pseudorange positioning: GPS and Galileo with a LEO navigation layer.\n#\n# A receiver in Madrid tracks the GPS baseline constellation (GPS SPS Performance Standard,\n# 5th edition), Galileo (Walker 24/3/1, Galileo OS SDD) and a LEO navigation constellation\n# (the public Xona Pulsar X5 signal: 10.23 Mchip/s in the L5 band, received power -144.9 to\n# -136.2 dBW, arXiv:2509.19551). Each system carries its own receiver clock, so the\n# inter-system bias of Galileo and of the LEO layer is estimated with the position; the LEO\n# pseudoranges are simulated with a 40 ns bias to show it recovered. Every pseudorange's\n# sigma is the delay-lock-loop thermal noise at the C/N0 of its elevation combined with the\n# system's signal-in-space range error.\n#\n# The report compares GNSS-only, LEO-only and fused fixes epoch by epoch and gives the PDOP,\n# HDOP and VDOP against the number of LEO satellites added to the GNSS geometry (highest\n# elevation first). MODELLED.\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 3\nduration_s = 1800.0\nstep_s = 30.0\n\n[user]\nlat_deg = 40.42\nlon_deg = -3.70\nheight_m = 650.0\n\n[joint]\nmax_leo_sweep = 12\n\n[[system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\n\n[[system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\n\n[[system]]\nname = \"Pulsar X5\"\nleo_preset = \"xona-pulsar\"\nsignal = \"X5\"\nisb_ns = 40.0\n", "mission-thread-short.toml": "# A short mission thread that runs from a binary alone: launch and ascent, one low-Earth-orbit rendezvous, one day of\n# trans-lunar cruise and the return and entry, with the Moon's position from the analytic series (no kernel file).\n# It is the bundled companion of mission-thread-artemis-class, which reads a Moon kernel cut from a checkout.\n#\n# HONESTY. Every number is ILLUSTRATIVE, a round figure chosen to make the chain run, not the performance of any\n# vehicle, sensor, station or network; the phases are a stated simplification of one stack. MODELLED. Public sources\n# only; not affiliated with or endorsed by any agency. Advisory software, not certified navigation equipment.\nkind = \"mission-thread\"\ntitle = \"Short mission thread, launch to entry (ILLUSTRATIVE)\"\nseed = 20261028\nepoch_utc = \"2028-01-01T00:00:00Z\"\n\n[entry]\n# The launch pad at the epoch, in GCRF: 28.5 deg N, 80.6 deg W, rotating with the Earth.\nframe = \"gcrf\"\nx = [5285007.866, 1880185.649, 3025316.817, -137.105, 385.389, 0.0]\nsigma_pos_m = 10.0\nsigma_vel_mps = 0.01\ntimescale = \"utc\"\nsigma_time_s = 1.0e-7\nsigma_drift_s_per_s = 1.0e-12\n\n[[phase]]\nid = \"ascent\"\nkind = \"launch-ascent\"\nduration_s = 540.0\nnav = [\"gnss\", \"inertial\"]\ntime = \"gnss\"\n[phase.requirement]\nmax_pos_m = 100.0\n[phase.model]\ngnss_acquire_s = 90.0\ngnss_sigma_pos_m = 5.0\ngnss_sigma_vel_mps = 0.05\ngnss_time_sigma_s = 1.0e-7\nimu_q_acc = 1.0e-3\nclock_q_f = 1.0e-22\nclock_q_d = 1.0e-30\nstep_s = 1.0\ninsertion_alt_m = 185000.0\ninsertion_inclination_deg = 28.5\n[[phase.model.fades]]\nstart_s = 60.0\nend_s = 150.0\nwhat = \"max-q plume mask\"\n[[phase.model.fades]]\nstart_s = 300.0\nend_s = 330.0\nwhat = \"staging\"\n\n[[phase]]\nid = \"rdv-1\"\nkind = \"leo-rendezvous\"\nduration_s = 3000.0\nnav = [\"relative-optical\", \"gnss\"]\ntime = \"gnss\"\n[phase.handover]\n# A wait of two days, then GNSS is acquired again: dead reckoning for ten minutes, then the fix floor.\nrule = \"reacquire\"\nacquire_s = 600.0\nq_acc = 1.0e-9\nfloor_pos_m = 8.66\nfloor_vel_mps = 0.07\nfloor_time_s = 1.0e-7\n[phase.model]\ntarget_alt_m = 185000.0\ntarget_abs_sigma_pos_m = 5.0\ntarget_abs_sigma_vel_mps = 0.005\ncapture_pos_m = 0.5\ncapture_vel_mps = 0.02\nmin_window_s = 300.0\n[[phase.model.legs]]\nrange_m = 20000.0\nend_range_m = 1000.0\nduration_s = 1200.0\nsensor = \"rf-ranging\"\ninterval_s = 10.0\n[[phase.model.legs]]\nrange_m = 1000.0\nend_range_m = 20.0\nduration_s = 1500.0\nsensor = \"optical-camera\"\ninterval_s = 5.0\n[[phase.model.legs]]\nrange_m = 20.0\nend_range_m = 1.0\nduration_s = 300.0\nsensor = \"lidar\"\ninterval_s = 1.0\n\n[[phase]]\nid = \"cruise\"\nkind = \"tli-and-cruise\"\nduration_s = 86400.0\nnav = [\"gnss-ssv\", \"ground-tracking\"]\ntime = \"ground-clock\"\n[phase.requirement]\nmax_pos_m = 5000.0\n[phase.model]\n# The nominal parking orbit at the burn (185 km circular, 28.5 deg): the handovers between the rendezvous phases\n# advance a nominal state on a straight line, so the chain states the orbit; the covariance, the clock and the time\n# are the thread's.\nstart_state_gcrf = [6563137.0, 0.0, 0.0, 0.0, 6848.755, 3718.571]\ntli_dv_mps = 3130.0\ntli_dv_sigma_fraction = 0.001\ntli_pointing_sigma_rad = 0.001\nstep_s = 3600.0\nprocess_q_acc = 1.0e-13\nclock_q_f = 1.0e-22\nclock_q_d = 1.0e-30\nssv_uere_m = 5.0\nssv_window_s = 21600.0\nssv_step_min = 10.0\nground_range_sigma_m = 10.0\nground_range_rate_sigma_mps = 0.001\nground_interval_s = 3600.0\n\n[[phase]]\nid = \"entry\"\nkind = \"entry\"\nduration_s = 21600.0\nnav = [\"ground-tracking\"]\ntime = \"ground-clock\"\nframe = \"gcrf\"\ntimescale = \"utc\"\n[phase.requirement]\nmax_pos_m = 5000.0\n[phase.model]\n# The nominal return state 6 hours before the entry interface (a two-body backward integration of an interface\n# state at 122 km, 10.93 km/s, 6 deg below the horizontal); the covariance, the clock and the time are the thread's.\nstart_state_gcrf = [-62790259.413, -44485726.468, -25683846.151, 2429.589, 746.8, 431.165]\nstep_s = 1800.0\nprocess_q_acc = 1.0e-13\nclock_q_f = 1.0e-22\nclock_q_d = 1.0e-30\nground_range_sigma_m = 10.0\nground_range_rate_sigma_mps = 0.001\nground_interval_s = 1800.0\ninterface_alt_m = 121920.0\nballistic_coeff_kg_m2 = 350.0\ncorridor_min_deg = 5.6\ncorridor_max_deg = 6.4\ndownrange_sensitivity_km_per_deg = 400.0\nflight_time_s = 900.0\nmax_decel_g = 12.0\n", "moonlight-service-volume.toml": "# Lunar navigation SERVICE-VOLUME analysis — Moonlight / LCNS-class constellation.\n#\n# Where src/lunar.rs runs a single south-pole protection-level PASS, src/lunar_service.rs\n# analyses a whole SERVICE VOLUME: it sweeps a selenographic latitude/longitude grid over a\n# time horizon and reports, for an ILLUSTRATIVE Moonlight / LCNS-class lunar-orbit\n# constellation:\n#\n#   * DOP / coverage / availability — the fraction of (grid point, epoch) samples with\n#     >= 4 visible satellites AND PDOP < threshold, plus the PDOP and visible-count\n#     envelopes. The DOP geometry REUSES the gnss_lib_py-VALIDATED kernel\n#     (crate::orbit::dop) exactly — service_dop is a thin filter + that kernel.\n#\n#   * Generalised lunar ARAIM protection levels (HPL/VPL) over the volume — the SAME\n#     LunaNet LNIS lunar ARAIM machinery the south-pole pass uses (crate::lunar::lunar_araim,\n#     sigma_URE ~ 30 m, P_sat ~ 1e-4), generalised from the south pole to an arbitrary\n#     surface point. At the south pole with the same geometry/budget it reduces to the\n#     existing south-pole protection level.\n#\n# CONSTELLATION (ILLUSTRATIVE; PUBLIC-SOURCE; NOT AFFILIATED WITH ESA): public ESA material\n# describes LCNS / Moonlight as a small constellation (~4 satellites, first phase) on\n# elliptical lunar frozen orbits favouring south-pole coverage (apolune over the south).\n# The defaults below APPROXIMATE that public description (4 sats, eccentric inclined orbit,\n# argument of perilune 90 deg so apolune sits over the southern hemisphere). These are\n# illustrative parameters for exercising the method, NOT the real Moonlight/LCNS ephemeris,\n# and imply no affiliation, endorsement, heritage, certification or TRL.\n#\n# HONESTY: MODELLED composition. The DOP geometry is validated BY REUSE of the validated\n# kernel; the coverage / availability / integrity composition is MODELLED — a circular-/\n# elliptical-Keplerian relay set (not a differential-corrected LCNS / 9:2 NRHO ephemeris),\n# a mean-rotation Moon (no physical libration / precessing pole), and published LunaNet LNIS\n# integrity parameters. This demonstrates the lunar service-volume METHOD, not an\n# operational Moonlight availability number. Deterministic (pure geometry; no randomness).\nkind = \"moonlight-service-volume\"\n\n# Illustrative LCNS-class constellation (public-source approximation; not affiliated).\n# The public first-phase description is ~4 satellites; the generalised lunar ARAIM\n# protection level needs >= 6 satellites IN VIEW (the single-fault hypothesis set needs\n# n-1 >= 5 redundancy), so this default uses a fuller (illustrative, expanded) set so the\n# PL envelope is exercised alongside the DOP / coverage headline. Set n_sats = 4 to model\n# the first-phase constellation (DOP/coverage only; the PL envelope is then empty).\nn_sats = 8\nsma_km = 9737.4        # ~8000 km perilune altitude above the mean lunar radius\neccentricity = 0.6\ninc_deg = 57.7\nargp_deg = 90.0        # apolune over the southern hemisphere (south-pole favouring)\n\n# Service-volume grid (south-polar region by default — the Artemis target).\nlat_min_deg = -90.0\nlat_max_deg = -60.0\nlat_step_deg = 10.0\nlon_min_deg = -180.0\nlon_max_deg = 180.0\nlon_step_deg = 60.0\n\n# Time horizon and sampling.\nhorizon_hours = 12.0\nstep_min = 60.0\n\n# Geometry / availability thresholds.\nelev_mask_deg = 5.0\npdop_threshold = 6.0\n\n# Integrity (LunaNet LNIS): surface-ops alert limit and integrity-risk budget.\nalert_limit_m = 50.0\np_hmi = 1e-4\n\n# OPTIONAL per-satellite geometry export for ONE named selenographic site. Off unless\n# BOTH coordinates are given; the aggregate coverage / DOP summary above collapses\n# per-satellite geometry, but slant range and look angles are what a link budget consumes.\n#   export_site_lat_deg = -89.9\n#   export_site_lon_deg = 0.0\n#\n# OPTIONAL transmit antenna for that export. Read only when the export site is also set.\n# Each exported row then also carries the off-boresight angle AT THE SATELLITE and the\n# transmit gain toward the site from the REAL Airy aperture pattern\n# (antenna::pattern_gain_dbi), and the report gains an `antenna_pattern` block reporting\n# the in-beam count under that pattern BESIDE the in-beam count under the symmetric\n# gain-to-beamwidth approximation (theta_3dB[deg] = sqrt(31000/G_lin)), plus the\n# correction between them. Both are emitted; neither replaces the other. The defaults\n# below are the engine's own representative lunar transmit aperture, the same 1 m dish at\n# 2.4 GHz that scenarios/lunar-attack-surface.toml runs.\n#   [export_antenna]\n#   diameter_m = 1.0       # required: the pattern is a statement about one aperture\n#   carrier_hz = 2.4e9     # default 2.4e9 (S-band lunar AFS)\n#   efficiency = 0.60      # default 0.60 (antenna::DEFAULT_APERTURE_EFFICIENCY)\n#\n# With an export site set, a plain run ALSO emits <scenario>.table.csv: the per-satellite\n# geometry in long form, one row per (epoch, satellite), with the row count on the header\n# line. This is the largest array the crate publishes — 2304 rows in the released joint\n# communications-and-navigation table — and inside JSON it is the shape a naive consumer\n# truncates without anything objecting. The four antenna columns are present only when\n# export_antenna is configured, and the header says which case the file is. No export\n# site, no array, no file.\n#\n# OPTIONAL real, retrieved geometry in place of the illustrative constellation above.\n# UNSET BY DEFAULT, and unset changes nothing: the report is byte-identical to what it is\n# without this line. Point it at a file and that file's geometry drives the headline\n# coverage / DOP / protection-level figures, the report gains an `ephemeris` provenance\n# block (path, SHA-256 of the exact bytes, upstream document, URL, retrieval date), and an\n# `ephemeris_comparison` block carries the sigma_URE RANGING REQUIREMENT under that\n# geometry BESIDE the unchanged Keplerian and perturbed results, with the difference and\n# the ratio emitted as their own named quantities. Nothing is replaced; nothing is tuned to\n# bring the geometries together.\n#\n# Two file formats, two distinct provenance classes (see src/lunar_ephemeris.rs and\n# tests/fixtures/lunar_ephemeris/NOTICE.md):\n#   * `# format: elements` -> a PUBLISHED CONSTELLATION DEFINITION, propagated by the same\n#     Kepler solver the illustrative set uses, so the only difference between the two runs\n#     is the constellation design. Provenance class `published-elements`.\n#   * `# format: states`   -> a TABULATED MOON-CENTRED STATE EPHEMERIS (what an SPK/BSP\n#     kernel evaluates to), Lagrange-interpolated and reduced to MCMF by the IAU 2015 /\n#     WGCCRE lunar orientation. Provenance class `published-ephemeris`. A horizon past the\n#     end of the table is REFUSED rather than extrapolated.\n#\n# An `elements` file states its own frame (`# elements_frame: icrf` or `mci`, default\n# `mci`) and may give the phase as either a mean or a TRUE anomaly, so a fixture can carry\n# exactly the numbers its source printed. An ICRF-stated set is propagated in ICRF and\n# reduced by the IAU 2015 / WGCCRE lunar orientation, with no frame approximation; an\n# OP-frame set (the Ely / Ely and Lieb convention) is read as MCI, and the report emits the\n# COMPUTED tilt that introduces as `ephemeris.published_frame_tie_angle_deg`.\n#\n# The committed candidates (all regenerable from their recorded sources):\n#   ephemeris_path = \"tests/fixtures/lunar_ephemeris/lans_demo_ntrs20250009447.csv\"\n#     the 5-satellite joint ESA/NASA/JAXA LANS interoperability-demonstration reference\n#     constellation, Table 3 of Melman et al., ION GNSS+ 2025 / NASA NTRS 20250009447.\n#     Elements in ICRF at a stated epoch; the source calls the orbits NOTIONAL and that\n#     caveat is emitted with them. Five satellites can never put the six in view ARAIM\n#     needs, so this yields coverage and DOP but NO protection level and NO sigma\n#     requirement - reported absent, not manufactured.\n#   ephemeris_path = \"tests/fixtures/lunar_ephemeris/lncss_case_a_navi613.csv\"\n#     8-satellite LNCSS case study A, Table 1 of Bhamidipati, Mina, Sanchez and Gao,\n#     NAVIGATION 70(4) navi.613, 2023 (open access, CC BY). Cases B (12 sats) and C (16)\n#     are committed beside it. Its elements are stated in the Earth orbital-plane (OP)\n#     frame; to place them in that frame at the paper's epoch and propagate them under the\n#     lunar J2 + C22 field and Earth and Sun third bodies at DE440 positions, add\n#       planetary_kernel_path = \"tests/fixtures/lunar_service_volume_orekit_oracle/de440s_2025-11-09_15d.bsp\"\n#       epoch_utc = \"2025-11-09T00:00:00\"\n#     (that cut kernel covers 2025-11-08..2025-11-25; any SPK holding the Earth, Moon and\n#     Sun over the horizon works, e.g. NAIF de440s.bsp).\n#   ephemeris_path = \"tests/fixtures/lunar_ephemeris/horizons_lunar_orbiters_2023001_12h.csv\"\n#     the four spacecraft really in lunar orbit on 2023-01-01, from JPL Horizons. NOT a\n#     navigation constellation: 1-2 in view over the south pole, no protection level, so\n#     the sigma requirement comes back ABSENT rather than invented.\n", "multi-band-jamming-waterfall.toml": "# Multi-band jamming waterfall: low Earth orbit (LEO) positioning, navigation and timing\n# (PNT) signals in four bands (UHF, L, S and C) beside GPS and Galileo, each band with\n# its own jammer, drawn as one waterfall per band on one timeline.\n#\n# A LEO-PNT system that spreads its signals over several bands is harder to deny than a\n# single L-band system: a jammer built for one band leaves the others alone. This\n# scenario shows that with the `spectrum` kind's spectral separation coefficient (SSC)\n# chain, band by band. Every signal is public or representative; none depends on a\n# particular LEO system:\n#   UHF  generic-uhf (465 MHz, BPSK(5) pilot and data, 10 MHz), -150 dBW   [representative]\n#   L    xona-x5 (1190.51625 MHz, published), at its -144.9 dBW minimum; GPS L1 C/A and\n#        Galileo E5a at their specification minimums\n#   S    generic-s (2492.028 MHz, BPSK(5), 16.5 MHz), -150 dBW              [representative]\n#   C    generic-c-band-leo (5020 MHz, BPSK(10), 20 MHz), -152 dBW          [representative]\n# (BPSK binary phase-shift keying.) The LEO designs are drawn with every component,\n# band-limited to their transmit bandwidth.\n#\n# Timeline (60 s, one row per second):\n#   10 s  a continuous-wave (CW) tone at the UHF carrier, -120 dBW received.\n#   20 s  a chirp (swept) jammer 16 MHz wide around L1, 9 microsecond sweeps, 50 mW at\n#         100 m: it takes GPS L1 C/A and leaves the L5-band signals alone.\n#   30 s  wideband (barrage) noise, 40 MHz around 1185 MHz, -118 dBW: it hits Galileo E5a\n#         and Xona X5 together.\n#   40 s  narrowband noise, 2 MHz at the S carrier, -128 dBW.\n#   50 s  noise matched to the C-band signal's own spectrum, -124 dBW.\n# The [grid] waterfall is the L band; three [[panels]] add UHF, S and C.\n# MODELLED: the signal spectra are validated closed forms; every jammer, power and\n# timing here is a scenario input.\nkind = \"spectrum\"\nseed = 11\nduration_s = 60.0\nstep_s = 1.0\n\n[receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n\n[grid]\nf_min_mhz = 1160.0\nf_max_mhz = 1600.0\nn_freq = 440\n\n[[panels]]\nname = \"UHF\"\nf_min_mhz = 455.0\nf_max_mhz = 475.0\nn_freq = 200\n\n[[panels]]\nname = \"S band\"\nf_min_mhz = 2482.0\nf_max_mhz = 2502.0\nn_freq = 200\n\n[[panels]]\nname = \"C band\"\nf_min_mhz = 5005.0\nf_max_mhz = 5035.0\nn_freq = 200\n\n[[bands]]\nname = \"generic-uhf\"\nsignal = \"generic-uhf\"\nsignal_power_dbw = -150.0\n\n[[bands]]\nname = \"gps-l1ca\"\n\n[[bands]]\nname = \"galileo-e5a\"\n\n[[bands]]\nname = \"xona-x5\"\nsignal = \"xona-x5\"\n\n[[bands]]\nname = \"generic-s\"\nsignal = \"generic-s\"\nsignal_power_dbw = -150.0\n\n[[bands]]\nname = \"generic-c-band-leo\"\nsignal = \"generic-c-band-leo\"\nsignal_power_dbw = -152.0\n\n[[jammers]]\nname = \"UHF CW tone\"\nwaveform = \"cw\"\ncentre_mhz = 465.0\nreceived_power_dbw = -120.0\non_s = 10.0\n\n[[jammers]]\nname = \"L1 chirp privacy device\"\nwaveform = \"chirp\"\ncentre_mhz = 1575.42\nbandwidth_mhz = 16.0\nsweep_period_us = 9.0\neirp_dbw = -13.0\nrange_m = 100.0\non_s = 20.0\n\n[[jammers]]\nname = \"L5-band barrage\"\nwaveform = \"wideband\"\ncentre_mhz = 1185.0\nbandwidth_mhz = 40.0\nreceived_power_dbw = -118.0\non_s = 30.0\n\n[[jammers]]\nname = \"S narrowband noise\"\nwaveform = \"narrowband\"\ncentre_mhz = 2492.028\nbandwidth_mhz = 2.0\nreceived_power_dbw = -128.0\non_s = 40.0\n\n[[jammers]]\nname = \"C matched noise\"\nwaveform = \"matched\"\ncentre_mhz = 5020.0\nmatched_to = \"generic-c-band-leo\"\nreceived_power_dbw = -124.0\non_s = 50.0\n", "ntn-5g-positioning.toml": "# Positioning from a 5G non-terrestrial network (NTN) downlink in the mobile-satellite S band.\n#\n# 3GPP band n256 (downlink 2170 to 2200 MHz, 3GPP TS 38.101-5) serves handsets from\n# satellites. A positioning reference signal in a 5 MHz New Radio channel (4.5 MHz occupied)\n# or a 200 kHz narrowband channel (180 kHz occupied) bounds the time-of-arrival accuracy\n# through its root-mean-square bandwidth: the Cramér-Rao bound is c / (2 pi beta\n# sqrt(2 (C/N0) T)), with beta = B / sqrt(12) for a flat spectrum. The scenario compares the\n# two channels over a representative NTN shell (324 satellites at 600 km, 55 deg, 10 deg mask), adds a\n# 1 m network synchronisation and ephemeris error, and runs downlink time-of-arrival fixes and\n# a single-satellite Doppler fix over the longest pass (height held to 10 m).\n#\n# The bandwidth-to-bound step is a textbook closed form; the positioning accuracy is MODELLED\n# (a bound on a multipath-free channel, not an achieved result).\nkind = \"ntn-positioning\"\nseed = 5\ncarrier_hz = 2172.5e6\nintegration_s = 0.1\ndoppler_integration_s = 1.0\ncn0_dbhz = [38.0, 50.0]\nsync_error_m = 1.0\nduration_s = 600.0\nstep_s = 10.0\n\n[user]\nlat_deg = 52.5\nlon_deg = 13.4\nheight_m = 40.0\n\n[[signal]]\nname = \"NR 5 MHz\"\nbandwidth_hz = 4.5e6\n\n[[signal]]\nname = \"NB 200 kHz\"\nbandwidth_hz = 180e3\n\n[[system]]\nname = \"NTN shell\"\nrole = \"leo\"\nmask_deg = 10.0\n[[system.shell]]\ntotal = 324\nplanes = 18\nphasing = 1\naltitude_km = 600.0\ninclination_deg = 55.0\n", "oem-interop.toml": "# CCSDS OEM interoperability-bridge demonstrator (GMAT / Orekit / STK interop).\n#\n# GMAT, Orekit and STK all EXPORT CCSDS Orbit Ephemeris Messages; this is the\n# IMPORT side of the bridge that lets Kshana ingest them. With no `oem_text` the\n# scenario round-trips a generated reference constellation (a MEO + a LEO orbit)\n# through export -> import and reports the round-trip fidelity, proving the importer\n# is the exact inverse of the writer. Set `oem_text` to an inline OEM string to\n# ingest a real external file instead (segments, frames, epoch span + a\n# velocity-consistency check are reported).\n#\n# HONEST SCOPE: MODELLED structural + physical ingest check, NOT an orbit-accuracy\n# validation of the source ephemeris.\n# Run:  kshana scenarios/oem-interop.toml\nkind = \"oem-interop\"\n", "optical-atmosphere-network.toml": "# Optical PNT through the atmosphere: three ILLUSTRATIVE ground sites (a cloudier northern site, a\n# middling central site and a clearer southern site) viewing a LEO optical terminal at 30 degrees\n# elevation at 1550 nm. The cloud climates are stated inputs, not measurements or any dataset's\n# values, so every availability below is MODELLED. The run reports per site the clear-air loss,\n# the Hufnagel-Valley turbulence state, the availability against the link margin, the margin\n# needed for 40 / 50 / 60 / 70 percent (an optical link cannot pass thick cloud, so a site has an availability ceiling that no margin lifts, reported per site), the outage-duration distribution and the timing error\n# growth per outage for three clock classes, then the site-diversity availability of the best 1, 2\n# and 3 sites with independent and with distance-correlated weather (500 km decorrelation length).\nkind = \"optical-atmosphere\"\nwavelength_nm = 1550.0\nelevation_deg = 30.0\navailability_targets_pct = [40.0, 50.0, 60.0, 70.0]\n\n[link]\ntx_power_w = 0.5\ntx_aperture_m = 0.1\nrx_aperture_m = 0.4\nrange_km = 1000.0\noptics_efficiency = 0.5\ndetector_efficiency = 0.7\npointing_loss_db = 3.0\nreceiver_sensitivity_dbm = -30.0\n\n[atmosphere]\nhv_ground_cn2 = 1.7e-14\nhv_wind_ms = 21.0\nwave = \"plane\"\ndirection = \"downlink\"\npath_eff_km = 10.0\nvisibility_km = 23.0\naerosol_scale_height_m = 1200.0\ntop_km = 30.0\ncloud_effective_radius_um = 10.0\n\n[network]\ncorrelation_length_km = 500.0\n\n[clock]\nclasses = [\"ocxo\", \"rafs\", \"dsac\"]\nthreshold_ns = 100.0\n\n[[site]]\nname = \"northern\"\nlat_deg = 58.0\nlon_deg = 10.0\naltitude_m = 50.0\np_cloud = 0.65\nmedian_lwp_kg_m2 = 0.08\nsigma_ln = 1.0\nmean_outage_h = 9.0\noutage_sigma_ln = 1.0\ndata_source = \"ILLUSTRATIVE input, not a measurement\"\n\n[[site]]\nname = \"central\"\nlat_deg = 48.0\nlon_deg = 11.0\naltitude_m = 600.0\np_cloud = 0.5\nmedian_lwp_kg_m2 = 0.06\nsigma_ln = 1.0\nmean_outage_h = 7.0\noutage_sigma_ln = 1.0\ndata_source = \"ILLUSTRATIVE input, not a measurement\"\n\n[[site]]\nname = \"southern\"\nlat_deg = 37.0\nlon_deg = 14.0\naltitude_m = 1200.0\np_cloud = 0.3\nmedian_lwp_kg_m2 = 0.04\nsigma_ln = 1.0\nmean_outage_h = 5.0\noutage_sigma_ln = 1.0\ndata_source = \"ILLUSTRATIVE input, not a measurement\"\n\n# One seeded realisation of each site's link through time (MODELLED; a draw from the model above, not the climate).\n# Absent, no series is written and the result is the 0.37 document.\n[timeseries]\nduration_h = 336.0\nstep_s = 600.0\nseed = 37\n", "optical-atmosphere-techniques.toml": "# Enhancement-technique what-ifs for one ILLUSTRATIVE ground site: a wavelength change, a larger\n# receive aperture, an adaptive-optics scintillation reduction and extra margin, each predicted as\n# an availability gain over the same site's baseline. The gains are stated inputs (Kshana does not\n# model an adaptive-optics loop), a new wavelength or aperture re-evaluates the clear-sky budget,\n# the clear-air loss and the aperture averaging, and everything is MODELLED. The terminal is\n# deliberately margin-limited (about 3 dB before the atmosphere) so the techniques matter; the\n# run also states the cloud ceiling that no technique lifts. Targets below 100 percent of the\n# margin table are reported as the extra margin needed (negative means a surplus).\nkind = \"optical-atmosphere\"\nwavelength_nm = 1550.0\nelevation_deg = 25.0\navailability_targets_pct = [50.0, 60.0, 70.0]\n\n[link]\ntx_power_w = 0.5\ntx_aperture_m = 0.1\nrx_aperture_m = 0.3\nrange_km = 1000.0\noptics_efficiency = 0.5\ndetector_efficiency = 0.7\npointing_loss_db = 3.0\nreceiver_sensitivity_dbm = -17.0\n\n[atmosphere]\nwave = \"spherical\"\ndirection = \"uplink\"\npath_eff_km = 10.0\nvisibility_km = 15.0\n\n[clock]\nclasses = [\"tcxo\", \"ocxo\", \"dsac\"]\nthreshold_ns = 100.0\n\n[[site]]\nname = \"single-site\"\nlat_deg = 40.0\nlon_deg = 12.0\naltitude_m = 300.0\np_cloud = 0.2\nmedian_lwp_kg_m2 = 0.03\nsigma_ln = 1.0\nmean_outage_h = 6.0\noutage_sigma_ln = 1.0\ndata_source = \"ILLUSTRATIVE input, not a measurement\"\n\n[[technique]]\nname = \"wavelength 1064 nm\"\nwavelength_nm = 1064.0\n\n[[technique]]\nname = \"receive aperture 1.0 m\"\nrx_aperture_m = 1.0\n\n[[technique]]\nname = \"adaptive optics, 80 % scintillation reduction\"\nscint_variance_reduction = 0.8\n\n[[technique]]\nname = \"6 dB extra margin\"\nextra_margin_db = 6.0\n\n[[technique]]\nname = \"aperture 1.0 m + AO + 3 dB\"\nrx_aperture_m = 1.0\nscint_variance_reduction = 0.8\nextra_margin_db = 3.0\n\n# One seeded realisation of each site's link through time (MODELLED; a draw from the model above, not the climate).\n# Absent, no series is written and the result is the 0.37 document.\n[timeseries]\nduration_h = 336.0\nstep_s = 600.0\nseed = 37\n", "orbit-gnss-challenged.toml": "# GNSS availability derived from orbital geometry (not hand-authored windows).\n#\n# A spacecraft well inside the GNSS shell (here ~8,000 km altitude) does not have\n# continuous coverage: as the constellation moves, the count of satellites that\n# clear the elevation mask and are not occulted by Earth rises and falls. The\n# visible count is computed from line-of-sight geometry at each step and mapped to\n# a GNSS state (>=4 visible = nominal fix, 1-3 = degraded, 0 = denied). When the\n# fix drops, the onboard clock must hold time across the gap; the quantum clock\n# coasts far longer within a tight timing bound than the chip-scale reference.\n# Vendor-neutral; constellation and clock parameters are public/cited.\n\nkind = \"orbit\"\nseed = 7\nthreshold_ns = 5.0\n# Elevation mask (deg) above the user's local horizontal.\nmask_deg = 10.0\n# 1-sigma user-equivalent range error (m) for the position-accuracy summary;\n# position sigma = position-DOP * this. ~1 m is a representative modern\n# dual-frequency UERE (Kaplan & Hegarty, Understanding GPS/GNSS).\nsigma_uere_m = 1.0\n\n[time]\nstep_s = 60.0\nduration_s = 86400.0   # one day\n\n# User spacecraft at ~8,000 km altitude, inside the GNSS shell.\n[user]\naltitude_km = 8000.0\ninclination_deg = 0.0\nraan_deg = 0.0\nu0_deg = 0.0\n\n# GPS-like Walker-delta constellation: 24 satellites, 6 planes, 55 deg inclination,\n# ~20,180 km altitude (GPS public constellation parameters; IS-GPS-200 / USCG NAVCEN).\n[constellation]\naltitude_km = 20180.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# Quantum: strontium optical lattice clock (space-oriented goal on ground hardware).\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented stability goal sigma_y(1s)=1e-15 (arXiv:1503.08457); lab Sr reaches 4.8e-17 (Oelker et al., Nature Photonics 2019). Not flown.\"\ny0 = 1.0e-15\nq_wf = 1.0e-30\nq_rw = 1.0e-40\nflicker_floor = 1.0e-16\n\n# Classical: chip-scale atomic clock (deployed commercial part).\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA.45s / SA65 chip-scale atomic clock, sigma_y(1s)=3.0e-10 (datasheet); deployed commercial part.\"\ny0 = 1.0e-11\nq_wf = 9.0e-20\nq_rw = 1.0e-28\nflicker_floor = 2.0e-11\n", "orbit-molniya.toml": "# GNSS availability for a highly-eccentric (Molniya) user, from orbital geometry.\n#\n# A Molniya orbit is a 12-hour, highly-eccentric, critically-inclined orbit\n# (a ~ 26,600 km, e ~ 0.74, i = 63.4 deg, argument of perigee 270 deg) that\n# loiters near apogee over the northern hemisphere. The user spends most of the\n# revolution far above the GNSS shell (looking \"down\" at the constellation, with\n# Earth often occulting the far side) and races through perigee below it. The\n# visible-satellite count therefore swings widely over the orbit, and during the\n# long high-apogee dwell the onboard clock must hold time across the gaps.\n#\n# The critical inclination (63.4 deg) freezes the argument of perigee under J2;\n# `j2 = true` additionally applies the secular nodal regression. Vendor-neutral;\n# orbit and clock parameters are public/cited.\n\nkind = \"orbit\"\nseed = 11\nthreshold_ns = 5.0\nmask_deg = 5.0\nsigma_uere_m = 1.0\n\n[time]\nstep_s = 120.0\nduration_s = 43200.0   # one ~12 h Molniya revolution\n\n# User on a Molniya orbit. altitude_km sets the semi-major-axis altitude\n# (a = 6371 km + 20229 km = 26,600 km); with e = 0.74 the perigee is ~540 km and\n# the apogee ~38,900 km. u0_deg = 0 starts the revolution at perigee.\n[user]\naltitude_km = 20229.0\ninclination_deg = 63.4\nargp_deg = 270.0\neccentricity = 0.74\nu0_deg = 0.0\nj2 = true\n\n# GPS-like Walker-delta constellation: 24 satellites, 6 planes, 55 deg inclination,\n# ~20,180 km altitude (GPS public constellation parameters; IS-GPS-200 / USCG NAVCEN).\n[constellation]\naltitude_km = 20180.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# Quantum: strontium optical lattice clock (space-oriented goal on ground hardware).\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented stability goal sigma_y(1s)=1e-15 (arXiv:1503.08457); lab Sr reaches 4.8e-17 (Oelker et al., Nature Photonics 2019). Not flown.\"\ny0 = 1.0e-15\nq_wf = 1.0e-30\nq_rw = 1.0e-40\n\n# Classical: chip-scale atomic clock (deployed commercial part).\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA.45s / SA65 chip-scale atomic clock, sigma_y(1s)=3.0e-10 (datasheet); deployed commercial part.\"\ny0 = 1.0e-11\nq_wf = 9.0e-20\nq_rw = 1.0e-28\n", "orbit-multignss.toml": "# Multi-GNSS availability from orbital geometry: GPS + Galileo combined.\n#\n# The same geometry-derived availability as orbit-gnss-challenged.toml, but the\n# user now sees two constellations at once. Combining GPS and Galileo roughly\n# doubles the visible-satellite count, lifting availability and tightening the\n# dilution of precision for the same challenging user orbit. Add further\n# `[[constellations]]` blocks (GLONASS, BeiDou) to model full multi-GNSS.\n# Vendor-neutral; constellation parameters are public/cited.\n\nkind = \"orbit\"\nseed = 7\nthreshold_ns = 5.0\nmask_deg = 10.0\nsigma_uere_m = 1.0\n\n[time]\nstep_s = 60.0\nduration_s = 86400.0   # one day\n\n# User spacecraft at ~8,000 km altitude, inside the GNSS shell.\n[user]\naltitude_km = 8000.0\ninclination_deg = 0.0\n\n# Primary constellation: GPS-like Walker-delta (24 sats, 6 planes, 55 deg,\n# ~20,180 km; IS-GPS-200 / USCG NAVCEN).\n[constellation]\naltitude_km = 20180.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# Additional constellation: Galileo-like Walker (24 sats, 3 planes, 56 deg,\n# ~23,222 km; European GNSS Service Centre / Galileo OS SIS ICD).\n[[constellations]]\naltitude_km = 23222.0\ninclination_deg = 56.0\nplanes = 3\nsats_per_plane = 8\nphasing_f = 1.0\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 1.0e-15\nq_wf = 1.0e-30\nq_rw = 1.0e-40\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA.45s / SA65 chip-scale atomic clock, sigma_y(1s)=3.0e-10 (datasheet); deployed commercial part.\"\ny0 = 1.0e-11\nq_wf = 9.0e-20\nq_rw = 1.0e-28\n", "orbit-real-tle.toml": "# GNSS availability from REAL satellite geometry, via two-line element sets.\n#\n# Instead of a synthetic Walker pattern, the constellation is parsed from a block\n# of TLEs (the standard NORAD/Celestrak format) given inline below. Drop in the\n# current GPS/Galileo/etc. element sets from celestrak.org to study coverage for\n# an actual constellation. Here a small GPS-like MEO set (i = 55 deg, ~12 h orbit,\n# six planes) is seen by a low-Earth-orbit user.\n#\n# Scope: the engine reads each TLE's mean Keplerian elements and propagates them\n# two-body — it is NOT an SGP4 propagator (accurate near epoch; use elements from\n# a common epoch). Vendor-neutral.\n\nkind = \"orbit\"\nseed = 13\nthreshold_ns = 10.0\nmask_deg = 5.0\nsigma_uere_m = 1.0\n\n[time]\nstep_s = 120.0\nduration_s = 43200.0   # ~ one GPS revolution\n\n# Low-Earth-orbit user (~500 km), looking up at the MEO constellation.\n[user]\naltitude_km = 500.0\ninclination_deg = 51.6\nu0_deg = 0.0\n\n# Real-format TLEs: six GPS-like satellites spread over six orbital planes.\n[constellation]\ntle = \"\"\"\n2 41001  55.0000   0.0000 0073892 201.7677   0.0000  2.00568623 70561\n2 41002  55.0000  60.0000 0073892 201.7677  60.0000  2.00568623 70561\n2 41003  55.0000 120.0000 0073892 201.7677 120.0000  2.00568623 70561\n2 41004  55.0000 180.0000 0073892 201.7677 180.0000  2.00568623 70561\n2 41005  55.0000 240.0000 0073892 201.7677 240.0000  2.00568623 70561\n2 41006  55.0000 300.0000 0073892 201.7677 300.0000  2.00568623 70561\n\"\"\"\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 1.0e-15\nq_wf = 1.0e-30\nq_rw = 1.0e-40\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA.45s / SA65 chip-scale atomic clock, sigma_y(1s)=3.0e-10 (datasheet); deployed commercial part.\"\ny0 = 1.0e-11\nq_wf = 9.0e-20\nq_rw = 1.0e-28\n", "orbit-rinex.toml": "# GNSS availability from a real RINEX 3 broadcast ephemeris.\n#\n# The constellation is built directly from a block of RINEX 3 GPS navigation\n# records (the broadcast ephemeris a receiver decodes), given inline below. Each\n# record becomes a satellite propagated by the IS-GPS-200 user algorithm and\n# rotated into the inertial frame, then fed through the same geometry/visibility\n# pipeline as any other constellation. Drop in a real `.rnx`/`brdc` NAV file's\n# GPS records (e.g. from an IGS station) to study coverage from actual broadcast\n# data. This is the standards-interop path: RINEX in, PNT geometry out.\n#\n# Scope: GPS LNAV broadcast ephemeris only (no Galileo/BeiDou/GLONASS yet); the\n# orbit is the broadcast Keplerian+harmonic model, valid for a few hours either\n# side of each Toe. Eight GPS satellites are spread over four orbital planes here\n# and seen by a low-Earth-orbit user. Vendor-neutral.\n\nkind = \"orbit\"\nseed = 13\nthreshold_ns = 10.0\nmask_deg = 5.0\nsigma_uere_m = 1.0\n\n[time]\nstep_s = 120.0\nduration_s = 43200.0   # ~ one GPS revolution\n\n# Low-Earth-orbit user (~500 km), looking up at the MEO constellation.\n[user]\naltitude_km = 500.0\ninclination_deg = 51.6\nu0_deg = 0.0\n\n# Real-format RINEX 3 GPS navigation records: eight satellites across four planes.\n[constellation]\nrinex = \"\"\"\n     3.04           N: GNSS NAV DATA    G: GPS              RINEX VERSION / TYPE\n                                                            END OF HEADER\nG01 2023 01 01 00 00 00 4.567890123456D-04 1.136868377216D-12 0.000000000000D+00\n     6.500000000000D+01-1.234375000000D+01 4.567890123456D-09-3.141592653590D+00\n    -6.146728992462D-07 1.234567890123D-02 7.430091500282D-06 5.153679868698D+03\n     1.728000000000D+05 1.117587089539D-08-3.141592653590D+00 7.450580596924D-09\n     9.876543210987D-01 2.612500000000D+02 5.678901234567D-01-8.123456789012D-09\n    -2.345678901234D-10 1.000000000000D+00 2.244000000000D+03 0.000000000000D+00\n     2.000000000000D+00 0.000000000000D+00-1.117587089539D-08 6.500000000000D+01\n     1.674000000000D+05 4.000000000000D+00 0.000000000000D+00 0.000000000000D+00\nG02 2023 01 01 00 00 00 4.567890123456D-04 1.136868377216D-12 0.000000000000D+00\n     6.500000000000D+01-1.234375000000D+01 4.567890123456D-09-1.570796326795D+00\n    -6.146728992462D-07 1.234567890123D-02 7.430091500282D-06 5.153679868698D+03\n     1.728000000000D+05 1.117587089539D-08-3.141592653590D+00 7.450580596924D-09\n     9.876543210987D-01 2.612500000000D+02 5.678901234567D-01-8.123456789012D-09\n    -2.345678901234D-10 1.000000000000D+00 2.244000000000D+03 0.000000000000D+00\n     2.000000000000D+00 0.000000000000D+00-1.117587089539D-08 6.500000000000D+01\n     1.674000000000D+05 4.000000000000D+00 0.000000000000D+00 0.000000000000D+00\nG03 2023 01 01 00 00 00 4.567890123456D-04 1.136868377216D-12 0.000000000000D+00\n     6.500000000000D+01-1.234375000000D+01 4.567890123456D-09-2.356194490192D+00\n    -6.146728992462D-07 1.234567890123D-02 7.430091500282D-06 5.153679868698D+03\n     1.728000000000D+05 1.117587089539D-08-1.570796326795D+00 7.450580596924D-09\n     9.876543210987D-01 2.612500000000D+02 5.678901234567D-01-8.123456789012D-09\n    -2.345678901234D-10 1.0000