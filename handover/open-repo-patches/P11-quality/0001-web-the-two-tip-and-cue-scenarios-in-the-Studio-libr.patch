ed platform vibration level added in\n# quadrature (docs/QUANTUM.md). The supplied q_va is only the fallback if the table is\n# removed. The residual bias is the published bias stability of a laboratory hybrid quantum\n# accelerometer. The interferometer parameters are a bracket in the published range, not a\n# datasheet of any instrument.\n#\n# What it answers: how long each sensor keeps the dead-reckoned position inside 100 m, and\n# how the position error grows, when one sensor is specified by interferometer physics and\n# the other by a datasheet. MODELLED: a single-axis error model, not a three-axis\n# navigation solution, and no statement about any real instrument. The further CAI error\n# terms (laser-phase noise, wavefront curvature, fringe ambiguity) are library functions,\n# not yet part of this kind.\nkind = \"inertial\"\nseed = 20261013\nthreshold_m = 100.0\n\n[time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0, t1 = 7200.0, state = \"denied\" },\n]\n\n[accel_quantum]\nid = \"cold-atom-interferometer\"\nprovenance = \"Cold-atom (Rb-87 D2) interferometric accelerometer: q_va derived from the [accel_quantum.cai] parameters, a bracket in the GAIN/MAIUS literature range (Freier et al. arXiv:1512.05660; Becker et al. Nature 2018); residual bias 5.88e-7 m/s^2 = the 6e-8 g bias stability of a laboratory hybrid quantum accelerometer (Templier et al., Science Advances 2022, arXiv:2209.13209). Laboratory maturity, not deployed.\"\nbias = 5.88e-7\nq_va = 4.6656e-8   # fallback only: overridden by the interferometer physics below\n\n[accel_quantum.cai]\nwavelength_m = 780.241209e-9   # Rb-87 D2 line\npulse_sep_t = 0.02             # pulse separation T (s)\natom_number = 1.0e6            # detected atoms per shot N\ncontrast = 0.5                 # initial fringe contrast C0\ncycle_time_s = 0.5             # measurement cycle time T_c (s)\nvibration_psd = 1.0e-12        # stated platform vibration PSD (m/s^2)^2/Hz along the axis\n\n[accel_classical]\nid = \"nav-grade-quartz\"\nprovenance = \"Navigation-grade quartz accelerometer (Honeywell QA-2000 / Groves AESS Tutorial): bias stability ~160 ug = 1.57e-3 m/s^2; noise ~20 ug/sqrtHz = 1.96e-4 (m/s^2)/sqrtHz; bias instability ~1 ug = 1e-5 m/s^2; modest acceleration random walk\"\nbias = 1.57e-3\nq_va = 3.8416e-8\nbias_instability = 1.0e-5\nq_aa = 1.0e-13\n", "quantum-gnss-free-nav.toml": "# GNSS-free quantum navigation — quantum (cold-atom interferometer) vs classical\n# navigation-grade INS dead-reckoning over a GNSS outage. MODELLED; illustrative,\n# public-source device parameters; models the class, no TRL/flight claim.\nkind = \"quantum-gnss-free-nav\"\n\noutage_s = 300.0\nthreshold_m = 100.0\nquantum_bias_m_s2 = 1.0e-7\nclassical_bias_m_s2 = 5.0e-5\n", "quantum-pnt-demonstrator.suite.toml": "# Quantum-Enabled PNT Demonstrator — the three application areas as one study.\n# Run: kshana --study scenarios/quantum-pnt-demonstrator.suite.toml\n# MODELLED throughout; each scenario carries its own representativeness + gaps-to-flight.\ntitle = \"Quantum-Enabled PNT Demonstrator (trusted timing + GNSS-free nav + anomaly detection)\"\n\nscenarios = [\n    { path = \"quantum-time-transfer.toml\", label = \"trusted-quantum-timing\" },\n    { path = \"quantum-gnss-free-nav.toml\", label = \"gnss-free-quantum-nav\" },\n    { path = \"quantum-anomaly-detect.toml\", label = \"quantum-anomaly-detection\" },\n]\n", "quantum-time-transfer.toml": "# Trusted quantum timing — end-to-end time-transfer chain, secure dissemination,\n# anomaly detection and a quantum-vs-classical trade. MODELLED; illustrative,\n# public-source device/link parameters; models the class, no TRL/flight claim.\nkind = \"quantum-time-transfer\"\n\nintegration_s = 1.0\ndissemination_interval_s = 100.0\nlink_loss_db = 30.0\nclassical_link_sigma_s = 1.0e-9\nmonitor_pfa = 1.0e-3\nattack_delay_s = 5.0e-9\nclock_fault_sigma = 4.0\n", "quantum-trade.toml": "# Quantum-vs-classical PNT trade with measured-ADEV ingestion (ESA AO/1-13503 demonstrator).\n#\n# Computes the timing-holdover and inertial-holdover benefit of a CANDIDATE clock\n# over a CLASSICAL baseline, plus a GNSS-denied resilience-vs-time envelope. The\n# candidate floor is driven by a partner clock's MEASURED overlapping-ADEV curve\n# (the defensibility hinge) fitted by non-negative least squares — so the holdover\n# budget rests on real data, not an assumed long-tau floor.\n#\n# HONEST SCOPE: MODELLED — it QUANTIFIES a partner's quantum-clock benefit; it does\n# NOT validate the device, and never borrows the SGP4/Allan/IGS validation islands.\n# When any row's floor is an assumed class default, a floor caveat renders on the\n# artifact. Run:  kshana scenarios/quantum-trade.toml\nkind = \"quantum-trade\"\n\ntiming_threshold_s = 20.0e-9     # 20 ns phase-error threshold\nposition_threshold_m = 100.0     # 100 m position-error threshold\n\n# Classical baseline clock class: csac | uso | dsac\nbaseline_clock_class = \"csac\"\n\n# Candidate = a partner optical clock's MEASURED overlapping-ADEV curve\n# (tau seconds; sigma_y). The slight long-tau upturn is a realistic red-noise floor,\n# so the recovered holdover is defensible rather than a white-noise artefact.\ncandidate_adev_taus   = [1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0]\ncandidate_adev_values = [5.0e-16, 1.6e-16, 6.0e-17, 4.0e-17, 6.0e-17, 2.0e-16]\n\n# Resilience envelope sample times (s).\nresilience_times_s = [1.0, 60.0, 600.0, 1800.0, 3600.0, 7200.0, 14400.0, 28800.0]\n", "rail-tunnel-coast.toml": "# Rail tunnel coast: how long a train's inertial navigation system (INS) keeps it\n# inside a track-discrimination budget with no Global Navigation Satellite System\n# (GNSS) in a tunnel.\n#\n# The mission question: GNSS-based train positioning loses the sky in every tunnel,\n# cutting and covered station. On a line with parallel tracks, telling which track the\n# train is on needs a cross-track error well under half the track spacing (track\n# centres on European main lines are typically around 4 m apart). How many seconds\n# into a tunnel does the position error pass 2 m, and 20 m? At 160 km/h (44.4 m/s) the\n# answer converts directly into how long a tunnel the INS alone can bridge.\n#\n# The model is `ins-trn-coast` (five growth terms combined root-sum-square). The IMU\n# (inertial measurement unit) is the representative tactical-grade class from the\n# engine's grade table (Groves 2013, Table 4.1 band), NOT a datasheet for any product.\n#\n# Honest scope: real train positioning also uses wheel odometry and trackside balises.\n# This engine has no odometer model, so this file is INS only, which is the\n# pessimistic bound; an odometer would hold along-track error far lower. No aiding is\n# applied (`trn_fix_mode = \"none\"`). MODELLED: every figure is modelled from class\n# coefficients, not measured on a train.\nkind = \"ins-trn-coast\"\n\nimu_grade = \"tactical\"\n\n# 160 km/h. The scale-factor term grows with the distance run.\nspeed_m_s = 44.4\nref_accel_m_s2 = 0.0\n\ncombination = \"rss\"\n\n# Track discrimination (2 m) and a coarse along-line budget (20 m).\ncrossing_thresholds_m = [2.0, 20.0]\n\ndrift_band_lo_m_per_s = 0.001\ndrift_band_hi_m_per_s = 0.050\n\ntrn_fix_mode = \"none\"\n\n# A 10-minute GNSS-denied section: at 160 km/h, about 27 km of tunnel.\nmission_duration_s = 600.0\n", "realtime-frame-eop.toml": "# Real-time lunar frame / Earth-orientation (EOP) prediction budget.\n#\n# A lunar navigation frame realised from an Earth-based UT1/polar-motion product is only as good\n# as the PREDICTED Earth orientation available in real time: the final IERS values for a given day\n# are published weeks later, so an operational service runs on the Bulletin A prediction. This\n# scenario emits the two P4 tables (src/frame_eop.rs):\n#\n#   Table 1 (frame-error consistency): the post-processed (definitive, zero-latency) ~0.27 m frame\n#     position and the real-time (predicted, one-hour latency) ~14.4 m frame position, each\n#     expressed as its equivalent UT1 error via the L19 lever arm Dr = D_EM * omega_earth * dUT1 —\n#     0.27 m <-> ~0.010 ms and 14.4 m <-> ~0.51 ms. The ~14.4 m is the GENUINE propagation of a\n#     round representative OD covariance (0.27 m / 4 mm/s) through the one-hour latency — NOT\n#     back-solved to hit 15 m; the order-15-m scale is independently bracketed by the real EOP-\n#     prediction curve (Table 2: ~9.9 m at 1 day, ~18.8 m at 2 days).\n#   Table 2 (UT1 prediction error vs horizon): the L18 curve read directly off the real IERS\n#     finals2000A series — the Bulletin A minus Bulletin B final floor and the multi-day\n#     persistence-predictor error — each mapped to a Moon-frame position by L19.\n#\n# It also reports the L21 root-sum-square real-time frame-error budget (EOP + ephemeris + frame-\n# realisation floor). The frame-realisation floor is DERIVED from an actual 7-parameter Helmert\n# datum realisation (its post-fit RMS residual), and the polar-motion term is sourced from the\n# measured Bulletin-A-minus-Bulletin-B pole residual when a real EOP series is supplied.\n#\n# A plain run emits <scenario>.table.csv — the P4 Table 1 + Table 2 reproducibility artifact\n# (byte-stable, golden-pinned in tests/golden/realtime-frame-eop.csv).\n#\n# Honesty: VALIDATED closed form (the L19 lever arm, omega_earth cross-checked against the CIO\n# Earth-rotation angle) and VALIDATED real data (the L18 UT1 and polar-motion curves off the real\n# finals2000A rows). DERIVED frame-realisation floor (the Helmert post-fit residual). MODELLED are\n# the lunar-relay OD covariance magnitudes (0.27 m post-processed, ~14.4 m real-time at one-hour\n# latency — a round, not back-solved, allocation), and the multi-day predictor is persistence, not\n# IERS's operational Bulletin A algorithm. Not a certified real-time frame product.\nkind = \"realtime-frame-eop\"\n\n# THE EOP INPUT. Always a REAL IERS finals2000A product, used verbatim. With no path the\n# library's own embedded copy of the 2026 extract (tools/finals2000A_2026.txt, MJD 61173-61204)\n# is in force: 20 rows carry a Bulletin B final block and 12 are Bulletin A PREDICTION-ONLY rows\n# (MJD 61193-61204), so a bare run reports `predicted_rows.n` = 12 and a populated\n# `table2_error_vs_horizon` with no file argument and no network (G12).\n#\n# Other verbatim extracts committed with the repository, for `eop_finals2000a`:\n#\n#   eop_finals2000a = \"tests/fixtures/agency/eop/finals2000A_2022001_longspan.txt\"   # 45 final rows\n#   eop_finals2000a = \"tests/fixtures/agency/eop/finals2000A_2022001.txt\"            # 5 final rows\n#                                                                                    # (the pre-G12 default)\n#\n# Both of those are FINAL-ONLY: every row carries a Bulletin B block, so they publish no Bulletin A\n# prediction row and `predicted_rows.n` is 0 on them. That zero is the FILE's property, not a\n# parser failure, and it stays exercised by test. Moving the default onto the 2026 extract moved\n# ten cells of the released p4_frame_eop.csv; they are enumerated old-to-new in\n# docs/revisions/G12-default-eop-cell-changes.md under programme rule R4. The emitted `eop_input`\n# block names whichever input is actually in force and carries its row census.\n#\n# `eop_finals2000a_later` takes an ARCHIVED LATER VINTAGE of the same product — the file as it\n# stood once the dates the first file predicts had become Bulletin B final. Supplying it turns on\n# the true predicted-vs-final vintage differencing. Without it, `table4_predicted_vs_final_horizon`\n# is emitted with no rows and says so explicitly: a single instantaneous fetch predicts only dates\n# that have no final yet, so the residual does not exist and none is synthesised.\n#\n# The defaults below reproduce the representative lunar-relay OD covariance (0.27 m / ~14.4 m) and\n# the P4 markers; uncomment to override.\nepoch = \"2022-01-01\"\nhorizons_days = [1, 2, 3]\n# ephemeris_pos_sigma_m = 0.27\n# ephemeris_vel_sigma_mps = 4.0e-3\n# latency_s = 3600.0\n# frame_realization_floor_m = 0.2  # explicit override; default is DERIVED from the Helmert residual\n# frame_realization_tie_noise_m = 0.2\n# delta_ut1_ms = 0.5\n# delta_xp_mas = 0.0\n# delta_yp_mas = 0.0\n# eop_finals2000a = \"tests/fixtures/agency/eop/finals2000A_2022001_longspan.txt\"\n# eop_finals2000a_later = \"<archived later vintage of the SAME product>\"\n\n# THE OPERATIONAL-STYLE PREDICTOR (Table 5 + Table 6).\n#\n# Table 2's multi-day curve is PERSISTENCE (\"tomorrow's UT1 is today's\"), which is not what an\n# operational user runs on: they consume the IERS Bulletin A prediction. Table 5 adds the class of\n# model Bulletin A uses — a least-squares bias + rate fit over a trailing window plus the principal\n# periodic terms (annual, semi-annual and the two principal zonal tides for UT1; the Chandler\n# wobble, annual and semi-annual for the pole), extrapolated, with the last in-window residual\n# carried forward — and scores it PREDICTED-VERSUS-FINAL: a forecast for T+h built only from rapid\n# Bulletin A rows at or before T, measured against the LATER-PUBLISHED Bulletin B final at T+h.\n# Persistence is scored over the identical epochs against the identical finals beside it, so the\n# two columns differ in the predictor and in nothing else. Both are reported; neither replaces the\n# other, and Table 2 is unchanged.\n#\n# IERS fits 365 days. No series committed with this repository is close to that, so the default\n# window is 15 days: at most 19 so BOTH committed real extracts can populate it (the 2026 extract\n# spans 19 days of finals), and at least ~13.8 so the monthly zonal tide clears the half-cycle\n# admission threshold. A term the window cannot constrain is REPORTED as rejected, with the cycles\n# the window spans, rather than silently dropped. The bundled 2026 default spans 19 days of\n# finals, so a bare run populates Table 5. The 5-row finals2000A_2022001 excerpt supports no\n# complete window at all, and on that input Table 5 reports `insufficient-data` and says why.\n#\n# operational_window_days = 15.0          # 365.0 against a real year-long product\n# operational_min_cycle_fraction = 0.5    # cycles of a period the window must span to admit it\n# operational_anchor_residual = true      # false gives the bare least-squares extrapolation\n", "reentry.toml": "# Ballistic re-entry corridor demonstrator (Allen-Eggers, mission analysis).\n#\n# Closed-form analytic entry of a non-lifting body through an exponential\n# atmosphere at constant flight-path angle: peak deceleration (independent of the\n# ballistic coefficient), the velocity and altitude at peak-g, and the\n# peak-heating velocity.\n#\n# HONEST SCOPE: MODELLED ballistic (no-lift), exponential isothermal atmosphere,\n# constant flight-path angle. No aerothermal/TPS model -- the heating output is the\n# peak-heating VELOCITY, not a heat-flux. Not a 3-/6-DoF trajectory.\n# Run:  kshana scenarios/reentry.toml\nkind = \"reentry\"\n\nentry_velocity_m_s = 7800.0      # near-circular LEO entry interface speed\nflight_path_angle_deg = 6.0      # below local horizontal\nballistic_coeff_kg_m2 = 100.0    # m / (C_D * A)\n", "slot-timing-ocxo-leo.toml": "# Slot timing: how long an oven-controlled crystal oscillator (OCXO) on a low-Earth-orbit\n# smallsat stays inside the guard of a time-indexed routing slot after its last Global\n# Navigation Satellite System (GNSS) fix, and how often it needs a fix.\n#\n# The oscillator figures are the Allan-deviation maxima, ageing and temperature bound of\n# the Microchip OX-208 datasheet (Rev 12-1-2021), the telecom-timing `ocxo` preset. The\n# noise model is fitted to lie at or above every datasheet point, so it is an envelope of\n# maxima, not a measurement of any unit. The slot figures below are illustrative choices,\n# not a requirement from any operator:\n#   - a 100 ns guard at k = 3 (about 99.7 % of a Gaussian error inside the guard);\n#   - a 10 ns one-sigma fix, taken 10 minutes ago, applied 5 s after it is taken;\n#   - a 2 K temperature change since the fix, read through the datasheet bound.\n#\n# The optional [spoofing] section adds the timing protection level for the same clock\n# in a 550 km orbit, with a ground-station two-way time transfer every 45 minutes as the\n# only independent timing cross-check.\n#\n# What the run answers: seconds until the guard breaks, the term that breaks it, the fix\n# cadence that keeps the clock inside, and how far a single ground spoofer can pull the\n# clock before the satellite leaves its reach. MODELLED throughout.\nkind = \"slot-timing\"\n\n[oscillator]\npreset = \"ocxo\"\n\n[slot]\nguard_ns = 100.0\nk_sigma = 3.0\nfix_sigma_ns = 10.0\nelapsed_since_sync_s = 600.0\nfix_latency_s = 5.0\ntemperature_excursion_k = 2.0\n\n[spoofing]\naltitude_km = 550.0\nspoofer_min_elevation_deg = 0.0\nreceiver_time_sigma_ns = 10.0\nmax_ramp_rate_ns_per_s = 10.0\n\n[[spoofing.checks]]\nkind = \"ground-contact\"\nrevisit_s = 2700.0\nsigma_ns = 2.0\n", "small-uas-jammed-nav.toml": "# Small uncrewed aircraft under GNSS jamming: how far a flight-controller-class\n# MEMS inertial unit drifts once the receiver loses lock, against a tactical-grade\n# unit, on the same closed-loop GNSS/INS filter as `gnss-ins.toml`.\n#\n# The question a small-UAS (uncrewed aircraft system) builder asks: after a jammer\n# takes the Global Navigation Satellite System (GNSS) away, how many seconds does the\n# inertial solution stay inside a position budget? `jamming-demo.toml` shows why the\n# outage happens (a 10 W broadband jammer 1 km away puts the jammer-to-signal ratio\n# near 72 dB, far past what a C/A tracking loop tolerates); this scenario takes that\n# denial as given (GNSS nominal for 100 s, then denied for 60 s) and asks what the\n# inertial navigation system (INS) does next.\n#\n# The flight-controller unit is a Bosch BMI088, a common 6-axis MEMS (micro-electro-\n# mechanical system) inertial unit on small-UAS flight controllers. Its biases are the\n# RESIDUALS left after the usual start-up calibration, not the raw datasheet offsets:\n#   - gyro: the zero-rate offset (±1 °/s, raw) is estimated at rest before take-off,\n#     so the residual is its temperature drift, ±0.015 °/s per K (Bosch BST-BMI088-\n#     DS000-19, rev 1.9, gyroscope table), over an assumed 10 K warm-up after\n#     calibration: 0.15 °/s = 2.618e-3 rad/s per axis;\n#   - accelerometer: the zero-g offset (20 mg typical, raw) is removed by a one-off\n#     calibration, so the residual is its temperature drift, < 0.2 mg per K (same\n#     datasheet, accelerometer table), over the same 10 K: 2 mg = 0.0196 m/s² per axis.\n# In flight the unit keeps warming (motor and speed-controller heat, sun, altitude), so\n# the bias keeps moving after the filter has learned it. That drift is what the\n# filter cannot learn in advance, and it is what ends the coast: the same two\n# temperature coefficients times an ASSUMED in-flight warming rate of 1 K per minute,\n# entered as linear rate-ramps in `[imu_classical.error_model]` below:\n#   - gyro: 0.015 °/s per K x 1 K/min = 4.363e-6 rad/s per s;\n#   - accelerometer: 0.2 mg per K x 1 K/min = 3.269e-5 m/s² per s.\n# The signs are chosen, not measured. The 10 K warm-up and the 1 K/min rate are\n# assumptions, and they are the numbers to change first: a slower warming rate\n# lengthens the in-spec coast and a faster one shortens it (scale both rate_ramp\n# lines together and rerun, rather than trusting a figure typed here). White noise,\n# scale-factor and misalignment are not layered on. The tactical-grade comparator is taken as\n# temperature-compensated and carries no ramp.\n#\n# The pack has two fixed slots named `imu_quantum` and `imu_classical`. Here the\n# `imu_quantum` slot carries the BETTER unit, the tactical-grade comparator with the\n# same biases as `gnss-ins.toml`, and `imu_classical` carries the flight-controller\n# MEMS unit. Nothing quantum is modelled in this file.\n#\n# Honest scope (inherited from the `gnss-ins` pack): loosely coupled, a single\n# deterministic manoeuvring profile (a forward-acceleration and yaw square wave), not a\n# recorded drone flight; flat-Earth tangent-plane comparison. Every figure this file\n# produces is MODELLED. Validating it needs flight logs from a jammed environment.\nkind = \"gnss-ins\"\nseed = 7\nthreshold_m = 50.0\nfix_interval_s = 1.0\nsigma_pos_m = 1.0\nsigma_vel_mps = 0.05\nlat_deg = 59.437\nlon_deg = 24.745\nalt_m = 120.0\n\n[time]\nstep_s = 0.1\nduration_s = 160.0\n\n[gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 100.0, state = \"nominal\" },\n  { t0 = 100.0, t1 = 160.0, state = \"denied\" },\n]\n\n[imu_quantum]\nid = \"tactical-imu\"\nprovenance = \"Tactical-grade MEMS/quartz inertial unit, the comparator: the same residual biases as scenarios/gnss-ins.toml\"\naccel_bias = [0.03, -0.02, 0.0]\ngyro_bias = [0.0, 0.0, 1.0e-4]\n\n[imu_classical]\nid = \"bmi088-flight-controller\"\nprovenance = \"Bosch BMI088 MEMS IMU (BST-BMI088-DS000-19 rev 1.9): residual bias after start-up calibration = temperature drift over an assumed 10 K warm-up; gyro 0.015 deg/s/K x 10 K = 2.618e-3 rad/s, accel 0.2 mg/K x 10 K = 0.0196 m/s^2 per axis; signs chosen\"\naccel_bias = [0.0196, -0.0196, 0.0196]\ngyro_bias = [2.618e-3, -2.618e-3, 2.618e-3]\n\n# The filter's prior on this unit's biases: the same datasheet-derived residual bounds\n# as above, taken as 1-sigma. Without it the filter keeps the pack default prior (a\n# gyro bias of 1e-4 rad/s, 1-sigma), which puts this unit's 2.618e-3 rad/s residual\n# 26 sigma out: the filter then never learns the bias, and the coast measures that\n# mis-tuning rather than the sensor.\n[imu_classical.filter_prior]\nsigma_accel_bias = 0.0196\nsigma_gyro_bias = 2.618e-3\n\n# Continued in-flight warming, 1 K/min (assumed), through the datasheet temperature\n# coefficients above: the bias drift the filter has not seen when GNSS is lost.\n[imu_classical.error_model]\nrate_ramp_gyro = [4.363e-6, -4.363e-6, 4.363e-6]\nrate_ramp_accel = [3.269e-5, -3.269e-5, 3.269e-5]\n", "solar-system-tour.toml": "# The whole solar system at one epoch.\n#\n# Every body the engine knows — the Sun, the eight planets, Pluto, the Moon, Phobos,\n# Deimos, Io, Europa, Ganymede, Callisto and Titan — at 2026-09-28 00:00 UTC: its\n# heliocentric position and velocity in the ICRF (International Celestial Reference\n# Frame, equatorial J2000), its physical constants (gravitational parameter, radii, J2 — the\n# second zonal harmonic — where published, sidereal rotation, International Astronomical\n# Union (IAU) pole, its J2000 mean value, and prime meridian at the epoch), the light time and one-way and\n# two-way range from the Earth, and an orbit track sampled over one revolution.\n# result.json carries enough to draw an interactive solar system.\n#\n# WHERE THE NUMBERS COME FROM\n#   planets  Jet Propulsion Laboratory (JPL) Keplerian elements (Standish and Williams),\n#            Table 1 for 1800 AD to 2050 AD\n#   Moon     the Montenbruck & Gill lunar series, splitting the Earth-Moon barycentre\n#   moons    JPL mean elements with the IAU synchronous rotation rate; Titan from the IAU\n#            rotation model\n#   light    the radiometric light-time solve, transmitter at its retarded position\n#\n# WHAT IS VALIDATED, AND WHAT IS NOT\n# Each body carries its own label. Mercury to Saturn and the Earth are VALIDATED against\n# JPL Horizons (Development Ephemeris DE441) within twice the Standish page's nominal\n# error. Uranus and Neptune from Table 1 exceed the page's figures against DE441 (by 2.0\n# and 5.2 times) and are MODELLED; so are Pluto, the Moon and the seven moons, which\n# were measured against Horizons but have no published bound. See tests/solar_system_horizons_reference.rs.\n#\n# The three links below add the Mars-to-Jupiter, Saturn-to-Earth and Europa-to-Jupiter\n# light times: interplanetary relay geometry, a ringed-planet downlink and a moon-to-planet\n# hop.\nkind = \"solar-system\"\nepoch = \"2026-09-28T00:00:00\"\nobserver = \"Earth\"\ntrack_points = 180\n\n[[links]]\nfrom = \"Mars\"\nto = \"Jupiter\"\n\n[[links]]\nfrom = \"Saturn\"\nto = \"Earth\"\n\n[[links]]\nfrom = \"Europa\"\nto = \"Jupiter\"\n", "space-packet.toml": "# CCSDS 133.0-B Space Packet framing demonstrator (TM/TC interop).\n#\n# Frames a synthetic telemetry/telecommand packet stream (6-octet primary header +\n# data field) and reports the per-packet primary-header decode, total stream bytes,\n# and that the encode<->decode round trip is exact -- the agency packet-format\n# bridge that lets any Kshana scenario output be wrapped as a conformant stream.\n#\n# HONEST SCOPE: exact, deterministic CCSDS-133.0 *framing* (primary-header bit\n# layout + round-trip). NOT a conformance certification; no secondary header / CRC /\n# segmentation logic beyond the sequence flags.\n# Run:  kshana scenarios/space-packet.toml\nkind = \"space-packet\"\n\napid = 100              # Application Process Identifier (0..=2047)\ntelecommand = false     # false = TM (telemetry), true = TC (telecommand)\npacket_count = 4        # frame a short sequence (first/continuation/last flags)\ndata_len = 32           # user-data-field octets per packet\n", "space-weather.toml": "# Space-weather environment model demonstrator.\n#\n# Solar (F10.7 / F10.7a) and geomagnetic (Kp) activity drive the Jacchia-1971\n# exospheric temperature, which in turn scales thermospheric neutral density above\n# the static US-Standard-Atmosphere-1976 model — the solar-cycle density dependence\n# (a ~5–10x swing at LEO) the static atmosphere omits. Reports the indices, the\n# exospheric temperature, and the activity-corrected vs static density at a set of\n# altitudes.\n#\n# HONEST SCOPE: MODELLED. The Kp<->ap conversion is the definitional IAGA table and\n# the exospheric temperature is validated against published solar-min/mean/max\n# magnitudes, but the density correction is a CALIBRATED FIRST-ORDER scale-height\n# coupling — it captures the right sign, monotonicity and order of magnitude, NOT\n# the absolute accuracy of a data-validated (NRLMSISE-00) atmosphere.\n# Run:  kshana scenarios/space-weather.toml\nkind = \"space-weather\"\n\nf107 = 180.0       # daily 10.7 cm solar radio flux (sfu) — an active sun\nf107a = 165.0      # 81-day average (sfu)\nkp = 4.0           # planetary geomagnetic index (0-9); 4 = unsettled\naltitudes_km = [300.0, 400.0, 500.0, 600.0, 800.0]\n", "spoof-attack.toml": "# Active time-spoofing attack: can each clock's integrity monitor catch the spoof\n# before it does harm?\n#\n# An attacker injects a slowly-ramping false GNSS time (0.1 ns/s from t = 60 s).\n# The receiver cross-checks the asserted time against its own clock's coasted\n# prediction and flags the spoof when the discrepancy exceeds the detection bound\n# (5 sigma of the clock-aided monitor). The optical clock's bound is a fraction of\n# a nanosecond, so it detects the spoof almost immediately — far below the 20 ns\n# operational spec. The chip-scale clock's own coast noise over the monitoring\n# window already exceeds 20 ns, so it cannot distinguish the spoof from its own\n# drift and the attack reaches the spec undetected. Vendor-neutral.\n\nkind = \"spoof\"\nthreshold_ns = 20.0\n\n[time]\nstep_s = 10.0\nduration_s = 660.0\n\n[attack]\nstart_s = 60.0\nrate_ns_per_s = 0.1\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n", "spoof-detect.toml": "# Combined RF/measurement spoof detector: multi-SV RAIM-consistency + AGC + SQM, fused.\n#\n# This pack runs `kshana::spoof_detect` — the integrated CombinedSpoofDetector — against a\n# parameterised spoofing attack. Where the `spoof` pack catches a *time* spoof via the clock,\n# this catches the spoof *transmitter* via three independent receiver observables and fuses\n# them into one weighted decision (which layer fired, and the overall verdict).\n#\n# The attack is described in the parameters the TEXBAT public test battery (Humphreys et al.,\n# ION GNSS 2012) uses to classify a record: the spoofer power advantage over the authentic\n# floor (dB), whether it is carrier-phase aligned (an aligned spoofer leaves no SQM\n# correlation-distortion signature), and whether it pushes time (common-mode, RAIM-invisible)\n# or position (a satellite subset, RAIM-detectable).\n#\n# This example is a static matched-power POSITION push (~ds4): a +1.5 dB advantage (under the\n# 3 dB AGC margin, so power alone misses it) that biases three satellites — caught by the RAIM\n# parity layer and corroborated by SQM. Try `carrier_aligned = true`, `push = \"time\"`, and a\n# small `power_advantage_db` to reproduce the documented hard case (ds7) that defeats the RF\n# layers and is left to the clock-aided `spoof` pack.\n#\n# Honest scope: this drives the detector with parameterised observables, not raw IQ — kshana is\n# a simulator, not an SDR receiver; raw-vector (TEXBAT IQ / licensed Spirent) validation is a\n# documented follow-on.\n\nkind = \"spoof-detect\"\n\n[attack]\npower_advantage_db = 1.5\ncarrier_aligned = false\npush = \"position\"\npush_magnitude_m = 75.0\nnum_biased = 3\nel_imbalance = 0.12\n\n[detector]\nsat_power_dbm = -130.0\nagc_margin_db = 3.0\nsqm_tolerance = 0.10\nraim_p_fa = 1.0e-3\nsigma_m = 5.0\nfusion_threshold = 0.5\n\n# `satellites` is optional; omitting it uses a well-spread 8-satellite geometry. To specify your\n# own sky, list azimuth/elevation rows, e.g.:\n# [[satellites]]\n# az_deg = 0.0\n# el_deg = 80.0\n", "spoof-meaconing.toml": "# Time-spoof detection with an explicit attack shape and a stochastic detector.\n#\n# The clock-aided monitor forms the GNSS-vs-clock time discrepancy y over a 600 s\n# window with 1σ uncertainty σ set by the clock's noise PSD. A spoof shifts y's\n# mean to the spoof offset μ. The detector is a two-sided χ²₁ energy test\n# (y/σ)² > λ, with λ read off the inverse χ²₁ CDF at the target false-alarm\n# probability. The Security figure of merit is 1 − P_md, the probability of\n# correctly detecting a spec-sized spoof; both the closed-form P_md and a\n# Monte-Carlo estimate (mc_runs trials per hypothesis) are reported.\n#\n# Here the attack is a meaconing (delayed re-broadcast) shape rather than the\n# default linear ramp: a constant delay with a sinusoidal component from the relay\n# geometry. Switch `kind` to `linear_ramp`, `step_jump`, or `replay` for the other\n# shapes.\n# The timing spec is deliberately tight (0.5 ns) so the chip-scale clock sits at a\n# stressed operating point (its ~0.24 ns monitor noise puts a spec-sized spoof at\n# only ~2σ → it is missed most of the time), while the optical clock — ~50× quieter\n# — still catches it with near-certainty. A looser spec is caught by both.\nkind = \"spoof\"\nthreshold_ns = 0.5\n\n[time]\nstep_s = 1.0\nduration_s = 1200.0\n\n[attack]\nstart_s = 100.0\ntarget_pfa = 0.001\nmc_runs = 20000\n\n[attack.shape]\nkind = \"meaconing\"\ndelay_ns = 8.0\noscillation_hz = 0.01\n\n# An optical clock (quiet) vs a chip-scale atomic clock (noisier short-term).\n[clock_quantum]\nid = \"optical-lattice\"\nprovenance = \"Optical lattice clock: ADEV ~1e-16/sqrt(tau); laboratory maturity\"\ny0 = 0.0\nq_wf = 1.0e-26\nq_rw = 1.0e-34\ndrift = 0.0\nflicker_floor = 0.0\n\n[clock_classical]\nid = \"csac\"\nprovenance = \"Chip-scale atomic clock (Microsemi SA.45s class): ADEV ~3e-10/sqrt(tau)\"\ny0 = 0.0\nq_wf = 1.0e-22\nq_rw = 1.0e-30\ndrift = 0.0\nflicker_floor = 0.0\n", "starlink-sop-doppler-positioning.toml": "# Doppler-only positioning from a broadband constellation used as a signal of opportunity.\n#\n# The Starlink downlink carries no navigation message and its code and carrier phase are not\n# usable for ranging, but its Doppler is: Kozhaya, Saroufim and Kassas (\"Unveiling Starlink\n# for PNT\", NAVIGATION 72(1), 2025, https://navi.ion.org/content/72/1/navi.685) track the\n# 240 MHz OFDM beacon at 11.325 GHz with a Doppler error of about 30 Hz (one sigma) and report\n# about 2 m three-dimensional error in 20 s with three satellites. This scenario uses the\n# `starlink-sop` preset: the first shell of 1584 satellites at 550 km and 53 deg (FCC 21-48;\n# the Walker phasing is representative) with that Doppler error, a stationary receiver in\n# Columbus, Ohio, a window of one minute, and one Doppler measurement per satellite every\n# 0.1 s (the beacon repeats every 4/3 ms, so a receiver can form Doppler far faster; whether\n# faster estimates are independent is not known, so the rate is a modelling input).\n#\n# The error-against-window table is the comparison with the published figure. It is a\n# MODELLED consistency check, not a reproduction: the paper's receiver estimated the\n# satellite states and oscillator offsets from real captures, while this model has a perfect\n# ephemeris and puts every error into the 30 Hz Doppler sigma.\nkind = \"leo-pvt\"\nmode = \"doppler\"\nseed = 11\nduration_s = 60.0\nstep_s = 0.1\n\n[user]\nlat_deg = 40.0\nlon_deg = -83.0\nheight_m = 220.0\n\n[doppler]\n# The receiver knows its height to 5 m (a barometer or a terrain model): Doppler from one\n# shell at 53 deg constrains the vertical weakly over a short window.\nheight_sigma_m = 5.0\nwindows_s = [5.0, 10.0, 20.0, 40.0, 60.0]\n\n[[system]]\nname = \"Starlink SoP\"\nleo_preset = \"starlink-sop\"\nmask_deg = 25.0\n", "sweep-clock-stability.toml": "# Trade study: how does holdover scale with clock stability?\n#\n# Sweep the classical clock's white-FM noise PSD (q_wf = sigma_y(1s)^2) across\n# five decades and record the holdover time — the seconds the clock keeps the\n# timing solution inside the spec after GNSS is lost. The quantum clock is held\n# fixed, so its curve is flat and the gap to the classical curve is the stability\n# advantage as a function of clock grade. Vendor-neutral; the base scenario is the\n# 2 h clock-holdover reference.\n\nkind = \"sweep\"\nparameter = \"classical_q_wf\"   # vary the classical white-FM PSD\nmetric = \"holdover_s\"          # record the holdover time\nstart = 1.0e-24                # ~ optical-class sigma_y(1s)=1e-12\nstop = 1.0e-18                 # ~ poor oscillator sigma_y(1s)=1e-9\nsteps = 25\nscale = \"log\"\n\n[base]\nseed = 42\nthreshold_ns = 20.0\n\n[base.time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[base.gnss]\nwindows = [\n  { t0 = 0.0,    t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0,  t1 = 7200.0, state = \"denied\" },\n]\n\n[base.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); q_wf=sigma_y(1s)^2; flicker floor modeled at sigma_y=1e-16; not flown.\"\ny0   = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\nflicker_floor = 1.0e-16\n\n[base.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf is swept by this study; flicker floor modeled at sigma_y=2e-11.\"\ny0   = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\nflicker_floor = 2.0e-11\n", "sweep-nd-inertial.toml": "# Generic N-D parameter sweep over ANY scenario kind. Unlike the clock-only\n# `sweep` kind, `sweep-nd` varies dotted TOML keys of the `[base]` scenario over\n# the Cartesian product of the axes, re-runs each grid node, and reads the chosen\n# metrics out of the result by dotted JSON path. It works for every pack\n# (inertial, gnss-ins, integrity, spoof, …) because it operates at the\n# TOML/result boundary, not on a per-pack Rust type. Native runs evaluate the\n# grid in parallel (no extra dependency); wasm falls back to sequential. The\n# output grid is deterministic and row-major (the last axis varies fastest).\n#\n# This example sweeps the inertial dead-reckoning pack over the GNSS-outage alert\n# threshold and the classical accelerometer bias, recording the holdover and the\n# drift RMS for the classical sensor at every node.\n#\n# The result states the unit of every axis and metric (`key_units`, `metric_units`),\n# read from the swept pack's own units table. The inertial pack echoes `threshold_m`\n# with a unit but reports the accelerometer bias under another path, so that axis\n# declares its unit itself; a declared unit that disagrees with the pack's is an error.\nkind = \"sweep-nd\"\nmetrics = [\"classical.fom.holdover_s\", \"classical.fom.pos_rms_m\"]\n\n[[axes]]\nkey = \"threshold_m\"\nstart = 100.0\nstop = 500.0\nsteps = 5\n\n[[axes]]\nkey = \"accel_classical.bias\"\nstart = 1.0e-3\nstop = 3.0e-3\nsteps = 3\nscale = \"log\"\nunit = \"m/s^2\"\n\n[base]\nkind = \"inertial\"\nseed = 42\nthreshold_m = 100.0\n\n[base.time]\nstep_s = 10.0\nduration_s = 7200.0\n\n[base.gnss]\nwindows = [\n  { t0 = 0.0,   t1 = 600.0,  state = \"nominal\" },\n  { t0 = 600.0, t1 = 7200.0, state = \"denied\" },\n]\n\n[base.accel_quantum]\nid = \"cold-atom-quat\"\nprovenance = \"Cold-atom quantum accelerometer: low residual bias\"\nbias = 5.88e-7\nq_va = 4.6656e-8\n\n[base.accel_classical]\nid = \"nav-grade-quartz\"\nprovenance = \"Navigation-grade quartz accelerometer: larger residual bias\"\nbias = 1.57e-3\nq_va = 3.8416e-8\nbias_instability = 1.0e-5\nq_aa = 1.0e-13\n", "telecom-prtc-holdover-24h.toml": "# Telecom timing reference: a rubidium clock that loses its Global Navigation Satellite\n# System (GNSS) reference and holds over for 24 hours, checked against the masks of the\n# International Telecommunication Union Telecommunication Standardization Sector (ITU-T).\n#\n# The record is 25 hours at one sample per second. For the first hour the clock is\n# disciplined, and its time error is 1 ns of white phase noise. At 3 600 s the GNSS\n# reference is lost and the clock free-runs for 24 hours with:\n#   - white, flicker and (where the fit needs it) random-walk frequency noise, fitted to\n#     the datasheet's Allan-deviation maxima and scaled to lie at or above every one;\n#   - linear frequency aging at the datasheet's monthly figure;\n#   - a daily temperature cycle of +/-2 K (an illustrative indoor swing) through the\n#     datasheet's temperature bound, read linearly as a worst case.\n# The oscillator figures come from the Microchip 8040C Rubidium Frequency Standard\n# datasheet (DS00003047A). How they become a noise model is MODELLED: see the report's\n# `oscillator` block and docs/TELECOM-TIMING.md.\n#\n# What the run answers: how long this clock stays inside each time-error budget, and\n# whether the record meets the ePRTC-A holdover requirement of ITU-T G.8272.1 (a time\n# error that may rise from 30 ns to 100 ns over the holdover period). A rubidium clock is\n# not the caesium-class reference that requirement assumes, so a FAIL there is the\n# expected, informative answer. PRTC-A (ITU-T G.8272) is a LOCKED-mode requirement; it is\n# applied here as a comparison only, and the report states that condition beside it.\n#\n# Not a conformance test and not a measurement of any unit.\nkind = \"telecom-timing\"\nseed = 20260925\nmasks = [\"eprtc-a-holdover\", \"prtc-a\"]\n\n[holdover]\noscillator = \"rubidium\"\ngnss_loss_s = 3600.0\nduration_s = 90000.0\nsample_interval_s = 1.0\nlocked_te_sigma_ns = 1.0\ninitial_frequency_offset = 0.0\ntemperature_amplitude_k = 2.0\ntemperature_period_s = 86400.0\n# ITU-T G.8272.1 Table 3: under 6 days locked, the holdover period H is 70 000 s.\nlocked_duration_days = 5.0\n\n# Budgets: each is a figure an ITU-T Recommendation states.\n[[budgets]]\nname = \"ePRTC default max|TE_HO|\"\nmax_abs_te_ns = 100.0\nsource = \"ITU-T G.8272.1 (2024) Amd. 1 (07/2025) clause 8.3.1\"\n\n[[budgets]]\nname = \"network holdover allocation, short GNSS interruption\"\nmax_abs_te_ns = 400.0\nsource = \"ITU-T G.8271.1 (2022) Amd. 3 (05/2025) Table V.1, failure scenario (b) (an example allocation)\"\n\n[[budgets]]\nname = \"network limit at reference point C\"\nmax_abs_te_ns = 1100.0\nsource = \"ITU-T G.8271.1 (2022) Amd. 3 (05/2025) clause 7.3.1 (max|TE_L|, compared unfiltered)\"\n\n[[budgets]]\nname = \"end application, accuracy class 4\"\nmax_abs_te_ns = 1500.0\nsource = \"ITU-T G.8271 (03/2020) Amd. 1 (08/2024) Table 1, class 4\"\n", "telecom-synce-eec.toml": "# Telecom timing, frequency synchronisation: a free-running oven-controlled crystal\n# oscillator (OCXO) set against the synchronous Ethernet equipment clock (EEC) wander\n# generation masks of the International Telecommunication Union Telecommunication\n# Standardization Sector (ITU-T).\n#\n# The masks: ITU-T G.8262 (10/2024) EEC Option 1 (Tables 1 and 3) and Option 2 (Tables 4\n# and 5), and ITU-T G.8262.1 (11/2025) enhanced EEC (Tables 1 and 3), each the\n# constant-temperature (within +/-1 K) maximum time interval error (MTIE) and time\n# deviation (TDEV) limit. The record is 12 000 s at one sample per second, so TDEV\n# reaches 1 000 s, the end of every mask, under the twelve-times-tau rule.\n#\n# The clock: the OCXO preset (Microchip OX-208 datasheet, Rev 12-1-2021), free-running\n# from the first sample with white, flicker and (where the fit needs it) random-walk\n# frequency noise fitted to the datasheet's Allan-deviation maxima, and its linear aging.\n# The temperature is held constant (amplitude 0 K), as the masks assume.\n#\n# What the run answers: does this oscillator's own wander, with no loop at all, already\n# fit inside each mask? These are LOCKED-mode masks for a clock synchronised to a\n# wander-free reference. A phase-locked loop passes the oscillator's wander at\n# observation intervals short against its time constant and suppresses it at longer\n# ones, so the free-running record stands in for the oscillator's contribution at short\n# intervals and overstates it at long ones. A FAIL at long intervals says the loop must\n# do that work; it says nothing about any EEC. The report states the locked condition\n# beside every verdict.\n#\n# The 10 Hz measurement filter the Recommendations state acts before sampling; the kind\n# takes the record as already measured through it.\n#\n# Not a conformance test and not a measurement of any unit.\nkind = \"telecom-timing\"\nseed = 20260925\nmasks = [\"g8262-eec-option-1\", \"g8262-eec-option-2\", \"g8262-1-eeec\"]\n# No time-error budgets: they are phase-synchronisation figures, not EEC requirements.\nbudgets = []\n\n[holdover]\noscillator = \"ocxo\"\ngnss_loss_s = 0.0\nduration_s = 12000.0\nsample_interval_s = 1.0\nlocked_te_sigma_ns = 0.0\ninitial_frequency_offset = 0.0\ntemperature_amplitude_k = 0.0\ntemperature_period_s = 86400.0\n", "telecom-tie-ingest.toml": "# Telecom timing, ingestion example: a time interval error (TIE) series given inline and\n# checked against the masks of the International Telecommunication Union\n# Telecommunication Standardization Sector (ITU-T).\n#\n# Give your own record the same way: `samples` holds [time_s, time_error_ns] pairs,\n# uniformly sampled. The WebAssembly build has no filesystem, so inline samples are the\n# form that runs everywhere; on native builds `csv_path = \"your.csv\"` reads a file of\n# `time_s,time_error_ns` rows instead (a header line and `#` comments are skipped).\n#\n# THE DATA BELOW IS NOT A MEASUREMENT. It is the first 1 200 s of the engine's own\n# chip-scale atomic clock (CSAC) holdover fixture (tests/fixtures/telecom_timing/\n# holdover_te_series.csv, seed 20260925), rounded to 1 ps: 300 s disciplined, then the\n# Global Navigation Satellite System (GNSS) reference is lost. It is here to show the\n# input shape and what the report does with it.\n#\n# holdover_start_s marks the loss, so the budgets and the ePRTC-A holdover envelope of\n# ITU-T G.8272.1 Table 3 are timed from it. Masks written through a 0.1 Hz low-pass\n# filter (the T-BC/T-TSC classes of G.8273.2 and the G.8271.1 network limits) are\n# evaluated on the filtered series; the record is sampled every second, the coarsest\n# interval the engine applies that filter at.\nkind = \"telecom-timing\"\nmasks = [\"prtc-a\", \"prtc-b\", \"eprtc\", \"eprtc-a-holdover\", \"t-bc-class-c\", \"g8271-1-point-c\"]\n\n[series]\nholdover_start_s = 300.0\nlocked_duration_days = 5.0\nsamples = [\n  [0, -0.299], [1, 0.405], [2, 0.518], [3, 0.874], [4, -1.471], [5, 0.279], [6, 1.159], [7, 0.602],\n  [8, 1.572], [9, -0.107], [10, 0.180], [11, 0.633], [12, -1.063], [13, 0.159], [14, 0.145], [15, -0.549],\n  [16, -0.583], [17, -0.644], [18, 0.116], [19, 0.097], [20, -0.017], [21, -1.306], [22, 1.312], [23, 0.724],\n  [24, 0.721], [25, 1.316], [26, -1.823], [27, -2.049], [28, 0.493], [29, -0.367], [30, 1.773], [31, -1.369],\n  [32, 0.479], [33, 0.904], [34, -0.394], [35, -0.272], [36, -0.274], [37, -1.622], [38, 0.705], [39, 0.842],\n  [40, 2.143], [41, 0.390], [42, 0.111], [43, 0.354], [44, -0.458], [45, 2.234], [46, -0.054], [47, 0.007],\n  [48, -0.041], [49, 1.322], [50, 1.137], [51, -1.083], [52, -1.785], [53, -0.875], [54, -1.141], [55, -1.480],\n  [56, 1.017], [57, 0.799], [58, 1.402], [59, 0.547], [60, 0.400], [61, 0.865], [62, -0.110], [63, 0.417],\n  [64, -0.372], [65, 1.013], [66, -0.546], [67, -0.260], [68, -0.263], [69, 0.251], [70, 0.584], [71, -1.498],\n  [72, 2.004], [73, 0.218], [74, 0.026], [75, -1.433], [76, -0.862], [77, 1.481], [78, 0.903], [79, -0.616],\n  [80, -0.002], [81, 0.791], [82, -0.782], [83, -0.643], [84, -1.066], [85, -1.233], [86, -0.315], [87, -0.239],\n  [88, 0.854], [89, 0.464], [90, -0.410], [91, 1.160], [92, 1.584], [93, 0.768], [94, 0.379], [95, 0.392],\n  [96, -1.724], [97, -0.149], [98, -1.994], [99, 0.772], [100, -0.026], [101, -1.554], [102, -0.070], [103, -1.709],\n  [104, -1.601], [105, -0.887], [106, -0.267], [107, 0.509], [108, -0.064], [109, -1.339], [110, -1.184], [111, 0.444],\n  [112, 0.652], [11