@@ -543,6 +543,19 @@ function entryHeating(r) {
   if (!has(r, "peak_deceleration.g", "peak_deceleration.altitude_m", "peak_heat_flux.w_cm2", "relative_entry.speed_m_s", "relative_entry.flight_path_angle_deg")) return null;
