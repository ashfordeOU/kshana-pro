45854  55.2875  99.2718 0012969 159.4500 200.6580  2.00565280  8217\nGPS BIII-4  (PRN 14)\n1 46826U 20078A   21208.36178102 -.00000038  00000-0  00000-0 0  9996\n2 46826  54.7925 283.2751 0008563 182.1587 177.9073  2.00554341  5690\n\"\"\"\n# Real Celestrak TLEs carry valid column-69 checksums; require them, so this\n# scenario fails to load if the snapshot is corrupted or hand-edited.\nstrict_checksum = true\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 1.0e-15\nq_wf = 1.0e-30\nq_rw = 1.0e-40\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA.45s / SA65 chip-scale atomic clock, sigma_y(1s)=3.0e-10 (datasheet); deployed commercial part.\"\ny0 = 1.0e-11\nq_wf = 9.0e-20\nq_rw = 1.0e-28\n", "orbit-urban-canyon-skyline.toml": "# GNSS availability and dilution of precision at the bottom of a city street: the `orbit`\n# kind with a ground-site user (`user_site`) under the `city-street` skyline preset.\n#\n# The question a road-vehicle or pedestrian-navigation team asks: the buildings either side\n# of a street hide every satellite low across it and leave a strip of sky along it, so how\n# much of the day does a GPS plus Galileo receiver still have four satellites, and what does\n# the narrow strip do to the position dilution of precision? The street runs north-south,\n# 20 m between 30 m walls, with the antenna 1.5 m up on the centreline: the walls rise to\n# atan(28.5/10) = 70.7 deg across the street and fall to the 5 deg receiver mask along it.\n# The site is a generic point in a north-west European city (52.0 N, 5.0 E); remove the\n# [skyline] section to see the same site under open sky.\n#\n# `user_site` makes the user a ground site fixed to the rotating Earth (geodetic elevation\n# and azimuth, so the skyline has an Earth-fixed azimuth to depend on); an orbiting `user`\n# refuses a skyline. The clock-holdover half of the result is the orbit kind's usual\n# quantum-versus-classical comparison over the visibility timeline the street leaves.\n#\n# The skyline preset is REPRESENTATIVE (provenance in docs/SKYLINE.md and `kshana skyline\n# --preset city-street`): a street of the proportions urban-climate studies report, not a\n# survey of any street. Line of sight only: no diffraction, reflection or non-line-of-sight\n# reception. The constellations are Walker patterns with their public parameters, and their\n# relative phase is not a snapshot of any date. MODELLED.\nkind = \"orbit\"\nseed = 7\nthreshold_ns = 5.0\nmask_deg = 5.0\nsigma_uere_m = 1.0\n\n[time]\nstep_s = 300.0\nduration_s = 86400.0   # one day\n\n[user_site]\nlat_deg = 52.0\nlon_deg = 5.0\nheight_m = 45.0\n\n# GPS-like Walker-delta (24 satellites, 6 planes, 55 deg, ~20,180 km; IS-GPS-200 / USCG\n# NAVCEN public constellation parameters).\n[constellation]\naltitude_km = 20180.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# Galileo-like Walker 24/3/1 (23,222 km, 56 deg; Galileo OS SDD issue 1.1).\n[[constellations]]\naltitude_km = 23222.0\ninclination_deg = 56.0\nplanes = 3\nsats_per_plane = 8\nphasing_f = 1.0\n\n[clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 1.0e-15\nq_wf = 1.0e-30\nq_rw = 1.0e-40\n\n[clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA.45s / SA65 chip-scale atomic clock, sigma_y(1s)=3.0e-10 (datasheet); deployed commercial part.\"\ny0 = 1.0e-11\nq_wf = 9.0e-20\nq_rw = 1.0e-28\n\n[skyline]\npreset = \"city-street\"\n", "passes.toml": "# Ground-station pass prediction demonstrator (ground segment & operations).\n#\n# Predicts the visibility passes (AOS / TCA / LOS, maximum elevation, duration) of\n# a circular orbit over a ground station above an elevation mask across a window --\n# the rise/set scheduler the static look-angle primitives do not provide. AOS/LOS\n# crossings are solved by bisection and the culmination by golden-section search;\n# total access time is summed.\n#\n# The orbit is an SGP4 element set on the IAU 2006/2000A Earth-fixed frame (UT1 = UTC\n# and no polar motion unless ut1_minus_utc_s, xp_arcsec, yp_arcsec are given); the\n# elevations are apparent, with ITU-R P.834-9 refraction and the downlink light time\n# (switches `refraction` and `light_time`, both on by default).\n# Run:  kshana scenarios/passes.toml\nkind = \"passes\"\n\naltitude_km = 550.0\ninclination_deg = 97.6      # sun-synchronous-like\nraan_deg = 0.0\narg_lat_deg = 0.0\n\nstation_lat_deg = 52.2       # Delft, NL\nstation_lon_deg = 4.4\nstation_alt_m = 0.0\n\n# epoch = [year, month, day, hour, minute, second]  (UTC ~ UT1)\nepoch = [2024.0, 1.0, 1.0, 0.0, 0.0, 0.0]\n\nmask_deg = 10.0\nduration_hours = 24.0\nstep_s = 10.0\n", "polar-arctic-leo-coverage.toml": "# Satellites in view and dilution of precision from the equator to the pole: MEO GNSS alone,\n# a near-polar LEO constellation alone, and both.\n#\n# GPS and Galileo orbit at 55 and 56 deg inclination, so north of about 70 deg every MEO\n# satellite is on the equatorward half of the sky at low elevation and the vertical geometry\n# weakens. The Iridium constellation (six near-polar planes of 11 at 780 km and 86.4 deg, the\n# `iridium-stl` preset) converges over the poles. The sweep samples eight longitudes and\n# thirteen epochs over two hours at each latitude and reports the mean satellites in view,\n# the median PDOP, HDOP and VDOP and the availability (PDOP at or below 6) for each group.\n#\n# MODELLED: geometry only; ionospheric scintillation, strong at high latitude, is not modelled.\nkind = \"leo-pvt\"\nmode = \"polar\"\nduration_s = 7200.0\nstep_s = 600.0\n\n[polar]\nlat_step_deg = 10.0\nlon_step_deg = 45.0\npdop_threshold = 6.0\n\n[[system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\nmask_deg = 10.0\n\n[[system]]\nname = \"Galileo\"\npreset = \"galileo\"\nmask_deg = 10.0\n\n[[system]]\nname = \"Iridium\"\nleo_preset = \"iridium-stl\"\nmask_deg = 10.0\n", "pvt-abmf.toml": "# Real-observation single-point positioning (SPP) from a surveyed IGS station.\n#\n# This solves a receiver's position from genuine GNSS measurements: the RINEX 3\n# code pseudoranges logged by IGS station ABMF (Aubergine, Le Moule, Guadeloupe)\n# on 2018-05-13 at 01:30 GPS, and the GPS broadcast ephemeris for that day. The\n# dual-frequency ionosphere-free L1/L2 combination removes the ionosphere; the\n# Saastamoinen/Niell model handles the troposphere; an iterated weighted\n# least-squares solve recovers position and clock. The result is validated\n# against the station's surveyed coordinate (truth_ecef): the engine reports the\n# horizontal, vertical, and 3-D error of the fix.\n#\n# Scope: single-point positioning from broadcast ephemeris (metre-level), not\n# carrier-phase PPP/RTK. Vendor-neutral; the data are open IGS products.\n\nkind = \"pvt\"\nmask_deg = 5.0\ndual_frequency = true\n\n# ABMF surveyed ECEF coordinate (m), the IGS a-priori from the observation header.\ntruth_ecef = [2919786.4480, -5383745.1780, 1774604.7340]\n\nobs_rinex = \"\"\"\n     3.02           OBSERVATION DATA    M                   RINEX VERSION / TYPE\nConverto v3.5.1     IGN-RGP             20180514 013007 UTC PGM / RUN BY / DATE\nSNR is mapped to RINEX snr flag value [1-9]                 COMMENT\nLX:     < 12dBHz -> 1; 12-17dBHz -> 2; 18-23dBHz -> 3       COMMENT\n       24-29dBHz -> 4; 30-35dBHz -> 5; 36-41dBHz -> 6       COMMENT\n       42-47dBHz -> 7; 48-53dBHz -> 8; >= 54dBHz -> 9       COMMENT\nABMF                                                        MARKER NAME\n97103M001                                                   MARKER NUMBER\nAutomatic           Institut Geographique National          OBSERVER / AGENCY\n1830399             LEICA GR25          4.11                REC # / TYPE / VERS\n1441112501          TRM57971.00     NONE                    ANT 