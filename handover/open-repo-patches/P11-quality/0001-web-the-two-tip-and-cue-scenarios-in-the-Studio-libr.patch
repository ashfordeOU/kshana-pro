, so from a fixed site Jupiter never moves in the sky, while the Earth, riding\n# with Jupiter, rises and sets once per Europan day: the Earth link is available only for\n# part of the run, and the report shows what the local constellation must carry alone.\n#\n# The Europa constants (gravitational parameter, mean radius, International Astronomical\n# Union (IAU) pole and prime meridian)\n# are the published values cited in src/body.rs; no J2 (second zonal harmonic) is carried\n# for Europa, so the relay\n# orbits are two-body. The Earth-Europa light time is about 36 minutes one way at this\n# epoch, near a Jupiter opposition.\n#\n# One simplification matters more here than at Mars: the relays orbit inside Europa's Hill\n# sphere (about 13 700 km) but Jupiter's pull on them is not modelled, so their orbits are\n# idealised. The run shows the geometry and what the Earth link adds (availability rises\n# from about half the Europan day to about three quarters), not a flyable design.\n#\n# MODELLED: the constellation, the noise and the measurement model are modelling choices.\nkind = \"body-pnt\"\nbody = \"Europa\"\nepoch = \"2027-02-19T00:00:00\"\nduration_s = 306822.0\nstep_s = 1800.0\nseed = 11\n\n[user]\nkind = \"surface\"\nlat_deg = 20.0\nlon_deg = 60.0\n\n[constellation]\nplanes = 3\nsats_per_plane = 4\naltitude_km = 4500.0\ninclination_deg = 55.0\nsigma_range_m = 1.0\nmask_deg = 10.0\n\n[earth_link]\nenabled = true\nsigma_range_m = 1.0\n","body":"Europa","user":{"kind":"surface","lat_deg":20.0,"lon_deg":60.0},"relays":12,"relay_alt_km":4500.0,"relay_period_h":14.552,"light_s":2182.9,"fom":{"availability_relays":0.4795,"availability_with_earth":0.7135,"earth_visibility":0.4386,"mean_relays_visible":3.4211,"median_formal_sigma_relays_m":5.3603,"median_formal_sigma_with_earth_m":4.2389,"median_pdop":5.3603,"n_epochs":171,"rms_error_relays_m":112.7418,"rms_error_with_earth_m":86.4993,"rms_normalised_error_relays":1.0161,"rms_normalised_error_with_earth":0.9888},"t":[