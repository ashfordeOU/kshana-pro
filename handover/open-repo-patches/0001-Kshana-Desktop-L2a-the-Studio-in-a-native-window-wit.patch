+++ b/web/studio/lib/desktop.mjs
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// Kshana Desktop: the Studio's engine client when the page runs inside the Desktop app
+// (apps/desktop). The heavy functions (runs, charts, tables, the localised text) go to
+// the native engine through the app's `engine_call` command; every other function keeps
+// using the WebAssembly client `base`, so each tool page works as it does on the web.
+// A cancel rejects the waiting native calls at once; the native run itself finishes in
+// the background and its answer is dropped.
+import { EngineCancelled } from "./engine.mjs";
+
+/** The Desktop's invoke function, or null outside the Desktop. */
+export function desktopInvoke(g = globalThis) {
+  const i = g && g.__TAURI_INTERNALS__;
+  return i && typeof i.invoke === "function" ? (cmd, args) => i.invoke(cmd, args) : null;
+}
+
+/** The engine client for the Desktop: `base` (the WebAssembly client, or null) wrapped. */
+export async function desktopEngine(base, invoke) {
+  const native = new Set(await invoke("engine_native_fns"));
+  const pending = new Map();
+  let nextId = 1;
+  const callNative = (fn, args) => {
+    const id = nextId++;
+    return new Promise((resolve, reject) => {
+      pending.set(id, reject);
+      invoke("engine_call", { name: fn, args }).then(
+        (v) => { if (pending.delete(id)) resolve(v); },
+        (e) => { if (pending.delete(id)) reject(new Error(String(e && e.message ? e.message : e))); },
+      );
+    });
+  };
+  return {
+    get mode() { return "native"; },
+    get canCancel() { return true; },
+    native,
+    call(fn, ...args) {
+      if (native.has(fn)) return callNative(fn, args);
+      if (base) return base.call(fn, ...args);
+      return Promise.reject(new Error(`this engine build has no ${String(fn)}`));
+    },
+    // Both engines learn the catalogue: the native one localises runs, the WebAssembly one the tool pages.
+    register(tag, ftl) {
+      const n = callNative("register_catalogue", [tag, ftl]);
+      const w = base && typeof base.register === "function" ? base.register(tag, ftl).catch(() => null) : Promise.resolve(null);
+      return Promise.all([n, w]).then(() => undefined);
+    },
+    cancel() {
+      for (const [id, reject] of pending) {
+        pending.delete(id);
+        reject(new EngineCancelled());
+      }
+      if (base && base.canCancel) base.cancel();
+      return true;
+    },
+  };
+}
diff --git a/web/studio/lib/desktop.test.mjs b/web/studio/lib/desktop.test.mjs
new file mode 100644
index 0000000..e2514b4
--- /dev/null
+++ b/web/studio/lib/desktop.test.mjs
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// Tests for the Desktop engine client (desktop.mjs) against a fake invoke and a fake
+// WebAssembly client. Run with `node web/studio/lib/desktop.test.mjs`.
+import assert from "node:assert/strict";
+import { desktopEngine, desktopInvoke } from "./desktop.mjs";
+import { isCancelled } from "./engine.mjs";
+
+const calls = [];
+let release = null;
+const invoke = async (cmd, args) => {
+  calls.push([cmd, args]);
+  if (cmd === "engine_native_fns") return ["run", "run_all", "register_catalogue"];
+  if (cmd === "engine_call" && args.name === "run" && args.args[0] === "slow") {
+    await new Promise((r) => { release = r; });
+    return "late";
+  }
+  if (cmd === "engine_call" && args.name === "run" && args.args[0] === "bad") throw "invalid scenario";
+  if (cmd === "engine_call") return `native:${args.name}`;
+  throw new Error("unknown command");
+};
+const baseCalls = [];
+const base = {
+  canCancel: true,
+  cancelled: 0,
+  call: (fn, ...args) => { baseCalls.push(fn); return Promise.resolve(`wasm:${fn}`); },
+  register: (tag) => { baseCalls.push(`register:${tag}`); return Promise.resolve(); },
+  cancel() { this.cancelled++; return true; },
+};
+
+assert.equal(desktopInvoke({}), null);
+assert.equal(typeof desktopInvoke({ __TAURI_INTERNALS__: { invoke: () => 1 } }), "function");
+
+const e = await desktopEngine(base, invoke);
+assert.equal(e.mode, "native");
+assert.equal(e.canCancel, true);
+// Native functions go to the app; the rest to the WebAssembly client.
+assert.equal(await e.call("run", "x"), "native:run");
+assert.equal(await e.call("receiver_trust", "y"), "wasm:receiver_trust");
+assert.deepEqual(baseCalls, ["receiver_trust"]);
+// An engine error reaches the page as an Error with the engine's message.
+await assert.rejects(e.call("run", "bad"), /invalid scenario/);
+// A catalogue is registered with both engines.
+await e.register("de", "x = y");
+assert.ok(calls.some(([c, a]) => c === "engine_call" && a.name === "register_catalogue"));
+assert.ok(baseCalls.includes("register:de"));
+// Cancel rejects a waiting native call at once, and its late answer is dropped.
+const p = e.call("run", "slow");
+await new Promise((r) => setTimeout(r, 0));
+e.cancel();
+await assert.rejects(p, (err) => isCancelled(err));
+release();
+assert.equal(base.cancelled, 1);
+// Without a WebAssembly client, a function the native engine lacks is refused clearly.
+const lone = await desktopEngine(null, invoke);
+await assert.rejects(lone.call("receiver_trust"), /no receiver_trust/);
+console.log("desktop.test.mjs: ok");
