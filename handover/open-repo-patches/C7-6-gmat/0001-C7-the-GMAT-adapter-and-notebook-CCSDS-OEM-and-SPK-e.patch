diff --git a/.github/workflows/flight-dynamics.yml b/.github/workflows/flight-dynamics.yml
index f04bfec33..18f2e9157 100644
--- a/.github/workflows/flight-dynamics.yml
+++ b/.github/workflows/flight-dynamics.yml
@@ -108,3 +108,56 @@ jobs:
           name: flight-dynamics-${{ matrix.tool }}
           path: ${{ runner.temp }}/fd
           if-no-files-found: warn
+  gmat:
+    # GMAT R2026a reads the OEM and the SPK through its ephemeris propagators. The adapter was
+    # written without running GMAT, so this job may fail while it is fixed from these logs; it
+    # does not fail the workflow, and C7 does not count GMAT done until it is green.
+    needs: write
+    runs-on: ubuntu-22.04
+    timeout-minutes: 60
+    continue-on-error: true
+    env:
+      GMAT_TARBALL_SHA256: fe124b4a606b2e3b704a6fbb1c37b87598d5df0d18cb661c304b5f60074a7754
+      GMAT_URL: https://sourceforge.net/projects/gmat/files/GMAT/GMAT-R2026a/gmat-ubuntu-x64-R2026a.tar.gz/download
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
+        with:
+          name: fd-inputs
+          path: fd-inputs
+      - name: Cache GMAT R2026a (keyed on the tarball's SHA-256)
+        id: gmat-cache
+        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        with:
+          path: ~/gmat
+          key: gmat-R2026a-fe124b4a606b2e3b704a6fbb1c37b87598d5df0d18cb661c304b5f60074a7754
+      - name: Fetch GMAT R2026a and check its SHA-256
+        if: steps.gmat-cache.outputs.cache-hit != 'true'
+        run: |
+          set -euo pipefail
+          curl -sSfL --retry 4 -o "$RUNNER_TEMP/gmat.tar.gz" "$GMAT_URL"
+          echo "$GMAT_TARBALL_SHA256  $RUNNER_TEMP/gmat.tar.gz" | sha256sum -c -
+          mkdir -p ~/gmat
+          tar xzf "$RUNNER_TEMP/gmat.tar.gz" -C ~/gmat
+          rm "$RUNNER_TEMP/gmat.tar.gz"
+      - name: GMAT's runtime libraries
+        run: sudo apt-get update && sudo apt-get install -y libgfortran5 libgomp1
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
+        with:
+          python-version: "3.12"
+      - name: Install the wheel and the adapter's requirements
+        run: |
+          pip install --no-index --find-links fd-inputs/dist kshana
+          pip install -r integrations/flight-dynamics/requirements-gmat.txt
+      - name: Run the GMAT notebook top to bottom
+        env:
+          GMAT_ROOT: /home/runner/gmat/GMAT/R2026a
+          KSHANA_FD_CLI_DIR: ${{ github.workspace }}/fd-inputs/cli
+          KSHANA_FD_OUT: ${{ runner.temp }}/fd
+        run: python integrations/flight-dynamics/run_notebooks.py gmat
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        if: always()
+        with:
+          name: flight-dynamics-gmat
+          path: ${{ runner.temp }}/fd
+          if-no-files-found: warn
