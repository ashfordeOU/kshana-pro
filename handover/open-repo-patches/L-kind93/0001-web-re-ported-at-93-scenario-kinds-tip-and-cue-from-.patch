ar-coast-road","max":38.996,"max_member":"ship-strait","mean":36.817},"min_tracking":{"unit":"count","members":2,"min":1.0,"min_member":"ship-strait","max":7.0,"max_member":"car-coast-road","mean":4.0}}},"leo-pass-vs-gnss-cn0":{"kind":"leo-pass","chips":[["56.8 dB-Hz","low-orbit peak C/N0"],["47.8 dB-Hz","GNSS median C/N0"],["590 s","pass duration"]]},"leo-doppler-positioning":{"kind":"leo-pvt","chips":[["7.4 m","horizontal error"],["26","satellites"],["811","Doppler measurements"]]},"meo-leo-fused-pvt":{"kind":"leo-pvt","chips":[["1.06 m","GNSS alone, RMS error"],["0.41 m","fused with low orbit"],["1.06","median PDOP, fused"]]},"leo-ppp-convergence":{"kind":"leo-ppp","chips":[["7.4 min","to converge, GNSS only"],["2.3 min","with 288 low-orbit satellites"],["10 cm","horizontal criterion"]]},"leo-pnt-end-to-end":{"kind":"leo-pnt-chain","chips":[["60.7 dB-Hz","peak C/N0 over the pass"],["0.25 m","signal-in-space range error, RMS"],["0.43 m","fused fix, RMS error"]]},"leo-timing-utc":{"kind":"leo-pvt","chips":[["17.0 ns","median measurement sigma"],["9.9 to 25.0 ns","RMS time error across the cases"],["16","clock and signal-level cases"]]},"ntn-5g-positioning":{"kind":"ntn-positioning","chips":[["324","satellites"],["10.0","in view on average"],["2.1 m","median 3-D sigma, NR 5 MHz"],["25.9 m","median 3-D sigma, NB 200 kHz"]]},"leo-navmsg-fit-interval-trade":{"kind":"leo-navmsg","chips":[["1.8 mm","worst range error, 60 s fit"],["46.6 mm","worst range error, 900 s fit"]]},"leo-band-trade":{"kind":"leo-signal","chips":[["5","signal designs"],["2.2 cm","finest code jitter at equal C/N0"],["5100 MHz","its carrier"]]}},"toml":{"constellation-multi-gnss-coverage":"# Multi-constellation coverage: the four global navigation satellite systems (GNSS) together,\n# as a map of satellites in view, dilution of precision (DOP) and availability over the whole\n# Earth for one day.\n#\n# Each system is a preset built from its operator's published nominal elements:\n#   - GPS: the baseline 24-slot constellation, GPS Standard Positioning Service Performance\n#     Standard, 5th edition (2020), Tables 3.2-1 and 3.2-3;\n#   - Galileo: the Walker 24/3/1 reference constellation at 29 599.801 km semi-major axis and\n#     56 deg, Galileo Open Service Service Definition Document issue 1.1, Tables 1 and 23;\n#   - BeiDou: 24 medium Earth orbit satellites in a Walker 24/3/1 at 21 528 km and 55 deg,\n#     3 geostationary and 3 inclined geosynchronous satellites, BeiDou Open Service\n#     Performance Standard 3.0, section 4.1 (the medium-orbit phase and the inclined\n#     geosynchronous crossing longitude are modelled, the standard does not state them);\n#   - GLONASS: 24 satellites, 3 planes, 19 100 km, 64.8 deg, from the slot formula of the\n#     GLONASS Interface Control Document edition 5.1, section 5.2.\n#\n# The receiver estimates one clock per system (clock = \"per-constellation\"), so a fix needs\n# three position unknowns plus one clock for every system in view. The four systems' slot\n# tables come from different reference epochs, so their relative phase is not a snapshot of\n# any real date; the statistics over a day are what the run is for.\n#\n# What the run answers: how many satellites are in view, the position, horizontal, vertical\n# and geometric DOP per 10 deg cell, and the share of time the position DOP (PDOP) is at or\n# below 6 above a 10 deg mask. MODELLED: two-body orbits, a spherical Earth, geometry only.\n\nkind = \"constellation-design\"\nbody = \"earth\"\nduration_s = 86164.0\nstep_s = 900.0\nmask_deg = 10.0\npdop_threshold = 6.0\ngrid_step_deg = 10.0\nclock = \"per-constellation\"\ntrack_points = 25\nmax_tracks = 102\n\n[[constellation]]\nname = \"GPS\"\npreset = \"gps-baseline\"\n\n[[constellation]]\nname = \"Galileo\"\npreset = \"galileo\"\n\n[[constellation]]\nname = \"BeiDou\"\npreset = \"beidou\"\n\n[[constellation]]\nname = \"GLONASS\"\npreset = \"glonass\"\n","leo-pnt-mega-shell":"# A low-Earth-orbit positioning, navigation and timing (PNT) mega-constellation: 5 000\n# satellites in four Walker shells, scored as a coverage and dilution-of-precision (DOP) map.\n#\n# The shells are an illustrative design, not any operator's filing:\n#   - 1 600 satellites, Walker delta 1600/32/1 at 550 km and 53 deg;\n#   - 1 600 satellites, Walker delta 1600/32/7 at 540 km and 53.2 deg;\n#   - 1 000 satellites, Walker delta 1000/20/3 at 570 km and 70 deg;\n#   -   800 satellites, Walker star 800/16/1 at 560 km and 97.6 deg (near-polar, planes\n#       spread over 180 deg) to fill the high latitudes.\n#\n# At this size the visibility prefilter matters: each epoch the satellites are sorted by\n# sub-satellite latitude and a grid row only tests those within one coverage half-angle of\n# it. The `work` block of the result states how many satellite-point pair tests a brute-force\n# scan would have made and how many were made. The secular J2 drift of the nodes is on, and\n# the tracks are downsampled to 120 satellites.\n#\n# What the run answers: satellites in view, PDOP/HDOP/VDOP/GDOP per 10 deg cell, and the\n# share of time with PDOP at or below 3 above a 20 deg mask over two hours. The weak spot the\n# map shows is the polar caps: no shell reaches above about 82 deg latitude, so a user near a\n# pole sees every satellite on one side of the sky and the vertical geometry degrades. MODELLED: an\n# illustrative design, two-body orbits with J2, a spherical Earth, geometry only.\n\nkind = \"constellation-design\"\nbody = \"earth\"\nduration_s = 7200.0\nstep_s = 600.0\nmask_deg = 20.0\npdop_threshold = 3.0\ngrid_step_deg = 10.0\nclock = \"common\"\nj2 = true\ntrack_points = 13\nmax_tracks = 120\n\n[[constellation]]\nname = \"LEO-PNT\"\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 1600\nplanes = 32\nphasing = 1\naltitude_km = 550.0\ninclination_deg = 53.0\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 1600\nplanes = 32\nphasing = 7\naltitude_km = 540.0\ninclination_deg = 53.2\nraan0_deg = 5.625\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 1000\nplanes = 20\nphasing = 3\naltitude_km = 570.0\ninclination_deg = 70.0\n\n[[constellation.shell]]\npattern = \"star\"\ntotal = 800\nplanes = 16\nphasing = 1\naltitude_km = 560.0\ninclination_deg = 97.6\n","lunar-relay-constellation":"# A lunar relay and navigation constellation: satellites in elliptical lunar frozen orbits\n# (ELFO) plus a circular low-lunar-orbit shell, scored as a coverage and dilution-of-precision\n# (DOP) map over the whole Moon for one day.\n#\n# The central body is the Moon: gravitational parameter, 1 737.4 km radius and spin rate come\n# from the body module (the DE and IAU values cited there). The design is illustrative, not\n# any agency's:\n#   - an ELFO shell: 8 satellites as a Walker 8/4/1 with perilune about 720 km and apolune\n#     about 7 500 km (semi-major axis 5 847.4 km, eccentricity 0.58), 57.8 deg inclination\n#     and argument of perilune 90 deg, so every satellite lingers at apolune over the south\n#     polar region;\n#   - a circular shell: 6 satellites as a Walker 6/3/1 at 1 500 km and 85 deg.\n#\n# One receiver clock is shared (clock = \"common\"): the relay set is one system on one time\n# scale. Latitude is lunar body-fixed; the map is an equirectangular projection with no land\n# outline.\n#\n# What the run answers: where on the Moon four or more of these satellites are in view above\n# a 10 deg mask, the PDOP/HDOP/VDOP/GDOP per 10 deg cell, and the share of the day with PDOP\n# at or below 6. MODELLED: two-body orbits around a spherical Moon (no Earth third-body\n# perturbation, which a real frozen-orbit design depends on), geometry only.\n\nkind = \"constellation-design\"\nbody = \"moon\"\nduration_s = 86400.0\nstep_s = 1800.0\nmask_deg = 10.0\npdop_threshold = 6.0\ngrid_step_deg = 10.0\nclock = \"common\"\ntrack_points = 49\nmax_tracks = 14\n\n[[constellation]]\nname = \"Lunar relay\"\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 8\nplanes = 4\nphasing = 1\nsemi_major_axis_km = 5847.4\neccentricity = 0.58\ninclination_deg = 57.8\nargp_deg = 90.0\n\n[[constellation.shell]]\npattern = \"delta\"\ntotal = 6\nplanes = 3\nphasing = 1\naltitude_km = 1500.0\ninclination_deg = 85.0\n","mars-orbit-pnt":"# Positioning a low Mars orbiter with a Mars navigation constellation and a deep-space link.\n#\n# A 300 km near-polar orbiter navigates around Mars for one sol (88 775 s) from the\n# 2027-02-19 opposition, when the Earth is closest and far from a solar conjunction. Two\n# kinds of measurement:\n#\n#   1. ONE-WAY PSEUDORANGES from twelve navigation satellites at 10 000 km in three planes\n#      inclined 60 deg (a Walker delta, phasing 1), flown as two-body orbits with the secular\n#      drift from Mars' J2 (the second zonal harmonic, its oblateness). The user clock is\n#      unknown, so these rows carry a clock column.\n#   2. A TWO-WAY RANGE FROM EARTH, clock-free, whenever the Earth is above the Mars limb\n#      for the orbiter. The Earth's direction and distance come from the analytic\n#      solar-system ephemeris at every epoch.\n#\n# The report gives, per epoch, the relays in view, the constellation-only dilution of\n# precision, the formal position uncertainty with and without the Earth row, and the\n# error of a seeded least-squares fix each way; over the sol, the availability and the\n# root-mean-square errors, and the Earth-Mars light time and round trip.\n#\n# MODELLED. The relay orbits, the 1 m range noise and the instantaneous measurement model\n# are modelling choices; nothing here is validated against a mission's navigation data.\n# The Mars constants are the published values cited in src/body.rs.\nkind = \"body-pnt\"\nbody = \"Mars\"\nepoch = \"2027-02-19T00:00:00\"\nduration_s = 88775.0\nstep_s = 300.0\nseed = 7\n\n[user]\nkind = \"orbiter\"\naltitude_km = 300.0\ninclination_deg = 93.0\n\n[constellation]\nplanes = 3\nsats_per_plane = 4\naltitude_km = 10000.0\ninclination_deg = 60.0\nsigma_range_m = 1.0\n\n[earth_link]\nenabled = true\nsigma_range_m = 1.0\n","europa-surface-pnt":"# Positioning a lander on Europa: the Jovian-moon case.\n#\n# A lander at 20 deg north, 60 deg east on Europa's surface navigates for one Europan day\n# (3.55 Earth days, the synchronous rotation period) with twelve navigation satellites at\n# 4 500 km in three planes inclined 55 deg, under a 10 deg elevation mask, and a two-way\n# range from Earth whenever the Earth is above the lander's horizon. Europa is tidally\n# locked, so from a fixed site Jupiter never moves in the sky, while the Earth, riding\n# with Jupiter, rises and sets once per Europan day: the Earth link is available only for\n# part of the run, and the report shows what the local constellation must carry alone.\n#\n# The Europa constants (gravitational parameter, mean radius, International Astronomical\n# Union (IAU) pole and prime meridian)\n# are the published values cited in src/body.rs; no J2 (second zonal harmonic) is carried\n# for Europa, so the relay\n# orbits are two-body. The Earth-Europa light time is about 36 minutes one way at this\n# epoch, near a Jupiter opposition.\n#\n# One simplification matters more here than at Mars: the relays orbit inside Europa's Hill\n# sphere (about 13 700 km) but Jupiter's pull on them is not modelled, so their orbits are\n# idealised. The run shows the geometry and what the Earth link adds (availability rises\n# from about half the Europan day to about three quarters), not a flyable design.\n#\n# MODELLED: the constellation, the noise and the measurement model are modelling choices.\nkind = \"body-pnt\"\nbody = \"Europa\"\nepoch = \"2027-02-19T00:00:00\"\nduration_s = 306822.0\nstep_s = 1800.0\nseed = 11\n\n[user]\nkind = \"surface\"\nlat_deg = 20.0\nlon_deg = 60.0\n\n[constellation]\nplanes = 3\nsats_per_plane = 4\naltitude_km = 4500.0\ninclination_deg = 55.0\nsigma_range_m = 1.0\nmask_deg = 10.0\n\n[earth_link]\nenabled = true\nsigma_range_m = 1.0\n","solar-system-tour":"# The whole solar system at one epoch.\n#\n# Every body the engine knows — the Sun, the eight planets, Pluto, the Moon, Phobos,\n# Deimos, Io, Europa, Ganymede, Callisto and Titan — at 2026-09-28 00:00 UTC: its\n# heliocentric position and velocity in the ICRF (International Celestial Reference\n# Frame, equatorial J2000), its physical constants (gravitational parameter, radii, J2 — the\n# second zonal harmonic — where published, sidereal rotation, International Astronomical\n# Union (IAU) pole, its J2000 mean value, and prime meridian at the epoch), the light time and one-way and\n# two-way range from the Earth, and an orbit track sampled over one revolution.\n# result.json carries enough to draw an interactive solar system.\n#\n# WHERE THE NUMBERS COME FROM\n#   planets  Jet Propulsion Laboratory (JPL) Keplerian elements (Standish and Williams),\n#            Table 1 for 1800 AD to 2050 AD\n#   Moon     the Montenbruck & Gill lunar series, splitting the Earth-Moon barycentre\n#   moons    JPL mean elements with the IAU synchronous rotation rate; Titan from the IAU\n#            rotation model\n#   light    the radiometric light-time solve, transmitter at its retarded position\n#\n# WHAT IS VALIDATED, AND WHAT IS NOT\n# Each body carries its own label. Mercury to Saturn and the Earth are VALIDATED against\n# JPL Horizons (Development Ephemeris DE441) within twice the Standish page's nominal\n# error. Uranus and Neptune from Table 1 exceed the page's figures against DE441 (by 2.0\n# and 5.2 times) and are MODELLED; so are Pluto, the Moon and the seven moons, which\n# were measured against Horizons but have no published bound. See tests/solar_system_horizons_reference.rs.\n#\n# The three links below add the Mars-to-Jupiter, Saturn-to-Earth and Europa-to-Jupiter\n# light times: interplanetary relay geometry, a ringed-planet downlink and a moon-to-planet\n# hop.\nkind = \"solar-system\"\nepoch = \"2026-09-28T00:00:00\"\nobserver = \"Earth\"\ntrack_points = 180\n\n[[links]]\nfrom = \"Mars\"\nto = \"Jupiter\"\n\n[[links]]\nfrom = \"Saturn\"\nto = \"Earth\"\n\n[[links]]\nfrom = \"Europa\"\nto = \"Jupiter\"\n","campaign-shared-jammer-sea-road":"# Cross-domain composition: one jammer, two platforms. A ship in the Gulf of Finland\n# (59.80 N, 24.90 E, the maritime-strait-jamming example's receiver) and a car on a\n# Helsinki coast road (60.17 N, 24.94 E) sit under the same broadband jammer, placed\n# at 59.80 N, 25.44 E, 30 m up (about 30 km from the ship and 50 km from the car).\n#\n# At 8 dBW (6.3 W) the ship loses every satellite (mean jammer-to-signal ratio,\n# J/S, about 39 dB) while the car, 20 km further off, keeps at least four (about\n# 35 dB): the combined summary names the ship as the worst platform.\n#\n# The jammer's power and position are declared once under [[compose.shared]] and\n# written into each member at the keys it binds them to, so the two runs cannot\n# disagree about the threat. Each member is an ordinary `jamming` run; the combined\n# summary names the best and worst platform for each metric.\n#\n# MODELLED: as the `jamming` kind is. The car is modelled with the same open-sky\n# receiver as the ship; urban masking and the vehicle antenna are not.\nkind = \"campaign\"\ntitle = \"One jammer, a ship and a car\"\nseed = 20260928\n\n[[compose.shared]]\nname = \"jammer_power\"\nunit = \"dBW\"\nvalue = 8.0\n\n[[compose.shared]]\nname = \"jammer_position\"\nunit = \"m\"\nvalue = [2904623.523, 1381438.498, 5489328.347]\n\n[[compose.members]]\nlabel = \"ship-strait\"\nbind = { jammer_power = \"jammer.power_dbw\", jammer_position = \"jammer.position_ecef_m\" }\nmetrics = [\n  { name = \"availability\", path = \"fom.availability_under_jamming\" },\n  { name = \"mean_js\", path = \"fom.mean_js_db\" },\n  { name = \"min_tracking\", path = \"fom.min_tracking\" },\n]\n[compose.members.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[compose.members.scenario.time]\nstep_s = 30.0\nduration_s = 1800.0\n[compose.members.scenario.receiver]\nlat_deg = 59.80\nlon_deg = 24.90\nalt_m = 0.0\n[compose.members.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[compose.members.scenario.jammer]\nposition_ecef_m = [0.0, 0.0, 0.0]\npower_dbw = 0.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n[[compose.members]]\nlabel = \"car-coast-road\"\nbind = { jammer_power = \"jammer.power_dbw\", jammer_position = \"jammer.position_ecef_m\" }\nmetrics = [\n  { name = \"availability\", path = \"fom.availability_under_jamming\" },\n  { name = \"mean_js\", path = \"fom.mean_js_db\" },\n  { name = \"min_tracking\", path = \"fom.min_tracking\" },\n]\n[compose.members.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[compose.members.scenario.time]\nstep_s = 30.0\nduration_s = 1800.0\n[compose.members.scenario.receiver]\nlat_deg = 60.17\nlon_deg = 24.94\nalt_m = 0.0\n[compose.members.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[compose.members.scenario.jammer]\nposition_ecef_m = [0.0, 0.0, 0.0]\npower_dbw = 0.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n","campaign-jam-spoof-holdover-integrity":"# A chained mission: nominal, jamming, spoofing, GNSS loss with clock holdover and\n# inertial coasting, an integrity alarm, and recovery, on one shared timeline.\n#\n# Every phase runs ordinary scenarios of existing kinds, each dispatched exactly as\n# `kshana <file>.toml` would run it. The campaign reads their outputs into channels\n# on one mission timeline (a 10 s grid, zero-order hold) and draws them as synced\n# panels: clock time error against its guard, the carrier-to-noise density ratio\n# (C/N0) against the tracking floor, the vertical protection level against the\n# alert limit, the inertial position error, and the alarm flags.\n#\n# State is handed on between phases in two ways here:\n# - `end_at`: the spoofing phase ends when the clock-aided spoofing monitor of the\n#   `spoof` run detects the ramp (its `classical.detect_time_s`), not at a fixed time.\n# - `carry`: the holdover and integrity-alarm phases continue the clock time error\n#   from where the previous phase left it, so the offset the spoofer pulled in before\n#   detection is where the free-running clock starts. Recovery re-synchronises to\n#   GNSS, so it carries nothing.\n#\n# The receiver is the jamming example's (52 N, 4 E) under a GPS-like 24-satellite\n# Walker shell; the jammer is 1 km away and its power sets the phase: off, -30 dBW\n# (links degraded but still tracking), 10 dBW (every satellite lost). The clock is a\n# chip-scale atomic clock (Microchip SA.45s datasheet sigma_y(1 s) = 3e-10), the\n# inertial unit the gnss-ins example's tactical class, and the integrity monitor the\n# integrity example's snapshot receiver autonomous integrity monitoring (RAIM) with\n# the approach-with-vertical-guidance (APV-I) alert limits, run on that example's\n# own user track (a 0.4 km-altitude circular track, not the jamming receiver's\n# fixed site). The integrity alarm is produced by a 25 deg elevation mask, standing\n# in for the partial sky a receiver has while reacquiring; recovery returns to 5 deg.\n#\n# MODELLED: the chaining is a modelling choice (additive carry, zero-order hold), and\n# each phase is as good as the kind that ran it.\nkind = \"campaign\"\ntitle = \"Jamming, spoofing, holdover and integrity: a chained mission\"\nseed = 20260928\n\n[timeline]\nstep_s = 10.0\n\n# ---------------------------------------------------------------- nominal\n[[phases]]\nname = \"nominal\"\nduration_s = 600.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 42\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 600.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# ---------------------------------------------------------------- jamming\n[[phases]]\nname = \"jamming\"\nduration_s = 600.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 43\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 600.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[phases.runs.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = -30.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# ---------------------------------------------------------------- spoofing\n# A time-push spoofer ramps the receiver clock at 0.1 ns/s from the start of the\n# phase. The phase ends when the clock-aided monitor detects it (end_at), capped at\n# 900 s. The RF detector (spoof-detect) sees a +1.5 dB, three-satellite position push\n# and alarms at phase start.\n[[phases]]\nname = \"spoofing\"\nduration_s = 900.0\nend_at = \"classical.detect_time_s\"\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"spoof\"\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 900.0\n[phases.runs.scenario.attack]\nstart_s = 0.0\nrate_ns_per_s = 0.1\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"spoof-detect\"\n[phases.runs.scenario.attack]\npower_advantage_db = 1.5\ncarrier_aligned = false\npush = \"position\"\npush_magnitude_m = 75.0\nnum_biased = 3\nel_imbalance = 0.12\n[phases.runs.scenario.detector]\nsat_power_dbm = -130.0\nagc_margin_db = 3.0\nsqm_tolerance = 0.10\nraim_p_fa = 1.0e-3\nsigma_m = 5.0\nfusion_threshold = 0.5\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 900.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[phases.runs.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = -30.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n# ---------------------------------------------------------------- holdover\n# The jammer goes to 10 dBW: every satellite is lost. The clock free-runs from its\n# last synchronisation, continuing the spoofed offset (carry), and the tactical\n# inertial unit coasts (the gnss-ins run is warmed up on GNSS for 100 s, skipped).\n[[phases]]\nname = \"holdover\"\nduration_s = 1800.0\ncarry = [\"time_error_ns\"]\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 44\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 1800.0\n[phases.runs.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 1.0, state = \"nominal\" },\n  { t0 = 1.0, t1 = 1800.0, state = \"denied\" },\n]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\nskip_s = 100.0\n[phases.runs.scenario]\nkind = \"gnss-ins\"\nseed = 7\nthreshold_m = 50.0\nfix_interval_s = 1.0\nsigma_pos_m = 1.0\nsigma_vel_mps = 0.05\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.time]\nstep_s = 0.5\nduration_s = 1900.0\n[phases.runs.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 100.0, state = \"nominal\" },\n  { t0 = 100.0, t1 = 1900.0, state = \"denied\" },\n]\n[phases.runs.scenario.imu_quantum]\nid = \"cold-atom-imu\"\nprovenance = \"Quantum-grade inertial unit: low residual accelerometer/gyro bias (cold-atom-class)\"\naccel_bias = [0.015, 0.0, 0.0]\ngyro_bias = [0.0, 0.0, 5.0e-5]\n[phases.runs.scenario.imu_classical]\nid = \"tactical-imu\"\nprovenance = \"Tactical-grade MEMS/quartz inertial unit: larger residual bias\"\naccel_bias = [0.03, -0.02, 0.0]\ngyro_bias = [0.0, 0.0, 1.0e-4]\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 1800.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[phases.runs.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = 10.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n# ---------------------------------------------------------------- integrity alarm\n# The jammer drops back to -30 dBW and satellites are reacquired, but only above a\n# 25 deg mask: at most epochs the vertical protection level exceeds the 50 m alert\n# limit, or too few satellites remain to form one, so the monitor alarms and the clock stays in holdover (carry) rather than trusting GNSS.\n[[phases]]\nname = \"integrity-alarm\"\nduration_s = 600.0\ncarry = [\"time_error_ns\"]\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 45\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 1.0, state = \"nominal\" },\n  { t0 = 1.0, t1 = 600.0, state = \"denied\" },\n]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 25.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[phases.runs.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = -30.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 25.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# ---------------------------------------------------------------- recovery\n[[phases]]\nname = \"recovery\"\nduration_s = 600.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 46\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 600.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 600.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n","l-band-waterfall-jamming":"# L-band waterfall under jamming: the whole Global Navigation Satellite System (GNSS)\n# L band as one power spectral density (PSD), frequency across, time down, while a\n# scripted sequence of jammers switches on.\n#\n# The question a spectrum monitor or a receiver designer asks: what does the band look\n# like while this happens, and which signals does each jammer actually take away? The\n# navigation signals sit about 20 dB below the thermal noise floor, so the picture shows\n# the floor and the jammers; the per-band carrier-to-noise density (C/N0) bars show what\n# despreading recovers. Each jammer is scored against each band by its spectral\n# separation coefficient (SSC), the overlap of the two spectra over the receiver band\n# (Betz 2001; Kaplan & Hegarty, Understanding GPS/GNSS, 3rd ed., section 9.4), so a\n# jammer only hurts the bands its spectrum reaches.\n#\n# Timeline (60 s, one row per second):\n#   10 s  a swept (chirp) jammer, 16 MHz wide around L1, a 9 microsecond sawtooth, the\n#         shape of a car-cigarette-lighter privacy device: 50 mW (-13 dBW) at 100 m.\n#         It takes GPS L1 coarse/acquisition (C/A) and Galileo E1 away together.\n#   30 s  a continuous-wave (CW) tone exactly on the L1 carrier, 10 mW at 1 km. On C/A\n#         it lands on the peak of the binary phase-shift keying (BPSK) spectrum; on\n#         Galileo E1 it lands in the null of the multiplexed binary offset carrier (MBOC)\n#         spectrum, so E1 recovers when the chirp stops at 40 s while C/A stays lost.\n#   45 s  flat 2 MHz noise on the L2 carrier, received at -135 dBW: GPS L2 civil (L2C)\n#         is degraded but keeps tracking.\n# GPS L5 and Galileo E5a, at 1176.45 MHz, are outside every jammer's spectrum.\n#\n# The [iq] section draws the model at 35 s as complex IQ samples (20.48 MHz around L1),\n# writes them as a Signal Metadata Format (SigMF) recording and reads them back, and\n# compares a Welch estimate with the model: a check of the synthesis, the SigMF codec and\n# the estimator, not a measurement. A real recording can be compared instead with a\n# [recording] section (meta_path = \"capture.sigmf-meta\"), native builds only.\n#\n# Assumptions: signal powers are the interface-specification minimum received powers\n# (IS-GPS-200, IS-GPS-705, Galileo Open Service Signal-in-Space Interface Control\n# Document); a 290 K antenna and a 2 dB receiver noise figure; free-space propagation\n# to the jammers, 0 dBi receive gain toward them. MODELLED: the signal spectra are\n# validated closed forms, but every jammer, power and timing here is a scenario input.\nkind = \"spectrum\"\nseed = 7\nduration_s = 60.0\nstep_s = 1.0\n\n[receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n\n[grid]\nf_min_mhz = 1160.0\nf_max_mhz = 1590.0\nn_freq = 430\n\n[[jammers]]\nname = \"chirp privacy device\"\nwaveform = \"chirp\"\ncentre_mhz = 1575.42\nbandwidth_mhz = 16.0\nsweep_period_us = 9.0\neirp_dbw = -13.0\nrange_m = 100.0\non_s = 10.0\noff_s = 40.0\n\n[[jammers]]\nname = \"CW tone on L1\"\nwaveform = \"cw\"\ncentre_mhz = 1575.42\neirp_dbw = -20.0\nrange_m = 1000.0\non_s = 30.0\n\n[[jammers]]\nname = \"L2 narrowband noise\"\nwaveform = \"narrowband\"\ncentre_mhz = 1227.60\nbandwidth_mhz = 2.0\nreceived_power_dbw = -135.0\non_s = 45.0\n\n[iq]\ncentre_mhz = 1575.42\nsample_rate_mhz = 20.48\nt_s = 35.0\nlog2_samples = 16\nnfft = 1024\ndatatype = \"cf32_le\"\n","campaign-sweep-jammer-power":"# A parameter sweep through a campaign: the jamming example's receiver (52 N, 4 E,\n# GPS-like 24-satellite Walker shell) under a broadband jammer 1 km away, with the\n# jammer's transmit power swept from -50 dBW (10 nW) to +10 dBW (10 W) in 5 dB\n# steps. Each node is an ordinary `jamming` run; the campaign records, per node,\n# the fraction of epochs with at least four satellites still tracking, the mean\n# jammer-to-signal ratio (J/S), and the fewest satellites tracking.\n#\n# The jamming chain (Kaplan and Hegarty, Understanding GPS/GNSS, 3rd ed., section\n# 9.4) is deterministic, so one run per node is the whole answer; add `runs` and a\n# `seed_key` to make every node a Monte Carlo ensemble for a stochastic kind.\n# J/S moves exactly 1 dB per dB of transmit power; availability falls from 1 to 0\n# where the effective carrier-to-noise density ratio crosses the 25 dB-Hz floor.\n#\n# MODELLED: as the `jamming` kind is.\nkind = \"campaign\"\ntitle = \"Jammer power sweep: availability and J/S against transmit power\"\nseed = 20260928\n\n[sweep]\nmetrics = [\n  { name = \"availability\", path = \"fom.availability_under_jamming\" },\n  { name = \"mean_js\", path = \"fom.mean_js_db\" },\n  { name = \"min_tracking\", path = \"fom.min_tracking\" },\n]\n\n[[sweep.axes]]\nname = \"jammer_power\"\nkey = \"jammer.power_dbw\"\nunit = \"dBW\"\nstart = -50.0\nstop = 10.0\nsteps = 13\n\n[sweep.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[sweep.scenario.time]\nstep_s = 60.0\nduration_s = 1800.0\n[sweep.scenario.receiver]\nlat_deg = 52.0\nlon_deg = 4.0\nalt_m = 0.0\n[sweep.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[sweep.scenario.jammer]\nposition_ecef_m = [3926375.101, 274488.966, 5002803.345]\npower_dbw = 10.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n","campaign-monte-carlo-clock-holdover":"# A seeded Monte Carlo ensemble through a campaign, on a case with a closed form.\n#\n# A chip-scale atomic clock (Microchip SA.45s datasheet sigma_y(1 s) = 3e-10, so a\n# white-frequency-noise intensity q_wf = 9e-20 s^2/s and nothing else stochastic) is\n# disciplined to GNSS for 600 s and then coasts to 3600 s. The holdover predictor\n# removes the deterministic frequency offset exactly, so the time error at the end\n# of the run is the accumulated white-frequency noise since the last synchronisation\n# at 590 s: Gaussian, mean zero, variance q_wf * tau with tau = 3010 s, a standard\n# deviation of sqrt(9e-20 * 3010) s = 16.46 ns (NIST Technical Note 1337, the random\n# walk of phase under white frequency noise).\n#\n# Realisation k runs the scenario with `seed = 42 + k`, so the ensemble reproduces\n# exactly. The campaign reports, per metric, the mean, the standard deviation, the\n# 5th, 50th and 95th percentiles and a fixed-seed bootstrap 95% confidence interval\n# on the mean. The test suite checks that the mean falls inside that interval around\n# zero and that the spread matches 16.46 ns.\n#\n# MODELLED: the clock is a datasheet-level model, not a measurement of any unit.\nkind = \"campaign\"\ntitle = \"Monte Carlo: free-running clock error against its closed form\"\nseed = 20260928\n\n[monte_carlo]\nruns = 200\nseed_key = \"seed\"\nmetrics = [\n  { name = \"final_error\", path = \"classical.series[-1].error_ns\" },\n  { name = \"timing_rms\", path = \"classical.fom.timing_rms_ns\" },\n]\n\n[monte_carlo.scenario]\nseed = 42\nthreshold_ns = 20.0\n[monte_carlo.scenario.time]\nstep_s = 10.0\nduration_s = 3600.0\n[monte_carlo.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 600.0, state = \"nominal\" },\n  { t0 = 600.0, t1 = 3600.0, state = \"denied\" },\n]\n[monte_carlo.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[monte_carlo.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n","campaign-spectrum-holdover-integrity":"# A chained mission driven by the L-band spectrum: a chirp jammer takes GPS L1 C/A and\n# Galileo E1, the clock holds over, and a continuous-wave (CW) tone left on the L1\n# carrier keeps C/A down while E1 recovers, so the receiver falls back to Galileo and\n# its integrity monitor runs on a Galileo-only sky.\n#\n# Every phase runs ordinary scenarios of existing kinds, each dispatched exactly as\n# `kshana <file>.toml` would run it. The carrier-to-noise density ratio (C/N0) of each\n# band comes from the `spectrum` kind: the jammer's spectral separation coefficient\n# against that band's own modulation, through (C/N0)_eff = [1/(C/N0) + sum (J/S) kappa]^-1\n# (see docs/SPECTRUM.md). The campaign reads the L1 C/A and E1 rows of the spectrum\n# timeline into two channels on one mission timeline (a 1 s grid, zero-order hold).\n#\n# State is handed on between phases in two ways here:\n# - `end_at`: the onset phase ends when the spectrum run first loses L1 C/A\n#   (`timeline.bands[0].first_loss_t_s`, 10 s here), not at a fixed time; the clock's\n#   holdover starts at that instant.\n# - `carry`: the holdover phase continues the clock time error from the end of the\n#   onset phase. The fallback phase re-synchronises the clock to Galileo, so it\n#   carries nothing.\n#\n# The jammers are the ones in scenarios/l-band-waterfall-jamming.toml: a 16 MHz chirp\n# privacy device at -13 dBW EIRP, 100 m away, and a CW tone on 1575.42 MHz at -20 dBW\n# EIRP, 1 km away, both through the jamming kind's free-space path loss. The clock is\n# a chip-scale atomic clock (Microchip SA.45s datasheet sigma_y(1 s) = 3e-10). The\n# integrity monitor is the integrity example's snapshot receiver autonomous integrity\n# monitoring (RAIM) with the approach-with-vertical-guidance (APV-I) alert limits, on\n# a GPS-like 24-satellite Walker shell during onset and on a Galileo-like Walker\n# 24/3/1 (29 599.8 km semi-major axis, 56 deg; Galileo OS SDD 1.1) during fallback.\n#\n# MODELLED: the chaining is a modelling choice (additive carry, zero-order hold), and\n# each phase is as good as the kind that ran it. E1 recovering under the CW tone rests\n# on the spectrum kind's continuous-spectrum treatment (a CW tone on the MBOC carrier\n# null couples nothing); a real tone would couple through the code's spectral lines.\nkind = \"campaign\"\ntitle = \"L-band jamming from the spectrum, clock holdover and a Galileo-only fallback\"\nseed = 20260928\n\n[timeline]\nstep_s = 1.0\n\n# ---------------------------------------------------------------- onset\n# All bands nominal until the chirp switches on at 10 s. The phase ends at the first\n# loss of L1 C/A that the spectrum run computes.\n[[phases]]\nname = \"onset\"\nduration_s = 60.0\nend_at = \"timeline.bands[0].first_loss_t_s\"\nend_at_run = 1\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 42\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 1.0\nduration_s = 60.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 60.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_e1_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n  { channel = \"alarm\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\", compare = \"below\", threshold = 25.0 },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 60.0\nstep_s = 1.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1160.0\nf_max_mhz = 1590.0\nn_freq = 430\n[[phases.runs.scenario.jammers]]\nname = \"chirp privacy device\"\nwaveform = \"chirp\"\ncentre_mhz = 1575.42\nbandwidth_mhz = 16.0\nsweep_period_us = 9.0\neirp_dbw = -13.0\nrange_m = 100.0\non_s = 10.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 60.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n\n# ---------------------------------------------------------------- holdover\n# The chirp stays on: L1 C/A and E1 are both below the 25 dB-Hz tracking floor, and\n# the clock free-runs from its last synchronisation, continuing the onset error.\n[[phases]]\nname = \"holdover\"\nduration_s = 600.0\ncarry = [\"time_error_ns\"]\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 43\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 600.0\n[phases.runs.scenario.gnss]\nwindows = [\n  { t0 = 0.0, t1 = 1.0, state = \"nominal\" },\n  { t0 = 1.0, t1 = 600.0, state = \"denied\" },\n]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_e1_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n  { channel = \"alarm\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\", compare = \"below\", threshold = 25.0 },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 600.0\nstep_s = 10.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1160.0\nf_max_mhz = 1590.0\nn_freq = 430\n[[phases.runs.scenario.jammers]]\nname = \"chirp privacy device\"\nwaveform = \"chirp\"\ncentre_mhz = 1575.42\nbandwidth_mhz = 16.0\nsweep_period_us = 9.0\neirp_dbw = -13.0\nrange_m = 100.0\non_s = 0.0\n\n# ---------------------------------------------------------------- fallback\n# The chirp is gone; the CW tone on the L1 carrier remains. L1 C/A stays below the\n# floor; E1, whose MBOC spectrum has a null at its carrier, recovers. The receiver\n# re-synchronises the clock on Galileo and runs RAIM on a Galileo-only sky. The alarm\n# channel follows E1, the band the receiver now navigates on.\n[[phases]]\nname = \"galileo-fallback\"\nduration_s = 300.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nseed = 44\nthreshold_ns = 50.0\n[phases.runs.scenario.time]\nstep_s = 10.0\nduration_s = 300.0\n[phases.runs.scenario.gnss]\nwindows = [{ t0 = 0.0, t1 = 300.0, state = \"nominal\" }]\n[phases.runs.scenario.clock_quantum]\nid = \"optical-sr-lattice\"\nprovenance = \"Strontium optical lattice clock, space-oriented goal sigma_y(1s)=1e-15 (arXiv:1503.08457); not flown.\"\ny0 = 5.0e-17\nq_wf = 1.0e-30\nq_rw = 0.0\n[phases.runs.scenario.clock_classical]\nid = \"csac-sa45s\"\nprovenance = \"Microchip SA65 / SA.45s CSAC datasheet sigma_y(1s)=3e-10; q_wf=sigma_y(1s)^2.\"\ny0 = 5.0e-10\nq_wf = 9.0e-20\nq_rw = 0.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_e1_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n  { channel = \"alarm\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\", compare = \"below\", threshold = 25.0 },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 300.0\nstep_s = 10.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1160.0\nf_max_mhz = 1590.0\nn_freq = 430\n[[phases.runs.scenario.jammers]]\nname = \"CW tone on L1\"\nwaveform = \"cw\"\ncentre_mhz = 1575.42\neirp_dbw = -20.0\nrange_m = 1000.0\non_s = 0.0\n\n[[phases.runs]]\n[phases.runs.scenario]\nkind = \"integrity\"\nseed = 7\nmask_deg = 5.0\nsigma_uere_m = 1.0\np_fa = 1.0e-5\np_md = 1.0e-3\nal_h_m = 40.0\nal_v_m = 50.0\n[phases.runs.scenario.time]\nstep_s = 30.0\nduration_s = 300.0\n[phases.runs.scenario.user]\naltitude_km = 0.4\ninclination_deg = 45.0\nraan_deg = 10.0\nu0_deg = 0.0\n[phases.runs.scenario.constellation]\naltitude_km = 23221.664\ninclination_deg = 56.0\nplanes = 3\nsats_per_plane = 8\nphasing_f = 1.0\n","leo-pass-vs-gnss-cn0":"# A LEO-PNT pass against the Galileo satellites in view: C/N0 over one pass.\n#\n# LEO-PNT is positioning, navigation and timing from satellites in low Earth orbit (LEO). A\n# ground user near Munich watches one pass of a generic LEO navigation satellite (the\n# representative generic-leo preset: 550 km sun-synchronous, an L-band carrier at the Galileo\n# E5 centre frequency of 1191.795 MHz, 0 dBW EIRP from a nadir-pointing 110 deg Gaussian beam)\n# and the Galileo satellites above a 5 deg mask on E1, all through the same patch antenna and\n# receiver noise model. The pass is designed to peak at 80 deg elevation mid-window.\n#\n# The result reproduces, qualitatively, what LEO-PNT demonstrations show: the LEO carrier-to-\n# noise density (C/N0) rises and falls in a bell a few minutes long, peaking several dB above\n# the flat MEO (medium Earth orbit) GNSS carriers, which sit in the mid-40s to about 50 dB-Hz.\n# The larger LEO signal comes from a range some forty times shorter than to a MEO satellite\n# (about 26 to 32 dB less free-space loss), not from a stronger transmitter. The Galileo\n# carriers use the minimum received power of the Galileo OS SIS ICD Issue 2.1 Table 12, plus\n# 2 dB, scaled by range.\n#\n# MODELLED. No Celeste or other workshop data is used: every LEO number here comes from the\n# representative preset in src/leo_link/presets/generic.rs.\nkind = \"leo-pass\"\nname = \"LEO pass versus MEO GNSS C/N0\"\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 900.0\nstep_s = 2.0\n\n[user]\nenvironment = \"ground\"\nlat_deg = 48.137\nlon_deg = 11.575\nheight_m = 520.0\nmask_deg = 5.0\n\n[[satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"L\"]\norbit = \"pass\"\nmax_elevation_deg = 80.0\ntca_s = 450.0\n\n[gnss]\nconstellation = \"galileo\"\nband = \"E1\"\nmax_satellites = 8\n","leo-doppler-positioning":"# Positioning from LEO Doppler alone, over a generic LEO navigation constellation.\n#\n# A receiver near Munich measures the Doppler shift of every satellite of a 258-satellite\n# LEO navigation constellation (the public Xona Pulsar X1 signal table and constellation,\n# arXiv:2509.19551; the split between its two inclinations is representative) for ten\n# minutes and solves for its position and clock drift by batch least squares. Doppler gives\n# range rate, and only the part of the satellite velocity across the line of sight carries\n# position information, so the geometry is the change of the lines of sight over the pass,\n# not the spread of satellites at one instant.\n#\n# The report gives the full-window error, the error against window length (how quickly a\n# Doppler fix forms), the Doppler, Doppler-rate and jerk envelope of the system over an\n# overhead pass, and a single-pass table: the formal along-track and cross-track errors of a\n# fix from ONE satellite pass against the user's distance from the ground track. The\n# cross-track error grows without bound as the pass goes overhead, where the Doppler curve\n# stops depending on the cross-track distance (and the mirror image across the track fits\n# almost as well).\n#\n# MODELLED. Doppler noise 1 Hz one sigma (0.19 m/s at 1593 MHz), perfect ephemeris, no\n# ionosphere or troposphere rate, a height-free three-dimensional fit.\nkind = \"leo-pvt\"\nmode = \"doppler\"\nseed = 7\nduration_s = 600.0\nstep_s = 10.0\n\n[user]\nlat_deg = 48.14\nlon_deg = 11.58\nheight_m = 520.0\n\n[doppler]\npass_offsets_km = [25.0, 100.0, 250.0, 500.0, 1000.0, 1500.0]\n\n[[system]]\nname = \"Pulsar X1\"\nleo_preset = \"xona-pulsar\"\nsignal = \"X1\"\nsigma_doppler_hz = 1.0\n","meo-leo-fused-pvt":"# Fused MEO and LEO pseudorange positioning: GPS and Galileo with a LEO navigation layer.\n#\n# A receiver in Madrid tracks the GPS baseline constellation (GPS SPS Performance Standard,\n# 5th edition), Galileo (Walker 24/3/1, Galileo OS SDD) and a LEO navigation constellation\n# (the public Xona Pulsar X5 signal: 10.23 Mchip/s in the L5 band, received power -144.9 to\n# -136.2 dBW, arXiv:2509.19551). Each system carries its own receiver clock, so the\n# inter-system bias of Galileo and of the LEO layer is estimated with the position; the LEO\n# pseudoranges are simulated with a 40 ns bias to show it recovered. Every pseudorange's\n# sigma is the delay-lock-loop thermal noise at the C/N0 of its elevation combined with the\n# system's signal-in-space range error.\n#\n# The report compares GNSS-only, LEO-only and fused fixes epoch by epoch and gives the PDOP,\n# HDOP and VDOP against the number of LEO satellites added to the GNSS geometry (highest\n# elevation first). MODELLED.\nkind = \"leo-pvt\"\nmode = \"joint\"\nseed = 3\nduration_s = 1800.0\nstep_s = 30.0\n\n[user]\nlat_deg = 40.42\nlon_deg = -3.70\nheight_m = 650.0\n\n[joint]\nmax_leo_sweep = 12\n\n[[system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\n\n[[system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\n\n[[system]]\nname = \"Pulsar X5\"\nleo_preset = \"xona-pulsar\"\nsignal = \"X5\"\nisb_ns = 40.0\n","leo-ppp-convergence":"# Precise point positioning (PPP) convergence with LEO augmentation.\n#\n# A float PPP filter on ionosphere-free code and phase runs at three mid-latitude sites with\n# GPS, Galileo, BeiDou (medium Earth orbit) and GLONASS, and then with each of four LEO\n# constellations added. Li et al. (\"LEO constellation-augmented multi-GNSS for rapid PPP\n# convergence\", Journal of Geodesy 93:749-764, 2019, doi 10.1007/s00190-018-1195-2) report\n# multi-GNSS convergence shortened from 9.6 min to 7.0, 3.2, 2.1 and 1.3 min with 60, 96, 192\n# and 288 LEO satellites; `compare_li_2019` puts those figures beside the modelled ones.\n#\n# The four LEO constellations here are representative Walker delta shells at 1000 km and\n# 60 deg with 60, 96, 192 and 288 satellites; they are NOT the paper's designs, and the noise,\n# stations and convergence definition (horizontal and vertical errors below 10 cm until the\n# end of the run) are this model's. The comparison is therefore a MODELLED consistency check\n# on the trend: convergence must shorten monotonically with the number of LEO satellites.\nkind = \"leo-ppp\"\nseed = 20\nduration_s = 1800.0\nstep_s = 10.0\nruns = 4\ncompare_li_2019 = true\n\n[[site]]\nlat_deg = 30.5\nlon_deg = 114.4\n\n[[site]]\nlat_deg = 48.1\nlon_deg = 11.6\n\n[[site]]\nlat_deg = 39.0\nlon_deg = -77.0\n\n[[gnss]]\nname = \"GPS\"\npreset = \"gps-baseline\"\nmask_deg = 7.0\n\n[[gnss]]\nname = \"Galileo\"\npreset = \"galileo\"\nmask_deg = 7.0\n\n[[gnss]]\nname = \"BeiDou\"\npreset = \"beidou-meo\"\nmask_deg = 7.0\n\n[[gnss]]\nname = \"GLONASS\"\npreset = \"glonass\"\nmask_deg = 7.0\n\n[[case]]\nname = \"60 LEO\"\n[[case.system]]\nname = \"LEO-60\"\nmask_deg = 7.0\n[[case.system.shell]]\ntotal = 60\nplanes = 6\nphasing = 1\naltitude_km = 1000.0\ninclination_deg = 60.0\n\n[[case]]\nname = \"96 LEO\"\n[[case.system]]\nname = \"LEO-96\"\nmask_deg = 7.0\n[[case.system.shell]]\ntotal = 96\nplanes = 8\nphasing = 1\naltitude_km = 1000.0\ninclination_deg = 60.0\n\n[[case]]\nname = \"192 LEO\"\n[[case.system]]\nname = \"LEO-192\"\nmask_deg = 7.0\n[[case.system.shell]]\ntotal = 192\nplanes = 12\nphasing = 1\naltitude_km = 1000.0\ninclination_deg = 60.0\n\n[[case]]\nname = \"288 LEO\"\n[[case.system]]\nname = \"LEO-288\"\nmask_deg = 7.0\n[[case.system.shell]]\ntotal = 288\nplanes = 16\nphasing = 1\naltitude_km = 1000.0\ninclination_deg = 60.0\n","leo-pnt-end-to-end":"# LEO-PNT end to end on a generic constellation: signal design -> pass link budget ->\n# navigation message -> fused MEO + LEO fix and precise point positioning convergence.\n#\n# One low Earth orbit (LEO) positioning, navigation and timing (PNT) system is followed\n# through every stage of the engine, with no named system's data at all:\n#\n# - Signal: the representative L-band design `generic-l` (binary phase-shift keying at\n#   10.23 Mchip/s, pilot and data halves, 20.46 MHz transmit bandwidth) from the public\n#   preset file data/leo-signals/generic-bands.toml.\n# - Pass: a user in Madrid watches a designed pass of a 1080 km, 53 deg satellite peaking at\n#   75 deg. The band takes the design's centre, bandwidth and chip rate and splits its\n#   EIRP (equivalent isotropically radiated power) across the design's components; every\n#   epoch gives the tracked (pilot) component's C/N0 (carrier-to-noise density) and its\n#   band-limited code-tracking jitter.\n# - Navigation message: the Galileo Keplerian set with along-track, cross-track and radial\n#   correction polynomials, fitted every 300 s to a truth orbit at the pass satellite's\n#   altitude and inclination; its broadcast signal-in-space range error (SISRE) is the LEO\n#   orbit-and-clock error downstream.\n# - Positioning: GPS and Galileo with a generic 240-satellite LEO layer (Walker 240/12/1\n#   at 1080 km, 53 deg). The LEO system takes the pass's C/N0 line, the message's SISRE\n#   and the design's carrier and chip rate.\n# - Precise point positioning (PPP): GPS and Galileo alone and with the same LEO layer, the\n#   LEO orbit-and-clock error taken from the message.\n#\n# MODELLED: every stage keeps its own label; the chain adds no physics.\nkind = \"leo-pnt-chain\"\nname = \"LEO-PNT end to end, generic 1080 km constellation\"\nseed = 5\nsignal_design = \"generic-l\"\n# Orbit determination and clock prediction, as a range error (m): representative of on-board\n# GNSS orbit determination with a steered chip-scale clock at the decimetre level (the ATOMIC\n# payload reports under 10 cm per axis in orbit and 24 cm in clock: InsideGNSS,\n# https://insidegnss.com/first-steps-toward-a-fully-operational-leo-pnt-payload/).\nod_sisre_m = 0.25\n\n[signal]\npresets = [\"generic-bands\"]\n\n[pass]\nepoch = \"2026-09-28T08:00:00\"\nduration_s = 1200.0\nstep_s = 5.0\n\n[pass.user]\nenvironment = \"ground\"\nlat_deg = 40.42\nlon_deg = -3.70\nheight_m = 650.0\nmask_deg = 10.0\n\n[[pass.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"L\"]\norbit = \"pass\"\naltitude_km = 1080.0\ninclination_deg = 53.0\nmax_elevation_deg = 75.0\ntca_s = 600.0\n\n[[pass.satellite.band]]\nname = \"L\"\nsignal = \"generic-l\"\neirp_dbw = 10.0\n\n[pass.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n\n[navmsg.message]\nmodel = \"kepler-rac\"\nfit_interval_s = 300.0\n\n[navmsg.trade]\nspan_s = 1200.0\n\n[fusion]\nmode = \"joint\"\nduration_s = 1800.0\nstep_s = 30.0\n\n[fusion.user]\nlat_deg = 40.42\nlon_deg = -3.70\nheight_m = 650.0\n\n[fusion.joint]\nmax_leo_sweep = 8\n\n[[fusion.system]]\nname = \"GPS\"\npreset = \"gps-baseline\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.6\n\n[[fusion.system]]\nname = \"Galileo\"\npreset = \"galileo\"\ncn0_dbhz = [38.0, 48.0]\nsisre_m = 0.3\nisb_ns = 12.0\n\n[[fusion.system]]\nname = \"Generic LEO\"\nrole = \"leo\"\nisb_ns = 25.0\n\n[[fusion.system.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n\n[ppp]\nduration_s = 1800.0\nstep_s = 10.0\nruns = 2\n\n[[ppp.site]]\nlat_deg = 40.42\nlon_deg = -3.70\n\n[[ppp.gnss]]\nname = \"GPS\"\npreset = \"gps-baseline\"\nmask_deg = 7.0\n\n[[ppp.gnss]]\nname = \"Galileo\"\npreset = \"galileo\"\nmask_deg = 7.0\n\n[[ppp.case]]\nname = \"240 LEO\"\n\n[[ppp.case.system]]\nname = \"Generic LEO\"\nmask_deg = 7.0\n\n[[ppp.case.system.shell]]\ntotal = 240\nplanes = 12\nphasing = 1\naltitude_km = 1080.0\ninclination_deg = 53.0\n","leo-timing-utc":"# Time transfer to UTC from LEO satellites, against C/N0 and the receiver oscillator.\n#\n# A timing receiver at a surveyed site in Boulder, Colorado recovers its clock from the\n# Iridium constellation (the `iridium-stl` preset: 66 satellites at 780 km, L-band bursts,\n# received power 300 to 2400 times GPS), holds time with its own oscillator when no\n# satellite is in view, and converts the system time to UTC with the broadcast offset\n# (IS-GPS-200 expression; the parameters below are illustrative, with a 5 ns uncertainty).\n# Four oscillator classes (TCXO, OCXO, chip-scale atomic clock, rubidium) and four C/N0\n# offsets are compared over six hours, every row with the same seed so the rows differ only\n# in C/N0 and oscillator. The Iridium bursts arrive 25 to 34 dB above GPS, so the loop noise\n# of the 25 000 symbol/s ranging signal matters only when the C/N0 is cut by 20 dB or more;\n# at nominal power the 5 m representative signal-in-space range error and the UTC-offset\n# uncertainty set the floor, and with a satellite in view about 93% of the time the\n# oscillator matters little.\n#\n# NIST measured Iridium PNT timing receivers with a miniature atomic clock within 40 ns of\n# UTC(NIST) over 40 days (https://www.nist.gov/publications/validating-timing-performance-improvement-ionospheric-corrections-iridium-pnt-receivers).\n# The modelled figures are a consistency comparison with that, not a reproduction of the test.\n# `trace = true` adds each row's time error at every epoch, so the run animates\n# (`--animate html`); the row statistics are the same with or without it.\n# MODELLED.\nkind = \"leo-pvt\"\nmode = \"timing\"\nseed = 9\nduration_s = 21600.0\nstep_s = 10.0\n\n[user]\nlat_deg = 39.99\nlon_deg = -105.26\nheight_m = 1655.0\n\n[timing]\nclocks = [\"tcxo\", \"ocxo\", \"csac\", \"rafs\"]\ncn0_offsets_db = [-30.0, -20.0, -10.0, 0.0]\nweek = 2436\ntow0_s = 172800.0\ntrace = true\n\n[timing.utc]\na0_s = 4.0e-9\na1_s_per_s = 1.0e-14\nt_ot_s = 147456.0\nwn_t = 2436\ndelta_t_ls_s = 18.0\nsigma_s = 5.0e-9\n\n[[system]]\nname = \"Iridium\"\nleo_preset = \"iridium-stl\"\nmask_deg = 15.0\n","ntn-5g-positioning":"# Positioning from a 5G non-terrestrial network (NTN) downlink in the mobile-satellite S band.\n#\n# 3GPP band n256 (downlink 2170 to 2200 MHz, 3GPP TS 38.101-5) serves handsets from\n# satellites. A positioning reference signal in a 5 MHz New Radio channel (4.5 MHz occupied)\n# or a 200 kHz narrowband channel (180 kHz occupied) bounds the time-of-arrival accuracy\n# through its root-mean-square bandwidth: the Cramér-Rao bound is c / (2 pi beta\n# sqrt(2 (C/N0) T)), with beta = B / sqrt(12) for a flat spectrum. The scenario compares the\n# two channels over a representative NTN shell (324 satellites at 600 km, 55 deg, 10 deg mask), adds a\n# 1 m network synchronisation and ephemeris error, and runs downlink time-of-arrival fixes and\n# a single-satellite Doppler fix over the longest pass (height held to 10 m).\n#\n# The bandwidth-to-bound step is a textbook closed form; the positioning accuracy is MODELLED\n# (a bound on a multipath-free channel, not an achieved result).\nkind = \"ntn-positioning\"\nseed = 5\ncarrier_hz = 2172.5e6\nintegration_s = 0.1\ndoppler_integration_s = 1.0\ncn0_dbhz = [38.0, 50.0]\nsync_error_m = 1.0\nduration_s = 600.0\nstep_s = 10.0\n\n[user]\nlat_deg = 52.5\nlon_deg = 13.4\nheight_m = 40.0\n\n[[signal]]\nname = \"NR 5 MHz\"\nbandwidth_hz = 4.5e6\n\n[[signal]]\nname = \"NB 200 kHz\"\nbandwidth_hz = 180e3\n\n[[system]]\nname = \"NTN shell\"\nrole = \"leo\"\nmask_deg = 10.0\n[[system.shell]]\ntotal = 324\nplanes = 18\nphasing = 1\naltitude_km = 600.0\ninclination_deg = 55.0\n","leo-navmsg-fit-interval-trade":"# LEO navigation message: signal-in-space range error (SISRE) versus fit interval.\n#\n# A low Earth orbit (LEO) positioning, navigation and timing (PNT) satellite broadcasts\n# its orbit as a compact parameter set fitted to a short arc. The question: how long can\n# one message cover before its representation error outgrows the target, and what does a\n# set of along-track, cross-track and radial (RAC) correction polynomials buy?\n#\n# Truth: a 550 km, 97.6 deg orbit integrated with the EGM2008 gravity field to degree 20\n# and drag. Each message is fitted over its interval and used over a period centred in\n# it. Two models: the Galileo Open Service Signal-in-Space Interface Control Document\n# (OS SIS ICD) 16-parameter Keplerian set, and that set plus RAC polynomials of degree\n# 7 (along), 5 (cross) and 6 (radial). Why so high: the least-squares Keplerian residual\n# is what the 16 parameters cannot span, so it oscillates across the window, and only a\n# polynomial of higher degree than the Keplerian set already spans removes it (a\n# cross-track polynomial of lower degree removes almost nothing). SISRE uses the\n# global-average weights for the\n# orbit altitude (Montenbruck et al. 2018 method): at 550 km the radial weight is about\n# 0.47 and the transverse weight squared about 1/2.6, so along- and cross-track errors\n# count far more than for medium Earth orbit.\n#\n# The first table sets the usage period equal to the fit interval (1 to 15 minutes);\n# the second holds a 5-minute fit and shortens the update period. No preset is used: the\n# numbers are Kshana's own truth and fit, the representation error only (no orbit\n# determination or prediction error). MODELLED.\nkind = \"leo-navmsg\"\nname = \"LEO message fit-interval trade\"\nseed = 11\nanalysis = [\"fit-interval-trade\"]\n\n[orbit]\naltitude_km = 550.0\ninclination_deg = 97.6\ngravity_degree = 20\ncd_area_over_mass = 0.005\n\n[message]\nmodel = \"kepler-rac\"\nrac_degrees = [7, 5, 6]\n\n[trade]\nspan_s = 1800\nfit_intervals_s = [60, 120, 180, 300, 450, 600, 900]\nupdate_periods_s = [30, 60, 150, 300]\nupdate_fit_interval_s = 300\nmodels = [\"kepler16\", \"kepler-rac\"]\n","leo-band-trade":"# LEO-PNT band trade, UHF to wide C band: what a low Earth orbit (LEO) positioning,\n# navigation and timing (PNT) signal gains and loses in each band, independent of any\n# particular system.\n#\n# Five REPRESENTATIVE designs from the compiled-in `generic-bands` preset, each a pilot\n# and data pair with a 50/50 power split sized to its band:\n#   UHF   465 MHz,      BPSK(5) in 10 MHz\n#   L     1191.795 MHz, BPSK(10) in 20.46 MHz (the Galileo E5 centre)\n#   S     2492.028 MHz, BPSK(5) in 16.5 MHz (the NavIC S-band carrier, in the RDSS band)\n#   C     5020 MHz,     BPSK(10) in 20 MHz (the middle of the 5010-5030 MHz RNSS band)\n#   wide C 5100 MHz,    BPSK(50) in 120 MHz\n# (BPSK binary phase-shift keying; RDSS Radio Determination Satellite Service; RNSS Radio\n# Navigation Satellite Service.)\n#\n# The trade table puts four things side by side:\n#   * ionospheric delay: first order, 40.3 TEC / f^2, for a 50 TECU slant total electron\n#     content: UHF carries (1191.795/465)^2 = 6.6 times the L-band delay, C band 0.056;\n#   * free-space loss at a 1000 km slant range: +20 log10(f/f_L) dB relative to L;\n#   * ranging accuracy (delay-lock-loop thermal-noise jitter, 0.5 chip coherent\n#     early-late spacing, 1 Hz loop) at equal C/N0 (45 dB-Hz for all), and at equal\n#     radiated power (C/N0 falls with the free-space loss: isotropic antennas at both\n#     ends, so the higher band's smaller receive aperture is charged in full);\n#   * the J/S a CW tone, wideband noise and matched noise may reach before the tracked\n#     pilot falls below 25 dB-Hz, at the equal-power C/N0.\n# MODELLED: the closed forms are validated; the designs, the TEC, the range and the\n# equal-power assumption are inputs. No rain or atmospheric loss (it matters at C band).\nkind = \"leo-signal\"\npresets = [\"generic-bands\"]\n\n[receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ncn0_dbhz = [30.0, 35.0, 40.0, 45.0, 50.0, 55.0]\nreference_cn0_dbhz = 45.0\nloop_bandwidth_hz = 1.0\nintegration_time_s = 0.02\ncorrelator_spacings_chips = [1.0, 0.5, 0.2, 0.1]\nreference_spacing_chips = 0.5\ntracking_threshold_dbhz = 25.0\n\n[acquisition]\naltitude_km = 550.0\noscillator_ppm = 0.5\ncoherent_ms = 1.0\nnoncoherent = 1\npfa_cell = 1e-4\n\n[trade]\nreference_signal = \"generic-l\"\nslant_tec_tecu = 50.0\nslant_range_km = 1000.0\n","leo-resilience-gnss-jammed-leo-carries":"# LEO-PNT resilience mission: GNSS jammed, LEO-PNT carries the user, integrity maintained.\n#\n# Three phases on one 30 s timeline, each running a `spectrum` receiver (what it can still\n# track) and an `integrity` run (receiver autonomous integrity monitoring, RAIM, against a\n# 40 m horizontal and 50 m vertical alert limit):\n#\n#   nominal   GPS L1 C/A, Galileo E5a and a generic low Earth orbit (LEO) positioning,\n#             navigation and timing (PNT) layer in the S and C bands all track; integrity\n#             uses the GNSS layer (24 satellites at 20 200 km) and the LEO layer (240 at\n#             1080 km, 53 deg, and 72 at 1080 km, 97 deg) together.\n#   jammed    two barrage jammers, one over L1 and one over L5/E5, at -95 dBW received:\n#             both GNSS signals fall below the 25 dB-Hz tracking floor; the S- and C-band\n#             LEO signals are untouched. Integrity runs on the LEO layer alone.\n#   recovery  the jammers stop; both layers again.\n#\n# The alarm channel is the integrity kind's own: raised at epochs where the protection\n# level cannot be formed or exceeds the alert limit. With GNSS jammed the LEO layer alone\n# still forms a protection level at every epoch; it is under the 50 m alert limit at 28\n# of the 30 grid times and the alarm is raised at the other two. That is integrity\n# working: the user is warned whenever the bound is too large, and availability, not\n# integrity, is what the jamming costs.\n#\n# The integrity runs use that kind's own user track (a circular track 0.4 km up, the\n# convention of the other bundled integrity runs), not the spectrum receiver's site, and\n# a 1 m user-equivalent range error for both layers; those are scenario choices, stated\n# here. The integrity kind does not see the jammer: the jammed phase's LEO-only\n# constellation is the campaign's statement of what the spectrum run says is left.\n# MODELLED.\nkind = \"campaign\"\ntitle = \"GNSS jammed, LEO-PNT carries the user, integrity maintained\"\nseed = 20260929\n\n[timeline]\nstep_s = 30.0\n\n[[phases]]\nname = \"nominal\"\nduration_s = 600.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"cn0_gps_l1ca_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[0].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_galileo_e5a_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[1].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_leo_s_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[2].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_leo_c_dbhz\", unit = \"dB-Hz\", t = \"timeline.t_s[]\", y = \"timeline.bands[3].cn0_effective_dbhz[]\" },\n  { channel = \"cn0_floor_dbhz\", t = \"timeline.t_s[]\", y = \"receiver.tracking_threshold_dbhz\" },\n]\n[phases.runs.scenario]\nkind = \"spectrum\"\nseed = 7\nduration_s = 600.0\nstep_s = 30.0\n[phases.runs.scenario.receiver]\nnoise_figure_db = 2.0\nantenna_temp_k = 290.0\ntracking_threshold_dbhz = 25.0\n[phases.runs.scenario.grid]\nf_min_mhz = 1150.0\nf_max_mhz = 1600.0\nn_freq = 90\n[[phases.runs.scenario.panels]]\nname = \"S band\"\nf_min_mhz = 2482.0\nf_max_mhz = 2502.0\nn_freq = 40\n[[phases.runs.scenario.panels]]\nname = \"C band\"\nf_min_mhz = 5005.0\nf_max_mhz = 5035.0\nn_freq = 40\n[[phases.runs.scenario.bands]]\nname = \"gps-l1ca\"\n[[p