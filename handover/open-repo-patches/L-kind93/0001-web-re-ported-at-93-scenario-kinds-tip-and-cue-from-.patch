mes the ship as the worst platform.\n#\n# The jammer's power and position are declared once under [[compose.shared]] and\n# written into each member at the keys it binds them to, so the two runs cannot\n# disagree about the threat. Each member is an ordinary `jamming` run; the combined\n# summary names the best and worst platform for each metric.\n#\n# MODELLED: as the `jamming` kind is. The car is modelled with the same open-sky\n# receiver as the ship; urban masking and the vehicle antenna are not.\nkind = \"campaign\"\ntitle = \"One jammer, a ship and a car\"\nseed = 20260928\n\n[[compose.shared]]\nname = \"jammer_power\"\nunit = \"dBW\"\nvalue = 8.0\n\n[[compose.shared]]\nname = \"jammer_position\"\nunit = \"m\"\nvalue = [2904623.523, 1381438.498, 5489328.347]\n\n[[compose.members]]\nlabel = \"ship-strait\"\nbind = { jammer_power = \"jammer.power_dbw\", jammer_position = \"jammer.position_ecef_m\" }\nmetrics = [\n  { name = \"availability\", path = \"fom.availability_under_jamming\" },\n  { name = \"mean_js\", path = \"fom.mean_js_db\" },\n  { name = \"min_tracking\", path = \"fom.min_tracking\" },\n]\n[compose.members.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[compose.members.scenario.time]\nstep_s = 30.0\nduration_s = 1800.0\n[compose.members.scenario.receiver]\nlat_deg = 59.80\nlon_deg = 24.90\nalt_m = 0.0\n[compose.members.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[compose.members.scenario.jammer]\nposition_ecef_m = [0.0, 0.0, 0.0]\npower_dbw = 0.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n\n[[compose.members]]\nlabel = \"car-coast-road\"\nbind = { jammer_power = \"jammer.power_dbw\", jammer_position = \"jammer.position_ecef_m\" }\nmetrics = [\n  { name = \"availability\", path = \"fom.availability_under_jamming\" },\n  { name = \"mean_js\", path = \"fom.mean_js_db\" },\n  { name = \"min_tracking\", path = \"fom.min_tracking\" },\n]\n[compose.members.scenario]\nkind = \"jamming\"\nseed = 1\nmask_deg = 5.0\ntracking_threshold_dbhz = 25.0\n[compose.members.scenario.time]\nstep_s = 30.0\nduration_s = 1800.0\n[compose.members.scenario.receiver]\nlat_deg = 60.17\nlon_deg = 24.94\nalt_m = 0.0\n[compose.members.scenario.constellation]\naltitude_km = 20200.0\ninclination_deg = 55.0\nplanes = 6\nsats_per_plane = 4\nphasing_f = 1.0\n[compose.members.scenario.jammer]\nposition_ecef_m = [0.0, 0.0, 0.0]\npower_dbw = 0.0\ngain_dbi = 0.0\njammer_type = \"broadband\"\nbandwidth_mhz = 20.0\n","title":"One jammer, a ship and a car","shared":{"jammer_position":{"unit":"m","value":[2904623.523,1381438.498,5489328.347]},"jammer_power":{"unit":"dBW","value":8.0}},"members":[{"name":"car-coast-road","kind":"jamming","metrics":{"availability":1.0,"mean_js":34.638,"min_tracking":7.0}},{"name":"ship-strait","kind":"jamming","metrics":{"availability":0.0,"mean_js":38.996,"min_tracking":1.0}}],"units":{"availability":"1","mean_js":"dB","min_tracking":"count"}}},"imagery":{"tile":[768,384],"cols":4,"rows":5,"bodies":{"Sun":{"i":0,"licence":"CC BY 4.0","credit":"Solar System Scope (solarsystemscope.com), from NASA mission data","source":"https://commons.wikimedia.org/wiki/File%3ASolarsystemscope_texture_2k_sun.jpg","padded":false},"Mercury":{"i":1,"licence":"CC BY 4.0","credit":"Solar System Scope (solarsystemscope.com), from NASA mission data","source":"https://commons.wikimedia.org/wiki/File%3ASolarsystemscope_texture_2k_mercury.jpg","padded":false},"Venus":{"i":2,"licence":"CC BY 4.0","credit":"Solar System Scope (solarsystemscope.com), from NASA mission data","source":"https://commons.wikimedia.org/wiki/File%3ASolarsystemscope_texture_2k_venus_atmosphere.jpg","padded":false},"Earth":{"i":3,"licence":"Public domain","credit":"NASA Visible Earth, Blue Marble","source":"assets/planets/earth-day-2048.jpg","padded":false},"Moon":{"i":4,"licence":"Public domain","credit":"NASA Scientific Visualization