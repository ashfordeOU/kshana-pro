.jammer_tolerance.cw_js_max_db\": {\n      \"note\": \"largest J/S of a CW tone at the carrier before the tracked component reaches the threshold (J over the tracked power)\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB\"\n    },\n    \"signals[].jammer_tolerance.matched_js_max_db\": {\n      \"note\": \"the same for noise matched to the tracked component's spectrum\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB\"\n    },\n    \"signals[].jammer_tolerance.reference_cn0_dbhz\": {\n      \"note\": \"total in-band C/N0 the tolerance starts from\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB-Hz\"\n    },\n    \"signals[].jammer_tolerance.tracking_threshold_dbhz\": {\n      \"note\": \"threshold the tolerance runs to\",\n      \"provenance\": \"input\",\n      \"unit\": \"dB-Hz\"\n    },\n    \"signals[].jammer_tolerance.wideband_js_max_db\": {\n      \"note\": \"the same for flat noise over the transmit band\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB\"\n    },\n    \"signals[].orbit_altitude_m\": {\n      \"note\": \"constellation orbit altitude given by the preset\",\n      \"provenance\": \"spec\",\n      \"unit\": \"m\"\n    },\n    \"signals[].psd.db_per_hz[]\": {\n      \"note\": \"band-limited composite PSD, unit area inside the transmit band; null outside it\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB(1/Hz)\"\n    },\n    \"signals[].psd.offset_hz[]\": {\n      \"note\": \"offset from the centre of each PSD sample\",\n      \"provenance\": \"computed\",\n      \"unit\": \"Hz\"\n    },\n    \"signals[].received_power_dbw\": {\n      \"note\": \"reference (minimum) received in-band power at the user antenna\",\n      \"provenance\": \"spec\",\n      \"unit\": \"dBW\"\n    },\n    \"signals[].received_power_max_dbw\": {\n      \"note\": \"maximum received power, when published\",\n      \"provenance\": \"spec\",\n      \"unit\": \"dBW\"\n    },\n    \"signals[].reference_cn0_dbhz\": {\n      \"note\": \"total in-band C/N0: received power minus the noise density, or the receiver's reference C/N0\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB-Hz\"\n    },\n    \"signals[].tracking.chip_length_m\": {\n      \"note\": \"c / chip rate\",\n      \"provenance\": \"closed-form\",\n      \"unit\": \"m\"\n    },\n    \"signals[].tracking.cn0_dbhz[]\": {\n      \"note\": \"total in-band C/N0, one column of jitter_m each\",\n      \"provenance\": \"input\",\n      \"unit\": \"dB-Hz\"\n    },\n    \"signals[].tracking.component_cn0_offset_db\": {\n      \"note\": \"10 log10(share/eta): the tracked component's C/N0 relative to the total in-band C/N0, in the convention the tracking formula takes\",\n      \"provenance\": \"closed-form\",\n      \"unit\": \"dB\"\n    },\n    \"signals[].tracking.jitter_m[][]\": {\n      \"note\": \"band-limited early-late code-tracking thermal-noise jitter (Betz & Kolodziejski 2009), 1-sigma, per spacing and C/N0\",\n      \"provenance\": \"computed\",\n      \"unit\": \"m\"\n    },\n    \"signals[].tracking.jitter_unlimited_band_m[][]\": {\n      \"note\": \"the same with an unlimited front end, the textbook BPSK form sqrt(B_L(1 - B_L T/2) d/(2 C/N0)) chips (with the non-coherent squaring loss when selected); null for non-BPSK\",\n      \"provenance\": \"closed-form\",\n      \"unit\": \"m\"\n    },\n    \"signals[].tracking.ranging_accuracy_m\": {\n      \"note\": \"code-tracking thermal-noise ranging accuracy (1-sigma) at the reference C/N0 and spacing\",\n      \"provenance\": \"computed\",\n      \"unit\": \"m\"\n    },\n    \"signals[].tracking.reference_cn0_dbhz\": {\n      \"note\": \"C/N0 of the headline ranging accuracy\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB-Hz\"\n    },\n    \"signals[].tracking.reference_spacing_chips\": {\n      \"note\": \"spacing of the headline ranging accuracy\",\n      \"provenance\": \"input\",\n      \"unit\": \"chip\"\n    },\n    \"signals[].tracking.small_spacing_limit_m[]\": {\n      \"note\": \"vanishing-spacing (Gabor bandwidth) bound on the coherent early-late jitter, per C/N0\",\n      \"provenance\": \"closed-form\",\n      \"unit\": \"m\"\n    },\n    \"signals[].tracking.spacings_chips[]\": {\n      \"note\": \"early-late spacings, one row of jitter_m each\",\n      \"provenance\": \"input\",\n      \"unit\": \"chip\"\n    },\n    \"signals[].tx_bandwidth_hz\": {\n      \"note\": \"transmit bandwidth; the spectrum is zero outside it\",\n      \"provenance\": \"spec\",\n      \"unit\": \"Hz\"\n    },\n    \"trade.rows[].centre_hz\": {\n      \"note\": \"centre frequency\",\n      \"provenance\": \"spec\",\n      \"unit\": \"Hz\"\n    },\n    \"trade.rows[].cn0_equal_eirp_dbhz\": {\n      \"note\": \"C/N0 if every signal left the satellite at the reference signal's EIRP with isotropic antennas: reference C/N0 minus the free-space loss difference\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB-Hz\"\n    },\n    \"trade.rows[].cw_js_max_equal_eirp_db\": {\n      \"note\": \"CW J/S tolerance at the equal-EIRP C/N0\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB\"\n    },\n    \"trade.rows[].free_space_loss_db\": {\n      \"note\": \"free-space path loss 20 log10(4 pi d f / c) at the slant range\",\n      \"provenance\": \"closed-form\",\n      \"unit\": \"dB\"\n    },\n    \"trade.rows[].free_space_loss_vs_reference_db\": {\n      \"note\": \"free-space loss minus the reference signal's, 20 log10(f/f_ref)\",\n      \"provenance\": \"closed-form\",\n      \"unit\": \"dB\"\n    },\n    \"trade.rows[].gabor_bandwidth_hz\": {\n      \"note\": \"Gabor bandwidth of the tracked component inside the transmit band\",\n      \"provenance\": \"computed\",\n      \"unit\": \"Hz\"\n    },\n    \"trade.rows[].iono_delay_m\": {\n      \"note\": \"first-order ionospheric group delay 40.3 TEC / f^2\",\n      \"provenance\": \"closed-form\",\n      \"unit\": \"m\"\n    },\n    \"trade.rows[].iono_delay_ratio\": {\n      \"note\": \"ionospheric delay over the reference signal's, (f_ref/f)^2\",\n      \"provenance\": \"closed-form\",\n      \"unit\": \"1\"\n    },\n    \"trade.rows[].jitter_equal_cn0_m\": {\n      \"note\": \"ranging accuracy at the receiver's reference C/N0 for every signal\",\n      \"provenance\": \"computed\",\n      \"unit\": \"m\"\n    },\n    \"trade.rows[].jitter_equal_eirp_m\": {\n      \"note\": \"ranging accuracy at that C/N0\",\n      \"provenance\": \"computed\",\n      \"unit\": \"m\"\n    },\n    \"trade.rows[].matched_js_max_equal_eirp_db\": {\n      \"note\": \"matched-noise J/S tolerance at the equal-EIRP C/N0\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB\"\n    },\n    \"trade.rows[].tx_bandwidth_hz\": {\n      \"note\": \"transmit bandwidth\",\n      \"provenance\": \"spec\",\n      \"unit\": \"Hz\"\n    },\n    \"trade.rows[].wideband_js_max_equal_eirp_db\": {\n      \"note\": \"wideband-noise J/S tolerance at the equal-EIRP C/N0\",\n      \"provenance\": \"computed\",\n      \"unit\": \"dB\"\n    },\n    \"trade.slant_range_km\": {\n      \"note\": \"slant range of the free-space loss\",\n      \"provenance\": \"input\",\n      \"unit\": \"km\"\n    },\n    \"trade.slant_tec_tecu\": {\n      \"note\": \"slant total electron content, 1 TECU = 1e16 electrons/m^2\",\n      \"provenance\": \"input\",\n      \"unit\": \"TECU\"\n    }\n  },\n  \"evidence\": {\n    \"id_rule\": \"the stable id of the matrix row (the ID column): VM- and 8 hex digits, issued once and never reassigned\",\n    \"matrix\": \"docs/VERIFICATION-MATRIX.md\",\n    \"rows\": [\n      {\n        \"id\": \"VM-cf3cdcd3\",\n        \"requirement\": \"Reproducibility & software assurance\",\n        \"status\": \"MODELLED\"\n      },\n      {\n        \"id\": \"VM-25c2d93d\",\n        \"requirement\": \"Band-limited closed forms for any ranging signal: power in band and early-late code-tracking jitter against published values, with the Gabor bandw