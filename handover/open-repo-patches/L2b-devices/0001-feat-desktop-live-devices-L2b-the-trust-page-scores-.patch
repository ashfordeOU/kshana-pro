diff --git a/web/studio/lib/devices.mjs b/web/studio/lib/devices.mjs
new file mode 100644
index 0000000..7570125
--- /dev/null
+++ b/web/studio/lib/devices.mjs
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// Live devices in Kshana Desktop (apps/desktop, L2b): the trust page's client for the app's
+// device commands and the loop that re-scores a receiver's latest sentences. The app reads
+// the receiver (a serial port, a TCP stream or a growing file) read only; this module only
+// asks it for the excerpt and hands it to the native scorer. Outside the Desktop there is
+// no invoke function and the panel is not shown.
+
+/** The app's device commands, over the Desktop's invoke function. */
+export function deviceApi(invoke) {
+  return {
+    list: () => invoke("devices_list"),
+    start: (source, baud) => invoke("device_start", { source, baud: baud ? Number(baud) : null }),
+    status: () => invoke("device_status"),
+    excerpt: () => invoke("device_excerpt"),
+    stop: () => invoke("device_stop"),
+  };
+}
+
+/** The native engine as a trust page uses one (`available`, `version`, `has`, `call`). */
+export async function nativeEngine(invoke) {
+  const fns = new Set(await invoke("engine_native_fns"));
+  const version = fns.has("version") ? await invoke("engine_call", { name: "version", args: [] }) : null;
+  return {
+    available: true,
+    version,
+    has: (fn) => fns.has(fn),
+    call: (fn, ...args) => invoke("engine_call", { name: fn, args }),
+    error: null,
+  };
+}
+
+/** The serial speeds the app sets (devices.rs BAUDS); "" leaves the port's speed as it is. */
+export const BAUDS = ["", "4800", "9600", "19200", "38400", "57600", "115200", "230400", "460800"];
+
+/**
+ * Score the excerpt every `everyMs` while it grows. `score(text, ex)` is awaited; a tick
+ * never overlaps the one before, and an excerpt already scored (same `seq`) is skipped.
+ * `onStatus(status)` gets the capture state each tick. Returns `{ stop, tick }`.
+ */
+export function liveLoop({ api, score, onStatus = () => {}, everyMs = 5000, setTimer = setTimeout, clearTimer = clearTimeout }) {
+  let last = -1;
+  let timer = null;
+  let stopped = false;
+  let busy = null;
+  const tick = async () => {
+    if (busy) return busy;
+    busy = (async () => {
+      const ex = await api.excerpt();
+      const st = await api.status();
+      onStatus(st);
+      if (ex && ex.seq !== last && ex.sentences > 0) {
+        last = ex.seq;
+        await score(ex.text, ex);
+      }
+      return st;
+    })();
+    try { return await busy; } finally { busy = null; }
+  };
+  const loop = async () => {
+    if (stopped) return;
+    try { await tick(); } catch (e) { onStatus({ running: false, error: String(e && e.message ? e.message : e) }); }
+    if (!stopped) timer = setTimer(loop, everyMs);
+  };
+  timer = setTimer(loop, 0);
+  return {
+    tick,
+    stop() { stopped = true; if (timer != null) clearTimer(timer); timer = null; },
+  };
+}
+
+/** A one-line, unlocalised summary of a capture state's counters, for the status line's variables. */
+export function counters(st) {
+  return {
+    sentences: Number(st && st.sentences) || 0,
+    kept: Number(st && st.excerpt_sentences) || 0,
+    other: Number(st && st.other_lines) || 0,
+    ageS: st && st.last_unix_ms ? Math.max(0, Math.round((Date.now() - st.last_unix_ms) / 1000)) : null,
+  };
+}
diff --git a/web/studio/lib/devices.test.mjs b/web/studio/lib/devices.test.mjs
new file mode 100644
index 0000000..08265de
--- /dev/null
+++ b/web/studio/lib/devices.test.mjs
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// Tests for the live device client (devices.mjs) against a fake Desktop invoke.
+// Run with `node web/studio/lib/devices.test.mjs`.
+import assert from "node:assert/strict";
+import { deviceApi, nativeEngine, liveLoop, counters, BAUDS } from "./devices.mjs";
+
+const calls = [];
+let seq = 0;
+let text = "";
+const invoke = async (cmd, args) => {
+  calls.push([cmd, args]);
+  switch (cmd) {
+    case "devices_list": return [{ path: "/dev/ttyACM0", label: "ttyACM0" }];
+    case "device_start": return { running: true, source: args.source };
+    case "device_status": return { running: true, sentences: seq, excerpt_sentences: seq, other_lines: 1, last_unix_ms: Date.now() };
+    case "device_excerpt": return { seq, text, sentences: seq };
+    case "device_stop": return { stopped: "x" };
+    case "engine_native_fns": return ["version", "receiver_trust_replay"];
+    case "engine_call": return args.name === "version" ? "0.41.0" : `scored:${args.args[1]}`;
+    default: throw new Error(`unknown command ${cmd}`);
+  }
+};
+
+// The commands and their arguments.
+const api = deviceApi(invoke);
+assert.deepEqual(await api.list(), [{ path: "/dev/ttyACM0", label: "ttyACM0" }]);
+await api.start("tcp:127.0.0.1:10110", "");
+assert.deepEqual(calls.at(-1), ["device_start", { source: "tcp:127.0.0.1:10110", baud: null }]);
+await api.start("/dev/ttyUSB0", "4800");
+assert.deepEqual(calls.at(-1), ["device_start", { source: "/dev/ttyUSB0", baud: 4800 }]);
+assert.equal(BAUDS[0], "");
+assert.ok(BAUDS.includes("4800") && BAUDS.includes("115200"));
+
+// The native engine as the trust page uses it.
+const eng = await nativeEngine(invoke);
+assert.equal(eng.available, true);
+assert.equal(eng.version, "0.41.0");
+assert.equal(eng.has("receiver_trust_replay"), true);
+assert.equal(eng.has("receiver_trust"), false);
+assert.equal(await eng.call("receiver_trust_replay", "[platform]", "$GPGGA"), "scored:$GPGGA");
+
+// The loop: scores a grown excerpt once, skips an unchanged one, never overlaps, stops.
+const timers = [];
+const setTimer = (fn) => { timers.push(fn); return timers.length; };
+const cleared = [];
+const scored = [];
+const statuses = [];
+let gate = null;
+const loop = liveLoop({
+  api, everyMs: 5000, setTimer, clearTimer: (id) => cleared.push(id),
+  onStatus: (s) => statuses.push(s),
+  score: async (t) => { scored.push(t); if (gate) await gate; },
+});
+// Nothing captured yet: no score.
+await timers.shift()();
+assert.deepEqual(scored, []);
+seq = 2; text = "$A\n$B\n";
+await timers.shift()();
+assert.deepEqual(scored, ["$A\n$B\n"]);
+// Unchanged: skipped.
+await timers.shift()();
+assert.equal(scored.length, 1);
+// A slow score: a second tick while it runs joins it instead of scoring again.
+seq = 3; text = "$A\n$B\n$C\n";
+let open;
+gate = new Promise((r) => { open = r; });
+const a = loop.tick();
+const b = loop.tick();
+open();
+await Promise.all([a, b]);
+assert.equal(scored.length, 2);
+assert.ok(statuses.length >= 4);
+loop.stop();
+assert.equal(cleared.length, 1);
+// A tick that fails reports a stopped state instead of throwing, and the loop goes on.
+timers.length = 0;
+const bad = liveLoop({ api: { status: async () => { throw new Error("gone"); }, excerpt: async () => ({}) }, score: async () => {}, setTimer, clearTimer: () => {}, onStatus: (s) => statuses.push(s) });
+await timers.shift()();
+assert.deepEqual(statuses.at(-1), { running: false, error: "gone" });
+assert.equal(timers.length, 1);
+bad.stop();
+
+assert.deepEqual(counters({ sentences: 10, excerpt_sentences: 8, other_lines: 2, last_unix_ms: null }), { sentences: 10, kept: 8, other: 2, ageS: null });
+assert.deepEqual(counters(null), { sentences: 0, kept: 0, other: 0, ageS: null });
+console.log("devices.mjs: OK");
