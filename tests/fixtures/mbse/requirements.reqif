<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="KP-HEADER">
      <COMMENT>Exported by Kshana Pro MBSE. Acceptance criteria are machine-checkable expressions over open Kshana engine result documents.</COMMENT>
      <CREATION-TIME>1970-01-01T00:00:00Z</CREATION-TIME>
      <REQ-IF-TOOL-ID>Kshana Pro</REQ-IF-TOOL-ID>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <SOURCE-TOOL-ID>Kshana Pro MBSE</SOURCE-TOOL-ID>
      <TITLE>Kshana worked example</TITLE>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="KP-DT-STRING" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="String" MAX-LENGTH="32000"/>
        <DATATYPE-DEFINITION-ENUMERATION IDENTIFIER="KP-DT-METHOD" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="Verification method">
          <SPECIFIED-VALUES>
            <ENUM-VALUE IDENTIFIER="KP-EV-TEST" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="test">
              <PROPERTIES><EMBEDDED-VALUE KEY="0" OTHER-CONTENT=""/></PROPERTIES>
            </ENUM-VALUE>
            <ENUM-VALUE IDENTIFIER="KP-EV-ANALYSIS" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="analysis">
              <PROPERTIES><EMBEDDED-VALUE KEY="1" OTHER-CONTENT=""/></PROPERTIES>
            </ENUM-VALUE>
            <ENUM-VALUE IDENTIFIER="KP-EV-INSPECTION" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="inspection">
              <PROPERTIES><EMBEDDED-VALUE KEY="2" OTHER-CONTENT=""/></PROPERTIES>
            </ENUM-VALUE>
            <ENUM-VALUE IDENTIFIER="KP-EV-DEMONSTRATION" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="demonstration">
              <PROPERTIES><EMBEDDED-VALUE KEY="3" OTHER-CONTENT=""/></PROPERTIES>
            </ENUM-VALUE>
          </SPECIFIED-VALUES>
        </DATATYPE-DEFINITION-ENUMERATION>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="KP-SOT-REQ" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="KP-AD-ID" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="ReqIF.ForeignID">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>KP-DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="KP-AD-TEXT" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="ReqIF.Text">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>KP-DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-ENUMERATION IDENTIFIER="KP-AD-METHOD" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="Verification Method" MULTI-VALUED="false">
              <TYPE><DATATYPE-DEFINITION-ENUMERATION-REF>KP-DT-METHOD</DATATYPE-DEFINITION-ENUMERATION-REF></TYPE>
            </ATTRIBUTE-DEFINITION-ENUMERATION>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="KP-AD-CRITERION" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="Acceptance Criterion">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>KP-DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="KP-AD-RUNS" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="Kshana Runs">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>KP-DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="KP-AD-CAPS" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="Kshana Capabilities">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>KP-DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPECIFICATION-TYPE IDENTIFIER="KP-ST" LAST-CHANGE="1970-01-01T00:00:00Z" LONG-NAME="Requirements specification"/>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="KP-SO-CLK-001" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CLK-001"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="During a GNSS outage the chip-scale atomic clock (CSAC) shall keep the 95th-percentile timing error within 20 ns."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="classical.fom.timing_p95_ns &lt;= 20 ns"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-CLOCK"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-CLK-002" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CLK-002"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The CSAC shall hold the timing specification for at least 30 minutes after GNSS is denied."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="classical.fom.holdover_s &gt;= 30 min"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-CLOCK"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-CLK-003" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CLK-003"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The optical clock's timing error shall stay within 1 ns at every sample of the run."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-TEST</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="abs_max(quantum.series[].error_ns) &lt;= 1 ns"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-CLOCK"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-CLK-004" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CLK-004"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The CSAC's timing error shall stay below 50 ns at every sample of the run."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="classical.series.error_ns.max &lt;= 50 ns"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-CLOCK"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-CLK-005" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CLK-005"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The CSAC's Allan deviation at the shortest averaging time the run resolves shall not exceed 1e-10, computed with the IEEE 1139 power-law noise model and a validated Allan estimator."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="classical.adev_curve[0].adev &lt;= 1e-10"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-CLOCK"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Frequency stability characterisation;IEEE-1139 power-law clock noise + flicker-FM floor"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CAPS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-CLK-006" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CLK-006"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The clock filter shall pass its own statistical consistency check."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-DEMONSTRATION</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="quantum.filter_health.consistent == true"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-CLOCK"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-INT-001" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="INT-001"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The horizontal protection level shall stay below the horizontal alert limit at every epoch."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="epochs.hpl_m &lt; al_h_m for all epochs"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-RAIM"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-INT-002" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="INT-002"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Integrity shall be available at 95 % of epochs or more."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="fraction(epochs.available == true) &gt;= 95 %"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-RAIM"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-INT-003" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="INT-003"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="No epoch shall show misleading information: the vertical error shall stay inside the protection level."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="abs(stanford.points.error_m) &lt; stanford.points.pl_m for all points"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-RAIM"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-CMP-001" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CMP-001"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="In the chained jamming, spoofing and holdover mission, a spoofing alarm shall be raised within 30 minutes of the start."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="min(timeline.events[].t_s) &lt;= 30 min"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-CAMPAIGN"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-CMP-002" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CMP-002"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="In the chained mission the clock time error shall stay within its guard at every timeline step."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="timeline.channels.time_error_ns.values &lt;= timeline.channels.guard_ns.values for all values"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-CAMPAIGN"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-LEO-001" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="LEO-001"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="With low Earth orbit (LEO) augmentation the fused three-dimensional position error shall be 0.5 m root mean square (RMS) or better."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="fusion.fused.rms_error_3d_m &lt;= 0.5 m"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-LEO"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-LEO-002" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="LEO-002"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The LEO navigation message shall keep the signal-in-space range error (SISRE) within 30 cm RMS."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="navmsg.sisre_rms_m &lt;= 30 cm"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="RUN-LEO"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-RUNS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>KP-SOT-REQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="KP-SO-LEO-003" LAST-CHANGE="1970-01-01T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="LEO-003"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="With 240 LEO satellites, precise point positioning (PPP) shall converge within 10 minutes."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>KP-AD-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>KP-EV-ANALYSIS</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ppp.cases[1].median_convergence_min &lt;= 10 min"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>KP-AD-CRITERION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
