    package RequirementDefinitions {
        requirement def <'CLK-001'> 'CLK-001' {
            doc /* During a GNSS outage the chip-scale atomic clock (CSAC) shall keep the 95th-percentile timing error within 20 ns. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "classical.fom.timing_p95_ns <= 20 ns";
        }
        requirement def <'CLK-002'> 'CLK-002' {
            doc /* The CSAC shall hold the timing specification for at least 30 minutes after GNSS is denied. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "classical.fom.holdover_s >= 30 min";
        }
        requirement def <'CLK-003'> 'CLK-003' {
            doc /* The optical clock's timing error shall stay within 1 ns at every sample of the run. */
            attribute verificationMethod : ScalarValues::String = "test";
            attribute acceptanceCriterion : ScalarValues::String = "abs_max(quantum.series[].error_ns) <= 1 ns";
        }
        requirement def <'CLK-004'> 'CLK-004' {
            doc /* The CSAC's timing error shall stay below 50 ns at every sample of the run. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "classical.series.error_ns.max <= 50 ns";
        }
        requirement def <'CLK-005'> 'CLK-005' {
            doc /* The CSAC's Allan deviation at the shortest averaging time the run resolves shall not exceed 1e-10, computed with the IEEE 1139 power-law noise model and a validated Allan estimator. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "classical.adev_curve[0].adev <= 1e-10";
            attribute kshanaCapabilities : ScalarValues::String = "Frequency stability characterisation;IEEE-1139 power-law clock noise + flicker-FM floor";
        }
        requirement def <'CLK-006'> 'CLK-006' {
            doc /* The clock filter shall pass its own statistical consistency check. */
            attribute verificationMethod : ScalarValues::String = "demonstration";
            attribute acceptanceCriterion : ScalarValues::String = "quantum.filter_health.consistent == true";
        }
        requirement def <'INT-001'> 'INT-001' {
            doc /* The horizontal protection level shall stay below the horizontal alert limit at every epoch. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "epochs.hpl_m < al_h_m for all epochs";
        }
        requirement def <'INT-002'> 'INT-002' {
            doc /* Integrity shall be available at 95 % of epochs or more. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "fraction(epochs.available == true) >= 95 %";
        }
        requirement def <'INT-003'> 'INT-003' {
            doc /* No epoch shall show misleading information: the vertical error shall stay inside the protection level. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "abs(stanford.points.error_m) < stanford.points.pl_m for all points";
        }
        requirement def <'CMP-001'> 'CMP-001' {
            doc /* In the chained jamming, spoofing and holdover mission, a spoofing alarm shall be raised within 30 minutes of the start. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "min(timeline.events[].t_s) <= 30 min";
        }
        requirement def <'CMP-002'> 'CMP-002' {
            doc /* In the chained mission the clock time error shall stay within its guard at every timeline step. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "timeline.channels.time_error_ns.values <= timeline.channels.guard_ns.values for all values";
        }
        requirement def <'LEO-001'> 'LEO-001' {
            doc /* With low Earth orbit (LEO) augmentation the fused three-dimensional position error shall be 0.5 m root mean square (RMS) or better. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "fusion.fused.rms_error_3d_m <= 0.5 m";
        }
        requirement def <'LEO-002'> 'LEO-002' {
            doc /* The LEO navigation message shall keep the signal-in-space range error (SISRE) within 30 cm RMS. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "navmsg.sisre_rms_m <= 30 cm";
        }
        requirement def <'LEO-003'> 'LEO-003' {
            doc /* With 240 LEO satellites, precise point positioning (PPP) shall converge within 10 minutes. */
            attribute verificationMethod : ScalarValues::String = "analysis";
            attribute acceptanceCriterion : ScalarValues::String = "ppp.cases[1].median_convergence_min <= 10 min";
        }
        requirement def <'OPS-001'> 'OPS-001' {
            doc /* The receiver housing shall carry the programme's identification label. */
            attribute verificationMethod : ScalarValues::String = "inspection";
        }
    }
